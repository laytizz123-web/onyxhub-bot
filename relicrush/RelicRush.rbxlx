}

-- Recompenses quotidiennes (7 jours, x mult du meilleur monde pour les pieces)
Config.Daily = {
	Cooldown = 20 * 3600, Reset = 48 * 3600,
	Days = {
		{ coins = 300 }, { coins = 500 }, { potion = &quot;PotionCoins&quot; }, { coins = 1200 },
