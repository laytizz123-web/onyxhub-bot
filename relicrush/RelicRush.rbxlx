-- Quetes -----------------------------------------------------------------------------------------------
Config.DailyQuestPool = {
	{ id = &quot;break&quot;, text = &quot;Detruis %d tresors&quot;, goal = 60, stat = &quot;Breaks&quot;, reward = 2 },
	{ id = &quot;crates&quot;, text = &quot;Ouvre %d caisses&quot;, goal = 15, stat = &quot;Crates&quot;, reward = 2 },
