</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Icons</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Icones de RELIC RUSH (planche fournie + petites icones), affichees via EditableImage
-- a partir de IconData (aucun upload necessaire). Si tu uploades les PNG de assets/icons,
-- renseigne leurs IDs dans Icons.AssetIds pour les utiliser a la place.

local AssetService = game:GetService(&quot;AssetService&quot;)

local Icons = {}
Icons.AssetIds = {
	-- index = &quot;rbxassetid://123456&quot;,
}

local IconData
local cache = {}
local supported = true

local B64 = {}
do
	local chars = &quot;ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/&quot;
	for i = 1, #chars do
		B64[string.byte(chars, i)] = i - 1
	end
end

local function b64decode(s)
	local len = #s
	local pad = (string.sub(s, -2) == &quot;==&quot;) and 2 or ((string.sub(s, -1) == &quot;=&quot;) and 1 or 0)
	local outLen = (len // 4) * 3 - pad
	local out = buffer.create(outLen)
	local o = 0
	for i = 1, len, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local n = (B64[a] or 0) * 262144 + (B64[b] or 0) * 4096 + (B64[c] or 0) * 64 + (B64[d] or 0)
		if o &lt; outLen then
			buffer.writeu8(out, o, n // 65536)
		end
		if o + 1 &lt; outLen then
			buffer.writeu8(out, o + 1, (n // 256) % 256)
		end
		if o + 2 &lt; outLen then
			buffer.writeu8(out, o + 2, n % 256)
		end
		o += 3
	end
	return out
end

local function content(name)
	if cache[name] ~= nil then
		return cache[name]
	end
	cache[name] = false
	if not supported then
		return false
	end
	if not IconData then
		local ok, data = pcall(require, script.Parent:WaitForChild(&quot;IconData&quot;, 10))
		IconData = ok and data or {}
	end
	local entry = IconData[name]
	if not entry then
		return false
	end
	local ok, result = pcall(function()
		local size = entry.size
		local palette = b64decode(entry.palette)
		local rle = b64decode(entry.data)
		local pixels = buffer.create(size * size * 4)
		local o = 0
		for i = 0, buffer.len(rle) - 2, 2 do
			local run = buffer.readu8(rle, i)
			local color = buffer.readu32(palette, buffer.readu8(rle, i + 1) * 4)
			for _ = 1, run do
				buffer.writeu32(pixels, o, color)
				o += 4
			end
		end
		local image = AssetService:CreateEditableImage({ Size = Vector2.new(size, size) })
		image:WritePixelsBuffer(Vector2.zero, Vector2.new(size, size), pixels)
		return Content.fromObject(image)
	end)
	if ok then
		cache[name] = result
		return result
	end
	warn(&quot;[RelicRush] Icone &quot; .. name .. &quot; indisponible : &quot; .. tostring(result))
	supported = false
	return false
end

-- Vrai si une image existe pour ce nom (ID uploade ou image integree)
function Icons.Has(name)
	if Icons.AssetIds[name] then
		return true
	end
	if not IconData then
		local ok, data = pcall(require, script.Parent:WaitForChild(&quot;IconData&quot;, 10))
		IconData = ok and data or {}
	end
	return IconData[name] ~= nil and supported
end

function Icons.Apply(target, name)
	local id = Icons.AssetIds[name]
	if id then
		target.Image = id
		return target
	end
	local c = content(name)
	if c then
		local ok = pcall(function()
			target.ImageContent = c
		end)
		if ok then
			return target
		end
	end
	-- repli : etiquette texte (jamais d'emoji)
	local l = Instance.new(&quot;TextLabel&quot;)
	l.Name = &quot;IconFallback&quot;
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = Color3.fromRGB(255, 210, 90)
	l.Text = string.upper(name)
	l.ZIndex = target.ZIndex + 1
	l.Parent = target
	return target
end

function Icons.Image(name, parent, props)
	local img = Instance.new(&quot;ImageLabel&quot;)
	img.Name = &quot;Icon_&quot; .. name
	img.BackgroundTransparency = 1
	img.ScaleType = Enum.ScaleType.Fit
	for k, v in pairs(props or {}) do
		img[k] = v
	end
	Icons.Apply(img, name)
	img.Parent = parent
	return img
end

function Icons.Button(name, parent, props)
	local b = Instance.new(&quot;ImageButton&quot;)
	b.Name = &quot;Btn_&quot; .. name
	b.BackgroundTransparency = 1
	b.AutoButtonColor = false
	b.ScaleType = Enum.ScaleType.Fit
	for k, v in pairs(props or {}) do
		b[k] = v
	end
	Icons.Apply(b, name)
	b.Parent = parent
	return b
end

return Icons
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">RelicModel</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Modeles 3D des reliques, construits par code (aucun import necessaire).
-- RelicModel.Build(relicId, opts) -&gt; Model centre sur l'origine (~2 studs), PrimaryPart &quot;Core&quot;.
-- opts.effects = false : sans lumiere ni particules (icones de l'interface).
-- opts.silhouette = true : relique non decouverte (noire).

local Config = require(script.Parent.Config)

local RelicModel = {}

local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad
local V = Vector3.new

local function piece(model, shape, size, cf, color, material, transparency)
	local p = Instance.new(shape == &quot;wedge&quot; and &quot;WedgePart&quot; or &quot;Part&quot;)
	if shape == &quot;ball&quot; then
		p.Shape = Enum.PartType.Ball
	elseif shape == &quot;cyl&quot; then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local NEON = Enum.Material.Neon
local METAL = Enum.Material.Metal
local GLASS = Enum.Material.Glass
local GOLD = Color3.fromRGB(255, 200, 60)

local function ball(m, d, cf, c, mat)
	return piece(m, &quot;ball&quot;, V(d, d, d), cf, c, mat)
end
local function box(m, s, cf, c, mat)
	return piece(m, &quot;box&quot;, s, cf, c, mat)
end
local function cyl(m, h, d, cf, c, mat) -- cylindre vertical
	return piece(m, &quot;cyl&quot;, V(h, d, d), cf * ANG(0, 0, rad(90)), c, mat)
end
local function ring(m, r, thick, cf, c, mat, n)
	n = n or 14
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		box(m, V(r * 2 * math.pi / n + 0.04, thick, thick), cf * CF(math.cos(a) * r, math.sin(a) * r, 0) * ANG(0, 0, a + math.pi / 2), c, mat)
	end
end
local function gem(m, s, cf, c, mat)
	-- octaedre : deux pyramides de coins
	box(m, V(s, s, s) * 0.72, cf * ANG(rad(45), 0, rad(45)), c, mat or GLASS)
	box(m, V(s * 0.45, s * 0.45, s * 0.45), cf * ANG(rad(45), 0, rad(45)), c:Lerp(Color3.new(1, 1, 1), 0.4), NEON)
end

local SHAPES = {}

SHAPES.rune = function(m, a, b)
	box(m, V(1.4, 1.9, 0.5), CF(), a, Enum.Material.Slate)
	box(m, V(0.18, 1.2, 0.1), CF(0, 0, -0.28), b, NEON)
	box(m, V(0.8, 0.18, 0.1), CF(0, 0.3, -0.28) * ANG(0, 0, rad(30)), b, NEON)
	box(m, V(0.6, 0.18, 0.1), CF(0, -0.35, -0.28) * ANG(0, 0, rad(-35)), b, NEON)
end
SHAPES.flask = function(m, a, b)
	ball(m, 1.4, CF(0, -0.3, 0), a, GLASS).Transparency = 0.25
	ball(m, 1.05, CF(0, -0.35, 0), a, NEON)
	cyl(m, 0.8, 0.5, CF(0, 0.6, 0), b, GLASS)
	cyl(m, 0.3, 0.6, CF(0, 1.05, 0), Color3.fromRGB(150, 100, 60), Enum.Material.Wood)
end
SHAPES.feather = function(m, a, b)
	for i = 0, 6 do
		local t = i / 6
		box(m, V(0.9 - math.abs(t - 0.45) * 1.1, 0.34, 0.1), CF(math.sin(t * 2) * 0.2, -1 + t * 2, 0) * ANG(0, 0, rad(-20 + t * 30)), i % 2 == 0 and a or a:Lerp(b, 0.4))
	end
	box(m, V(0.08, 2.3, 0.08), CF(0.05, 0, -0.06) * ANG(0, 0, rad(-8)), b, METAL)
end
SHAPES.amulet = function(m, a, b)
	ring(m, 0.85, 0.18, CF(), a, METAL)
	gem(m, 0.8, CF(), b)
	ring(m, 0.45, 0.1, CF(0, 1.05, 0), a, METAL, 10)
end
SHAPES.idol = function(m, a, b)
	box(m, V(1.6, 1.7, 1.2), CF(), a, METAL)
	box(m, V(1.9, 0.35, 1.3), CF(0, 0.95, 0), a:Lerp(Color3.new(0, 0, 0), 0.15), METAL)
	for _, x in ipairs({ -0.4, 0.4 }) do
		box(m, V(0.36, 0.22, 0.1), CF(x, 0.25, -0.62), b, NEON)
	end
	box(m, V(0.3, 0.5, 0.15), CF(0, -0.15, -0.62), a:Lerp(Color3.new(0, 0, 0), 0.2), METAL)
	box(m, V(0.9, 0.16, 0.1), CF(0, -0.55, -0.62), b, NEON)
	gem(m, 0.45, CF(0, 1.3, 0), b)
end
SHAPES.crown = function(m, a, b)
	cyl(m, 0.6, 1.9, CF(0, -0.4, 0), a, METAL)
	for i = 0, 5 do
		local ang = i / 6 * math.pi * 2
		local p = CF(math.cos(ang) * 0.82, 0.25, math.sin(ang) * 0.82)
		piece(m, &quot;wedge&quot;, V(0.3, 0.8, 0.5), p * ANG(0, -ang + math.pi / 2, 0), a, METAL)
		ball(m, 0.26, p * CF(0, 0.5, 0), b, NEON)
	end
	gem(m, 0.5, CF(0, -0.35, -0.95), b)
end
SHAPES.orb = function(m, a, b)
	ball(m, 1.5, CF(), a, NEON).Transparency = 0.1
	ball(m, 1.75, CF(), a, GLASS).Transparency = 0.6
	ring(m, 1.15, 0.12, CF() * ANG(rad(70), 0, 0), b, METAL)
	ring(m, 1.25, 0.1, CF() * ANG(rad(20), rad(60), 0), b, METAL)
end
SHAPES.acorn = function(m, a, b)
	local nut = ball(m, 1.4, CF(0, -0.2, 0), a)
	local mesh = Instance.new(&quot;SpecialMesh&quot;)
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = V(1, 1.25, 1)
	mesh.Parent = nut
	local cap = ball(m, 1.55, CF(0, 0.45, 0), Color3.fromRGB(120, 80, 45), Enum.Material.Wood)
	local cm = Instance.new(&quot;SpecialMesh&quot;)
	cm.MeshType = Enum.MeshType.Sphere
	cm.Scale = V(1, 0.55, 1)
	cm.Parent = cap
	cyl(m, 0.45, 0.16, CF(0, 0.95, 0), Color3.fromRGB(100, 65, 35))
	box(m, V(0.5, 0.06, 0.25), CF(0.25, 1.05, 0) * ANG(0, 0, rad(25)), b)
end
SHAPES.mushroom = function(m, a, b)
	cyl(m, 1, 0.55, CF(0, -0.5, 0), b)
	local cap = ball(m, 1.9, CF(0, 0.15, 0), a, NEON)
	local mesh = Instance.new(&quot;SpecialMesh&quot;)
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = V(1, 0.55, 1)
	mesh.Parent = cap
	for i = 0, 4 do
		local ang = i * 1.3
		ball(m, 0.25, CF(math.cos(ang) * 0.5, 0.55, math.sin(ang) * 0.5), b)
	end
end
SHAPES.lantern = function(m, a, b)
	box(m, V(1.2, 0.15, 1.2), CF(0, 0.85, 0), a, METAL)
	box(m, V(1.2, 0.15, 1.2), CF(0, -0.85, 0), a, METAL)
	for _, x in ipairs({ -0.55, 0.55 }) do
		for _, z in ipairs({ -0.55, 0.55 }) do
			box(m, V(0.1, 1.6, 0.1), CF(x, 0, z), a, METAL)
		end
	end
	ball(m, 0.8, CF(), b, NEON)
	box(m, V(1, 1.5, 1), CF(), b, GLASS).Transparency = 0.55
	ring(m, 0.3, 0.08, CF(0, 1.15, 0), a, METAL, 8)
end
SHAPES.totem = function(m, a, b)
	for i = 0, 2 do
		local y = -0.75 + i * 0.75
		box(m, V(1, 0.7, 1), CF(0, y, 0), a:Lerp(Color3.new(1, 1, 1), i * 0.08), Enum.Material.Wood)
		for _, x in ipairs({ -0.25, 0.25 }) do
			box(m, V(0.2, 0.15, 0.1), CF(x, y + 0.1, -0.52), b, NEON)
		end
	end
	for _, s in ipairs({ -1, 1 }) do
		piece(m, &quot;wedge&quot;, V(0.1, 0.6, 0.8), CF(s * 0.75, 0.8, 0) * ANG(0, rad(90 * s), 0), b)
	end
end
SHAPES.heart = function(m, a, b)
	ball(m, 1.1, CF(-0.38, 0.25, 0), a, NEON)
	ball(m, 1.1, CF(0.38, 0.25, 0), a, NEON)
	box(m, V(1.05, 1.05, 0.95), CF(0, -0.3, 0) * ANG(0, 0, rad(45)), a, NEON)
	ring(m, 1.25, 0.08, CF(), b, METAL)
end
SHAPES.gem = function(m, a, b)
	gem(m, 1.7, CF(), a)
	ring(m, 1.05, 0.08, CF() * ANG(rad(90), 0, 0), b, METAL)
end
SHAPES.geode = function(m, a, b)
	local shell = ball(m, 1.8, CF(), a, Enum.Material.Slate)
	for i = 0, 5 do
		local ang = i / 6 * math.pi * 2
		box(m, V(0.25, 0.7, 0.25), CF(math.cos(ang) * 0.4, 0.2, -0.75 + math.sin(ang) * 0.2) * ANG(rad(-60), ang, 0), b, NEON)
	end
	shell.Transparency = 0
end
SHAPES.prism = function(m, a, b)
	for i = 0, 2 do
		piece(m, &quot;wedge&quot;, V(1.2, 1.8, 0.7), CF() * ANG(0, i * math.pi * 2 / 3, 0) * CF(0, 0, -0.35), a:Lerp(b, i / 3), GLASS).Transparency = 0.15
	end
	ball(m, 0.6, CF(), b, NEON)
end
SHAPES.scepter = function(m, a, b)
	cyl(m, 2.2, 0.22, CF(0, -0.3, 0), b, METAL)
	gem(m, 0.9, CF(0, 1.05, 0), a)
	ring(m, 0.55, 0.1, CF(0, 1.05, 0), b, METAL, 10)
	ball(m, 0.4, CF(0, -1.4, 0), b, METAL)
end
SHAPES.cube = function(m, a, b)
	box(m, V(1.4, 1.4, 1.4), CF() * ANG(rad(35), rad(45), 0), a, Enum.Material.Glass)
	box(m, V(0.9, 0.9, 0.9), CF() * ANG(rad(35), rad(45), 0), b, NEON)
	for i = 0, 2 do
		ring(m, 1.25, 0.06, CF() * ANG(rad(i * 60), rad(i * 40), 0), b, NEON, 16)
	end
end
SHAPES.scarab = function(m, a, b)
	local body = ball(m, 1.5, CF(0, 0, 0.1), a, METAL)
	local mesh = Instance.new(&quot;SpecialMesh&quot;)
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = V(0.9, 0.55, 1.2)
	mesh.Parent = body
	ball(m, 0.6, CF(0, 0, -0.85), a, METAL)
	box(m, V(0.06, 0.5, 1.3), CF(0, 0.3, 0.15), b, NEON)
	for _, s in ipairs({ -1, 1 }) do
		for i = 0, 2 do
			box(m, V(0.5, 0.08, 0.08), CF(s * 0.75, -0.1, -0.3 + i * 0.4) * ANG(0, rad(s * (20 - i * 20)), rad(s * -25)), a, METAL)
		end
	end
	gem(m, 0.4, CF(0, 0.25, -0.85), b)
end
SHAPES.hourglass = function(m, a, b)
	cyl(m, 0.2, 1.5, CF(0, 1, 0), a, Enum.Material.Wood)
	cyl(m, 0.2, 1.5, CF(0, -1, 0), a, Enum.Material.Wood)
	for _, x in ipairs({ -0.6, 0.6 }) do
		cyl(m, 2, 0.14, CF(x, 0, 0), a, Enum.Material.Wood)
	end
	ball(m, 1, CF(0, 0.45, 0), b, GLASS).Transparency = 0.4
	ball(m, 1, CF(0, -0.45, 0), b, GLASS).Transparency = 0.4
	ball(m, 0.6, CF(0, -0.55, 0), b, NEON)
end
SHAPES.ankh = function(m, a, b)
	box(m, V(0.35, 1.4, 0.3), CF(0, -0.45, 0), a, METAL)
	box(m, V(1.4, 0.35, 0.3), CF(0, 0.3, 0), a, METAL)
	ring(m, 0.42, 0.22, CF(0, 0.85, 0), a, METAL, 12)
	gem(m, 0.35, CF(0, 0.3, -0.2), b)
end
SHAPES.mask = function(m, a, b)
	box(m, V(1.5, 1.8, 0.4), CF(), a, METAL)
	for i = 0, 4 do
		box(m, V(1.9 - i * 0.12, 0.16, 0.45), CF(0, 0.85 - i * 0.3, 0.15), i % 2 == 0 and b or a, METAL)
	end
	for _, x in ipairs({ -0.35, 0.35 }) do
		box(m, V(0.35, 0.15, 0.1), CF(x, 0.25, -0.22), Color3.fromRGB(20, 20, 40))
	end
	box(m, V(0.25, 0.7, 0.2), CF(0, -1.1, 0), b, METAL)
end
SHAPES.obelisk = function(m, a, b)
	box(m, V(0.7, 1.9, 0.7), CF(0, -0.2, 0), a, Enum.Material.Marble)
	piece(m, &quot;wedge&quot;, V(0.7, 0.5, 0.35), CF(0, 0.98, -0.175), b, METAL)
	piece(m, &quot;wedge&quot;, V(0.7, 0.5, 0.35), CF(0, 0.98, 0.175) * ANG(0, math.pi, 0), b, METAL)
	box(m, V(0.2, 0.2, 0.05), CF(0, 0.3, -0.37), b, NEON)
	box(m, V(1.1, 0.25, 1.1), CF(0, -1.25, 0), b, METAL)
end
SHAPES.sun = function(m, a, b)
	ball(m, 1.2, CF(), a, NEON)
	for i = 0, 9 do
		local ang = i / 10 * math.pi * 2
		piece(m, &quot;wedge&quot;, V(0.12, 0.6, 0.3), CF(math.cos(ang) * 0.95, math.sin(ang) * 0.95, 0) * ANG(0, 0, ang - math.pi / 2) * ANG(0, rad(90), 0), b, NEON)
	end
	ring(m, 0.75, 0.08, CF(), b, METAL)
end
SHAPES.snowflake = function(m, a, b)
	for i = 0, 2 do
		box(m, V(2, 0.16, 0.12), CF() * ANG(0, 0, i * math.pi / 3), a, GLASS)
		for _, s in ipairs({ -0.6, 0.6 }) do
			for _, t in ipairs({ -1, 1 }) do
				box(m, V(0.45, 0.1, 0.1), CF() * ANG(0, 0, i * math.pi / 3) * CF(s, 0, 0) * ANG(0, 0, rad(t * 50)) * CF(0.15 * (s &gt; 0 and 1 or -1), 0, 0), b, NEON)
			end
		end
	end
	gem(m, 0.5, CF(), b)
end
SHAPES.icicle = function(m, a, b)
	for i = 0, 2 do
		local x = (i - 1) * 0.45
		local h = 2 - math.abs(i - 1) * 0.6
		piece(m, &quot;wedge&quot;, V(0.35, h, 0.25), CF(x, 0.9 - h / 2, -0.12) * ANG(math.pi, 0, 0), a, GLASS)
		piece(m, &quot;wedge&quot;, V(0.35, h, 0.25), CF(x, 0.9 - h / 2, 0.12) * ANG(math.pi, math.pi, 0), a, GLASS)
	end
	box(m, V(1.5, 0.25, 0.6), CF(0, 0.95, 0), b, NEON)
end
SHAPES.bell = function(m, a, b)
	local shell = ball(m, 1.7, CF(0, 0, 0), a, METAL)
	local mesh = Instance.new(&quot;SpecialMesh&quot;)
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = V(0.9, 1.05, 0.9)
	mesh.Parent = shell
	cyl(m, 0.25, 1.8, CF(0, -0.75, 0), a, METAL)
	ball(m, 0.4, CF(0, -1, 0), b, NEON)
	ring(m, 0.25, 0.1, CF(0, 1, 0), b, METAL, 8)
end
SHAPES.horn = function(m, a, b)
	for i = 0, 6 do
		local t = i / 6
		local d = 0.9 - t * 0.7
		ball(m, d, CF(math.sin(t * 2.4) * 0.8 - 0.3, -0.9 + t * 1.8, 0), a:Lerp(b, t * 0.5))
	end
	ring(m, 0.42, 0.08, CF(-0.3, -0.85, 0) * ANG(rad(90), 0, 0), b, METAL, 10)
end
SHAPES.flame = function(m, a, b)
	ball(m, 1.3, CF(0, -0.35, 0), a, NEON)
	piece(m, &quot;wedge&quot;, V(0.9, 1.3, 0.6), CF(0, 0.5, -0.2), a, NEON)
	piece(m, &quot;wedge&quot;, V(0.9, 1.3, 0.6), CF(0, 0.5, 0.2) * ANG(0, math.pi, 0), a, NEON)
	ball(m, 0.7, CF(0, -0.3, -0.35), b, NEON)
end
SHAPES.hammer = function(m, a, b)
	cyl(m, 2, 0.24, CF(0, -0.3, 0), Color3.fromRGB(110, 75, 45), Enum.Material.Wood)
	box(m, V(1.5, 0.75, 0.75), CF(0, 0.8, 0), a, METAL)
	box(m, V(1.55, 0.2, 0.8), CF(0, 0.8, 0), b, NEON)
end
SHAPES.star = function(m, a, b)
	for i = 0, 4 do
		local ang = i / 5 * math.pi * 2
		piece(m, &quot;wedge&quot;, V(0.35, 1, 0.45), CF() * ANG(0, 0, ang) * CF(0, 0.65, -0.11), a, NEON)
		piece(m, &quot;wedge&quot;, V(0.35, 1, 0.45), CF() * ANG(0, 0, ang) * CF(0, 0.65, 0.11) * ANG(0, math.pi, 0), a, NEON)
	end
	ball(m, 0.7, CF(), b, NEON)
end
SHAPES.moon = function(m, a, b)
	for i = 0, 10 do
		local t = i / 10
		local ang = -2.2 + t * 4.4
		local d = 0.35 + math.sin(t * math.pi) * 0.45
		ball(m, d, CF(math.cos(ang) * 0.8, math.sin(ang) * 0.8, 0), a, NEON)
	end
	ball(m, 0.25, CF(-0.4, 0.2, 0), b, NEON)
end
SHAPES.halo = function(m, a, b)
	ring(m, 1, 0.22, CF() * ANG(rad(90), 0, 0), a, NEON, 18)
	ring(m, 0.75, 0.08, CF() * ANG(rad(90), 0, 0), b, NEON, 14)
	gem(m, 0.5, CF(0, 0, 0), b)
end
SHAPES.chalice = function(m, a, b)
	local cup = ball(m, 1.5, CF(0, 0.55, 0), a, METAL)
	local mesh = Instance.new(&quot;SpecialMesh&quot;)
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = V(1, 0.7, 1)
	mesh.Parent = cup
	cyl(m, 0.15, 1.3, CF(0, 0.95, 0), b, NEON)
	cyl(m, 0.9, 0.25, CF(0, -0.25, 0), a, METAL)
	cyl(m, 0.2, 1.1, CF(0, -0.75, 0), a, METAL)
	gem(m, 0.35, CF(0, 0.5, -0.72), b)
end
SHAPES.golem = function(m, a, b)
	box(m, V(1.5, 1.3, 1.2), CF(), a, Enum.Material.Slate)
	box(m, V(1.6, 0.3, 1.3), CF(0, 0.55, 0), GOLD, METAL)
	for _, x in ipairs({ -0.35, 0.35 }) do
		box(m, V(0.35, 0.18, 0.1), CF(x, 0.1, -0.62), b, NEON)
	end
	for _, s in ipairs({ -1, 1 }) do
		piece(m, &quot;wedge&quot;, V(0.3, 0.7, 0.4), CF(s * 0.85, 0.9, 0) * ANG(0, 0, rad(-s * 25)), GOLD, METAL)
		gem(m, 0.4, CF(s * 0.85, -0.45, -0.3), b)
	end
end

-- Formes de la planche de reliques ------------------------------------------------------------------
SHAPES.tome = function(m, a, b)
	box(m, V(1.7, 2, 0.7), CF(), a, Enum.Material.Slate)
	box(m, V(1.8, 2.1, 0.12), CF(0, 0, -0.36), a:Lerp(Color3.new(0, 0, 0), 0.25), Enum.Material.Slate)
	for _, x in ipairs({ -0.8, 0.8 }) do
		for _, y in ipairs({ -0.95, 0.95 }) do
			box(m, V(0.32, 0.32, 0.8), CF(x, y, 0), b, METAL)
		end
	end
	for i = 0, 3 do
		piece(m, &quot;wedge&quot;, V(0.1, 0.55, 0.22), CF(0, 0, -0.42) * ANG(0, 0, i * math.pi / 2) * CF(0, 0.32, 0) * ANG(0, rad(90), 0), b, NEON)
	end
	ball(m, 0.42, CF(0, 0, -0.42), b:Lerp(Color3.new(1, 1, 1), 0.4), NEON)
	ring(m, 0.62, 0.06, CF(0, 0, -0.43), b, METAL, 16)
end
SHAPES.star8 = function(m, a, b)
	for i = 0, 7 do
		local len = (i % 2 == 0) and 1.15 or 0.75
		piece(m, &quot;wedge&quot;, V(0.4, len, 0.5), CF() * ANG(0, 0, i * math.pi / 4) * CF(0, len / 2 + 0.25, -0.12), a, GLASS)
		piece(m, &quot;wedge&quot;, V(0.4, len, 0.5), CF() * ANG(0, 0, i * math.pi / 4) * CF(0, len / 2 + 0.25, 0.12) * ANG(0, math.pi, 0), a:Lerp(Color3.new(1, 1, 1), 0.2), GLASS)
	end
	ball(m, 0.75, CF(), b, NEON)
	gem(m, 0.5, CF(), b)
end
SHAPES.cageorb = function(m, a, b)
	ball(m, 1.55, CF(), a, NEON).Transparency = 0.05
	ball(m, 0.6, CF(0.2, 0.2, -0.35), a:Lerp(Color3.new(1, 1, 1), 0.6), NEON)
	for i = 0, 3 do
		ring(m, 0.86, 0.11, CF() * ANG(rad(i * 45), rad(i * 37), rad(i * 20)), b, METAL, 18)
	end
end
SHAPES.chime = function(m, a, b)
	box(m, V(1.9, 0.22, 0.6), CF(0, 1, 0), b, METAL)
	cyl(m, 0.3, 0.3, CF(0, 1.25, 0), b, METAL)
	for i = 0, 3 do
		local x = -0.66 + i * 0.44
		local h = 1.1 + (i % 2) * 0.35
		box(m, V(0.04, 0.3, 0.04), CF(x, 0.78, 0), b, METAL)
		cyl(m, h, 0.24, CF(x, 0.6 - h / 2, 0), a, GLASS)
		cyl(m, h * 0.8, 0.12, CF(x, 0.6 - h / 2, 0), a:Lerp(Color3.new(1, 1, 1), 0.5), NEON)
	end
end
SHAPES.wings = function(m, a, b)
	-- embleme dore avec gemme centrale et deux ailes de plumes
	box(m, V(0.9, 1.1, 0.35), CF() * ANG(0, 0, rad(45)), GOLD, METAL)
	gem(m, 0.6, CF(0, 0, -0.15), a)
	for _, s in ipairs({ -1, 1 }) do
		for k = 0, 3 do
			local len = 1.1 - k * 0.18
			box(m, V(len, 0.26, 0.08), CF(s * (0.55 + len / 2), 0.35 - k * 0.22, 0.05) * ANG(0, 0, rad(s * (25 - k * 14))), b, Enum.Material.SmoothPlastic)
		end
		box(m, V(0.5, 0.18, 0.1), CF(s * 0.6, 0.45, 0) * ANG(0, 0, rad(s * 30)), GOLD, METAL)
	end
	piece(m, &quot;wedge&quot;, V(0.3, 0.45, 0.3), CF(0, -0.75, 0) * ANG(math.pi, 0, 0), GOLD, METAL)
end
SHAPES.monolith = function(m, a, b)
	box(m, V(1.1, 1.9, 0.75), CF(0, -0.15, 0), a, Enum.Material.Slate)
	piece(m, &quot;wedge&quot;, V(1.1, 0.5, 0.38), CF(0, 1.05, -0.19), a, Enum.Material.Slate)
	piece(m, &quot;wedge&quot;, V(1.1, 0.5, 0.38), CF(0, 1.05, 0.19) * ANG(0, math.pi, 0), a, Enum.Material.Slate)
	gem(m, 0.42, CF(0, 0.15, -0.4), b)
	box(m, V(0.06, 1.3, 0.05), CF(-0.35, -0.2, -0.39), b, NEON)
	box(m, V(0.06, 1.3, 0.05), CF(0.35, -0.2, -0.39), b, NEON)
	box(m, V(1.3, 0.25, 0.95), CF(0, -1.15, 0), a:Lerp(Color3.new(0, 0, 0), 0.2), Enum.Material.Slate)
end
SHAPES.crystalcrown = function(m, a, b)
	cyl(m, 0.5, 1.9, CF(0, -0.55, 0), a:Lerp(Color3.new(0, 0, 0), 0.2), GLASS)
	for i = 0, 7 do
		local ang = i / 8 * math.pi * 2
		local h = (i % 2 == 0) and 1.3 or 0.9
		box(m, V(0.3, h, 0.3), CF(math.cos(ang) * 0.8, -0.3 + h / 2, math.sin(ang) * 0.8) * ANG(0, ang, 0) * ANG(0, rad(45), 0), a, GLASS)
	end
	gem(m, 0.55, CF(0, 0.2, 0), b)
end
SHAPES.top = function(m, a, b)
	cyl(m, 0.2, 1.9, CF(0, 0.3, 0), b, METAL)
	piece(m, &quot;wedge&quot;, V(1.6, 0.6, 0.8), CF(0, 0.7, -0.4), a, METAL)
	piece(m, &quot;wedge&quot;, V(1.6, 0.6, 0.8), CF(0, 0.7, 0.4) * ANG(0, math.pi, 0), a, METAL)
	for i = 0, 5 do
		piece(m, &quot;wedge&quot;, V(0.6, 1, 0.5), CF() * ANG(0, i * math.pi / 3, 0) * CF(0, -0.35, -0.25) * ANG(math.pi, 0, 0), a:Lerp(Color3.new(0, 0, 0), 0.25), METAL)
	end
	gem(m, 0.35, CF(0, -0.95, 0), Color3.fromRGB(90, 220, 255))
	cyl(m, 0.25, 0.25, CF(0, 1.1, 0), b, METAL)
end
SHAPES.shield = function(m, a, b)
	box(m, V(1.7, 1.4, 0.3), CF(0, 0.25, 0), a, METAL)
	piece(m, &quot;wedge&quot;, V(0.85, 0.9, 0.3), CF(-0.425, -0.9, 0) * ANG(math.pi, 0, 0), a, METAL)
	piece(m, &quot;wedge&quot;, V(0.85, 0.9, 0.3), CF(0.425, -0.9, 0) * ANG(math.pi, math.pi, 0), a, METAL)
	box(m, V(1.85, 0.2, 0.4), CF(0, 0.95, 0), b, METAL)
	box(m, V(0.2, 2.1, 0.36), CF(0, -0.05, 0), b, METAL)
	box(m, V(1.75, 0.18, 0.36), CF(0, 0.2, 0), b, METAL)
	gem(m, 0.55, CF(0, 0.2, -0.2), Color3.fromRGB(170, 70, 255))
	for _, x in ipairs({ -0.95, 0.95 }) do
		piece(m, &quot;wedge&quot;, V(0.2, 0.5, 0.3), CF(x, 1.05, 0), b, METAL)
	end
end
SHAPES.ring = function(m, a, b)
	local n = 22
	for i = 0, n - 1 do
		local ang = i / n * math.pi * 2
		box(m, V(0.34, 0.5, 0.18), CF(math.cos(ang) * 1, 0, math.sin(ang) * 1) * ANG(0, -ang, 0), a, METAL)
	end
	ring(m, 1.02, 0.07, CF(0, 0.26, 0) * ANG(rad(90), 0, 0), a:Lerp(Color3.new(1, 1, 1), 0.3), METAL, 22)
	ring(m, 1.02, 0.07, CF(0, -0.26, 0) * ANG(rad(90), 0, 0), a:Lerp(Color3.new(1, 1, 1), 0.3), METAL, 22)
	for i = 0, 3 do
		local ang = i / 4 * math.pi * 2
		gem(m, 0.3, CF(math.cos(ang) * 1.1, 0, math.sin(ang) * 1.1), b)
	end
end
SHAPES.scroll = function(m, a, b)
	box(m, V(1.6, 1.8, 0.06), CF(), a, Enum.Material.Fabric)
	for _, y in ipairs({ -1, 1 }) do
		cyl(m, 1.9, 0.3, CF(0, y * 0.95, 0) * ANG(0, 0, rad(90)), b, METAL)
		for _, x in ipairs({ -1.05, 1.05 }) do
			ball(m, 0.36, CF(x, y * 0.95, 0), b, METAL)
		end
	end
	ball(m, 0.5, CF(0, 0, -0.05), Color3.fromRGB(255, 170, 40), NEON)
	ring(m, 0.38, 0.05, CF(0, 0, -0.06), b, METAL, 12)
end
SHAPES.banner = function(m, a, b)
	cyl(m, 1.9, 0.18, CF(0, 0.95, 0) * ANG(0, 0, rad(90)), b, METAL)
	for _, x in ipairs({ -1, 1 }) do
		ball(m, 0.3, CF(x, 0.95, 0), b, METAL)
	end
	box(m, V(1.5, 1.4, 0.08), CF(0, 0.2, 0), a, Enum.Material.Fabric)
	piece(m, &quot;wedge&quot;, V(0.08, 0.6, 0.75), CF(-0.375, -0.8, 0) * ANG(math.pi, rad(90), 0), a, Enum.Material.Fabric)
	piece(m, &quot;wedge&quot;, V(0.08, 0.6, 0.75), CF(0.375, -0.8, 0) * ANG(math.pi, rad(-90), 0), a, Enum.Material.Fabric)
	box(m, V(1.5, 0.3, 0.1), CF(0, 0.3, -0.03), a:Lerp(Color3.fromRGB(255, 220, 120), 0.5), NEON)
	box(m, V(0.12, 2, 0.12), CF(-0.8, 0.1, 0), b, METAL)
	box(m, V(0.12, 2, 0.12), CF(0.8, 0.1, 0), b, METAL)
end
SHAPES.cocoon = function(m, a, b)
	for i = 0, 6 do
		local t = i / 6
		local d = 0.55 + math.sin(t * math.pi) * 0.55
		ball(m, d, CF(-1 + t * 2, math.sin(t * math.pi) * 0.2, 0) * ANG(0, 0, rad(-20)), (i % 2 == 0) and a or b, GLASS)
	end
	ball(m, 0.9, CF(0, 0.15, 0), b:Lerp(Color3.new(1, 1, 1), 0.3), NEON).Transparency = 0.4
end
SHAPES.spiky = function(m, a, b)
	ball(m, 1.4, CF(), a, Enum.Material.Slate)
	ball(m, 0.9, CF(0, 0, -0.35), b, NEON).Transparency = 0.3
	for i = 0, 13 do
		local yaw = (i * 2.4) % (math.pi * 2)
		local pitch = math.asin(-1 + 2 * (i + 0.5) / 14)
		piece(m, &quot;wedge&quot;, V(0.18, 0.7, 0.18), CF() * ANG(0, yaw, 0) * ANG(pitch + math.pi / 2, 0, 0) * CF(0, 0.95, 0), Color3.fromRGB(45, 25, 25), METAL)
	end
	ring(m, 0.72, 0.08, CF() * ANG(rad(90), 0, 0), b, NEON, 14)
end
SHAPES.eclipse = function(m, a, b)
	ball(m, 1.5, CF(), a, Enum.Material.SmoothPlastic)
	ring(m, 0.85, 0.22, CF(0, 0, 0.1), b, NEON, 22)
	ring(m, 1.0, 0.12, CF(0, 0, 0.15), Color3.fromRGB(255, 200, 80), NEON, 22)
	for i = 0, 11 do
		local ang = i / 12 * math.pi * 2
		box(m, V(0.12, 0.45, 0.05), CF(math.cos(ang) * 1.2, math.sin(ang) * 1.2, 0.15) * ANG(0, 0, ang - math.pi / 2), b, NEON)
	end
end

-- Effets selon la rarete
local function effects(model, core, def, rarity)
	local idx = rarity.index
	local glow = def.c2
	if idx &gt;= 3 then
		local l = Instance.new(&quot;PointLight&quot;)
		l.Color = glow
		l.Range = 6 + idx
		l.Brightness = 0.6 + idx * 0.15
		l.Shadows = false
		l.Parent = core
	end
	if idx &gt;= 4 then
		local att = Instance.new(&quot;Attachment&quot;)
		att.Parent = core
		local e = Instance.new(&quot;ParticleEmitter&quot;)
		e.Name = &quot;Aura&quot;
		e.Rate = 4 + idx * 2
		e.Lifetime = NumberRange.new(0.6, 1.2)
		e.Speed = NumberRange.new(0.5, 1.5)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.22), NumberSequenceKeypoint.new(1, 0) })
		e.LightEmission = 1
		e.Color = ColorSequence.new(rarity.color, glow)
		e.Parent = att
	end
	if idx &gt;= 6 then
		-- anneau d'energie autour des reliques Mythiques et plus
		local halo = Instance.new(&quot;Part&quot;)
		halo.Name = &quot;RarityHalo&quot;
		halo.Shape = Enum.PartType.Cylinder
		halo.Size = V(0.05, 3, 3)
		halo.CFrame = core.CFrame * ANG(0, 0, rad(90))
		halo.Material = Enum.Material.ForceField
		halo.Color = rarity.id == &quot;Secret&quot; and glow or rarity.color
		halo.Anchored = true
		halo.CanCollide = false
		halo.CanQuery = false
		halo.CanTouch = false
		halo.Massless = true
		halo.Parent = model
	end
	if idx &gt;= 7 then
		local att = Instance.new(&quot;Attachment&quot;)
		att.Parent = core
		local stars = Instance.new(&quot;ParticleEmitter&quot;)
		stars.Name = &quot;Stars&quot;
		stars.Rate = 10
		stars.Lifetime = NumberRange.new(1, 1.6)
		stars.Speed = NumberRange.new(0, 0.4)
		stars.SpreadAngle = Vector2.new(180, 180)
		stars.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.3), NumberSequenceKeypoint.new(1, 0) })
		stars.LightEmission = 1
		stars.Texture = &quot;rbxasset://textures/particles/sparkles_main.dds&quot;
		stars.Color = ColorSequence.new(Color3.new(1, 1, 1), glow)
		stars.Parent = att
	end
end

function RelicModel.Build(relicId, opts)
	opts = opts or {}
	local def = Config.RelicById[relicId]
	local model = Instance.new(&quot;Model&quot;)
	model.Name = &quot;Relic_&quot; .. relicId
	local core = Instance.new(&quot;Part&quot;)
	core.Name = &quot;Core&quot;
	core.Size = V(0.2, 0.2, 0.2)
	core.Transparency = 1
	core.Anchored = true
	core.CanCollide = false
	core.CanQuery = false
	core.CanTouch = false
	core.Massless = true
	core.Parent = model
	model.PrimaryPart = core
	if not def then
		ball(model, 1.4, CF(), Color3.fromRGB(150, 150, 160))
		return model
	end
	local build = SHAPES[def.shape] or SHAPES.gem
	build(model, def.c1, def.c2)
	local rarity = Config.RarityById[def.rarity]
	if opts.silhouette then
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA(&quot;BasePart&quot;) and p ~= core then
				p.Color = Color3.fromRGB(12, 10, 24)
				p.Material = Enum.Material.SmoothPlastic
				p.Transparency = math.max(p.Transparency, 0)
			end
		end
	elseif opts.effects ~= false then
		effects(model, core, def, rarity)
	end
	model:SetAttribute(&quot;RelicId&quot;, relicId)
	return model
end

-- Deplace un modele construit (pieces ancrees) : plus rapide que PivotTo pour beaucoup de reliques
function RelicModel.Parts(model)
	local parts, offsets = {}, {}
	local origin = model.PrimaryPart.CFrame
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA(&quot;BasePart&quot;) then
			table.insert(parts, p)
			table.insert(offsets, origin:ToObjectSpace(p.CFrame))
		end
	end
	return parts, offsets
end

return RelicModel
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Remotes</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- RemoteEvents / RemoteFunctions de RELIC RUSH (crees par le serveur).
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)

local EVENTS = { &quot;Action&quot;, &quot;Sync&quot;, &quot;Notify&quot;, &quot;FX&quot;, &quot;Trade&quot;, &quot;Boss&quot; }
local FUNCTIONS = { &quot;Query&quot; }

local Remotes = {}
local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild(&quot;Remotes&quot;) or Instance.new(&quot;Folder&quot;)
	folder.Name = &quot;Remotes&quot;
	folder.Parent = ReplicatedStorage
	for _, n in ipairs(EVENTS) do
		if not folder:FindFirstChild(n) then
			Instance.new(&quot;RemoteEvent&quot;, folder).Name = n
		end
	end
	for _, n in ipairs(FUNCTIONS) do
		if not folder:FindFirstChild(n) then
			Instance.new(&quot;RemoteFunction&quot;, folder).Name = n
		end
	end
else
	folder = ReplicatedStorage:WaitForChild(&quot;Remotes&quot;)
end
for _, n in ipairs(EVENTS) do
	Remotes[n] = folder:WaitForChild(n)
end
for _, n in ipairs(FUNCTIONS) do
	Remotes[n] = folder:WaitForChild(n)
end
return Remotes
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000017"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000016"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX00000008"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Point d'entree serveur de RELIC RUSH : chaque service demarre isole (une erreur n'arrete pas les autres).
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
require(ReplicatedStorage.Shared.Remotes)

local Modules = script.Parent.Modules

local function start(name, method)
	local ok, err = pcall(function()
		require(Modules[name])[method or &quot;Init&quot;]()
	end)
	if not ok then
		warn(&quot;[RelicRush] Demarrage de &quot; .. name .. &quot; : &quot; .. tostring(err))
	end
end

start(&quot;WorldBuilder&quot;, &quot;Build&quot;)
start(&quot;DataService&quot;)
start(&quot;Actions&quot;)
start(&quot;Targets&quot;)
start(&quot;TreasureService&quot;)
start(&quot;RelicService&quot;)
start(&quot;ProgressService&quot;)
start(&quot;BossService&quot;)
start(&quot;TradeService&quot;)
start(&quot;QueryService&quot;)
print(&quot;[RelicRush] Serveur pret.&quot;)
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000015"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Actions</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Routeur des actions client -&gt; serveur (un seul RemoteEvent &quot;Action&quot;).
-- Chaque service enregistre ses actions ; apres chaque action le joueur est resynchronise
-- (sauf si la fonction renvoie true). Limite de debit anti-spam.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)

local Actions = {}
local handlers = {}
local rate = {}

function Actions.Register(name, fn)
	handlers[name] = fn
end

function Actions.Notify(player, text, kind)
	Remotes.Notify:FireClient(player, text, kind or &quot;info&quot;)
end

function Actions.Init()
	Remotes.Action.OnServerEvent:Connect(function(player, name, ...)
		if type(name) ~= &quot;string&quot; then
			return
		end
		local fn = handlers[name]
		local data = DataService.Get(player)
		if not (fn and data) then
			return
		end
		local r = rate[player]
		local now = os.clock()
		if not r or now - r.t &gt; 1 then
			r = { t = now, n = 0 }
			rate[player] = r
		end
		r.n += 1
		if r.n &gt; 25 then
			return
		end
		local ok, skip = pcall(fn, player, data, ...)
		if not ok then
			warn(&quot;[RelicRush] Action &quot; .. name .. &quot; : &quot; .. tostring(skip))
		end
		if not skip then
			DataService.Sync(player)
		end
	end)
	game:GetService(&quot;Players&quot;).PlayerRemoving:Connect(function(p)
		rate[p] = nil
	end)
end

return Actions
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">BossService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Boss de chaque monde : golem anime dans l'arene, PV qui s'adaptent au nombre de joueurs,
-- onde de choc qui repousse (sans degats), recompenses partagees selon les degats infliges,
-- chance d'obtenir la relique du boss. Combats multijoueurs.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local F = require(ReplicatedStorage.Shared.Formulas)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Targets = require(script.Parent.Targets)
local WorldBuilder = require(script.Parent.WorldBuilder)

local BossService = {}

local state = {} -- [worldId] = { model, alive, respawnAt }

local function playersInWorld(worldId)
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local hrp = p.Character and p.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
		local w = hrp and WorldBuilder.WorldAt(hrp.Position)
		if w and w.id == worldId then
			table.insert(list, p)
		end
	end
	return list
end

local function part(model, props)
	local x = Instance.new(&quot;Part&quot;)
	x.Anchored = true
	x.CanCollide = false
	x.CanQuery = false
	x.CanTouch = false
	for k, v in pairs(props) do
		x[k] = v
	end
	x.Parent = model
	return x
end

-- Golem (comme l'icone BOSS) : corps de pierre, casque dore a cornes, yeux et cristaux lumineux
local function buildGolem(world, pos)
	local relic = Config.RelicById
	local glow = Color3.fromRGB(200, 90, 255)
	for _, r in ipairs(Config.Relics) do
		if r.boss and r.world == world.id then
			glow = r.c2
		end
	end
	local stone = world.id == &quot;Frozen&quot; and Color3.fromRGB(190, 215, 240) or (world.id == &quot;Lava&quot; and Color3.fromRGB(70, 55, 55) or (world.id == &quot;Celestial&quot; and Color3.fromRGB(235, 230, 245) or Color3.fromRGB(120, 112, 135)))
	local gold = Color3.fromRGB(255, 195, 60)
	local model = Instance.new(&quot;Model&quot;)
	model.Name = &quot;Boss_&quot; .. world.id
	local base = CFrame.new(pos)
	local S = 1.6
	local function rock(size, cf, color, mat)
		return part(model, { Size = size * S, CFrame = base * CFrame.new(cf.Position * S) * cf.Rotation, Color = color or stone, Material = mat or Enum.Material.Slate })
	end
	rock(Vector3.new(9, 8, 6), CFrame.new(0, 9, 0))
	rock(Vector3.new(7, 4, 5), CFrame.new(0, 4, 0))
	rock(Vector3.new(6, 5, 5.5), CFrame.new(0, 15, -0.5))
	rock(Vector3.new(7.2, 1.6, 6.2), CFrame.new(0, 17.4, -0.5), gold, Enum.Material.Metal)
	rock(Vector3.new(2.4, 1, 0.5), CFrame.new(0, 18.6, -3.4), gold, Enum.Material.Metal)
	for _, s in ipairs({ -1, 1 }) do
		rock(Vector3.new(1.4, 0.7, 0.3), CFrame.new(s * 1.3, 15.4, -3.3), glow, Enum.Material.Neon)
		rock(Vector3.new(1.2, 4, 1.2), CFrame.new(s * 4.2, 19.5, -0.5) * CFrame.Angles(0, 0, math.rad(-s * 35)), gold, Enum.Material.Metal)
		rock(Vector3.new(4, 4, 4), CFrame.new(s * 6.6, 11, 0), stone)
		rock(Vector3.new(3.2, 6, 3.2), CFrame.new(s * 7.2, 6, -0.5))
		rock(Vector3.new(3.6, 3, 3.6), CFrame.new(s * 7.2, 2.4, -0.8))
		rock(Vector3.new(3, 4, 3), CFrame.new(s * 2.6, 1.6, 0))
		for k = 1, 2 do
			rock(Vector3.new(1.2, 3, 1.2), CFrame.new(s * (5 + k), 12.5 + k, 1.5) * CFrame.Angles(0.3, 0, -s * 0.4), glow, Enum.Material.Neon)
		end
	end
	rock(Vector3.new(4, 1.2, 0.4), CFrame.new(0, 9, -3.1), gold, Enum.Material.Metal)
	rock(Vector3.new(1.4, 1.4, 0.4), CFrame.new(0, 9, -3.3) * CFrame.Angles(0, 0, math.rad(45)), glow, Enum.Material.Neon)
	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = glow
	light.Range = 30
	light.Brightness = 2
	light.Parent = model:GetChildren()[1]
	local hit = part(model, { Name = &quot;Hitbox&quot;, Size = Vector3.new(18, 30, 14), CFrame = base * CFrame.new(0, 15, 0), Transparency = 1, CanQuery = true })
	model.PrimaryPart = hit
	return model
end

local function spawnBoss(world)
	local pos = WorldBuilder.Arena(world.id)
	if not pos then
		return
	end
	local def = Config.Boss[world.id]
	local n = math.max(1, #playersInWorld(world.id))
	local model = buildGolem(world, pos)
	model:SetAttribute(&quot;Label&quot;, def.name)
	local st = state[world.id]
	st.model = model
	st.alive = true
	st.base = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA(&quot;BasePart&quot;) then
			st.base[d] = d.CFrame
		end
	end
	Targets.Register(model, {
		kind = &quot;boss&quot;,
		world = world.id,
		maxHp = math.floor(def.hp * world.mult * (1 + (n - 1) * Config.BossHpPerPlayer)),
		onHit = function(m, info, player)
			local data = DataService.Get(player)
			if data and not info.fought then
				info.fought = {}
			end
			if data and not info.fought[player] then
				info.fought[player] = true
				data.Stats.BossFights += 1
			end
		end,
		onDeath = function(m, info)
			st.alive = false
			st.model = nil
			st.respawnAt = os.time() + Config.BossRespawn
			local total = 0
			for _, d in pairs(info.hits) do
				total += d
			end
			for player, dmg in pairs(info.hits) do
				local data = DataService.Get(player)
				if data and player.Parent == Players then
					local share = dmg / math.max(total, 1)
					local coins = math.floor(def.coins * world.mult * math.max(share, 0.1) * F.CoinMult(data) * (1 + #Players:GetPlayers() * 0.1))
					DataService.AddCoins(player, coins)
					local relic
					if share &gt;= 0.05 then
						data.Stats.BossWins += 1
						if math.random() &lt; Config.BossRelicChance then
							for _, r in ipairs(Config.Relics) do
								if r.boss and r.world == world.id then
									local uid, first = DataService.GiveRelic(player, r.id)
									if uid then
										relic = r.id
										Remotes.Notify:FireAllClients(player.DisplayName .. &quot; a obtenu &quot; .. r.name .. &quot; sur le boss !&quot;, &quot;gold&quot;)
									end
								end
							end
						end
					end
					Remotes.FX:FireClient(player, &quot;BossReward&quot;, { boss = def.name, coins = coins, share = share, relic = relic })
					DataService.Sync(player)
				end
			end
			Remotes.FX:FireAllClients(&quot;BossDown&quot;, { world = world.id, position = m.PrimaryPart.Position })
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA(&quot;BasePart&quot;) then
					d.Anchored = false
					d.CanCollide = true
					d.AssemblyLinearVelocity = Vector3.new(math.random(-30, 30), math.random(20, 50), math.random(-30, 30))
				end
			end
			task.delay(4, function()
				m:Destroy()
			end)
		end,
	})
	Remotes.Notify:FireAllClients(def.name .. &quot; est apparu dans &quot; .. world.name .. &quot; !&quot;, &quot;gold&quot;)
end

-- Animation : respiration, regard vers le joueur le plus proche, onde de choc
local function animate(dt)
	local t = os.clock()
	for worldId, st in pairs(state) do
		local m = st.model
		if st.alive and m and m.Parent and m.PrimaryPart then
			local center = st.base[m.PrimaryPart].Position
			local nearest, nd
			for _, p in ipairs(Players:GetPlayers()) do
				local hrp = p.Character and p.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
				if hrp then
					local d = (hrp.Position - center).Magnitude
					if d &lt; 80 and (not nd or d &lt; nd) then
						nearest, nd = hrp, d
					end
				end
			end
			if nearest then
				local dir = (nearest.Position - center) * Vector3.new(1, 0, 1)
				if dir.Magnitude &gt; 1 then
					local target = math.atan2(-dir.X, -dir.Z)
					st.yaw = st.yaw or 0
					local diff = (target - st.yaw + math.pi) % (2 * math.pi) - math.pi
					st.yaw += diff * math.min(dt * 2, 1)
				end
			end
			local bob = math.sin(t * 2) * 0.6
			local pivot = CFrame.new(center.X, center.Y - 15 + bob, center.Z) * CFrame.Angles(0, st.yaw or 0, 0)
			local origin = CFrame.new(center.X, center.Y - 15, center.Z)
			local parts, cfs = {}, {}
			for p, cf in pairs(st.base) do
				if p.Parent then
					table.insert(parts, p)
					table.insert(cfs, pivot * origin:ToObjectSpace(cf))
				end
			end
			workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end
end

local function shockwaves()
	while true do
		task.wait(Config.BossShockwave.Interval)
		for worldId, st in pairs(state) do
			local m = st.model
			if st.alive and m and m.PrimaryPart then
				local pos = WorldBuilder.Arena(worldId)
				local pushed = false
				for _, p in ipairs(Players:GetPlayers()) do
					local hrp = p.Character and p.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
					if hrp then
						local d = hrp.Position - pos
						if d.Magnitude &lt; Config.BossShockwave.Radius then
							local dir = Vector3.new(d.X, 0, d.Z)
							dir = dir.Magnitude &gt; 0.1 and dir.Unit or Vector3.new(1, 0, 0)
							hrp.AssemblyLinearVelocity = dir * Config.BossShockwave.Push + Vector3.new(0, 45, 0)
							pushed = true
						end
					end
				end
				if pushed then
					Remotes.FX:FireAllClients(&quot;Shockwave&quot;, { position = pos, radius = Config.BossShockwave.Radius })
				end
			end
		end
	end
end

function BossService.Status()
	local out = {}
	for _, w in ipairs(Config.Worlds) do
		local st = state[w.id]
		local info = st.model and Targets.Get(st.model)
		out[w.id] = {
			alive = st.alive,
			hp = info and info.hp or 0,
			maxHp = info and info.maxHp or 0,
			respawnAt = st.respawnAt,
			name = Config.Boss[w.id].name,
			model = st.model,
		}
	end
	return out
end

function BossService.Init()
	for _, w in ipairs(Config.Worlds) do
		state[w.id] = { alive = false, respawnAt = os.time() + 5 }
	end
	RunService.Heartbeat:Connect(animate)
	task.spawn(shockwaves)
	task.spawn(function()
		while true do
			task.wait(1)
			for _, w in ipairs(Config.Worlds) do
				local st = state[w.id]
				if not st.alive and st.respawnAt and os.time() &gt;= st.respawnAt then
					st.respawnAt = nil
					local ok, err = pcall(spawnBoss, w)
					if not ok then
						warn(&quot;[RelicRush] Boss &quot; .. w.id .. &quot; : &quot; .. tostring(err))
						st.respawnAt = os.time() + 30
					end
				end
			end
			Remotes.Boss:FireAllClients(BossService.Status(), os.time())
		end
	end)
end

return BossService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">DataService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Sauvegarde des joueurs (DataStoreService) : nouvelles tentatives, sauvegarde automatique,
-- sauvegarde immediate apres un echange, a la deconnexion et a la fermeture du serveur.
-- Si le chargement echoue, la session n'est jamais sauvegardee (protection des donnees).

local DataStoreService = game:GetService(&quot;DataStoreService&quot;)
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local HttpService = game:GetService(&quot;HttpService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local F = require(ReplicatedStorage.Shared.Formulas)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = {}

local store, powerStore, rebirthStore, indexStore
pcall(function()
	store = DataStoreService:GetDataStore(&quot;RelicRush_v1&quot;)
	powerStore = DataStoreService:GetOrderedDataStore(&quot;RelicRush_Power_v1&quot;)
	rebirthStore = DataStoreService:GetOrderedDataStore(&quot;RelicRush_Rebirths_v1&quot;)
	indexStore = DataStoreService:GetOrderedDataStore(&quot;RelicRush_Index_v1&quot;)
end)

local cache, loaded = {}, {}
local loadedEvent = Instance.new(&quot;BindableEvent&quot;)
DataService.Loaded = loadedEvent.Event
local changedEvent = Instance.new(&quot;BindableEvent&quot;)
DataService.Changed = changedEvent.Event -- (player) apres chaque Sync

local function defaults()
	return {
		Coins = 0,
		TotalCoins = 0,
		Relics = {}, -- [uid (string)] = { id = relicId, locked = bool }
		NextUid = 1,
		Equipped = {}, -- liste d'uids (nombres)
		Index = {}, -- [relicId] = true
		Upgrades = {},
		Worlds = { Village = true },
		Rebirths = 0,
		BagBonus = 0,
		BagLevel = 0,
		Perks = {}, -- AutoHit, TripleOpen
		Boosts = {}, -- [Coins|Luck|Power] = fin (os.time)
		Stats = { Breaks = 0, Crates = 0, CoinsEarned = 0, BossFights = 0, BossWins = 0, Upgrades = 0, RarePlus = 0, Legendary = 0 },
		Quests = { Day = 0, List = {}, Base = {} }, -- quetes du jour
		Milestones = {}, -- [id] = true (reclamee)
		DailyStreak = 0,
		LastDaily = 0,
		Settings = { Music = 0.5, Sfx = 0.7, ShowOthers = true, LowGraphics = false, DamageNumbers = true },
	}
end

local function merge(into, from)
	for k, v in pairs(from) do
		if type(v) == &quot;table&quot; and type(into[k]) == &quot;table&quot; and #into[k] == 0 and next(into[k]) ~= nil then
			merge(into[k], v)
		else
			into[k] = v
		end
	end
end

local function retry(fn)
	for attempt = 1, 4 do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(&quot;[RelicRush] DataStore (essai &quot; .. attempt .. &quot;) : &quot; .. tostring(result))
		task.wait(attempt * 1.5)
	end
	return false
end

local function key(player)
	return &quot;u_&quot; .. player.UserId
end

function DataService.Get(player)
	return cache[player]
end

function DataService.Count(data)
	local n = 0
	for _ in pairs(data.Relics) do
		n += 1
	end
	return n
end

function DataService.Discovered(data)
	local n = 0
	for _ in pairs(data.Index) do
		n += 1
	end
	return n
end

-- Etat envoye au client + attributs visibles par tous (reliques equipees, puissance)
function DataService.Sync(player)
	local data = cache[player]
	if not data then
		return
	end
	local now = os.time()
	local power = F.Power(data, now)
	local equippedIds = {}
	for _, uid in ipairs(data.Equipped) do
		local item = data.Relics[tostring(uid)]
		if item then
			table.insert(equippedIds, item.id)
		end
	end
	player:SetAttribute(&quot;Power&quot;, power)
	player:SetAttribute(&quot;Relics&quot;, HttpService:JSONEncode(equippedIds))
	player:SetAttribute(&quot;Rebirths&quot;, data.Rebirths)
	local hum = player.Character and player.Character:FindFirstChildOfClass(&quot;Humanoid&quot;)
	if hum then
		hum.WalkSpeed = 16 + (data.Upgrades.Speed or 0) * F.UpgradeDef(&quot;Speed&quot;).per
	end
	local ls = player:FindFirstChild(&quot;leaderstats&quot;)
	if ls then
		ls.Puissance.Value = power
		ls.Pieces.Value = math.min(math.floor(data.Coins), 2 ^ 52)
		ls.Rebirths.Value = data.Rebirths
	end
	Remotes.Sync:FireClient(player, data, { power = power, serverTime = now, discovered = DataService.Discovered(data), count = DataService.Count(data) })
	changedEvent:Fire(player)
end

function DataService.AddCoins(player, amount)
	local data = cache[player]
	if not data then
		return
	end
	data.Coins += amount
	if amount &gt; 0 then
		data.TotalCoins += amount
		data.Stats.CoinsEarned += amount
	end
end

-- Ajoute une relique a l'inventaire (renvoie uid ou nil si plein)
function DataService.GiveRelic(player, relicId, noStats)
	local data = cache[player]
	local def = Config.RelicById[relicId]
	if not (data and def) then
		return nil
	end
	if DataService.Count(data) &gt;= F.InventoryCap(data) then
		return nil
	end
	local uid = data.NextUid
	data.NextUid += 1
	data.Relics[tostring(uid)] = { id = relicId }
	local first = not data.Index[relicId]
	data.Index[relicId] = true
	local r = Config.RarityById[def.rarity]
	if noStats then
		return uid, first
	end
	if r.index &gt;= 3 then
		data.Stats.RarePlus += 1
	end
	if r.index &gt;= 5 then
		data.Stats.Legendary += 1
	end
	return uid, first
end

function DataService.Save(player)
	local data = cache[player]
	if not (store and data and loaded[player]) then
		return false
	end
	local ok = retry(function()
		store:UpdateAsync(key(player), function()
			return data
		end)
	end)
	pcall(function()
		powerStore:SetAsync(key(player), math.min(F.Power(data), 2 ^ 52))
		rebirthStore:SetAsync(key(player), data.Rebirths)
		indexStore:SetAsync(key(player), DataService.Discovered(data))
	end)
	return ok
end

local function makeLeaderstats(player)
	local ls = Instance.new(&quot;Folder&quot;)
	ls.Name = &quot;leaderstats&quot;
	for _, n in ipairs({ &quot;Puissance&quot;, &quot;Pieces&quot;, &quot;Rebirths&quot; }) do
		Instance.new(&quot;NumberValue&quot;, ls).Name = n
	end
	ls.Parent = player
end

local function load(player)
	makeLeaderstats(player)
	local data = defaults()
	local ok = true
	if store then
		local result
		ok, result = retry(function()
			return store:GetAsync(key(player))
		end)
		if ok and type(result) == &quot;table&quot; then
			merge(data, result)
		end
	end
	if player.Parent ~= Players then
		return
	end
	if not ok then
		Remotes.Notify:FireClient(player, &quot;Sauvegarde indisponible : ta progression de cette session ne sera pas enregistree.&quot;, &quot;danger&quot;)
	end
	cache[player] = data
	loaded[player] = ok
	loadedEvent:Fire(player, data)
	DataService.Sync(player)
end

-- Classements globaux (mis en cache, rafraichis toutes les 2 minutes)
local tops = { Power = {}, Rebirths = {}, Index = {} }
local names = {}
function DataService.GetTop(kind)
	return tops[kind] or {}
end

local function refreshTops()
	for kind, st in pairs({ Power = powerStore, Rebirths = rebirthStore, Index = indexStore }) do
		if st then
			local ok, pages = pcall(function()
				return st:GetSortedAsync(false, 50)
			end)
			if ok then
				local list = {}
				for rank, entry in ipairs(pages:GetCurrentPage()) do
					local id = tonumber(string.sub(entry.key, 3))
					local name = names[id]
					if not name and id then
						local ok2, n = pcall(Players.GetNameFromUserIdAsync, Players, id)
						name = ok2 and n or &quot;Joueur&quot;
						names[id] = name
					end
					table.insert(list, { rank = rank, name = name or &quot;Joueur&quot;, userId = id, value = entry.value })
				end
				tops[kind] = list
			end
		end
	end
end

function DataService.Init()
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(load, p)
	end
	Players.PlayerAdded:Connect(load)
	Players.PlayerRemoving:Connect(function(player)
		DataService.Save(player)
		cache[player] = nil
		loaded[player] = nil
	end)
	game:BindToClose(function()
		if RunService:IsStudio() then
			task.wait(1)
		end
		local pending = 0
		for _, p in ipairs(Players:GetPlayers()) do
			pending += 1
			task.spawn(function()
				DataService.Save(p)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending &gt; 0 and os.clock() - t0 &lt; 25 do
			task.wait(0.2)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(90)
			for _, p in ipairs(Players:GetPlayers()) do
				task.spawn(DataService.Save, p)
			end
			refreshTops()
		end
	end)
	task.delay(6, refreshTops)
end

return DataService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">MapKit</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Boite a outils du decor de PET RUSH : pieces de base, props (arbres, maisons, lanternes...),
-- structures (stands, plateformes, escaliers, ponts) et gestion des emplacements libres.
-- Utilisee par MapBuilder (monde, village) et MapZones (decor de chaque zone).

local CollectionService = game:GetService(&quot;CollectionService&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local Config = require(ReplicatedStorage.Shared.Config)

local Kit = {}

local rng = Random.new(42) -- decor identique a chaque lancement
Kit.rng = rng

local function R(a, b)
	return rng:NextNumber(a, b)
end
Kit.R = R

-- Emplacements reserves (pas de coins / props dessus)
local avoid = {}
Kit.avoid = avoid
local function avoidCircle(pos, radius)
	table.insert(avoid, { pos = pos, radius = radius })
end
Kit.avoidCircle = avoidCircle
function Kit.avoidSegment(a, b, radius)
	local d = (b - a)
	local n = math.max(1, math.ceil(d.Magnitude / (radius * 0.8)))
	for i = 0, n do
		avoidCircle(a + d * (i / n), radius)
	end
end
function Kit.isFree(pos, margin)
	margin = margin or 0
	for _, av in ipairs(avoid) do
		local dx, dz = pos.X - av.pos.X, pos.Z - av.pos.Z
		if dx * dx + dz * dz &lt; (av.radius + margin) ^ 2 then
			return false
		end
	end
	return true
end

local KEEP_MATERIAL = { [Enum.Material.Neon] = true, [Enum.Material.Glass] = true, [Enum.Material.ForceField] = true }

local function part(props, parent)
	local p = Instance.new(&quot;Part&quot;)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		p[k] = v
	end
	if not KEEP_MATERIAL[p.Material] then
		p.Material = Enum.Material.SmoothPlastic
	end
	p.Parent = parent
	return p
end

local function wedge(props, parent)
	local w = Instance.new(&quot;WedgePart&quot;)
	w.Anchored = true
	w.TopSurface = Enum.SurfaceType.Smooth
	w.BottomSurface = Enum.SurfaceType.Smooth
	w.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		w[k] = v
	end
	w.Material = Enum.Material.SmoothPlastic
	w.Parent = parent
	return w
end

local function ballPart(cf, size, color, parent, material)
	return part({ Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic, CanCollide = false }, parent)
end

local function cylinder(cf, height, radius, color, parent, material)
	-- cylindre vertical
	return part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, radius * 2, radius * 2), CFrame = cf * CFrame.Angles(0, 0, math.rad(90)), Color = color, Material = material or Enum.Material.SmoothPlastic }, parent)
end

local function sign(parent, cf, size, text, textColor, bg)
	local board = part({ Name = &quot;Sign&quot;, Size = size, CFrame = cf, Color = bg or Color3.fromRGB(150, 100, 60), Material = Enum.Material.WoodPlanks }, parent)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = Instance.new(&quot;SurfaceGui&quot;)
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 30
		gui.LightInfluence = 0
		local l = Instance.new(&quot;TextLabel&quot;)
		l.Size = UDim2.fromScale(0.94, 0.86)
		l.Position = UDim2.fromScale(0.03, 0.07)
		l.BackgroundTransparency = 1
		l.Text = text
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.TextColor3 = textColor or Color3.new(1, 1, 1)
		l.Parent = gui
		local st = Instance.new(&quot;UIStroke&quot;)
		st.Color = Color3.fromRGB(22, 24, 52)
		st.Thickness = 4
		st.Parent = l
		gui.Parent = board
	end
	return board
end


local WATER = Color3.fromRGB(80, 190, 255)

local function pond(parent, center, radius, rimColor)
	local rim = cylinder(CFrame.new(center + Vector3.new(0, 0.05, 0)), 0.3, radius + 3, rimColor, parent)
	rim.CanCollide = false
	local water = cylinder(CFrame.new(center + Vector3.new(0, 0.12, 0)), 0.3, radius, WATER, parent, Enum.Material.Glass)
	water.Transparency = 0.1
	water.Reflectance = 0.15
	water.CanCollide = false
	for k = 1, 4 do
		local a = k * 1.7
		local pad = cylinder(CFrame.new(center + Vector3.new(math.cos(a) * radius * 0.55, 0.3, math.sin(a) * radius * 0.55)), 0.2, R(1.4, 2.2), Color3.fromRGB(90, 190, 80), parent)
		pad.CanCollide = false
		if k % 2 == 0 then
			ballPart(pad.CFrame * CFrame.new(0, 0.4, 0), 0.8, Color3.fromRGB(255, 140, 190), parent)
		end
	end
	avoidCircle(center, radius + 6)
end


local function cloudPuff(parent, pos, scale)
	local puffs = {}
	for k = 1, 5 do
		local b = ballPart(CFrame.new(pos + Vector3.new((k - 3) * 6 * scale, R(-1, 3) * scale, R(-3, 3) * scale)), R(8, 13) * scale, Color3.fromRGB(255, 255, 255), parent)
		b.CastShadow = false
		b.CanQuery = false
		table.insert(puffs, b)
	end
	local offset = Vector3.new(R(30, 60), 0, 0)
	for _, b in ipairs(puffs) do
		TweenService:Create(b, TweenInfo.new(R(30, 50), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { CFrame = b.CFrame + offset }):Play()
	end
end


local LEAF_COLORS = { Color3.fromRGB(95, 200, 75), Color3.fromRGB(120, 220, 85), Color3.fromRGB(75, 180, 70) }

local function roundTree(parent, pos, scale)
	scale = scale or 1
	cylinder(CFrame.new(pos + Vector3.new(0, 4 * scale, 0)), 8 * scale, 0.9 * scale, Color3.fromRGB(120, 80, 45), parent, Enum.Material.Wood)
	local base = pos + Vector3.new(0, 9 * scale, 0)
	ballPart(CFrame.new(base), 9 * scale, LEAF_COLORS[rng:NextInteger(1, 3)], parent, Enum.Material.Grass)
	for k = 1, 4 do
		local a = k * 1.7
		ballPart(CFrame.new(base + Vector3.new(math.cos(a) * 3 * scale, R(-1, 2) * scale, math.sin(a) * 3 * scale)), R(5, 7) * scale, LEAF_COLORS[rng:NextInteger(1, 3)], parent, Enum.Material.Grass)
	end
	-- petits fruits
	for k = 1, 3 do
		local a = k * 2.1
		ballPart(CFrame.new(base + Vector3.new(math.cos(a) * 4.2 * scale, R(-1, 1.5) * scale, math.sin(a) * 4.2 * scale)), 0.9 * scale, Color3.fromRGB(255, 80, 80), parent)
	end
end

local function pineTree(parent, pos, scale)
	scale = scale or 1
	cylinder(CFrame.new(pos + Vector3.new(0, 3 * scale, 0)), 6 * scale, 0.8 * scale, Color3.fromRGB(100, 65, 40), parent, Enum.Material.Wood)
	for k = 0, 3 do
		local r = (5.5 - k * 1.2) * scale
		local tier = cylinder(CFrame.new(pos + Vector3.new(0, (5 + k * 3) * scale, 0)), 3.2 * scale, r, Color3.fromRGB(40, 120 + k * 12, 60), parent, Enum.Material.Grass)
		tier.CanCollide = false
	end
	ballPart(CFrame.new(pos + Vector3.new(0, 16.5 * scale, 0)), 1.6 * scale, Color3.fromRGB(60, 160, 80), parent, Enum.Material.Grass)
end

local function palmTree(parent, pos, scale)
	scale = scale or 1
	local lean = R(-0.25, 0.25)
	local cf = CFrame.new(pos) * CFrame.Angles(0, R(0, 6.28), 0)
	for k = 0, 5 do
		cylinder(cf * CFrame.Angles(lean * k * 0.4, 0, 0) * CFrame.new(0, (1.2 + k * 2) * scale, 0), 2.2 * scale, (0.9 - k * 0.06) * scale, k % 2 == 0 and Color3.fromRGB(160, 115, 70) or Color3.fromRGB(140, 95, 55), parent, Enum.Material.Wood)
	end
	local top = (cf * CFrame.Angles(lean * 2.2, 0, 0) * CFrame.new(0, 13 * scale, 0)).Position
	for k = 1, 7 do
		local a = (k / 7) * math.pi * 2
		part({ Size = Vector3.new(1.6 * scale, 0.3 * scale, 7 * scale), CFrame = CFrame.new(top) * CFrame.Angles(0, a, 0) * CFrame.Angles(math.rad(-25), 0, 0) * CFrame.new(0, 0, -3.2 * scale), Color = Color3.fromRGB(70, 175, 70), Material = Enum.Material.Grass, CanCollide = false }, parent)
	end
	for k = 1, 3 do
		ballPart(CFrame.new(top + Vector3.new(math.cos(k * 2) * 0.8, -0.8, math.sin(k * 2) * 0.8)), 1 * scale, Color3.fromRGB(120, 80, 40), parent)
	end
end

local function bush(parent, pos, scale, flowerColor)
	scale = scale or 1
	for k = 1, 3 do
		ballPart(CFrame.new(pos + Vector3.new((k - 2) * 1.6 * scale, 1.2 * scale, R(-0.6, 0.6))), R(2.8, 3.6) * scale, LEAF_COLORS[rng:NextInteger(1, 3)], parent, Enum.Material.Grass)
	end
	if flowerColor then
		for k = 1, 4 do
			ballPart(CFrame.new(pos + Vector3.new(R(-2.5, 2.5) * scale, R(2, 3) * scale, R(-1.2, 1.2) * scale)), 0.7 * scale, flowerColor, parent)
		end
	end
end

local function flowerPatch(parent, pos)
	local colors = { Color3.fromRGB(255, 120, 170), Color3.fromRGB(255, 230, 80), Color3.fromRGB(150, 140, 255), Color3.new(1, 1, 1) }
	for k = 1, 6 do
		local p = pos + Vector3.new(R(-3, 3), 0, R(-3, 3))
		part({ Size = Vector3.new(0.15, 1, 0.15), CFrame = CFrame.new(p + Vector3.new(0, 0.5, 0)), Color = Color3.fromRGB(70, 160, 60), CanCollide = false }, parent)
		ballPart(CFrame.new(p + Vector3.new(0, 1.1, 0)), 0.6, colors[rng:NextInteger(1, #colors)], parent)
	end
end

local function rock(parent, pos, scale, color)
	scale = scale or 1
	part({ Size = Vector3.new(R(3, 5), R(2, 3.5), R(3, 5)) * scale, CFrame = CFrame.new(pos + Vector3.new(0, 0.6 * scale, 0)) * CFrame.Angles(R(-0.3, 0.3), R(0, 6.28), R(-0.3, 0.3)), Color = color or Color3.fromRGB(140, 140, 155), Material = Enum.Material.Slate }, parent)
end

local function mushroom(parent, pos, scale)
	scale = scale or 1
	cylinder(CFrame.new(pos + Vector3.new(0, 1 * scale, 0)), 2 * scale, 0.45 * scale, Color3.fromRGB(245, 235, 220), parent)
	local cap = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(3, 3, 3) * scale, CFrame = CFrame.new(pos + Vector3.new(0, 2.2 * scale, 0)), Color = Color3.fromRGB(235, 60, 70), CanCollide = false }, parent)
	local mesh = Instance.new(&quot;SpecialMesh&quot;)
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 0.6, 1)
	mesh.Parent = cap
	for k = 1, 4 do
		local a = k * 1.6
		ballPart(CFrame.new(pos + Vector3.new(math.cos(a) * 0.8 * scale, 2.75 * scale, math.sin(a) * 0.8 * scale)), 0.5 * scale, Color3.new(1, 1, 1), parent)
	end
end

local function lamp(parent, pos)
	cylinder(CFrame.new(pos + Vector3.new(0, 0.3, 0)), 0.6, 0.8, Color3.fromRGB(50, 50, 60), parent, Enum.Material.Metal)
	cylinder(CFrame.new(pos + Vector3.new(0, 4.5, 0)), 9, 0.25, Color3.fromRGB(50, 50, 60), parent, Enum.Material.Metal)
	local bulb = ballPart(CFrame.new(pos + Vector3.new(0, 9.4, 0)), 1.6, Color3.fromRGB(255, 230, 170), parent, Enum.Material.Neon)
	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = Color3.fromRGB(255, 220, 160)
	light.Range = 18
	light.Brightness = 1.5
	light.Parent = bulb
end

local function fenceLine(parent, from, to)
	local dir = to - from
	local len = dir.Magnitude
	local posts = math.floor(len / 6)
	for k = 0, posts do
		local p = from + dir * (k / posts)
		part({ Size = Vector3.new(0.6, 3.2, 0.6), CFrame = CFrame.new(p + Vector3.new(0, 1.6, 0)), Color = Color3.fromRGB(240, 235, 225), Material = Enum.Material.WoodPlanks }, parent)
	end
	for _, h in ipairs({ 1.2, 2.4 }) do
		part({ Size = Vector3.new(0.3, 0.4, len), CFrame = CFrame.lookAt((from + to) / 2 + Vector3.new(0, h, 0), to + Vector3.new(0, h, 0)), Color = Color3.fromRGB(240, 235, 225), Material = Enum.Material.WoodPlanks }, parent)
	end
end

local HOUSE_WALLS = { Color3.fromRGB(255, 225, 180), Color3.fromRGB(190, 225, 255), Color3.fromRGB(255, 200, 215), Color3.fromRGB(215, 245, 190) }
local HOUSE_ROOFS = { Color3.fromRGB(220, 75, 65), Color3.fromRGB(70, 120, 210), Color3.fromRGB(230, 140, 50), Color3.fromRGB(150, 80, 190) }

local function house(parent, cf, k)
	local w, d, h = 14, 12, 9
	local wall = HOUSE_WALLS[(k % #HOUSE_WALLS) + 1]
	local roof = HOUSE_ROOFS[(k % #HOUSE_ROOFS) + 1]
	part({ Size = Vector3.new(w + 1, 1, d + 1), CFrame = cf * CFrame.new(0, 0.5, 0), Color = Color3.fromRGB(150, 150, 160), Material = Enum.Material.Cobblestone }, parent)
	part({ Size = Vector3.new(w, h, d), CFrame = cf * CFrame.new(0, h / 2 + 1, 0), Color = wall }, parent)
	-- poutres
	for _, x in ipairs({ -w / 2, w / 2 }) do
		for _, z in ipairs({ -d / 2, d / 2 }) do
			part({ Size = Vector3.new(0.8, h, 0.8), CFrame = cf * CFrame.new(x, h / 2 + 1, z), Color = Color3.fromRGB(130, 85, 50), Material = Enum.Material.Wood }, parent)
		end
	end
	-- toit a deux pans
	local rh = 6
	wedge({ Size = Vector3.new(w + 2, rh, d / 2 + 1), CFrame = cf * CFrame.new(0, h + 1 + rh / 2, -(d / 4 + 0.5)), Color = roof }, parent)
	wedge({ Size = Vector3.new(w + 2, rh, d / 2 + 1), CFrame = cf * CFrame.new(0, h + 1 + rh / 2, d / 4 + 0.5) * CFrame.Angles(0, math.pi, 0), Color = roof }, parent)
	-- cheminee
	part({ Size = Vector3.new(1.8, 4, 1.8), CFrame = cf * CFrame.new(w / 3, h + rh, d / 5), Color = Color3.fromRGB(170, 90, 70), Material = Enum.Material.Brick }, parent)
	-- porte (face -Z, vers l'avant de cf)
	part({ Size = Vector3.new(3.2, 5.5, 0.4), CFrame = cf * CFrame.new(0, 3.75, -d / 2 - 0.2), Color = Color3.fromRGB(140, 90, 50), Material = Enum.Material.WoodPlanks }, parent)
	ballPart(cf * CFrame.new(1, 3.6, -d / 2 - 0.5), 0.4, Color3.fromRGB(255, 210, 60), parent, Enum.Material.Metal)
	-- fenetres
	for _, x in ipairs({ -w / 3.2, w / 3.2 }) do
		part({ Size = Vector3.new(2.8, 2.6, 0.3), CFrame = cf * CFrame.new(x, 5.5, -d / 2 - 0.15), Color = Color3.fromRGB(170, 220, 255), Material = Enum.Material.Glass, Transparency = 0.2 }, parent)
		part({ Size = Vector3.new(3.4, 0.4, 0.6), CFrame = cf * CFrame.new(x, 4, -d / 2 - 0.3), Color = Color3.new(1, 1, 1) }, parent)
		bush(parent, (cf * CFrame.new(x, 0, -d / 2 - 1.8)).Position, 0.45, Color3.fromRGB(255, 120, 170))
	end
end

-- Stand avec auvent raye (style boutique)
local function stand(parent, pos, lookAt, title, color, tag, attrs, promptText)
	local cf = CFrame.lookAt(pos, Vector3.new(lookAt.X, pos.Y, lookAt.Z))
	local counter = part({ Name = tag, Size = Vector3.new(12, 3.4, 4), CFrame = cf * CFrame.new(0, 1.7, 0), Color = Color3.fromRGB(170, 115, 65), Material = Enum.Material.WoodPlanks }, parent)
	part({ Size = Vector3.new(12.6, 0.5, 4.6), CFrame = cf * CFrame.new(0, 3.6, 0), Color = Color3.fromRGB(240, 235, 225), Material = Enum.Material.WoodPlanks }, parent)
	for _, x in ipairs({ -6, 6 }) do
		part({ Size = Vector3.new(0.7, 9, 0.7), CFrame = cf * CFrame.new(x, 4.5, 1.5), Color = Color3.fromRGB(240, 235, 225), Material = Enum.Material.Wood }, parent)
	end
	-- auvent raye incline
	for k = 0, 7 do
		local stripe = wedge({ Size = Vector3.new(1.6, 2, 6), CFrame = cf * CFrame.new(-5.6 + k * 1.6, 9.8, -0.5) * CFrame.Angles(0, math.pi, 0), Color = (k % 2 == 0) and color or Color3.new(1, 1, 1) }, parent)
		stripe.CanCollide = false
		local scallop = ballPart(cf * CFrame.new(-5.6 + k * 1.6, 8.8, -3.5), 1.6, (k % 2 == 0) and color or Color3.new(1, 1, 1), parent)
		scallop.CanCollide = false
	end
	sign(parent, cf * CFrame.new(0, 12, 0.5), Vector3.new(11, 2.6, 0.5), title, Color3.new(1, 1, 1), color)
	local prompt = Instance.new(&quot;ProximityPrompt&quot;)
	prompt.ActionText = promptText or &quot;Ouvrir&quot;
	prompt.ObjectText = title
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = counter
	for k, v in pairs(attrs or {}) do
		counter:SetAttribute(k, v)
	end
	CollectionService:AddTag(counter, tag)
	avoidCircle(pos, 12)
	return counter, cf
end

-- Grand oeuf decoratif tournant sur un piedestal
local function eggDisplay(parent, pos, color)
	cylinder(CFrame.new(pos + Vector3.new(0, 1, 0)), 2, 4, Color3.fromRGB(240, 240, 245), parent, Enum.Material.Marble)
	local ring = cylinder(CFrame.new(pos + Vector3.new(0, 2.1, 0)), 0.3, 4.3, color, parent, Enum.Material.Neon)
	ring.CanCollide = false
	local egg = part({ Name = &quot;EggDisplay&quot;, Shape = Enum.PartType.Ball, Size = Vector3.new(5, 5, 5), CFrame = CFrame.new(pos + Vector3.new(0, 6, 0)), Color = color, CanCollide = false }, parent)
	local mesh = Instance.new(&quot;SpecialMesh&quot;)
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 1.3, 1)
	mesh.Parent = egg
	for k = 1, 5 do
		local a = k * 1.25
		local spot = ballPart(egg.CFrame * CFrame.new(math.cos(a) * 2.35, R(-1.5, 2), math.sin(a) * 2.35), 1.2, color:Lerp(Color3.new(1, 1, 1), 0.55), parent)
		local weld = Instance.new(&quot;WeldConstraint&quot;)
		weld.Part0 = egg
		weld.Part1 = spot
		weld.Parent = spot
		spot.Anchored = false
	end
	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = color
	light.Range = 14
	light.Brightness = 1.5
	light.Parent = egg
	local sparkles = Instance.new(&quot;ParticleEmitter&quot;)
	sparkles.Rate = 6
	sparkles.Lifetime = NumberRange.new(1, 1.6)
	sparkles.Speed = NumberRange.new(1, 2)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
	sparkles.LightEmission = 1
	sparkles.Color = ColorSequence.new(Color3.new(1, 1, 1), color)
	sparkles.Parent = egg
	TweenService:Create(egg, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { CFrame = egg.CFrame * CFrame.new(0, 1.2, 0) * CFrame.Angles(0, math.pi, 0) }):Play()
end

-- Nouveaux props ------------------------------------------------------------------------------

local WOOD = Color3.fromRGB(165, 110, 65)
local WOOD_DARK = Color3.fromRGB(125, 82, 48)
local STONE = Color3.fromRGB(205, 200, 210)
local WHITE = Color3.new(1, 1, 1)

-- Banc en bois oriente (face = -Z de cf)
local function bench(parent, cf)
	for _, z in ipairs({ -0.5, 0.5 }) do
		part({ Size = Vector3.new(6, 0.35, 0.9), CFrame = cf * CFrame.new(0, 1.6, z), Color = WOOD }, parent)
	end
	for k = 0, 2 do
		part({ Size = Vector3.new(6, 0.6, 0.25), CFrame = cf * CFrame.new(0, 2.4 + k * 0.75, 1.05) * CFrame.Angles(math.rad(-10), 0, 0), Color = WOOD }, parent)
	end
	for _, x in ipairs({ -2.6, 2.6 }) do
		part({ Size = Vector3.new(0.4, 1.6, 2.2), CFrame = cf * CFrame.new(x, 0.8, 0.1), Color = Color3.fromRGB(60, 60, 70), Material = Enum.Material.Metal }, parent)
	end
	avoidCircle(cf.Position, 4)
end

-- Lanterne sur poteau (style jardin), couleur de lumiere au choix
local function lantern(parent, pos, color)
	color = color or Color3.fromRGB(255, 210, 140)
	cylinder(CFrame.new(pos + Vector3.new(0, 2.5, 0)), 5, 0.35, WOOD_DARK, parent, Enum.Material.Wood)
	part({ Size = Vector3.new(1.6, 0.3, 1.6), CFrame = CFrame.new(pos + Vector3.new(0, 5.1, 0)), Color = WOOD_DARK }, parent)
	local glass = part({ Size = Vector3.new(1.2, 1.5, 1.2), CFrame = CFrame.new(pos + Vector3.new(0, 6, 0)), Color = color, Material = Enum.Material.Neon, Transparency = 0.1, CanCollide = false }, parent)
	wedge({ Size = Vector3.new(1.9, 0.8, 0.95), CFrame = CFrame.new(pos + Vector3.new(0, 7.1, -0.475)), Color = Color3.fromRGB(200, 70, 60) }, parent)
	wedge({ Size = Vector3.new(1.9, 0.8, 0.95), CFrame = CFrame.new(pos + Vector3.new(0, 7.1, 0.475)) * CFrame.Angles(0, math.pi, 0), Color = Color3.fromRGB(200, 70, 60) }, parent)
	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = color
	light.Range = 14
	light.Brightness = 1.2
	light.Parent = glass
	avoidCircle(pos, 2)
end

-- Parterre de fleurs rond avec bordure
local FLOWER_COLORS = { Color3.fromRGB(255, 110, 160), Color3.fromRGB(255, 225, 70), Color3.fromRGB(150, 130, 255), Color3.fromRGB(255, 150, 80), WHITE }
local function flowerBed(parent, pos, radius, palette)
	palette = palette or FLOWER_COLORS
	local rim = cylinder(CFrame.new(pos + Vector3.new(0, 0.5, 0)), 1, radius + 0.8, STONE, parent, Enum.Material.Cobblestone)
	rim.CanCollide = true
	cylinder(CFrame.new(pos + Vector3.new(0, 0.75, 0)), 1, radius, Color3.fromRGB(120, 80, 50), parent)
	local n = math.floor(radius * radius * 0.9)
	for k = 1, n do
		local a = R(0, math.pi * 2)
		local r = math.sqrt(R(0, 1)) * (radius - 0.6)
		local p = pos + Vector3.new(math.cos(a) * r, 1.3, math.sin(a) * r)
		ballPart(CFrame.new(p), R(0.7, 1.1), palette[rng:NextInteger(1, #palette)], parent)
	end
	for k = 1, math.max(2, math.floor(radius)) do
		local a = R(0, math.pi * 2)
		ballPart(CFrame.new(pos + Vector3.new(math.cos(a) * radius * 0.5, 1.4, math.sin(a) * radius * 0.5)), R(1.4, 2), LEAF_COLORS[rng:NextInteger(1, 3)], parent, Enum.Material.Grass)
	end
	avoidCircle(pos, radius + 2)
end

-- Haie taillee entre deux points
local function hedge(parent, a, b, height, color)
	height = height or 3
	local d = b - a
	local cf = CFrame.lookAt((a + b) / 2 + Vector3.new(0, height / 2, 0), b + Vector3.new(0, height / 2, 0))
	part({ Size = Vector3.new(2.6, height, d.Magnitude), CFrame = cf, Color = color or Color3.fromRGB(70, 170, 70), Material = Enum.Material.Grass }, parent)
	for t = 0, d.Magnitude, 3 do
		ballPart(CFrame.new(a + d.Unit * t + Vector3.new(0, height, 0)), 2.8, color or Color3.fromRGB(80, 185, 75), parent, Enum.Material.Grass)
	end
end

-- Panneau indicateur avec fleches (vers les zones)
local function signpost(parent, pos, entries)
	cylinder(CFrame.new(pos + Vector3.new(0, 5, 0)), 10, 0.45, WOOD_DARK, parent, Enum.Material.Wood)
	for i, e in ipairs(entries) do
		local dir = Vector3.new(e.dir.X, 0, e.dir.Z).Unit
		local cf = CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.rad(90), 0)
		local y = 9.5 - i * 1.9
		sign(parent, CFrame.new(pos + Vector3.new(0, y, 0)) * cf.Rotation * CFrame.new(3.4, 0, 0), Vector3.new(6.5, 1.5, 0.3), e.text, WHITE, e.color or WOOD)
		part({ Size = Vector3.new(1.08, 1.08, 0.3), CFrame = CFrame.new(pos + Vector3.new(0, y, 0)) * cf.Rotation * CFrame.new(6.65, 0, 0) * CFrame.Angles(0, 0, math.rad(45)), Color = e.color or WOOD }, parent)
	end
	avoidCircle(pos, 3)
end

-- Plateau rond sureleve (colline douce) avec escalier vers dir ; renvoie le dessus
local function plateau(parent, pos, radius, height, topColor, sideColor, stairDir)
	cylinder(CFrame.new(pos + Vector3.new(0, height / 2, 0)), height, radius, sideColor, parent)
	cylinder(CFrame.new(pos + Vector3.new(0, height + 0.25, 0)), 0.5, radius + 0.6, topColor, parent)
	for k = 1, math.floor(radius * 1.2) do
		local a = (k / math.floor(radius * 1.2)) * math.pi * 2
		local drip = ballPart(CFrame.new(pos + Vector3.new(math.cos(a) * (radius + 0.4), height - 0.2, math.sin(a) * (radius + 0.4))), R(2.4, 3.4), topColor, parent)
		drip.CanCollide = false
	end
	if stairDir then
		local dir = Vector3.new(stairDir.X, 0, stairDir.Z).Unit
		local steps = math.ceil(height / 1)
		local cf = CFrame.lookAt(pos, pos + dir)
		for s = 1, steps do
			local h = height * (1 - (s - 1) / steps)
			part({ Name = &quot;Step&quot;, Size = Vector3.new(8, h, 2), CFrame = cf * CFrame.new(0, h / 2, -(radius - 1 + s * 2)), Color = (s % 2 == 0) and STONE or STONE:Lerp(Color3.new(0, 0, 0), 0.08), Material = Enum.Material.Cobblestone }, parent)
		end
		for _, x in ipairs({ -4.6, 4.6 }) do
			lantern(parent, (cf * CFrame.new(x, 0, -(radius + steps * 2 + 1))).Position)
		end
		Kit.avoidSegment(pos, pos + dir * (radius + steps * 2 + 2), 6)
	end
	avoidCircle(pos, radius + 3)
	return pos + Vector3.new(0, height + 0.5, 0)
end

-- Kiosque / gloriette
local function gazebo(parent, pos, roofColor)
	cylinder(CFrame.new(pos + Vector3.new(0, 0.5, 0)), 1, 9, STONE, parent, Enum.Material.Marble)
	for k = 1, 6 do
		local a = k / 6 * math.pi * 2
		cylinder(CFrame.new(pos + Vector3.new(math.cos(a) * 7.5, 5, math.sin(a) * 7.5)), 8, 0.5, WHITE, parent, Enum.Material.Marble)
	end
	local roof = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(20, 20, 20), CFrame = CFrame.new(pos + Vector3.new(0, 9, 0)), Color = roofColor or Color3.fromRGB(120, 190, 255), CanCollide = false }, parent)
	local m = Instance.new(&quot;SpecialMesh&quot;)
	m.MeshType = Enum.MeshType.Sphere
	m.Scale = Vector3.new(1, 0.45, 1)
	m.Parent = roof
	ballPart(CFrame.new(pos + Vector3.new(0, 13.8, 0)), 1.8, Config.Colors.Gold, parent, Enum.Material.Neon)
	bench(parent, CFrame.new(pos + Vector3.new(0, 1, 3)) * CFrame.Angles(0, math.pi, 0))
	avoidCircle(pos, 11)
end

-- Moulin a vent avec pales qui tournent
local function windmill(parent, pos, facing)
	local cf = CFrame.lookAt(pos, pos + facing)
	cylinder(cf * CFrame.new(0, 9, 0), 18, 5, Color3.fromRGB(250, 240, 220), parent)
	local roof = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(11, 11, 11), CFrame = cf * CFrame.new(0, 18, 0), Color = Color3.fromRGB(220, 75, 65) }, parent)
	part({ Size = Vector3.new(3, 5, 0.4), CFrame = cf * CFrame.new(0, 2.5, -5), Color = WOOD_DARK, Material = Enum.Material.WoodPlanks }, parent)
	local hub = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.5, 2, 2), CFrame = cf * CFrame.new(0, 15, -5.6) * CFrame.Angles(0, math.rad(90), 0), Color = WOOD_DARK, CanCollide = false }, parent)
	local blades = {}
	for k = 0, 3 do
		local b = part({ Size = Vector3.new(2.4, 11, 0.3), CFrame = hub.CFrame * CFrame.Angles(math.rad(k * 90), 0, 0) * CFrame.new(0, 6, 0) * CFrame.Angles(0, math.rad(90), 0), Color = (k % 2 == 0) and WHITE or Color3.fromRGB(255, 200, 200), CanCollide = false }, parent)
		b.Anchored = false
		local w = Instance.new(&quot;WeldConstraint&quot;)
		w.Part0 = hub
		w.Part1 = b
		w.Parent = b
		table.insert(blades, b)
	end
	TweenService:Create(hub, TweenInfo.new(8, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), { CFrame = hub.CFrame * CFrame.Angles(math.rad(-359), 0, 0) }):Play()
	avoidCircle(pos, 8)
end

-- Echoppe de marche decorative (auvent raye + caisses de fruits)
local STALL_COLORS = { Color3.fromRGB(255, 100, 120), Color3.fromRGB(80, 170, 255), Color3.fromRGB(255, 190, 40), Color3.fromRGB(130, 210, 90) }
local function stall(parent, cf, k)
	local color = STALL_COLORS[(k % #STALL_COLORS) + 1]
	part({ Size = Vector3.new(8, 3, 3.5), CFrame = cf * CFrame.new(0, 1.5, 0), Color = WOOD, Material = Enum.Material.WoodPlanks }, parent)
	for _, x in ipairs({ -3.8, 3.8 }) do
		part({ Size = Vector3.new(0.5, 7, 0.5), CFrame = cf * CFrame.new(x, 3.5, 1.4), Color = WOOD_DARK }, parent)
	end
	for s = 0, 4 do
		wedge({ Size = Vector3.new(1.6, 1.4, 4.5), CFrame = cf * CFrame.new(-3.2 + s * 1.6, 7.4, -0.3) * CFrame.Angles(0, math.pi, 0), Color = (s % 2 == 0) and color or WHITE, CanCollide = false }, parent)
	end
	local fruit = { Color3.fromRGB(255, 70, 70), Color3.fromRGB(255, 170, 40), Color3.fromRGB(120, 220, 80), Color3.fromRGB(170, 90, 220) }
	for i = 0, 2 do
		part({ Size = Vector3.new(2.2, 0.8, 1.8), CFrame = cf * CFrame.new(-2.6 + i * 2.6, 3.4, -0.4), Color = WOOD_DARK }, parent)
		for j = 1, 4 do
			ballPart(cf * CFrame.new(-2.6 + i * 2.6 + R(-0.6, 0.6), 4, -0.4 + R(-0.5, 0.5)), 0.7, fruit[((k + i) % #fruit) + 1], parent)
		end
	end
	avoidCircle(cf.Position, 6)
end

-- Statue doree de pet (patte geante sur socle) ou d'oeuf
local function statue(parent, pos, kind, color)
	color = color or Config.Colors.Gold
	local top
	part({ Size = Vector3.new(7, 3, 7), CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0)), Color = STONE, Material = Enum.Material.Marble }, parent)
	part({ Size = Vector3.new(7.8, 0.6, 7.8), CFrame = CFrame.new(pos + Vector3.new(0, 3.2, 0)), Color = WHITE, Material = Enum.Material.Marble }, parent)
	if kind == &quot;egg&quot; then
		local e = ballPart(CFrame.new(pos + Vector3.new(0, 7.5, 0)), 6, color, parent, Enum.Material.Metal)
		local m = Instance.new(&quot;SpecialMesh&quot;)
		m.MeshType = Enum.MeshType.Sphere
		m.Scale = Vector3.new(1, 1.3, 1)
		m.Parent = e
		e.Reflectance = 0.25
		top = e
	else
		local pad = ballPart(CFrame.new(pos + Vector3.new(0, 6, 0)), 5, color, parent, Enum.Material.Metal)
		pad.Reflectance = 0.25
		top = pad
		for k = -1.5, 1.5 do
			local toe = ballPart(CFrame.new(pos + Vector3.new(k * 1.6, 9.2 - math.abs(k) * 0.6, 0)), 2.4, color, parent, Enum.Material.Metal)
			toe.Reflectance = 0.25
		end
	end
	local sp = Instance.new(&quot;Sparkles&quot;)
	sp.SparkleColor = color
	sp.Parent = top
	avoidCircle(pos, 6)
end

-- Arche decorative (entree, jardin)
local function archway(parent, cf, width, height, color, text, textColor)
	local stone = color or STONE
	for _, x in ipairs({ -width / 2, width / 2 }) do
		part({ Size = Vector3.new(4, height, 4), CFrame = cf * CFrame.new(x, height / 2, 0), Color = stone, Material = Enum.Material.Marble }, parent)
		part({ Size = Vector3.new(5, 1.5, 5), CFrame = cf * CFrame.new(x, 0.75, 0), Color = stone:Lerp(Color3.new(0, 0, 0), 0.1), Material = Enum.Material.Marble }, parent)
		ballPart(cf * CFrame.new(x, height + 2.5, 0), 3, Config.Colors.Gold, parent, Enum.Material.Neon)
	end
	-- arc en segments
	local n = 9
	for i = 0, n do
		local a = math.pi * i / n
		local x = math.cos(a) * width / 2
		local y = height + math.sin(a) * width * 0.28
		part({ Size = Vector3.new(width / n + 1.2, 3, 4.4), CFrame = cf * CFrame.new(x, y, 0) * CFrame.Angles(0, 0, a + math.pi / 2), Color = stone, Material = Enum.Material.Marble, CanCollide = false }, parent)
	end
	if text then
		sign(parent, cf * CFrame.new(0, height + width * 0.28 - 0.5, -2.4) * CFrame.Angles(0, math.pi, 0), Vector3.new(width * 0.8, 4, 0.5), text, textColor or Config.Colors.Gold, Color3.fromRGB(120, 70, 200))
	end
end

-- Montgolfiere qui flotte au loin
local function balloon(parent, pos, color)
	local env = ballPart(CFrame.new(pos), 16, color, parent)
	env.CanCollide = false
	local stripes = ballPart(CFrame.new(pos), 16.3, WHITE, parent)
	stripes.CanCollide = false
	local m = Instance.new(&quot;SpecialMesh&quot;)
	m.MeshType = Enum.MeshType.Sphere
	m.Scale = Vector3.new(0.35, 1, 1)
	m.Parent = stripes
	local basket = part({ Size = Vector3.new(4, 3, 4), CFrame = CFrame.new(pos + Vector3.new(0, -12, 0)), Color = WOOD, Material = Enum.Material.WoodPlanks, CanCollide = false }, parent)
	local parts = { env, stripes, basket }
	for _, o in ipairs({ Vector3.new(1.8, 0, 1.8), Vector3.new(-1.8, 0, 1.8), Vector3.new(1.8, 0, -1.8), Vector3.new(-1.8, 0, -1.8) }) do
		table.insert(parts, part({ Size = Vector3.new(0.2, 6, 0.2), CFrame = CFrame.new(pos + o + Vector3.new(0, -8, 0)), Color = WOOD_DARK, CanCollide = false }, parent))
	end
	local rise = Vector3.new(0, R(6, 12), 0)
	for _, p in ipairs(parts) do
		TweenService:Create(p, TweenInfo.new(R(6, 10), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { CFrame = p.CFrame + rise }):Play()
	end
end

-- Petite ile decorative lointaine (profondeur du decor)
local function farIsland(parent, pos, size, top, dirt, decorate)
	part({ Size = Vector3.new(size, 3, size), CFrame = CFrame.new(pos + Vector3.new(0, -1.5, 0)), Color = top, CanCollide = false }, parent)
	local y = -3
	for k, s in ipairs({ size * 0.9, size * 0.6, size * 0.3 }) do
		part({ Size = Vector3.new(s, size * 0.18, s), CFrame = CFrame.new(pos + Vector3.new(0, y - size * 0.09, 0)), Color = (k % 2 == 0) and dirt:Lerp(Color3.new(0, 0, 0), 0.15) or dirt, CanCollide = false }, parent)
		y -= size * 0.18
	end
	for t = -size / 2, size / 2, 8 do
		for _, e in ipairs({ Vector3.new(t, -2, size / 2), Vector3.new(t, -2, -size / 2), Vector3.new(size / 2, -2, t), Vector3.new(-size / 2, -2, t) }) do
			local b = ballPart(CFrame.new(pos + e), 6, top, parent)
			b.CanCollide = false
		end
	end
	if decorate then
		decorate(pos)
	end
end

-- Riviere (bande d'eau avec berges) entre deux points
local function river(parent, a, b, width, bankColor)
	local d = b - a
	local cf = CFrame.lookAt((a + b) / 2, b)
	part({ Name = &quot;RiverBank&quot;, Size = Vector3.new(width + 4, 0.3, d.Magnitude), CFrame = cf * CFrame.new(0, 0.08, 0), Color = bankColor or Color3.fromRGB(230, 210, 160), CanCollide = false }, parent)
	local w = part({ Name = &quot;River&quot;, Size = Vector3.new(width, 0.3, d.Magnitude), CFrame = cf * CFrame.new(0, 0.16, 0), Color = WATER, Material = Enum.Material.Glass, Transparency = 0.1, CanCollide = false }, parent)
	w.Reflectance = 0.15
	for t = 0, d.Magnitude, 9 do
		for _, x in ipairs({ -width / 2 - 1.6, width / 2 + 1.6 }) do
			if rng:NextNumber() &lt; 0.6 then
				local r = part({ Size = Vector3.new(R(1.5, 2.6), R(0.8, 1.4), R(1.5, 2.6)), CFrame = cf * CFrame.new(x, 0.4, -d.Magnitude / 2 + t) * CFrame.Angles(0, R(0, 3), 0), Color = Color3.fromRGB(160, 160, 175), Material = Enum.Material.Slate }, parent)
				r.CanCollide = false
			end
		end
	end
	Kit.avoidSegment(a, b, width / 2 + 3)
end

-- Petit pont de planches (praticable) en travers d'une riviere
local function footbridge(parent, pos, dir, width, len)
	local cf = CFrame.lookAt(pos, pos + dir)
	local n = math.floor(len / 1.6)
	for i = 0, n do
		local t = i / n
		local y = 0.3 + math.sin(t * math.pi) * 1.4
		part({ Size = Vector3.new(width, 0.5, 1.7), CFrame = cf * CFrame.new(0, y, -len / 2 + t * len), Color = (i % 2 == 0) and WOOD or WOOD_DARK, Material = Enum.Material.WoodPlanks }, parent)
	end
	for _, x in ipairs({ -width / 2, width / 2 }) do
		for i = 0, 2 do
			local t = i / 2
			part({ Size = Vector3.new(0.5, 3, 0.5), CFrame = cf * CFrame.new(x, 1.8 + math.sin(t * math.pi) * 1.4, -len / 2 + t * len), Color = WOOD_DARK }, parent)
		end
	end
end

-- Exports -------------------------------------------------------------------------------------

Kit.part = part
Kit.wedge = wedge
Kit.ball = ballPart
Kit.cylinder = cylinder
Kit.sign = sign
Kit.WATER = WATER
Kit.pond = pond
Kit.cloudPuff = cloudPuff
Kit.LEAF_COLORS = LEAF_COLORS
Kit.roundTree = roundTree
Kit.pineTree = pineTree
Kit.palmTree = palmTree
Kit.bush = bush
Kit.flowerPatch = flowerPatch
Kit.rock = rock
Kit.mushroom = mushroom
Kit.lamp = lamp
Kit.fenceLine = fenceLine
Kit.house = house
Kit.stand = stand
Kit.eggDisplay = eggDisplay
Kit.bench = bench
Kit.lantern = lantern
Kit.flowerBed = flowerBed
Kit.hedge = hedge
Kit.signpost = signpost
Kit.plateau = plateau
Kit.gazebo = gazebo
Kit.windmill = windmill
Kit.stall = stall
Kit.statue = statue
Kit.archway = archway
Kit.balloon = balloon
Kit.farIsland = farIsland
Kit.river = river
Kit.footbridge = footbridge
Kit.WOOD = WOOD
Kit.WOOD_DARK = WOOD_DARK
Kit.STONE = STONE

-- Repartit count props au hasard dans la zone (hors emplacements reserves)
function Kit.scatter(zone, count, minR, maxR, fn, margin)
	local half = zone.size / 2
	local placed = 0
	for k = 1, count * 3 do
		if placed &gt;= count then
			break
		end
		local pos = zone.center + Vector3.new(R(-half + 14, half - 14), 0, R(-half + 14, half - 14))
		local r = (pos - zone.center).Magnitude
		if r &gt;= (minR or 0) and r &lt;= (maxR or half * 1.5) and Kit.isFree(pos, margin or 0) then
			placed += 1
			fn(pos, placed)
		end
	end
end

return Kit
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">MapZones</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Decor propre a chaque zone (hors Starter Village, construit par MapBuilder).
-- Chaque zone a son style : couleurs, vegetation, batiments, effets d'ambiance.

local TweenService = game:GetService(&quot;TweenService&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.MapKit)

local part, wedge, ball, cylinder, sign = Kit.part, Kit.wedge, Kit.ball, Kit.cylinder, Kit.sign
local R, rng = Kit.R, Kit.rng
local avoidCircle = Kit.avoidCircle
local WHITE = Color3.new(1, 1, 1)

local MapZones = {}
MapZones.Forest = nil -- defini plus bas (alias de Foret)

local function sphereMesh(p, scale)
	local m = Instance.new(&quot;SpecialMesh&quot;)
	m.MeshType = Enum.MeshType.Sphere
	m.Scale = scale
	m.Parent = p
	return p
end

local function cone(parent, pos, height, radius, color, material)
	-- cone en anneaux empiles (toits de tours, sapins, cornets)
	local n = 6
	for i = 0, n - 1 do
		local r = radius * (1 - i / n)
		local c = cylinder(CFrame.new(pos + Vector3.new(0, (i + 0.5) * height / n, 0)), height / n + 0.05, r, color, parent, material)
		c.CanCollide = i == 0
	end
	ball(CFrame.new(pos + Vector3.new(0, height, 0)), radius * 0.35, color, parent, material)
end

local function ambient(folder, zone, props)
	-- particules d'ambiance sur toute la zone
	local box = part({ Size = Vector3.new(zone.size, props.height or 14, zone.size), CFrame = CFrame.new(zone.center + Vector3.new(0, (props.height or 14) / 2 + (props.y or 1), 0)), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false }, folder)
	local e = Instance.new(&quot;ParticleEmitter&quot;)
	e.Rate = props.rate or 30
	e.Lifetime = props.life or NumberRange.new(4, 7)
	e.Speed = props.speed or NumberRange.new(0.5, 1.5)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = props.size or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.4, 0.35), NumberSequenceKeypoint.new(1, 0) })
	e.LightEmission = props.light or 1
	e.Color = ColorSequence.new(props.color)
	e.Acceleration = props.accel or Vector3.zero
	e.EmissionDirection = props.dir or Enum.NormalId.Top
	e.Transparency = props.transparency or NumberSequence.new(0)
	e.Shape = Enum.ParticleEmitterShape.Box
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	e.Parent = box
end

local function bob(p, height, time)
	TweenService:Create(p, TweenInfo.new(time or R(2.5, 4), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { CFrame = p.CFrame + Vector3.new(0, height, 0) }):Play()
end

local function spin(p, time)
	TweenService:Create(p, TweenInfo.new(time, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), { CFrame = p.CFrame * CFrame.Angles(0, math.rad(-359), 0) }):Play()
end

-- FORET ----------------------------------------------------------------------------------------

local function bigOak(parent, pos, scale)
	cylinder(CFrame.new(pos + Vector3.new(0, 6 * scale, 0)), 12 * scale, 1.8 * scale, Color3.fromRGB(110, 72, 42), parent, Enum.Material.Wood)
	for k = 1, 3 do
		local a = k * 2.1
		part({ Size = Vector3.new(1.2, 5, 1.2) * scale, CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * 2 * scale, 1.5 * scale, math.sin(a) * 2 * scale)) * CFrame.Angles(math.sin(a) * 0.7, 0, -math.cos(a) * 0.7), Color = Color3.fromRGB(110, 72, 42), Material = Enum.Material.Wood }, parent)
	end
	local top = pos + Vector3.new(0, 14 * scale, 0)
	ball(CFrame.new(top), 14 * scale, Color3.fromRGB(70, 165, 65), parent, Enum.Material.Grass)
	for k = 1, 6 do
		local a = k * 1.05
		ball(CFrame.new(top + Vector3.new(math.cos(a) * 5.5 * scale, R(-2, 2.5) * scale, math.sin(a) * 5.5 * scale)), R(7, 10) * scale, Kit.LEAF_COLORS[rng:NextInteger(1, 3)], parent, Enum.Material.Grass)
	end
	avoidCircle(pos, 8 * scale)
end

local function cabin(parent, cf)
	local logC = Color3.fromRGB(150, 98, 58)
	for i = 0, 6 do
		for _, z in ipairs({ -5, 5 }) do
			part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(14, 1.3, 1.3), CFrame = cf * CFrame.new(0, 0.65 + i * 1.2, z), Color = (i % 2 == 0) and logC or logC:Lerp(Color3.new(0, 0, 0), 0.12), Material = Enum.Material.Wood }, parent)
		end
		for _, x in ipairs({ -6.4, 6.4 }) do
			part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(11, 1.3, 1.3), CFrame = cf * CFrame.new(x, 1.25 + i * 1.2, 0) * CFrame.Angles(0, math.rad(90), 0), Color = logC, Material = Enum.Material.Wood }, parent)
		end
	end
	part({ Size = Vector3.new(12, 8, 9), CFrame = cf * CFrame.new(0, 4, 0), Color = Color3.fromRGB(210, 170, 120) }, parent)
	for _, s in ipairs({ -1, 1 }) do
		wedge({ Size = Vector3.new(16, 5, 7), CFrame = cf * CFrame.new(0, 10.8, s * 3.5) * CFrame.Angles(0, s &gt; 0 and math.pi or 0, 0), Color = Color3.fromRGB(90, 140, 70) }, parent)
	end
	part({ Size = Vector3.new(3, 5, 0.4), CFrame = cf * CFrame.new(0, 2.5, -5.8), Color = Color3.fromRGB(110, 70, 40), Material = Enum.Material.WoodPlanks }, parent)
	part({ Size = Vector3.new(2.5, 2.5, 0.3), CFrame = cf * CFrame.new(-4, 4.5, -5.8), Color = Color3.fromRGB(255, 220, 140), Material = Enum.Material.Neon }, parent)
	avoidCircle(cf.Position, 12)
end

local function campfire(parent, pos)
	for k = 1, 8 do
		local a = k / 8 * math.pi * 2
		Kit.rock(parent, pos + Vector3.new(math.cos(a) * 2.6, -0.4, math.sin(a) * 2.6), 0.4, Color3.fromRGB(130, 130, 140))
	end
	for k = 1, 3 do
		part({ Size = Vector3.new(0.7, 0.7, 4), CFrame = CFrame.new(pos + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, k * 1.05, math.rad(10)), Color = Color3.fromRGB(110, 70, 40), Material = Enum.Material.Wood }, parent)
	end
	local fireBase = part({ Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(pos + Vector3.new(0, 1, 0)), Transparency = 1, CanCollide = false }, parent)
	local fire = Instance.new(&quot;Fire&quot;)
	fire.Size = 5
	fire.Heat = 8
	fire.Parent = fireBase
	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = Color3.fromRGB(255, 160, 70)
	light.Range = 20
	light.Brightness = 2
	light.Parent = fireBase
	for k = 1, 3 do
		local a = k * 2.1 + 0.5
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(5, 1.4, 1.4), CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * 6, 0.7, math.sin(a) * 6)) * CFrame.Angles(0, -a + math.pi / 2, 0), Color = Color3.fromRGB(130, 85, 50), Material = Enum.Material.Wood }, parent)
	end
	avoidCircle(pos, 9)
end

local function tent(parent, cf, color)
	for _, s in ipairs({ -1, 1 }) do
		wedge({ Size = Vector3.new(7, 6, 4), CFrame = cf * CFrame.new(0, 3, s * 2) * CFrame.Angles(0, s &gt; 0 and math.pi or 0, 0), Color = color }, parent)
	end
	part({ Size = Vector3.new(2, 4, 0.2), CFrame = cf * CFrame.new(0, 2, -3.6), Color = color:Lerp(Color3.new(0, 0, 0), 0.4) }, parent)
	avoidCircle(cf.Position, 6)
end

local function treehouse(parent, pos)
	bigOak(parent, pos, 1.3)
	local deck = pos + Vector3.new(0, 11, 0)
	cylinder(CFrame.new(deck), 1, 8, Color3.fromRGB(170, 115, 70), parent, Enum.Material.WoodPlanks)
	part({ Size = Vector3.new(7, 5, 7), CFrame = CFrame.new(deck + Vector3.new(0, 3, 0)), Color = Color3.fromRGB(200, 140, 85), Material = Enum.Material.WoodPlanks }, parent)
	for _, s in ipairs({ -1, 1 }) do
		wedge({ Size = Vector3.new(9, 3, 4.5), CFrame = CFrame.new(deck + Vector3.new(0, 7, s * 2.25)) * CFrame.Angles(0, s &gt; 0 and math.pi or 0, 0), Color = Color3.fromRGB(220, 75, 65) }, parent)
	end
	for y = 1, 10 do
		part({ Size = Vector3.new(2.4, 0.3, 0.3), CFrame = CFrame.new(pos + Vector3.new(0, y, -9)), Color = Color3.fromRGB(140, 95, 55) }, parent)
	end
	for _, x in ipairs({ -1.2, 1.2 }) do
		part({ Size = Vector3.new(0.3, 11, 0.3), CFrame = CFrame.new(pos + Vector3.new(x, 5.5, -9)), Color = Color3.fromRGB(140, 95, 55) }, parent)
	end
end

function MapZones.Foret(folder, zone)
	local c = zone.center
	treehouse(folder, c + Vector3.new(95, 0, 70))
	cabin(folder, CFrame.new(c + Vector3.new(-100, 0, 80)) * CFrame.Angles(0, math.rad(40), 0))
	campfire(folder, c + Vector3.new(-70, 0, -40))
	for k, col in ipairs({ Color3.fromRGB(240, 120, 60), Color3.fromRGB(80, 160, 230), Color3.fromRGB(240, 200, 70) }) do
		local a = k * 2.1
		tent(folder, CFrame.lookAt(c + Vector3.new(-70 + math.cos(a) * 15, 0, -40 + math.sin(a) * 15), c + Vector3.new(-70, 0, -40)), col)
	end
	Kit.river(folder, c + Vector3.new(60, 0, -150), c + Vector3.new(120, 0, 150), 12, Color3.fromRGB(150, 120, 80))
	for k = 1, 5 do
		Kit.bench(folder, CFrame.new(c + Vector3.new(R(-110, -30), 0, R(-120, 120))) * CFrame.Angles(0, R(0, 6.28), 0))
	end
	Kit.scatter(zone, 12, 30, 200, function(pos)
		bigOak(folder, pos, R(0.8, 1.15))
	end, 6)
	Kit.scatter(zone, 70, 15, 200, function(pos)
		if rng:NextNumber() &lt; 0.7 then
			Kit.pineTree(folder, pos, R(0.9, 1.7))
		else
			Kit.roundTree(folder, pos, R(0.9, 1.3))
		end
		avoidCircle(pos, 4.5)
	end, 3)
	Kit.scatter(zone, 40, 10, 200, function(pos)
		Kit.mushroom(folder, pos, R(0.6, 1.5))
	end)
	Kit.scatter(zone, 30, 10, 200, function(pos)
		Kit.bush(folder, pos, R(0.8, 1.3), rng:NextNumber() &lt; 0.5 and Color3.fromRGB(150, 140, 255) or nil)
	end)
	Kit.scatter(zone, 18, 20, 200, function(pos)
		Kit.rock(folder, pos, R(0.8, 2), Color3.fromRGB(120, 125, 135))
	end)
	Kit.scatter(zone, 8, 30, 200, function(pos)
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(R(6, 9), 2.2, 2.2), CFrame = CFrame.new(pos + Vector3.new(0, 1.1, 0)) * CFrame.Angles(0, R(0, 6.28), 0), Color = Color3.fromRGB(120, 80, 45), Material = Enum.Material.Wood }, folder)
		avoidCircle(pos, 5)
	end)
	ambient(folder, zone, { color = Color3.fromRGB(230, 255, 130), rate = 45 })
end

-- DESERT ---------------------------------------------------------------------------------------

local function pyramid(parent, pos, size)
	local steps = 7
	for s = 0, steps - 1 do
		local w = size * (1 - s / steps)
		part({ Size = Vector3.new(w, size / steps, w), CFrame = CFrame.new(pos + Vector3.new(0, (s + 0.5) * size / steps, 0)), Color = Color3.fromRGB(225, 185, 115):Lerp(Color3.fromRGB(245, 215, 150), s / steps) }, parent)
	end
	ball(CFrame.new(pos + Vector3.new(0, size + 1, 0)), 3, Config.Colors.Gold, parent, Enum.Material.Neon)
	part({ Size = Vector3.new(5, 7, 1), CFrame = CFrame.new(pos + Vector3.new(0, 3.5, -size / 2 - 0.2)), Color = Color3.fromRGB(90, 60, 40) }, parent)
	avoidCircle(pos, size * 0.75 + 4)
end

local function cactus(parent, pos)
	local h = R(5, 9)
	local g = Color3.fromRGB(80, 175, 90)
	cylinder(CFrame.new(pos + Vector3.new(0, h / 2, 0)), h, 1, g, parent)
	ball(CFrame.new(pos + Vector3.new(0, h, 0)), 2, g, parent)
	for _, side in ipairs({ -1, 1 }) do
		local ah = R(2, 3.5)
		part({ Size = Vector3.new(2.2, 1.4, 1.4), CFrame = CFrame.new(pos + Vector3.new(side * 1.3, h * 0.45, 0)), Color = g }, parent)
		cylinder(CFrame.new(pos + Vector3.new(side * 2.2, h * 0.45 + ah / 2, 0)), ah, 0.7, g, parent)
		ball(CFrame.new(pos + Vector3.new(side * 2.2, h * 0.45 + ah, 0)), 1.4, g, parent)
	end
	ball(CFrame.new(pos + Vector3.new(0, h + 1, 0)), 0.9, Color3.fromRGB(255, 120, 170), parent)
	avoidCircle(pos, 4)
end

local function obelisk(parent, pos)
	part({ Size = Vector3.new(5, 1.5, 5), CFrame = CFrame.new(pos + Vector3.new(0, 0.75, 0)), Color = Color3.fromRGB(210, 170, 110) }, parent)
	part({ Size = Vector3.new(3, 16, 3), CFrame = CFrame.new(pos + Vector3.new(0, 9.5, 0)), Color = Color3.fromRGB(235, 200, 135) }, parent)
	wedge({ Size = Vector3.new(3, 2.5, 1.5), CFrame = CFrame.new(pos + Vector3.new(0, 18.75, -0.75)), Color = Config.Colors.Gold }, parent)
	wedge({ Size = Vector3.new(3, 2.5, 1.5), CFrame = CFrame.new(pos + Vector3.new(0, 18.75, 0.75)) * CFrame.Angles(0, math.pi, 0), Color = Config.Colors.Gold }, parent)
	for y = 4, 14, 3 do
		part({ Size = Vector3.new(1.2, 1.2, 0.2), CFrame = CFrame.new(pos + Vector3.new(0, y, -1.55)), Color = Color3.fromRGB(40, 90, 190) }, parent)
	end
	avoidCircle(pos, 4)
end

local function ruins(parent, pos)
	for k = 1, 6 do
		local a = k / 6 * math.pi * 2
		local h = (k % 3 == 0) and 3 or R(6, 12)
		local p = pos + Vector3.new(math.cos(a) * 9, 0, math.sin(a) * 9)
		cylinder(CFrame.new(p + Vector3.new(0, h / 2, 0)), h, 1.3, Color3.fromRGB(240, 220, 175), parent)
		part({ Size = Vector3.new(3.4, 0.8, 3.4), CFrame = CFrame.new(p + Vector3.new(0, h + 0.4, 0)), Color = Color3.fromRGB(225, 200, 150) }, parent)
	end
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(7, 2.4, 2.4), CFrame = CFrame.new(pos + Vector3.new(2, 1.2, 3)) * CFrame.Angles(0, 0.6, 0), Color = Color3.fromRGB(240, 220, 175) }, parent)
	avoidCircle(pos, 12)
end

local function sphinxStatue(parent, pos, facing)
	local cf = CFrame.lookAt(pos, pos + facing)
	local sand = Color3.fromRGB(230, 195, 125)
	part({ Size = Vector3.new(14, 3, 26), CFrame = cf * CFrame.new(0, 1.5, 0), Color = Color3.fromRGB(205, 170, 110) }, parent)
	part({ Size = Vector3.new(10, 7, 16), CFrame = cf * CFrame.new(0, 6.5, 3), Color = sand }, parent)
	for _, x in ipairs({ -3, 3 }) do
		part({ Size = Vector3.new(3, 2.5, 10), CFrame = cf * CFrame.new(x, 4.25, -8), Color = sand }, parent)
	end
	part({ Size = Vector3.new(7, 8, 6), CFrame = cf * CFrame.new(0, 13, -4), Color = sand }, parent)
	part({ Size = Vector3.new(9, 9, 5), CFrame = cf * CFrame.new(0, 13.5, -2.5), Color = Color3.fromRGB(60, 110, 220) }, parent)
	for y = 10, 17, 2 do
		part({ Size = Vector3.new(9.2, 0.6, 5.2), CFrame = cf * CFrame.new(0, y, -2.5), Color = Config.Colors.Gold }, parent)
	end
	part({ Size = Vector3.new(5, 5, 1), CFrame = cf * CFrame.new(0, 13, -7.4), Color = sand }, parent)
	avoidCircle(pos, 16)
end

function MapZones.Desert(folder, zone)
	local c = zone.center
	pyramid(folder, c + Vector3.new(90, 0, -90), 36)
	pyramid(folder, c + Vector3.new(-110, 0, 100), 24)
	pyramid(folder, c + Vector3.new(110, 0, 90), 18)
	sphinxStatue(folder, c + Vector3.new(-100, 0, -95), Vector3.new(1, 0, 1))
	ruins(folder, c + Vector3.new(50, 0, 40))
	for _, p in ipairs({ Vector3.new(-26, 0, -100), Vector3.new(26, 0, -100), Vector3.new(-26, 0, 100), Vector3.new(26, 0, 100) }) do
		obelisk(folder, c + p)
	end
	-- oasis
	local oasis = c + Vector3.new(-60, 0, 20)
	Kit.pond(folder, oasis, 18, Color3.fromRGB(120, 210, 90))
	for k = 1, 8 do
		local a = (k / 8) * math.pi * 2
		Kit.palmTree(folder, oasis + Vector3.new(math.cos(a) * 25, 0, math.sin(a) * 25), R(0.9, 1.3))
	end
	-- marche de tentes
	local tentColors = { Color3.fromRGB(230, 70, 70), Color3.fromRGB(60, 120, 220), Color3.fromRGB(240, 180, 40), Color3.fromRGB(150, 80, 200) }
	for k = 0, 3 do
		tent(folder, CFrame.lookAt(c + Vector3.new(40 + k * 16, 0, -40), c + Vector3.new(40 + k * 16, 0, 0)), tentColors[k + 1])
	end
	Kit.scatter(zone, 34, 18, 200, cactus)
	Kit.scatter(zone, 20, 20, 200, function(pos)
		Kit.rock(folder, pos, R(0.8, 2.2), Color3.fromRGB(200, 150, 100))
	end)
	ambient(folder, zone, { color = Color3.fromRGB(250, 225, 170), rate = 25, speed = NumberRange.new(3, 6), dir = Enum.NormalId.Right, light = 0, height = 6, transparency = NumberSequence.new(0.4, 1) })
end

-- PLAGE ----------------------------------------------------------------------------------------

local function umbrella(parent, pos, color)
	cylinder(CFrame.new(pos + Vector3.new(0, 4, 0)), 8, 0.25, WHITE, parent)
	for k = 0, 7 do
		local w = part({ Size = Vector3.new(3.4, 0.3, 4.4), CFrame = CFrame.new(pos + Vector3.new(0, 8, 0)) * CFrame.Angles(0, k * math.pi / 4, 0) * CFrame.new(0, -0.6, -2) * CFrame.Angles(math.rad(-20), 0, 0), Color = (k % 2 == 0) and color or WHITE, CanCollide = false }, parent)
	end
	ball(CFrame.new(pos + Vector3.new(0, 8.4, 0)), 0.8, color, parent)
	local towel = part({ Size = Vector3.new(3.5, 0.12, 6.5), CFrame = CFrame.new(pos + Vector3.new(3, 0.07, 1)) * CFrame.Angles(0, R(-0.3, 0.3), 0), Color = color:Lerp(WHITE, 0.3), CanCollide = false }, parent)
	part({ Size = Vector3.new(3.6, 0.13, 1), CFrame = towel.CFrame * CFrame.new(0, 0.01, 2.2), Color = WHITE, CanCollide = false }, parent)
	avoidCircle(pos, 6)
end

local function sandcastle(parent, pos)
	local sand = Color3.fromRGB(240, 205, 140)
	part({ Size = Vector3.new(9, 3, 9), CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0)), Color = sand }, parent)
	for _, o in ipairs({ Vector3.new(-4, 0, -4), Vector3.new(4, 0, -4), Vector3.new(-4, 0, 4), Vector3.new(4, 0, 4) }) do
		cylinder(CFrame.new(pos + o + Vector3.new(0, 2.5, 0)), 5, 1.6, sand, parent)
		cone(parent, pos + o + Vector3.new(0, 5, 0), 2.5, 1.8, sand:Lerp(WHITE, 0.15))
	end
	cylinder(CFrame.new(pos + Vector3.new(0, 4.5, 0)), 3, 2.6, sand, parent)
	part({ Size = Vector3.new(0.2, 3, 0.2), CFrame = CFrame.new(pos + Vector3.new(0, 7.5, 0)), Color = WHITE }, parent)
	part({ Size = Vector3.new(0.1, 1, 1.6), CFrame = CFrame.new(pos + Vector3.new(0, 8.4, 0.8)), Color = Color3.fromRGB(255, 80, 80) }, parent)
	avoidCircle(pos, 8)
end

local function lighthouse(parent, pos)
	part({ Size = Vector3.new(14, 3, 14), CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0)), Color = Color3.fromRGB(150, 150, 160), Material = Enum.Material.Slate }, parent)
	for i = 0, 6 do
		cylinder(CFrame.new(pos + Vector3.new(0, 3 + i * 4 + 2, 0)), 4, 4.6 - i * 0.3, (i % 2 == 0) and Color3.fromRGB(235, 60, 60) or WHITE, parent)
	end
	local lampY = 3 + 7 * 4
	cylinder(CFrame.new(pos + Vector3.new(0, lampY + 0.5, 0)), 1, 4, Color3.fromRGB(60, 60, 70), parent, Enum.Material.Metal)
	local glass = cylinder(CFrame.new(pos + Vector3.new(0, lampY + 3, 0)), 4, 2.6, Color3.fromRGB(255, 240, 160), parent, Enum.Material.Neon)
	cone(parent, pos + Vector3.new(0, lampY + 5, 0), 3.5, 3.4, Color3.fromRGB(235, 60, 60))
	local beam = part({ Size = Vector3.new(1.5, 1.5, 40), CFrame = CFrame.new(pos + Vector3.new(0, lampY + 3, 0)) * CFrame.new(0, 0, -20), Color = Color3.fromRGB(255, 245, 190), Material = Enum.Material.Neon, Transparency = 0.6, CanCollide = false }, parent)
	local pivot = part({ Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(pos + Vector3.new(0, lampY + 3, 0)), Transparency = 1, CanCollide = false }, parent)
	beam.Anchored = false
	local w = Instance.new(&quot;WeldConstraint&quot;)
	w.Part0 = pivot
	w.Part1 = beam
	w.Parent = beam
	spin(pivot, 6)
	local light = Instance.new(&quot;PointLight&quot;)
	light.Range = 30
	light.Color = Color3.fromRGB(255, 240, 170)
	light.Parent = glass
	avoidCircle(pos, 10)
end

local function beachHut(parent, cf, color)
	for _, x in ipairs({ -4, 4 }) do
		for _, z in ipairs({ -3.5, 3.5 }) do
			part({ Size = Vector3.new(0.8, 3, 0.8), CFrame = cf * CFrame.new(x, 1.5, z), Color = Kit.WOOD_DARK }, parent)
		end
	end
	part({ Size = Vector3.new(10, 0.6, 9), CFrame = cf * CFrame.new(0, 3.2, 0), Color = Kit.WOOD, Material = Enum.Material.WoodPlanks }, parent)
	part({ Size = Vector3.new(8, 6, 7), CFrame = cf * CFrame.new(0, 6.5, 0.5), Color = color }, parent)
	for i = 0, 3 do
		part({ Size = Vector3.new(8.1, 0.4, 7.1), CFrame = cf * CFrame.new(0, 4.5 + i * 1.5, 0.5), Color = WHITE }, parent)
	end
	for _, s in ipairs({ -1, 1 }) do
		wedge({ Size = Vector3.new(11, 3.5, 5), CFrame = cf * CFrame.new(0, 11.2, 0.5 + s * 2.5) * CFrame.Angles(0, s &gt; 0 and math.pi or 0, 0), Color = Color3.fromRGB(225, 190, 110) }, parent)
	end
	part({ Size = Vector3.new(2.6, 4, 0.3), CFrame = cf * CFrame.new(0, 5.5, -3.1), Color = Kit.WOOD_DARK }, parent)
	for i = 0, 3 do
		part({ Size = Vector3.new(3, 0.4, 1.2), CFrame = cf * CFrame.new(0, 0.6 + i * 0.75, -5.2 - i * -0.5 - 1.5 + i * 0), Color = Kit.WOOD }, parent)
	end
	avoidCircle(cf.Position, 9)
end

local function surfboard(parent, pos, color)
	local b = part({ Size = Vector3.new(2, 7, 0.4), CFrame = CFrame.new(pos + Vector3.new(0, 3.3, 0)) * CFrame.Angles(math.rad(-10), R(0, 6.28), 0), Color = color }, parent)
	sphereMesh(b, Vector3.new(1, 1, 1))
	part({ Size = Vector3.new(0.4, 6.4, 0.45), CFrame = b.CFrame, Color = WHITE, CanCollide = false }, parent)
end

local function starfish(parent, pos, color)
	for k = 0, 4 do
		part({ Size = Vector3.new(0.6, 0.3, 1.4), CFrame = CFrame.new(pos + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, k * math.pi * 2 / 5, 0) * CFrame.new(0, 0, -0.7), Color = color, CanCollide = false }, parent)
	end
end

function MapZones.Plage(folder, zone)
	local c = zone.center
	local half = zone.size / 2
	-- lagon cote ouest (pas de pont de ce cote) avec ponton
	local lagoon = c + Vector3.new(-half + 60, 0, 30)
	local water = cylinder(CFrame.new(lagoon + Vector3.new(0, 0.15, 0)), 0.3, 50, Color3.fromRGB(60, 210, 230), folder, Enum.Material.Glass)
	water.Transparency = 0.15
	water.CanCollide = false
	water.Reflectance = 0.2
	local shallow = cylinder(CFrame.new(lagoon + Vector3.new(0, 0.1, 0)), 0.3, 56, Color3.fromRGB(150, 235, 235), folder)
	shallow.CanCollide = false
	avoidCircle(lagoon, 56)
	for i = 0, 14 do
		part({ Size = Vector3.new(7, 0.6, 2.2), CFrame = CFrame.new(lagoon + Vector3.new(30 - i * 2.4, 1, -10)) * CFrame.Angles(0, math.rad(90), 0), Color = (i % 2 == 0) and Kit.WOOD or Kit.WOOD_DARK, Material = Enum.Material.WoodPlanks }, folder)
		if i % 3 == 0 then
			for _, z in ipairs({ -3.4, 3.4 }) do
				part({ Size = Vector3.new(0.8, 3.5, 0.8), CFrame = CFrame.new(lagoon + Vector3.new(30 - i * 2.4, 0.5, -10 + z)), Color = Kit.WOOD_DARK }, folder)
			end
		end
	end
	-- petit bateau amarre
	local boat = lagoon + Vector3.new(-6, 0.8, -18)
	part({ Size = Vector3.new(5, 1.6, 11), CFrame = CFrame.new(boat), Color = Color3.fromRGB(240, 240, 245) }, folder)
	part({ Size = Vector3.new(5.2, 0.5, 11.2), CFrame = CFrame.new(boat + Vector3.new(0, 0.6, 0)), Color = Color3.fromRGB(60, 140, 230) }, folder)
	part({ Size = Vector3.new(0.4, 9, 0.4), CFrame = CFrame.new(boat + Vector3.new(0, 5, 1)), Color = Kit.WOOD_DARK }, folder)
	wedge({ Size = Vector3.new(0.2, 7, 5), CFrame = CFrame.new(boat + Vector3.new(0, 5.5, -1.5)), Color = WHITE, CanCollide = false }, folder)
	lighthouse(folder, c + Vector3.new(-half + 25, 0, -half + 25))
	local cols = { Color3.fromRGB(255, 90, 110), Color3.fromRGB(60, 170, 255), Color3.fromRGB(255, 200, 50), Color3.fromRGB(110, 220, 120) }
	for k = 0, 3 do
		beachHut(folder, CFrame.lookAt(c + Vector3.new(40 + k * 24, 0, 120), c + Vector3.new(40 + k * 24, 0, 0)), cols[k + 1])
	end
	sandcastle(folder, c + Vector3.new(60, 0, -60))
	sandcastle(folder, c + Vector3.new(-40, 0, -100))
	-- filet de volley
	local net = c + Vector3.new(90, 0, -20)
	for _, z in ipairs({ -10, 10 }) do
		part({ Size = Vector3.new(0.6, 8, 0.6), CFrame = CFrame.new(net + Vector3.new(0, 4, z)), Color = WHITE }, folder)
	end
	part({ Size = Vector3.new(0.2, 2.5, 20), CFrame = CFrame.new(net + Vector3.new(0, 6.5, 0)), Color = Color3.fromRGB(250, 250, 250), Transparency = 0.3, CanCollide = false }, folder)
	ball(CFrame.new(net + Vector3.new(5, 1.2, 3)), 2, Color3.fromRGB(255, 220, 80), folder)
	avoidCircle(net, 14)
	Kit.scatter(zone, 14, 20, 200, function(pos)
		umbrella(folder, pos, cols[rng:NextInteger(1, #cols)])
	end, 4)
	Kit.scatter(zone, 26, 15, 200, function(pos)
		Kit.palmTree(folder, pos, R(1, 1.5))
		avoidCircle(pos, 4)
	end, 3)
	Kit.scatter(zone, 10, 20, 200, function(pos)
		surfboard(folder, pos, cols[rng:NextInteger(1, #cols)])
		avoidCircle(pos, 3)
	end)
	Kit.scatter(zone, 30, 10, 200, function(pos)
		if rng:NextNumber() &lt; 0.5 then
			starfish(folder, pos, Color3.fromRGB(255, 130, 90))
		else
			ball(CFrame.new(pos + Vector3.new(0, 0.3, 0)), R(0.8, 1.4), Color3.fromRGB(255, 220, 230), folder)
		end
	end)
	ambient(folder, zone, { color = WHITE, rate = 10, light = 0.3 })
end

-- CANDY LAND -----------------------------------------------------------------------------------

local CANDY = { Color3.fromRGB(255, 90, 160), Color3.fromRGB(120, 200, 255), Color3.fromRGB(255, 220, 80), Color3.fromRGB(150, 240, 140), Color3.fromRGB(190, 130, 255), Color3.fromRGB(255, 150, 90) }

local function lollipop(parent, pos, scale)
	local h = 9 * scale
	cylinder(CFrame.new(pos + Vector3.new(0, h / 2, 0)), h, 0.35 * scale, WHITE, parent)
	local col = CANDY[rng:NextInteger(1, #CANDY)]
	local rot = R(0, 6.28)
	local disc = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 7 * scale, 7 * scale), CFrame = CFrame.new(pos + Vector3.new(0, h + 3 * scale, 0)) * CFrame.Angles(0, rot, 0), Color = col }, parent)
	for k = 1, 3 do
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.05, (7 - k * 1.8) * scale, (7 - k * 1.8) * scale), CFrame = disc.CFrame, Color = (k % 2 == 1) and WHITE or col, CanCollide = false }, parent)
	end
	avoidCircle(pos, 4 * scale)
end

local function candyCane(parent, pos, scale)
	local h = 12 * scale
	for i = 0, 7 do
		cylinder(CFrame.new(pos + Vector3.new(0, (i + 0.5) * h / 8, 0)), h / 8, 0.9 * scale, (i % 2 == 0) and Color3.fromRGB(240, 50, 70) or WHITE, parent)
	end
	local rot = CFrame.Angles(0, R(0, 6.28), 0)
	for i = 0, 6 do
		local a = math.pi * i / 6
		local p = CFrame.new(pos + Vector3.new(0, h, 0)) * rot * CFrame.new(-math.cos(a) * 2 * scale + 2 * scale, math.sin(a) * 2 * scale, 0)
		ball(p, 1.9 * scale, (i % 2 == 0) and Color3.fromRGB(240, 50, 70) or WHITE, parent)
	end
	avoidCircle(pos, 4 * scale)
end

local function gumdrop(parent, pos, scale)
	local g = ball(CFrame.new(pos), 8 * scale, CANDY[rng:NextInteger(1, #CANDY)], parent, Enum.Material.Glass)
	g.Transparency = 0.1
	g.CanCollide = true
	sphereMesh(g, Vector3.new(1, 0.9, 1))
	avoidCircle(pos, 5 * scale)
end

local function cupcakeHouse(parent, pos, k)
	local base = CANDY[(k % #CANDY) + 1]
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		part({ Size = Vector3.new(4, 10, 1.6), CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * 7.2, 5, math.sin(a) * 7.2)) * CFrame.Angles(0, -a + math.pi / 2, 0), Color = (i % 2 == 0) and base or base:Lerp(WHITE, 0.3) }, parent)
	end
	cylinder(CFrame.new(pos + Vector3.new(0, 5, 0)), 10, 7, base:Lerp(WHITE, 0.5), parent)
	local frost = ball(CFrame.new(pos + Vector3.new(0, 11, 0)), 18, Color3.fromRGB(255, 245, 250), parent)
	sphereMesh(frost, Vector3.new(1, 0.55, 1))
	ball(CFrame.new(pos + Vector3.new(0, 14, 0)), 9, Color3.fromRGB(255, 220, 235), parent)
	ball(CFrame.new(pos + Vector3.new(0, 18.5, 0)), 3.5, Color3.fromRGB(230, 30, 60), parent)
	for i = 1, 14 do
		local a = R(0, 6.28)
		local sprinkle = part({ Size = Vector3.new(0.3, 0.3, 1.1), CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * R(2, 7), R(12.5, 14.5), math.sin(a) * R(2, 7))) * CFrame.Angles(R(0, 3), R(0, 3), 0), Color = CANDY[rng:NextInteger(1, #CANDY)], CanCollide = false }, parent)
	end
	part({ Size = Vector3.new(3.2, 5, 0.4), CFrame = CFrame.new(pos + Vector3.new(0, 2.5, -7.9)), Color = Color3.fromRGB(130, 75, 45) }, parent)
	avoidCircle(pos, 11)
end

local function iceCream(parent, pos)
	for i = 0, 5 do
		cylinder(CFrame.new(pos + Vector3.new(0, i * 1.6 + 0.8, 0)), 1.6, 0.6 + i * 0.45, Color3.fromRGB(225, 170, 100), parent)
	end
	ball(CFrame.new(pos + Vector3.new(0, 10.5, 0)), 6.5, CANDY[rng:NextInteger(1, #CANDY)], parent)
	ball(CFrame.new(pos + Vector3.new(0, 14.5, 0)), 5.5, CANDY[rng:NextInteger(1, #CANDY)], parent)
	ball(CFrame.new(pos + Vector3.new(0, 17.6, 0)), 1.6, Color3.fromRGB(230, 30, 60), parent)
	avoidCircle(pos, 5)
end

local function donut(parent, pos, color)
	local n = 14
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		ball(CFrame.new(pos + Vector3.new(math.cos(a) * 4.5, 2.3, math.sin(a) * 4.5)), 4.8, Color3.fromRGB(225, 170, 100), parent)
		ball(CFrame.new(pos + Vector3.new(math.cos(a) * 4.5, 3, math.sin(a) * 4.5)), 4.2, color, parent)
	end
	avoidCircle(pos, 8)
end

local function cottonTree(parent, pos, scale)
	cylinder(CFrame.new(pos + Vector3.new(0, 4 * scale, 0)), 8 * scale, 0.5 * scale, WHITE, parent)
	local col = rng:NextNumber() &lt; 0.5 and Color3.fromRGB(255, 170, 220) or Color3.fromRGB(170, 215, 255)
	for k = 1, 5 do
		ball(CFrame.new(pos + Vector3.new(R(-2.5, 2.5), 9 + R(-1, 2), R(-2.5, 2.5)) * scale), R(5, 7) * scale, col, parent)
	end
	avoidCircle(pos, 4 * scale)
end

function MapZones.Bonbons(folder, zone)
	local c = zone.center
	Kit.river(folder, c + Vector3.new(-150, 0, -60), c + Vector3.new(150, 0, -40), 12, Color3.fromRGB(255, 220, 235))
	for _, r in ipairs(folder:GetChildren()) do
		if r.Name == &quot;River&quot; then
			r.Color = Color3.fromRGB(120, 70, 45)
			r.Material = Enum.Material.SmoothPlastic
			r.Transparency = 0
		end
	end
	Kit.footbridge(folder, c + Vector3.new(0, 0, -51), Vector3.new(0, 0, 1), 14, 20)
	for k, p in ipairs({ Vector3.new(-100, 0, 80), Vector3.new(-60, 0, 120), Vector3.new(80, 0, 100), Vector3.new(110, 0, 50), Vector3.new(-110, 0, -110) }) do
		cupcakeHouse(folder, c + p, k)
	end
	for k, p in ipairs({ Vector3.new(60, 0, -110), Vector3.new(-40, 0, 40), Vector3.new(100, 0, -10) }) do
		donut(folder, c + p, CANDY[k])
	end
	for _, p in ipairs({ Vector3.new(40, 0, 60), Vector3.new(-80, 0, -10), Vector3.new(120, 0, -120) }) do
		iceCream(folder, c + p)
	end
	Kit.scatter(zone, 20, 20, 200, function(pos)
		lollipop(folder, pos, R(0.8, 1.4))
	end, 3)
	Kit.scatter(zone, 16, 20, 200, function(pos)
		candyCane(folder, pos, R(0.8, 1.3))
	end, 3)
	Kit.scatter(zone, 16, 20, 200, function(pos)
		cottonTree(folder, pos, R(0.9, 1.4))
	end, 3)
	Kit.scatter(zone, 18, 15, 200, function(pos)
		gumdrop(folder, pos, R(0.5, 1.2))
	end, 2)
	ambient(folder, zone, { color = Color3.fromRGB(255, 180, 230), rate = 35 })
end

-- NEIGE ----------------------------------------------------------------------------------------

local SNOW = Color3.fromRGB(248, 252, 255)

local function snowPine(parent, pos, scale)
	Kit.pineTree(parent, pos, scale)
	for k = 0, 3 do
		local r = (5.5 - k * 1.2) * scale
		local cap = cylinder(CFrame.new(pos + Vector3.new(0, (6.7 + k * 3) * scale, 0)), 0.6 * scale, r * 0.75, SNOW, parent)
		cap.CanCollide = false
	end
	ball(CFrame.new(pos + Vector3.new(0, 17.3 * scale, 0)), 1.4 * scale, SNOW, parent)
	avoidCircle(pos, 5 * scale)
end

local function snowman(parent, pos)
	ball(CFrame.new(pos + Vector3.new(0, 2.6, 0)), 5.5, SNOW, parent)
	ball(CFrame.new(pos + Vector3.new(0, 6.4, 0)), 4.2, SNOW, parent)
	ball(CFrame.new(pos + Vector3.new(0, 9.4, 0)), 3.2, SNOW, parent)
	for _, x in ipairs({ -0.55, 0.55 }) do
		ball(CFrame.new(pos + Vector3.new(x, 9.8, -1.45)), 0.45, Color3.fromRGB(30, 30, 40), parent)
	end
	local nose = part({ Size = Vector3.new(0.4, 0.4, 1.8), CFrame = CFrame.new(pos + Vector3.new(0, 9.3, -2.2)), Color = Color3.fromRGB(255, 140, 40), CanCollide = false }, parent)
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 4.4, 4.4), CFrame = CFrame.new(pos + Vector3.new(0, 8, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(230, 60, 60), CanCollide = false }, parent)
	cylinder(CFrame.new(pos + Vector3.new(0, 11.3, 0)), 0.4, 2.2, Color3.fromRGB(40, 40, 50), parent)
	cylinder(CFrame.new(pos + Vector3.new(0, 12.6, 0)), 2.4, 1.4, Color3.fromRGB(40, 40, 50), parent)
	for _, s in ipairs({ -1, 1 }) do
		part({ Size = Vector3.new(4, 0.3, 0.3), CFrame = CFrame.new(pos + Vector3.new(s * 3.4, 7, 0)) * CFrame.Angles(0, 0, math.rad(s * 25)), Color = Color3.fromRGB(110, 70, 40), CanCollide = false }, parent)
	end
	avoidCircle(pos, 4)
end

local function igloo(parent, pos, facing)
	local dome = ball(CFrame.new(pos), 18, SNOW, parent)
	sphereMesh(dome, Vector3.new(1, 1, 1))
	local cf = CFrame.lookAt(pos, pos + facing)
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(7, 6, 6), CFrame = cf * CFrame.new(0, 2.5, -9) * CFrame.Angles(0, math.rad(90), 0), Color = SNOW }, parent)
	part({ Size = Vector3.new(3.4, 4, 0.4), CFrame = cf * CFrame.new(0, 2, -12.5), Color = Color3.fromRGB(70, 90, 130) }, parent)
	for y = 2, 7, 2.5 do
		cylinder(CFrame.new(pos + Vector3.new(0, y, 0)), 0.15, math.sqrt(math.max(81 - y * y, 1)) + 0.05, Color3.fromRGB(215, 230, 245), parent).CanCollide = false
	end
	avoidCircle(pos, 13)
end

local function iceCrystal(parent, pos, scale)
	for k = 1, 4 do
		local h = R(4, 9) * scale
		part({ Size = Vector3.new(1.4, h, 1.4) * Vector3.new(scale, 1, scale), CFrame = CFrame.new(pos) * CFrame.Angles(R(-0.4, 0.4), R(0, 6.28), R(-0.4, 0.4)) * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, math.rad(45), 0), Color = Color3.fromRGB(170, 230, 255), Material = Enum.Material.Glass, Transparency = 0.2, CanCollide = false }, parent)
	end
	avoidCircle(pos, 3 * scale)
end

local function present(parent, pos)
	local col = CANDY[rng:NextInteger(1, #CANDY)]
	local s = R(2, 3.4)
	part({ Size = Vector3.new(s, s, s), CFrame = CFrame.new(pos + Vector3.new(0, s / 2, 0)) * CFrame.Angles(0, R(0, 3), 0), Color = col }, parent)
	part({ Size = Vector3.new(s + 0.1, s + 0.1, 0.5), CFrame = CFrame.new(pos + Vector3.new(0, s / 2, 0)), Color = WHITE, CanCollide = false }, parent)
end

function MapZones.Neige(folder, zone)
	local c = zone.center
	-- lac gele + patineurs (bonhommes)
	local lake = c + Vector3.new(70, 0, 60)
	local ice = cylinder(CFrame.new(lake + Vector3.new(0, 0.15, 0)), 0.3, 34, Color3.fromRGB(190, 235, 255), folder, Enum.Material.Glass)
	ice.Reflectance = 0.35
	ice.Transparency = 0.1
	cylinder(CFrame.new(lake + Vector3.new(0, 0.1, 0)), 0.3, 37, SNOW, folder)
	avoidCircle(lake, 40)
	igloo(folder, c + Vector3.new(-90, 0, 90), Vector3.new(1, 0, -1))
	igloo(folder, c + Vector3.new(-120, 0, 40), Vector3.new(1, 0, 0))
	-- chalet enneige
	local chalet = CFrame.new(c + Vector3.new(100, 0, -90)) * CFrame.Angles(0, math.rad(-130), 0)
	cabin(folder, chalet)
	for _, s in ipairs({ -1, 1 }) do
		wedge({ Size = Vector3.new(16.4, 1.2, 7.4), CFrame = chalet * CFrame.new(0, 13.6, s * 3.4) * CFrame.Angles(0, s &gt; 0 and math.pi or 0, 0), Color = SNOW }, folder)
	end
	-- colline de neige avec escalier
	Kit.plateau(folder, c + Vector3.new(-80, 0, -90), 22, 7, SNOW, Color3.fromRGB(205, 225, 245), Vector3.new(1, 0, 0.6))
	snowman(folder, c + Vector3.new(-80, 7.5, -90))
	Kit.scatter(zone, 50, 20, 200, function(pos)
		snowPine(folder, pos, R(0.9, 1.6))
	end, 3)
	Kit.scatter(zone, 10, 20, 200, function(pos)
		snowman(folder, pos)
	end, 3)
	Kit.scatter(zone, 16, 15, 200, function(pos)
		iceCrystal(folder, pos, R(0.7, 1.4))
	end, 2)
	Kit.scatter(zone, 20, 10, 200, function(pos)
		present(folder, pos)
	end)
	ambient(folder, zone, { color = WHITE, rate = 120, height = 40, y = 5, speed = NumberRange.new(2, 4), dir = Enum.NormalId.Bottom, light = 0.2, life = NumberRange.new(6, 9), size = NumberSequence.new(0.35) })
end

-- MYSTIQUE -------------------------------------------------------------------------------------

local MYST = { Color3.fromRGB(190, 90, 255), Color3.fromRGB(80, 220, 255), Color3.fromRGB(255, 90, 210), Color3.fromRGB(120, 255, 200) }

local function glowCrystal(parent, pos, scale, color)
	for k = 1, 5 do
		local h = R(4, 11) * scale
		local w = R(1.2, 2.2) * scale
		local cf = CFrame.new(pos) * CFrame.Angles(R(-0.45, 0.45), R(0, 6.28), R(-0.45, 0.45)) * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, math.rad(45), 0)
		part({ Size = Vector3.new(w, h, w), CFrame = cf, Color = color, Material = Enum.Material.Neon, Transparency = 0.15, CanCollide = false }, parent)
	end
	local l = Instance.new(&quot;PointLight&quot;)
	l.Color = color
	l.Range = 16 * scale
	l.Brightness = 1.5
	l.Parent = parent:GetChildren()[#parent:GetChildren()]
	avoidCircle(pos, 4 * scale)
end

local function glowMushroom(parent, pos, scale, color)
	cylinder(CFrame.new(pos + Vector3.new(0, 3 * scale, 0)), 6 * scale, 0.9 * scale, Color3.fromRGB(230, 220, 255), parent)
	local cap = ball(CFrame.new(pos + Vector3.new(0, 6.5 * scale, 0)), 8 * scale, color, parent, Enum.Material.Neon)
	sphereMesh(cap, Vector3.new(1, 0.55, 1))
	for k = 1, 5 do
		local a = k * 1.25
		ball(CFrame.new(pos + Vector3.new(math.cos(a) * 2.2 * scale, 7.8 * scale, math.sin(a) * 2.2 * scale)), 0.9 * scale, WHITE, parent, Enum.Material.Neon)
	end
	local l = Instance.new(&quot;PointLight&quot;)
	l.Color = color
	l.Range = 14 * scale
	l.Parent = cap
	avoidCircle(pos, 4 * scale)
end

local function magicTree(parent, pos, scale)
	cylinder(CFrame.new(pos + Vector3.new(0, 5 * scale, 0)), 10 * scale, 1 * scale, Color3.fromRGB(70, 50, 100), parent)
	local col = MYST[rng:NextInteger(1, #MYST)]
	for k = 1, 5 do
		ball(CFrame.new(pos + Vector3.new(R(-3, 3), 11 + R(-1.5, 2), R(-3, 3)) * scale), R(5, 7) * scale, col:Lerp(Color3.fromRGB(60, 30, 110), 0.45), parent, Enum.Material.Grass)
	end
	for k = 1, 4 do
		ball(CFrame.new(pos + Vector3.new(R(-4, 4), 9 + R(-1, 3), R(-4, 4)) * scale), 0.9 * scale, col, parent, Enum.Material.Neon)
	end
	avoidCircle(pos, 5 * scale)
end

local function runeCircle(parent, pos)
	local ring = cylinder(CFrame.new(pos + Vector3.new(0, 0.12, 0)), 0.2, 16, Color3.fromRGB(190, 120, 255), parent, Enum.Material.Neon)
	ring.CanCollide = false
	cylinder(CFrame.new(pos + Vector3.new(0, 0.16, 0)), 0.2, 15, Color3.fromRGB(45, 25, 80), parent).CanCollide = false
	cylinder(CFrame.new(pos + Vector3.new(0, 0.2, 0)), 0.2, 6, Color3.fromRGB(120, 230, 255), parent, Enum.Material.Neon).CanCollide = false
	for k = 1, 8 do
		local a = k / 8 * math.pi * 2
		local p = pos + Vector3.new(math.cos(a) * 18, 0, math.sin(a) * 18)
		part({ Size = Vector3.new(2.2, 7, 2.2), CFrame = CFrame.new(p + Vector3.new(0, 3.5, 0)) * CFrame.Angles(0, a, 0), Color = Color3.fromRGB(90, 80, 120), Material = Enum.Material.Slate }, parent)
		part({ Size = Vector3.new(0.3, 2, 1.2), CFrame = CFrame.new(p + Vector3.new(0, 4.5, 0)) * CFrame.Angles(0, a, 0) * CFrame.new(-1.15, 0, 0), Color = MYST[(k % #MYST) + 1], Material = Enum.Material.Neon }, parent)
	end
	local orb = ball(CFrame.new(pos + Vector3.new(0, 7, 0)), 4, Color3.fromRGB(200, 140, 255), parent, Enum.Material.Neon)
	orb.CanCollide = false
	bob(orb, 2, 3)
	local l = Instance.new(&quot;PointLight&quot;)
	l.Color = Color3.fromRGB(200, 140, 255)
	l.Range = 30
	l.Brightness = 2
	l.Parent = orb
	avoidCircle(pos, 21)
end

local function portal(parent, pos, facing)
	local cf = CFrame.lookAt(pos, pos + facing)
	local n = 20
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		ball(cf * CFrame.new(math.cos(a) * 9, 10 + math.sin(a) * 9, 0), 2.6, Color3.fromRGB(110, 90, 150), parent)
	end
	local disk = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 17, 17), CFrame = cf * CFrame.new(0, 10, 0) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(180, 100, 255), Material = Enum.Material.ForceField, CanCollide = false }, parent)
	local swirl = Instance.new(&quot;ParticleEmitter&quot;)
	swirl.Rate = 30
	swirl.Lifetime = NumberRange.new(1, 2)
	swirl.Speed = NumberRange.new(1, 3)
	swirl.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
	swirl.LightEmission = 1
	swirl.Color = ColorSequence.new(Color3.fromRGB(220, 160, 255), Color3.fromRGB(100, 220, 255))
	swirl.Parent = disk
	part({ Size = Vector3.new(24, 2, 8), CFrame = cf * CFrame.new(0, 1, 0), Color = Color3.fromRGB(90, 80, 120), Material = Enum.Material.Slate }, parent)
	avoidCircle(pos, 14)
end

local function floatingRock(parent, pos, scale)
	local r = part({ Size = Vector3.new(R(5, 9), R(3, 5), R(5, 9)) * scale, CFrame = CFrame.new(pos) * CFrame.Angles(R(-0.3, 0.3), R(0, 6), R(-0.3, 0.3)), Color = Color3.fromRGB(110, 95, 140), Material = Enum.Material.Slate, CanCollide = false }, parent)
	local g = ball(CFrame.new(pos + Vector3.new(0, r.Size.Y / 2, 0)), r.Size.X * 0.9, Color3.fromRGB(150, 110, 230), parent, Enum.Material.Grass)
	sphereMesh(g, Vector3.new(1, 0.25, 1))
	g.CanCollide = false
	for _, p in ipairs({ r, g }) do
		bob(p, R(2, 4), R(3, 5))
	end
end

function MapZones.Mystique(folder, zone)
	local c = zone.center
	runeCircle(folder, c + Vector3.new(0, 0, 0) + Vector3.new(70, 0, 40))
	portal(folder, c + Vector3.new(110, 0, -100), Vector3.new(-1, 0, 1))
	portal(folder, c + Vector3.new(-110, 0, 110), Vector3.new(1, 0, -1))
	Kit.plateau(folder, c + Vector3.new(-90, 0, -80), 20, 8, Color3.fromRGB(150, 110, 230), Color3.fromRGB(90, 70, 130), Vector3.new(1, 0, 0.4))
	glowCrystal(folder, c + Vector3.new(-90, 8.5, -80), 2, MYST[2])
	for k = 1, 16 do
		local a = k / 16 * math.pi * 2
		floatingRock(folder, c + Vector3.new(math.cos(a) * R(100, 150), R(20, 45), math.sin(a) * R(100, 150)), R(0.8, 1.6))
	end
	Kit.scatter(zone, 26, 20, 200, function(pos)
		magicTree(folder, pos, R(0.9, 1.4))
	end, 3)
	Kit.scatter(zone, 22, 15, 200, function(pos)
		glowCrystal(folder, pos, R(0.7, 1.4), MYST[rng:NextInteger(1, #MYST)])
	end, 2)
	Kit.scatter(zone, 20, 15, 200, function(pos)
		glowMushroom(folder, pos, R(0.6, 1.3), MYST[rng:NextInteger(1, #MYST)])
	end, 2)
	ambient(folder, zone, { color = Color3.fromRGB(210, 150, 255), rate = 60, height = 20 })
end

-- PET KINGDOM ----------------------------------------------------------------------------------

local ROYAL = Color3.fromRGB(235, 230, 245)
local ROYAL_ROOF = Color3.fromRGB(70, 90, 220)

local function tower(parent, pos, radius, height, roof)
	cylinder(CFrame.new(pos + Vector3.new(0, height / 2, 0)), height, radius, ROYAL, parent)
	cylinder(CFrame.new(pos + Vector3.new(0, height + 0.5, 0)), 1, radius + 1, ROYAL:Lerp(Color3.new(0, 0, 0), 0.08), parent)
	for k = 1, 8 do
		local a = k / 8 * math.pi * 2
		part({ Size = Vector3.new(1.8, 2, 1.8), CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * radius, height + 2, math.sin(a) * radius)), Color = ROYAL }, parent)
	end
	cone(parent, pos + Vector3.new(0, height + 1, 0), radius * 2.2, radius + 0.6, roof or ROYAL_ROOF)
	part({ Size = Vector3.new(0.3, 5, 0.3), CFrame = CFrame.new(pos + Vector3.new(0, height + radius * 2.2 + 3, 0)), Color = Config.Colors.Gold }, parent)
	local flag = part({ Size = Vector3.new(0.15, 1.8, 3), CFrame = CFrame.new(pos + Vector3.new(0, height + radius * 2.2 + 4.5, 1.5)), Color = Color3.fromRGB(230, 50, 70), CanCollide = false }, parent)
	for y = height * 0.35, height * 0.8, height * 0.22 do
		part({ Size = Vector3.new(1.6, 2.6, 0.4), CFrame = CFrame.new(pos + Vector3.new(0, y, -radius)), Color = Color3.fromRGB(255, 220, 120), Material = Enum.Material.Neon }, parent)
	end
end

local function castle(parent, pos, facing)
	local cf = CFrame.lookAt(pos, pos + facing)
	local W, D, H = 60, 40, 22
	-- remparts
	for _, side in ipairs({ { 0, -D / 2, W, 0 }, { 0, D / 2, W, 0 }, { -W / 2, 0, D, 90 }, { W / 2, 0, D, 90 } }) do
		local wcf = cf * CFrame.new(side[1], 0, side[2]) * CFrame.Angles(0, math.rad(side[4]), 0)
		if side[2] == -D / 2 then
			-- facade avec porte
			for _, x in ipairs({ -W / 2 + (W / 2 - 7) / 2, W / 2 - (W / 2 - 7) / 2 }) do
				part({ Size = Vector3.new(W / 2 - 7, H, 4), CFrame = wcf * CFrame.new(x, H / 2, 0), Color = ROYAL }, parent)
			end
			part({ Size = Vector3.new(14, H - 14, 4), CFrame = wcf * CFrame.new(0, 14 + (H - 14) / 2, 0), Color = ROYAL }, parent)
			part({ Size = Vector3.new(12, 13, 1), CFrame = wcf * CFrame.new(0, 6.5, 1.5), Color = Color3.fromRGB(120, 75, 45), Material = Enum.Material.WoodPlanks }, parent)
			sign(parent, wcf * CFrame.new(0, 17, -2.3) * CFrame.Angles(0, math.pi, 0), Vector3.new(26, 4, 0.5), &quot;PET KINGDOM&quot;, Config.Colors.Gold, Color3.fromRGB(120, 40, 160))
		else
			part({ Size = Vector3.new(side[3], H, 4), CFrame = wcf * CFrame.new(0, H / 2, 0), Color = ROYAL }, parent)
		end
		for t = -side[3] / 2 + 2, side[3] / 2 - 2, 4 do
			part({ Size = Vector3.new(2, 2.4, 4.4), CFrame = wcf * CFrame.new(t, H + 1.2, 0), Color = ROYAL }, parent)
		end
	end
	for _, o in ipairs({ Vector3.new(-W / 2, 0, -D / 2), Vector3.new(W / 2, 0, -D / 2), Vector3.new(-W / 2, 0, D / 2), Vector3.new(W / 2, 0, D / 2) }) do
		tower(parent, (cf * CFrame.new(o)).Position, 6, H + 10)
	end
	-- donjon central
	tower(parent, (cf * CFrame.new(0, 0, 4)).Position, 11, H + 26, Color3.fromRGB(230, 60, 90))
	avoidCircle(pos, 46)
end

local function topiary(parent, pos)
	part({ Size = Vector3.new(3, 2, 3), CFrame = CFrame.new(pos + Vector3.new(0, 1, 0)), Color = Color3.fromRGB(220, 120, 80) }, parent)
	cylinder(CFrame.new(pos + Vector3.new(0, 3.5, 0)), 3, 0.3, Kit.WOOD_DARK, parent)
	ball(CFrame.new(pos + Vector3.new(0, 6, 0)), 4.5, Color3.fromRGB(70, 170, 70), parent, Enum.Material.Grass)
	ball(CFrame.new(pos + Vector3.new(0, 9, 0)), 3, Color3.fromRGB(80, 185, 75), parent, Enum.Material.Grass)
	avoidCircle(pos, 3)
end

local function banner(parent, pos, color)
	cylinder(CFrame.new(pos + Vector3.new(0, 7, 0)), 14, 0.35, Config.Colors.Gold, parent, Enum.Material.Metal)
	part({ Size = Vector3.new(4, 0.3, 0.3), CFrame = CFrame.new(pos + Vector3.new(0, 13.5, 0)), Color = Config.Colors.Gold }, parent)
	part({ Size = Vector3.new(3.6, 6, 0.2), CFrame = CFrame.new(pos + Vector3.new(0, 10.4, 0)), Color = color, CanCollide = false }, parent)
	wedge({ Size = Vector3.new(0.2, 1.5, 1.8), CFrame = CFrame.new(pos + Vector3.new(-0.9, 6.65, 0)) * CFrame.Angles(math.rad(180), math.rad(90), 0), Color = color, CanCollide = false }, parent)
	wedge({ Size = Vector3.new(0.2, 1.5, 1.8), CFrame = CFrame.new(pos + Vector3.new(0.9, 6.65, 0)) * CFrame.Angles(math.rad(180), math.rad(-90), 0), Color = color, CanCollide = false }, parent)
	ball(CFrame.new(pos + Vector3.new(0, 10.6, -0.2)), 1.4, Config.Colors.Gold, parent, Enum.Material.Neon)
	avoidCircle(pos, 2)
end

function MapZones.Royaume(folder, zone)
	local c = zone.center
	local half = zone.size / 2
	-- on arrive par le sud (+Z) ; chateau au nord, tapis rouge jusqu'a sa porte
	local castlePos = c + Vector3.new(0, 0, -105)
	castle(folder, castlePos, Vector3.new(0, 0, 1))
	local z0, z1 = half, -84
	part({ Size = Vector3.new(10, 0.25, z0 - z1), CFrame = CFrame.new(c + Vector3.new(0, 0.15, (z0 + z1) / 2)), Color = Color3.fromRGB(210, 40, 60), CanCollide = false }, folder)
	for _, x in ipairs({ -5.3, 5.3 }) do
		part({ Size = Vector3.new(0.6, 0.3, z0 - z1), CFrame = CFrame.new(c + Vector3.new(x, 0.16, (z0 + z1) / 2)), Color = Config.Colors.Gold, CanCollide = false }, folder)
	end
	local n = 0
	for z = half - 30, -70, -22 do
		n += 1
		for _, x in ipairs({ -12, 12 }) do
			banner(folder, c + Vector3.new(x, 0, z), n % 2 == 0 and Color3.fromRGB(120, 60, 200) or Color3.fromRGB(220, 50, 80))
		end
	end
	-- statues dorees de pets
	for k, p in ipairs({ Vector3.new(-40, 0, 40), Vector3.new(40, 0, 40), Vector3.new(-45, 0, -30), Vector3.new(45, 0, -30) }) do
		Kit.statue(folder, c + p, k % 2 == 0 and &quot;egg&quot; or &quot;paw&quot;)
	end
	-- fontaine royale doree (le tapis passe autour)
	local f = c + Vector3.new(0, 0, 10)
	cylinder(CFrame.new(f + Vector3.new(0, 1, 0)), 2, 13, ROYAL, folder, Enum.Material.Marble)
	local w = cylinder(CFrame.new(f + Vector3.new(0, 1.8, 0)), 0.6, 12, Kit.WATER, folder, Enum.Material.Glass)
	w.Transparency = 0.2
	w.CanCollide = false
	cylinder(CFrame.new(f + Vector3.new(0, 5, 0)), 6, 2, Config.Colors.Gold, folder, Enum.Material.Metal)
	cylinder(CFrame.new(f + Vector3.new(0, 8.3, 0)), 0.8, 6, Config.Colors.Gold, folder, Enum.Material.Metal)
	local crown = f + Vector3.new(0, 9.5, 0)
	cylinder(CFrame.new(crown + Vector3.new(0, 1, 0)), 2, 2.6, Config.Colors.Gold, folder, Enum.Material.Neon)
	for k = 1, 5 do
		local a = k / 5 * math.pi * 2
		ball(CFrame.new(crown + Vector3.new(math.cos(a) * 2.4, 2.6, math.sin(a) * 2.4)), 1.2, Color3.fromRGB(255, 80, 120), folder, Enum.Material.Neon)
	end
	avoidCircle(f, 16)
	-- jardins a la francaise de chaque cote
	for _, sx in ipairs({ -1, 1 }) do
		local g = c + Vector3.new(sx * 90, 0, 40)
		Kit.hedge(folder, g + Vector3.new(-20, 0, -30), g + Vector3.new(-20, 0, 30))
		Kit.hedge(folder, g + Vector3.new(20, 0, -30), g + Vector3.new(20, 0, 30))
		Kit.hedge(folder, g + Vector3.new(-20, 0, -30), g + Vector3.new(20, 0, -30))
		Kit.flowerBed(folder, g, 9)
		for _, z in ipairs({ -20, 20 }) do
			topiary(folder, g + Vector3.new(0, 0, z))
		end
		Kit.avoidSegment(g + Vector3.new(0, 0, -32), g + Vector3.new(0, 0, 32), 22)
	end
	Kit.scatter(zone, 16, 30, 200, function(pos)
		topiary(folder, pos)
	end, 3)
	Kit.scatter(zone, 14, 30, 200, function(pos)
		Kit.roundTree(folder, pos, R(1, 1.4))
		avoidCircle(pos, 5)
	end, 4)
	Kit.scatter(zone, 14, 20, 200, function(pos)
		Kit.flowerPatch(folder, pos)
	end)
	ambient(folder, zone, { color = Color3.fromRGB(255, 225, 120), rate = 30 })
end

-- MONDE DE LAVE ----------------------------------------------------------------------------------

local function volcano(parent, pos)
	local rock = Color3.fromRGB(70, 55, 55)
	for i = 0, 5 do
		local r = 36 - i * 5.5
		cylinder(CFrame.new(pos + Vector3.new(0, i * 7 + 3.5, 0)), 7.05, r, rock:Lerp(Color3.fromRGB(110, 80, 70), i / 6), parent)
	end
	local crater = cylinder(CFrame.new(pos + Vector3.new(0, 42.2, 0)), 0.6, 7, Color3.fromRGB(255, 110, 30), parent, Enum.Material.Neon)
	local fire = Instance.new(&quot;Fire&quot;)
	fire.Size = 14
	fire.Heat = 20
	fire.Color = Color3.fromRGB(255, 120, 40)
	fire.SecondaryColor = Color3.fromRGB(255, 220, 90)
	fire.Parent = crater
	local smoke = Instance.new(&quot;Smoke&quot;)
	smoke.Size = 18
	smoke.RiseVelocity = 12
	smoke.Color = Color3.fromRGB(70, 60, 60)
	smoke.Opacity = 0.25
	smoke.Parent = crater
	for k = 1, 5 do
		local a = k * 1.25
		part({ Size = Vector3.new(3, 30, 1), CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * 20, 22, math.sin(a) * 20)) * CFrame.Angles(0, -a, math.rad(30)), Color = Color3.fromRGB(255, 120, 30), Material = Enum.Material.Neon, CanCollide = false }, parent)
	end
	avoidCircle(pos, 40)
end

local function obsidianSpike(parent, pos, scale)
	for k = 1, 3 do
		local h = R(4, 10) * scale
		part({ Size = Vector3.new(1.6 * scale, h, 1.6 * scale), CFrame = CFrame.new(pos) * CFrame.Angles(R(-0.35, 0.35), R(0, 6.28), R(-0.35, 0.35)) * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, math.rad(45), 0), Color = Color3.fromRGB(35, 25, 45), Material = Enum.Material.Glass, Reflectance = 0.3 }, parent)
	end
	avoidCircle(pos, 3 * scale)
end

local function deadTree(parent, pos, scale)
	cylinder(CFrame.new(pos + Vector3.new(0, 5 * scale, 0)), 10 * scale, 0.8 * scale, Color3.fromRGB(45, 35, 35), parent, Enum.Material.Wood)
	for k = 1, 3 do
		local a = k * 2.1
		part({ Size = Vector3.new(0.5, 4, 0.5) * scale, CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * 1.4, 8.5, math.sin(a) * 1.4) * scale) * CFrame.Angles(math.sin(a) * 0.8, 0, math.cos(a) * 0.8), Color = Color3.fromRGB(45, 35, 35), Material = Enum.Material.Wood }, parent)
	end
	ball(CFrame.new(pos + Vector3.new(0, 10.2 * scale, 0)), 0.8 * scale, Color3.fromRGB(255, 140, 50), parent, Enum.Material.Neon)
	avoidCircle(pos, 3)
end

function MapZones.Lava(folder, zone)
	local c = zone.center
	volcano(folder, c + Vector3.new(95, 0, -95))
	Kit.river(folder, c + Vector3.new(-150, 0, -70), c + Vector3.new(60, 0, -60), 12, Color3.fromRGB(60, 45, 45))
	Kit.river(folder, c + Vector3.new(-40, 0, 160), c + Vector3.new(-60, 0, 40), 10, Color3.fromRGB(60, 45, 45))
	for _, r in ipairs(folder:GetChildren()) do
		if r.Name == &quot;River&quot; then
			r.Color = Color3.fromRGB(255, 110, 30)
			r.Material = Enum.Material.Neon
			r.Transparency = 0
		end
	end
	Kit.footbridge(folder, c + Vector3.new(0, 0, -62), Vector3.new(0, 0, 1), 14, 20)
	for k = 1, 4 do
		local p = c + Vector3.new(R(-120, 120), 0, R(-120, 120))
		if Kit.isFree(p, 10) then
			local pool = cylinder(CFrame.new(p + Vector3.new(0, 0.15, 0)), 0.3, R(6, 10), Color3.fromRGB(255, 120, 30), folder, Enum.Material.Neon)
			pool.CanCollide = false
			cylinder(CFrame.new(p + Vector3.new(0, 0.1, 0)), 0.3, pool.Size.Y / 2 + 2, Color3.fromRGB(50, 40, 40), folder).CanCollide = false
			avoidCircle(p, pool.Size.Y / 2 + 4)
		end
	end
	Kit.scatter(zone, 28, 20, 200, function(pos)
		obsidianSpike(folder, pos, R(0.7, 1.5))
	end, 2)
	Kit.scatter(zone, 24, 20, 200, function(pos)
		deadTree(folder, pos, R(0.8, 1.3))
	end, 3)
	Kit.scatter(zone, 20, 20, 200, function(pos)
		Kit.rock(folder, pos, R(0.8, 2), Color3.fromRGB(80, 65, 65))
	end)
	ambient(folder, zone, { color = Color3.fromRGB(255, 140, 50), rate = 50, speed = NumberRange.new(2, 5), height = 25 })
end

-- MONDE CELESTE ----------------------------------------------------------------------------------

function MapZones.Celestial(folder, zone)
	MapZones.Royaume(folder, zone)
	local c = zone.center
	for k = 1, 14 do
		local a = k / 14 * math.pi * 2
		floatingRock(folder, c + Vector3.new(math.cos(a) * R(110, 150), R(25, 55), math.sin(a) * R(110, 150)), R(0.8, 1.5))
	end
	Kit.scatter(zone, 14, 20, 200, function(pos)
		glowCrystal(folder, pos, R(0.7, 1.2), Color3.fromRGB(255, 230, 140))
	end, 2)
	ambient(folder, zone, { color = Color3.fromRGB(255, 250, 220), rate = 40, height = 30 })
end

-- GROTTE DE CRISTAL ------------------------------------------------------------------------------

function MapZones.Cave(folder, zone)
	MapZones.Mystique(folder, zone)
	Kit.scatter(zone, 26, 20, 200, function(pos)
		glowCrystal(folder, pos, R(1, 2.2), MYST[rng:NextInteger(1, #MYST)])
	end, 3)
end


MapZones.Forest = MapZones.Foret
MapZones.Frozen = MapZones.Neige

return MapZones
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">ProgressService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Progression : ameliorations (forge), boutique (potions, sac, avantages), renaissance, mondes
-- (deblocage, voyage, portails), recompenses quotidiennes, quetes du jour et succes, parametres.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local ProximityPromptService = game:GetService(&quot;ProximityPromptService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local F = require(ReplicatedStorage.Shared.Formulas)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Actions = require(script.Parent.Actions)
local WorldBuilder = require(script.Parent.WorldBuilder)
local RelicService = require(script.Parent.RelicService)

local ProgressService = {}

local function notify(p, t, k)
	Actions.Notify(p, t, k)
end

local function shopPrice(item, data)
	if item.kind == &quot;potion&quot; and item.scale then
		return math.floor(item.price * F.BestWorld(data).mult ^ 0.85)
	elseif item.kind == &quot;inventory&quot; then
		return math.floor(item.price * item.growth ^ (data.BagLevel or 0))
	end
	return item.price
end
ProgressService.ShopPrice = shopPrice

-- Quetes du jour : 3 quetes tirees selon le jour et le joueur ; progression = stat - stat au debut
local function ensureQuests(player, data)
	local day = os.time() // 86400
	if data.Quests.Day == day and #data.Quests.List &gt; 0 then
		return
	end
	local rng = Random.new(day * 7919 + player.UserId % 100000)
	local pool = table.clone(Config.DailyQuestPool)
	local list = {}
	for _ = 1, Config.DailyQuestCount do
		local q = table.remove(pool, rng:NextInteger(1, #pool))
		table.insert(list, { id = q.id, claimed = false })
	end
	data.Quests = { Day = day, List = list, Base = table.clone(data.Stats) }
end
ProgressService.EnsureQuests = ensureQuests

local function questDef(id)
	for _, q in ipairs(Config.DailyQuestPool) do
		if q.id == id then
			return q
		end
	end
end

function ProgressService.QuestGoal(q, data)
	if q.worldScaled then
		return math.floor(q.goal * F.BestWorld(data).mult)
	end
	return q.goal
end

local function milestoneValue(data, stat)
	if stat == &quot;Equipped&quot; then
		return #data.Equipped
	elseif stat == &quot;Worlds&quot; then
		local n = 0
		for _ in pairs(data.Worlds) do
			n += 1
		end
		return n
	elseif stat == &quot;Discovered&quot; then
		return DataService.Discovered(data)
	elseif stat == &quot;Rebirths&quot; then
		return data.Rebirths
	end
	return data.Stats[stat] or 0
end
ProgressService.MilestoneValue = milestoneValue

local function teleport(player, worldId)
	local cf = WorldBuilder.Spawn(worldId)
	local hrp = player.Character and player.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if cf and hrp then
		player:SetAttribute(&quot;Target&quot;, nil)
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.CFrame = cf
		Remotes.FX:FireClient(player, &quot;Teleport&quot;, { world = worldId })
	end
end
ProgressService.Teleport = teleport

function ProgressService.Init()
	Actions.Register(&quot;buyUpgrade&quot;, function(player, data, id)
		local u = F.UpgradeDef(id)
		if not u then
			return
		end
		local lvl = data.Upgrades[id] or 0
		if lvl &gt;= u.max then
			return notify(player, u.name .. &quot; est au niveau maximum.&quot;, &quot;info&quot;)
		end
		local cost = F.UpgradeCost(id, lvl)
		if data.Coins &lt; cost then
			return notify(player, &quot;Il te manque &quot; .. F.Format(cost - data.Coins) .. &quot; pieces.&quot;, &quot;danger&quot;)
		end
		data.Coins -= cost
		data.Upgrades[id] = lvl + 1
		data.Stats.Upgrades += 1
		Remotes.FX:FireClient(player, &quot;Upgrade&quot;, { id = id, level = lvl + 1 })
	end)

	Actions.Register(&quot;buyShop&quot;, function(player, data, id)
		local item
		for _, it in ipairs(Config.Shop) do
			if it.id == id then
				item = it
			end
		end
		if not item then
			return
		end
		if item.kind == &quot;perk&quot; and data.Perks[id] then
			return notify(player, &quot;Tu possedes deja &quot; .. item.name .. &quot;.&quot;, &quot;info&quot;)
		end
		local price = shopPrice(item, data)
		if data.Coins &lt; price then
			return notify(player, &quot;Il te manque &quot; .. F.Format(price - data.Coins) .. &quot; pieces.&quot;, &quot;danger&quot;)
		end
		data.Coins -= price
		if item.kind == &quot;potion&quot; then
			local now = os.time()
			data.Boosts[item.boost] = math.max(data.Boosts[item.boost] or 0, now) + item.duration
		elseif item.kind == &quot;inventory&quot; then
			data.BagBonus += item.amount
			data.BagLevel = (data.BagLevel or 0) + 1
		elseif item.kind == &quot;perk&quot; then
			data.Perks[id] = true
		end
		Remotes.FX:FireClient(player, &quot;Purchase&quot;, { name = item.name })
	end)

	Actions.Register(&quot;rebirth&quot;, function(player, data)
		local cost = F.RebirthCost(data.Rebirths)
		if data.Coins &lt; cost then
			return notify(player, &quot;Il te faut &quot; .. F.Format(cost) .. &quot; pieces pour renaitre.&quot;, &quot;danger&quot;)
		end
		data.Rebirths += 1
		data.Coins = 0
		local keep = {}
		for _, u in ipairs(Config.Upgrades) do
			if u.keepOnRebirth then
				keep[u.id] = data.Upgrades[u.id]
			end
		end
		data.Upgrades = keep
		Remotes.FX:FireClient(player, &quot;Rebirth&quot;, { count = data.Rebirths })
		Remotes.Notify:FireAllClients(player.DisplayName .. &quot; a atteint la renaissance &quot; .. data.Rebirths .. &quot; !&quot;, &quot;gold&quot;)
	end)

	Actions.Register(&quot;unlockWorld&quot;, function(player, data, id)
		local w = Config.WorldById[id]
		if not w or data.Worlds[id] then
			return
		end
		local prev = Config.Worlds[w.index - 1]
		if prev and not data.Worlds[prev.id] then
			return notify(player, &quot;Debloque d'abord &quot; .. prev.name .. &quot;.&quot;, &quot;danger&quot;)
		end
		if data.Coins &lt; w.price then
			return notify(player, &quot;Il te manque &quot; .. F.Format(w.price - data.Coins) .. &quot; pieces.&quot;, &quot;danger&quot;)
		end
		data.Coins -= w.price
		data.Worlds[id] = true
		Remotes.FX:FireClient(player, &quot;WorldUnlock&quot;, { world = id })
		Remotes.Notify:FireAllClients(player.DisplayName .. &quot; a debloque &quot; .. w.name .. &quot; !&quot;, &quot;gold&quot;)
		task.delay(1.2, teleport, player, id)
	end)

	Actions.Register(&quot;teleport&quot;, function(player, data, id)
		if Config.WorldById[id] and data.Worlds[id] then
			teleport(player, id)
		end
		return true
	end)

	Actions.Register(&quot;daily&quot;, function(player, data)
		local since = os.time() - data.LastDaily
		if since &lt; Config.Daily.Cooldown then
			return notify(player, &quot;Prochaine recompense dans &quot; .. F.Time(Config.Daily.Cooldown - since), &quot;info&quot;)
		end
		data.DailyStreak = (since &lt; Config.Daily.Reset) and (data.DailyStreak % #Config.Daily.Days) + 1 or 1
		data.LastDaily = os.time()
		local day = Config.Daily.Days[data.DailyStreak]
		local mult = F.BestWorld(data).mult
		local text = {}
		if day.coins then
			local c = math.floor(day.coins * mult)
			DataService.AddCoins(player, c)
			table.insert(text, F.Format(c) .. &quot; pieces&quot;)
		end
		if day.potion then
			for _, it in ipairs(Config.Shop) do
				if it.id == day.potion then
					data.Boosts[it.boost] = math.max(data.Boosts[it.boost] or 0, os.time()) + it.duration
					table.insert(text, it.name)
				end
			end
		end
		if day.crate then
			local best = F.BestWorld(data)
			local got = 0
			for _ = 1, day.crate do
				local odds = F.CrateOdds(best.id, F.Luck(data) * 1.5)
				local r = math.random() * 100
				local rarity = odds[1].rarity
				for _, e in ipairs(odds) do
					r -= e.pct
					if r &lt;= 0 then
						rarity = e.rarity
						break
					end
				end
				local pool = {}
				for _, rel in ipairs(Config.Relics) do
					if rel.world == best.id and rel.rarity == rarity and not rel.boss then
						table.insert(pool, rel.id)
					end
				end
				if #pool &gt; 0 and DataService.GiveRelic(player, pool[math.random(#pool)]) then
					got += 1
				end
			end
			table.insert(text, got .. &quot; relique(s)&quot;)
		end
		Remotes.FX:FireClient(player, &quot;Daily&quot;, { day = data.DailyStreak, text = table.concat(text, &quot; + &quot;) })
	end)

	Actions.Register(&quot;claimQuest&quot;, function(player, data, index)
		ensureQuests(player, data)
		local q = data.Quests.List[tonumber(index) or 0]
		local def = q and questDef(q.id)
		if not def or q.claimed then
			return
		end
		local progress = (data.Stats[def.stat] or 0) - (data.Quests.Base[def.stat] or 0)
		if progress &lt; ProgressService.QuestGoal(def, data) then
			return notify(player, &quot;Quete pas encore terminee.&quot;, &quot;info&quot;)
		end
		q.claimed = true
		local coins = math.floor(Config.QuestRewardBase * def.reward * F.BestWorld(data).mult)
		DataService.AddCoins(player, coins)
		Remotes.FX:FireClient(player, &quot;Reward&quot;, { title = &quot;Quete terminee !&quot;, text = &quot;+&quot; .. F.Format(coins) .. &quot; pieces&quot; })
	end)

	Actions.Register(&quot;claimMilestone&quot;, function(player, data, id)
		for _, m in ipairs(Config.Milestones) do
			if m.id == id and not data.Milestones[id] and milestoneValue(data, m.stat) &gt;= m.goal then
				data.Milestones[id] = true
				DataService.AddCoins(player, m.coins)
				Remotes.FX:FireClient(player, &quot;Reward&quot;, { title = &quot;Succes debloque !&quot;, text = &quot;+&quot; .. F.Format(m.coins) .. &quot; pieces&quot; })
			end
		end
	end)

	Actions.Register(&quot;settings&quot;, function(player, data, s)
		if type(s) ~= &quot;table&quot; then
			return
		end
		for k, v in pairs(s) do
			if data.Settings[k] ~= nil and type(v) == type(data.Settings[k]) then
				data.Settings[k] = type(v) == &quot;number&quot; and math.clamp(v, 0, 1) or v
			end
		end
		if s.AutoHit ~= nil and type(s.AutoHit) == &quot;boolean&quot; then
			data.Settings.AutoHit = s.AutoHit
		end
	end)

	Actions.Register(&quot;target&quot;, function(player, data, model)
		local Targets = require(script.Parent.Targets)
		if typeof(model) == &quot;Instance&quot; and model:IsA(&quot;Model&quot;) then
			Targets.SetTarget(player, model)
		else
			player:SetAttribute(&quot;Target&quot;, nil)
		end
		return true
	end)

	-- portails : voyage si le monde est debloque (sinon le client ouvre le menu Mondes)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		local target = prompt:GetAttribute(&quot;Target&quot;)
		if target and prompt:GetAttribute(&quot;Panel&quot;) == &quot;Worlds&quot; then
			local data = DataService.Get(player)
			if data and data.Worlds[target] then
				teleport(player, target)
			end
		end
	end)

	DataService.Loaded:Connect(function(player, data)
		ensureQuests(player, data)
		player.CharacterAdded:Connect(function()
			task.wait(0.2)
			DataService.Sync(player)
		end)
	end)
	-- renouvellement des quetes a minuit (UTC)
	task.spawn(function()
		while true do
			task.wait(60)
			for _, p in ipairs(Players:GetPlayers()) do
				local data = DataService.Get(p)
				if data and data.Quests.Day ~= os.time() // 86400 then
					ensureQuests(p, data)
					DataService.Sync(p)
				end
			end
		end
	end)
end

return ProgressService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">QueryService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Requetes client -&gt; serveur avec reponse (RemoteFunction) : classements globaux.
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)

local QueryService = {}

function QueryService.Init()
	local last = {}
	Remotes.Query.OnServerInvoke = function(player, kind, arg)
		if last[player] and os.clock() - last[player] &lt; 0.5 then
			return nil
		end
		last[player] = os.clock()
		if kind == &quot;top&quot; and (arg == &quot;Power&quot; or arg == &quot;Rebirths&quot; or arg == &quot;Index&quot;) then
			return DataService.GetTop(arg)
		end
		return nil
	end
	game:GetService(&quot;Players&quot;).PlayerRemoving:Connect(function(p)
		last[p] = nil
	end)
end

return QueryService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">RelicService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Caisses et inventaire de reliques : ouverture (tirage serveur avec chance), equipement,
-- equipement automatique des meilleures, verrouillage, recyclage contre des pieces.

local CollectionService = game:GetService(&quot;CollectionService&quot;)
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local F = require(ReplicatedStorage.Shared.Formulas)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Actions = require(script.Parent.Actions)

local RelicService = {}

local function isEquipped(data, uid)
	for i, u in ipairs(data.Equipped) do
		if u == uid then
			return i
		end
	end
	return nil
end
RelicService.IsEquipped = isEquipped

function RelicService.Unequip(data, uid)
	local i = isEquipped(data, uid)
	if i then
		table.remove(data.Equipped, i)
	end
end

local function powerOf(data, uid)
	local item = data.Relics[tostring(uid)]
	local def = item and Config.RelicById[item.id]
	return def and def.power or 0
end

function RelicService.EquipBest(data)
	local all = {}
	for k in pairs(data.Relics) do
		table.insert(all, tonumber(k))
	end
	table.sort(all, function(a, b)
		return powerOf(data, a) &gt; powerOf(data, b)
	end)
	data.Equipped = {}
	for i = 1, math.min(F.Slots(data), #all) do
		table.insert(data.Equipped, all[i])
	end
end

-- Tirage d'une relique dans la caisse d'un monde
local function roll(worldId, luck)
	local odds, total = F.CrateOdds(worldId, luck)
	local r = math.random() * total
	local rarity = odds[#odds].rarity
	for _, e in ipairs(odds) do
		r -= e.weight
		if r &lt;= 0 then
			rarity = e.rarity
			break
		end
	end
	local pool = {}
	for _, rel in ipairs(Config.Relics) do
		if rel.world == worldId and rel.rarity == rarity and not rel.boss then
			table.insert(pool, rel.id)
		end
	end
	return pool[math.random(#pool)]
end

local function nearCrate(player, worldId)
	local hrp = player.Character and player.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
	local pos = require(script.Parent.WorldBuilder).Crate(worldId)
	return hrp ~= nil and pos ~= nil and (Vector3.new(pos.X, hrp.Position.Y, pos.Z) - hrp.Position).Magnitude &lt;= 30
end

local function openCrate(player, data, worldId, count)
	count = (count == 3) and 3 or 1
	local crate = Config.Crates[worldId]
	if not crate or not data.Worlds[worldId] then
		return
	end
	if count == 3 and not data.Perks.TripleOpen then
		return Actions.Notify(player, &quot;Achete l'ouverture x3 dans la Boutique !&quot;, &quot;danger&quot;)
	end
	if not nearCrate(player, worldId) then
		return Actions.Notify(player, &quot;Approche-toi de la caisse pour l'ouvrir.&quot;, &quot;danger&quot;)
	end
	local cost = crate.price * count
	if data.Coins &lt; cost then
		return Actions.Notify(player, &quot;Il te manque &quot; .. F.Format(cost - data.Coins) .. &quot; pieces.&quot;, &quot;danger&quot;)
	end
	if DataService.Count(data) + count &gt; F.InventoryCap(data) then
		return Actions.Notify(player, &quot;Inventaire plein ! Recycle des reliques ou agrandis ton sac.&quot;, &quot;danger&quot;)
	end
	data.Coins -= cost
	local luck = F.Luck(data)
	local results = {}
	for _ = 1, count do
		local id = roll(worldId, luck)
		local uid, first = DataService.GiveRelic(player, id)
		data.Stats.Crates += 1
		table.insert(results, { uid = uid, id = id, first = first })
		local def = Config.RelicById[id]
		if Config.RarityById[def.rarity].index &gt;= 5 then
			Remotes.Notify:FireAllClients(player.DisplayName .. &quot; a obtenu &quot; .. def.name .. &quot; (&quot; .. Config.RarityById[def.rarity].name .. &quot;) !&quot;, &quot;gold&quot;)
		end
		-- equipement automatique si un emplacement est libre
		if #data.Equipped &lt; F.Slots(data) then
			table.insert(data.Equipped, uid)
		end
	end
	Remotes.FX:FireClient(player, &quot;CrateOpen&quot;, { world = worldId, results = results })
end

local function recycleValue(def)
	local crate = Config.Crates[def.world]
	return math.floor(crate.price * 0.15 * Config.RarityById[def.rarity].index)
end
RelicService.RecycleValue = recycleValue

function RelicService.Init()
	Actions.Register(&quot;openCrate&quot;, openCrate)
	Actions.Register(&quot;equip&quot;, function(player, data, uid)
		uid = tonumber(uid)
		if not uid or not data.Relics[tostring(uid)] or isEquipped(data, uid) then
			return
		end
		if #data.Equipped &gt;= F.Slots(data) then
			return Actions.Notify(player, &quot;Tous tes emplacements sont pleins (ameliore-les a la Forge).&quot;, &quot;danger&quot;)
		end
		table.insert(data.Equipped, uid)
	end)
	Actions.Register(&quot;unequip&quot;, function(player, data, uid)
		RelicService.Unequip(data, tonumber(uid))
	end)
	Actions.Register(&quot;equipBest&quot;, function(player, data)
		RelicService.EquipBest(data)
	end)
	Actions.Register(&quot;lock&quot;, function(player, data, uid)
		local item = data.Relics[tostring(tonumber(uid))]
		if item then
			item.locked = not item.locked or nil
		end
	end)
	Actions.Register(&quot;recycle&quot;, function(player, data, list)
		if type(list) ~= &quot;table&quot; then
			return
		end
		local total, n = 0, 0
		for i, uid in ipairs(list) do
			if i &gt; 100 then
				break
			end
			uid = tonumber(uid)
			local item = uid and data.Relics[tostring(uid)]
			if item and not item.locked then
				RelicService.Unequip(data, uid)
				data.Relics[tostring(uid)] = nil
				total += recycleValue(Config.RelicById[item.id])
				n += 1
			end
		end
		if n &gt; 0 then
			DataService.AddCoins(player, total)
			Actions.Notify(player, n .. &quot; relique(s) recyclee(s) : +&quot; .. F.Format(total) .. &quot; pieces&quot;, &quot;good&quot;)
		end
	end)
end

return RelicService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Targets</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Cibles attaquables (tresors et boss). Le joueur choisit une cible (clic / toucher, ou frappe
-- automatique) ; ses reliques l'attaquent a chaque intervalle avec toute sa puissance.
-- Les degats sont calcules et appliques uniquement par le serveur.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local F = require(ReplicatedStorage.Shared.Formulas)
local DataService = require(script.Parent.DataService)

local Targets = {}
local entities = {} -- [Model] = { hp, maxHp, world, onDeath(entity, hits), hits = {[player]=dmg}, kind }
local folder

function Targets.Folder()
	return folder
end

function Targets.Register(model, info)
	info.hits = {}
	info.hp = info.maxHp
	entities[model] = info
	model:SetAttribute(&quot;HP&quot;, info.hp)
	model:SetAttribute(&quot;MaxHP&quot;, info.maxHp)
	model:SetAttribute(&quot;Kind&quot;, info.kind)
	model:SetAttribute(&quot;World&quot;, info.world)
	local hitbox = model.PrimaryPart
	local click = Instance.new(&quot;ClickDetector&quot;)
	click.MaxActivationDistance = Config.MaxTargetDistance
	click.Parent = hitbox
	click.MouseClick:Connect(function(player)
		Targets.SetTarget(player, model)
	end)
	model.Parent = folder
end

function Targets.Unregister(model)
	entities[model] = nil
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute(&quot;Target&quot;) == model.Name then
			p:SetAttribute(&quot;Target&quot;, nil)
		end
	end
end

function Targets.Get(model)
	return entities[model]
end

function Targets.SetTarget(player, model)
	if not model or not entities[model] then
		player:SetAttribute(&quot;Target&quot;, nil)
		return
	end
	if player:GetAttribute(&quot;Target&quot;) == model.Name then
		player:SetAttribute(&quot;Target&quot;, nil) -- deuxieme clic : on rappelle les reliques
	else
		player:SetAttribute(&quot;Target&quot;, model.Name)
	end
end

local function hrpOf(player)
	local c = player.Character
	return c and c:FindFirstChild(&quot;HumanoidRootPart&quot;)
end

-- Frappe automatique (avantage achete) : tresor le plus proche
local function autoTarget(player, hrp)
	local best, bd
	for m, info in pairs(entities) do
		if info.kind == &quot;treasure&quot; and m.PrimaryPart then
			local d = (m.PrimaryPart.Position - hrp.Position).Magnitude
			if d &lt; 60 and (not bd or d &lt; bd) then
				best, bd = m, d
			end
		end
	end
	if best then
		player:SetAttribute(&quot;Target&quot;, best.Name)
	end
end

local function tick()
	local now = os.time()
	for _, player in ipairs(Players:GetPlayers()) do
		local data = DataService.Get(player)
		local hrp = hrpOf(player)
		if data and hrp then
			local name = player:GetAttribute(&quot;Target&quot;)
			if not name and data.Perks.AutoHit and data.Settings.AutoHit ~= false then
				autoTarget(player, hrp)
				name = player:GetAttribute(&quot;Target&quot;)
			end
			if name then
				local model = folder:FindFirstChild(name)
				local info = model and entities[model]
				if not info or not model.PrimaryPart or (model.PrimaryPart.Position - hrp.Position).Magnitude &gt; Config.MaxTargetDistance then
					player:SetAttribute(&quot;Target&quot;, nil)
				elseif info.hp &gt; 0 then
					local dmg = F.Power(data, now)
					info.hp -= dmg
					info.hits[player] = (info.hits[player] or 0) + dmg
					if info.onHit then
						info.onHit(model, info, player, dmg)
					end
					if info.hp &lt;= 0 then
						info.hp = 0
						model:SetAttribute(&quot;HP&quot;, 0)
						Targets.Unregister(model)
						task.spawn(info.onDeath, model, info)
					else
						model:SetAttribute(&quot;HP&quot;, info.hp)
					end
				end
			end
		end
	end
end

function Targets.Init()
	folder = Instance.new(&quot;Folder&quot;)
	folder.Name = &quot;Targets&quot;
	folder.Parent = workspace
	task.spawn(function()
		while true do
			task.wait(Config.HitInterval)
			local ok, err = pcall(tick)
			if not ok then
				warn(&quot;[RelicRush] Targets : &quot; .. tostring(err))
			end
		end
	end)
end

return Targets
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">TradeService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Echanges securises entre joueurs.
-- Demande -&gt; acceptation -&gt; chacun ajoute jusqu'a 9 reliques -&gt; les deux valident -&gt; compte a
-- rebours -&gt; le serveur reverifie TOUT (propriete, verrou, place) puis echange en une fois et
-- sauvegarde immediatement les deux joueurs. Toute modification annule les validations.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local F = require(ReplicatedStorage.Shared.Formulas)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Actions = require(script.Parent.Actions)
local RelicService = require(script.Parent.RelicService)

local TradeService = {}

local requests = {} -- [target] = { [from] = os.clock() }
local sessions = {} -- [player] = session ; session = { a, b, offer = {[a]={}, [b]={}}, ready = {}, token }

local function other(s, p)
	return s.a == p and s.b or s.a
end

local function describe(s, viewer)
	local function list(p)
		local data = DataService.Get(p)
		local out = {}
		for _, uid in ipairs(s.offer[p]) do
			local item = data and data.Relics[tostring(uid)]
			if item then
				table.insert(out, { uid = uid, id = item.id })
			end
		end
		return out
	end
	local o = other(s, viewer)
	return {
		active = true,
		partner = o.DisplayName,
		partnerId = o.UserId,
		mine = list(viewer),
		theirs = list(o),
		myReady = s.ready[viewer] == true,
		theirReady = s.ready[o] == true,
		countdown = s.countdownEnd,
	}
end

local function push(s)
	for _, p in ipairs({ s.a, s.b }) do
		if p.Parent == Players then
			Remotes.Trade:FireClient(p, &quot;session&quot;, describe(s, p))
		end
	end
end

local function close(s, reason)
	for _, p in ipairs({ s.a, s.b }) do
		sessions[p] = nil
		if p.Parent == Players then
			Remotes.Trade:FireClient(p, &quot;closed&quot;, { reason = reason })
		end
	end
end

local function resetReady(s)
	s.ready = {}
	s.countdownEnd = nil
	s.token = (s.token or 0) + 1
end

local function execute(s)
	local da, db = DataService.Get(s.a), DataService.Get(s.b)
	if not (da and db) then
		return close(s, &quot;Echange annule.&quot;)
	end
	-- verification complete
	for _, pair in ipairs({ { s.a, da }, { s.b, db } }) do
		local p, data = pair[1], pair[2]
		for _, uid in ipairs(s.offer[p]) do
			local item = data.Relics[tostring(uid)]
			if not item or item.locked then
				return close(s, &quot;Echange annule : une relique n'est plus disponible.&quot;)
			end
		end
	end
	if DataService.Count(da) - #s.offer[s.a] + #s.offer[s.b] &gt; F.InventoryCap(da) or DataService.Count(db) - #s.offer[s.b] + #s.offer[s.a] &gt; F.InventoryCap(db) then
		return close(s, &quot;Echange annule : inventaire plein.&quot;)
	end
	-- transfert
	local moveAB, moveBA = {}, {}
	for _, uid in ipairs(s.offer[s.a]) do
		table.insert(moveAB, da.Relics[tostring(uid)].id)
		RelicService.Unequip(da, uid)
		da.Relics[tostring(uid)] = nil
	end
	for _, uid in ipairs(s.offer[s.b]) do
		table.insert(moveBA, db.Relics[tostring(uid)].id)
		RelicService.Unequip(db, uid)
		db.Relics[tostring(uid)] = nil
	end
	for _, id in ipairs(moveAB) do
		DataService.GiveRelic(s.b, id, true)
	end
	for _, id in ipairs(moveBA) do
		DataService.GiveRelic(s.a, id, true)
	end
	close(s, &quot;Echange reussi !&quot;)
	for _, p in ipairs({ s.a, s.b }) do
		DataService.Sync(p)
		task.spawn(DataService.Save, p)
		Remotes.FX:FireClient(p, &quot;TradeDone&quot;, {})
	end
end

function TradeService.Init()
	Actions.Register(&quot;tradeRequest&quot;, function(player, data, targetId)
		local target = Players:GetPlayerByUserId(tonumber(targetId) or 0)
		if not target or target == player or sessions[player] or sessions[target] then
			return Actions.Notify(player, &quot;Echange impossible pour le moment.&quot;, &quot;danger&quot;)
		end
		requests[target] = requests[target] or {}
		requests[target][player] = os.clock()
		Remotes.Trade:FireClient(target, &quot;request&quot;, { from = player.DisplayName, fromId = player.UserId })
		Actions.Notify(player, &quot;Demande envoyee a &quot; .. target.DisplayName, &quot;info&quot;)
		return true
	end)
	Actions.Register(&quot;tradeAccept&quot;, function(player, data, fromId)
		local from = Players:GetPlayerByUserId(tonumber(fromId) or 0)
		local t = requests[player] and from and requests[player][from]
		if not t or os.clock() - t &gt; Config.Trade.RequestTimeout or sessions[player] or sessions[from] then
			return Actions.Notify(player, &quot;Cette demande a expire.&quot;, &quot;danger&quot;)
		end
		requests[player][from] = nil
		local s = { a = from, b = player, offer = { [from] = {}, [player] = {} }, ready = {}, token = 0 }
		sessions[from] = s
		sessions[player] = s
		push(s)
		return true
	end)
	Actions.Register(&quot;tradeDecline&quot;, function(player, data, fromId)
		local from = Players:GetPlayerByUserId(tonumber(fromId) or 0)
		if requests[player] and from then
			requests[player][from] = nil
			Remotes.Notify:FireClient(from, player.DisplayName .. &quot; a refuse l'echange.&quot;, &quot;info&quot;)
		end
		return true
	end)
	Actions.Register(&quot;tradeAdd&quot;, function(player, data, uid)
		local s = sessions[player]
		uid = tonumber(uid)
		local item = uid and data.Relics[tostring(uid)]
		if not (s and item) or item.locked or table.find(s.offer[player], uid) or #s.offer[player] &gt;= Config.Trade.MaxItems then
			return true
		end
		table.insert(s.offer[player], uid)
		resetReady(s)
		push(s)
		return true
	end)
	Actions.Register(&quot;tradeRemove&quot;, function(player, data, uid)
		local s = sessions[player]
		local i = s and table.find(s.offer[player], tonumber(uid))
		if i then
			table.remove(s.offer[player], i)
			resetReady(s)
			push(s)
		end
		return true
	end)
	Actions.Register(&quot;tradeReady&quot;, function(player, data, on)
		local s = sessions[player]
		if not s then
			return true
		end
		s.ready[player] = on == true
		if s.ready[s.a] and s.ready[s.b] then
			s.token += 1
			local token = s.token
			s.countdownEnd = os.time() + Config.Trade.ConfirmTime
			push(s)
			task.delay(Config.Trade.ConfirmTime, function()
				if sessions[s.a] == s and s.token == token and s.ready[s.a] and s.ready[s.b] then
					execute(s)
				end
			end)
		else
			s.countdownEnd = nil
			s.token += 1
			push(s)
		end
		return true
	end)
	Actions.Register(&quot;tradeCancel&quot;, function(player)
		local s = sessions[player]
		if s then
			close(s, player.DisplayName .. &quot; a annule l'echange.&quot;)
		end
		return true
	end)
	Players.PlayerRemoving:Connect(function(p)
		local s = sessions[p]
		if s then
			close(s, &quot;L'autre joueur est parti.&quot;)
		end
		requests[p] = nil
	end)
end

return TradeService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">TreasureService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Tresors a detruire dans chaque monde + pieces a ramasser (aimant ameliorable).
-- Chaque participant recoit ses propres pieces en proportion de ses degats.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local F = require(ReplicatedStorage.Shared.Formulas)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Targets = require(script.Parent.Targets)
local WorldBuilder = require(script.Parent.WorldBuilder)

local TreasureService = {}

local counter = 0
local occupied = {} -- [worldId] = { [spotIndex] = true }
local coinsFolder
local coinData = {} -- [Part] = { owner, value, expires }

local function p(model, props)
	local x = Instance.new(&quot;Part&quot;)
	x.Anchored = true
	x.CanCollide = false
	x.CanQuery = false
	x.CanTouch = false
	x.TopSurface = Enum.SurfaceType.Smooth
	x.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		x[k] = v
	end
	x.Parent = model
	return x
end

local GOLD = Color3.fromRGB(255, 200, 60)

local function buildVisual(model, def, world, base)
	local s = def.scale
	local gem = world.color:Lerp(Color3.fromRGB(150, 220, 255), 0.3)
	if def.id == &quot;Vase&quot; then
		local clay = world.id == &quot;Frozen&quot; and Color3.fromRGB(170, 210, 240) or (world.id == &quot;Lava&quot; and Color3.fromRGB(80, 60, 60) or Color3.fromRGB(205, 120, 75))
		p(model, { Shape = Enum.PartType.Ball, Size = Vector3.new(3.4, 3.4, 3.4) * s, CFrame = base * CFrame.new(0, 1.8 * s, 0), Color = clay, Material = Enum.Material.SmoothPlastic })
		p(model, { Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.4 * s, 1.6 * s, 1.6 * s), CFrame = base * CFrame.new(0, 3.6 * s, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = clay })
		p(model, { Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.35 * s, 2.1 * s, 2.1 * s), CFrame = base * CFrame.new(0, 4.3 * s, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = clay:Lerp(Color3.new(0, 0, 0), 0.15) })
		p(model, { Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4 * s, 3.5 * s, 3.5 * s), CFrame = base * CFrame.new(0, 2.1 * s, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = GOLD, Material = Enum.Material.Metal })
		return Vector3.new(3.6, 4.6, 3.6) * s
	elseif def.id == &quot;Coffre&quot; then
		p(model, { Size = Vector3.new(4, 2.4, 2.8) * s, CFrame = base * CFrame.new(0, 1.2 * s, 0), Color = Color3.fromRGB(150, 95, 55), Material = Enum.Material.WoodPlanks })
		local lid = p(model, { Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 2.8, 2.8) * s, CFrame = base * CFrame.new(0, 2.4 * s, 0), Color = Color3.fromRGB(130, 80, 45), Material = Enum.Material.WoodPlanks })
		for _, x in ipairs({ -1.4, 1.4 }) do
			p(model, { Size = Vector3.new(0.4, 3.9, 2.9) * s, CFrame = base * CFrame.new(x * s, 1.9 * s, 0), Color = GOLD, Material = Enum.Material.Metal })
		end
		p(model, { Size = Vector3.new(0.8, 0.9, 0.3) * s, CFrame = base * CFrame.new(0, 2 * s, -1.45 * s), Color = GOLD, Material = Enum.Material.Metal })
		p(model, { Size = Vector3.new(0.5, 0.5, 0.2) * s, CFrame = base * CFrame.new(0, 2.1 * s, -1.62 * s) * CFrame.Angles(0, 0, math.rad(45)), Color = gem, Material = Enum.Material.Neon })
		return Vector3.new(4.4, 4, 3.2) * s
	else
		-- tresor geant : monticule d'or, gemmes, coffre ouvert
		for k = 1, 9 do
			local a = k * 0.7
			p(model, { Shape = Enum.PartType.Ball, Size = Vector3.new(2.6, 2.6, 2.6) * s * (1 - k * 0.04), CFrame = base * CFrame.new(math.cos(a) * (2.2 - k * 0.2) * s, (0.8 + k * 0.25) * s, math.sin(a) * (2.2 - k * 0.2) * s), Color = GOLD, Material = Enum.Material.Metal, Reflectance = 0.15 })
		end
		for k = 1, 5 do
			local a = k * 1.25
			p(model, { Size = Vector3.new(0.9, 1.8, 0.9) * s, CFrame = base * CFrame.new(math.cos(a) * 2.2 * s, 2.4 * s, math.sin(a) * 2.2 * s) * CFrame.Angles(0.3, a, 0.3), Color = gem, Material = Enum.Material.Neon })
		end
		local light = Instance.new(&quot;PointLight&quot;)
		light.Color = GOLD
		light.Range = 14
		light.Brightness = 1.5
		light.Parent = model:GetChildren()[1]
		local sp = Instance.new(&quot;Sparkles&quot;)
		sp.SparkleColor = GOLD
		sp.Parent = model:GetChildren()[1]
		return Vector3.new(6, 4.5, 6) * s
	end
end

local function pickDef()
	local total = 0
	for _, d in ipairs(Config.Treasures) do
		total += d.weight
	end
	local r = math.random() * total
	for _, d in ipairs(Config.Treasures) do
		r -= d.weight
		if r &lt;= 0 then
			return d
		end
	end
	return Config.Treasures[1]
end

local spawnTreasure

local function dropCoins(model, info)
	local pos = model.PrimaryPart.Position
	local world = Config.WorldById[info.world]
	local total = 0
	for _, dmg in pairs(info.hits) do
		total += dmg
	end
	for player, dmg in pairs(info.hits) do
		local data = DataService.Get(player)
		if data and player.Parent == Players then
			local share = total &gt; 0 and dmg / total or 1
			local value = info.coins * share * F.CoinMult(data)
			data.Stats.Breaks += 1
			local n = math.clamp(math.floor(3 + share * 4), 2, 7)
			for i = 1, n do
				local c = Instance.new(&quot;Part&quot;)
				c.Name = &quot;Coin&quot;
				c.Shape = Enum.PartType.Cylinder
				c.Size = Vector3.new(0.35, 1.6, 1.6)
				c.Color = GOLD
				c.Material = Enum.Material.Metal
				c.Reflectance = 0.2
				c.Anchored = true
				c.CanCollide = false
				c.CanQuery = false
				c.CanTouch = false
				local a = math.random() * math.pi * 2
				local r = 3 + math.random() * 5
				local target = pos + Vector3.new(math.cos(a) * r, -pos.Y + world.center.Y + 1.2, math.sin(a) * r)
				c.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
				c:SetAttribute(&quot;Owner&quot;, player.UserId)
				c.Parent = coinsFolder
				TweenService:Create(c, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(target) * CFrame.Angles(0, a, math.rad(90)) }):Play()
				coinData[c] = { owner = player, value = value / n, expires = os.clock() + 12, ready = os.clock() + 0.45 }
			end
		end
	end
	Remotes.FX:FireAllClients(&quot;Break&quot;, { position = pos, world = info.world, kind = model:GetAttribute(&quot;TreasureType&quot;) })
	-- disparition
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA(&quot;BasePart&quot;) then
			TweenService:Create(d, TweenInfo.new(0.35), { Transparency = 1, Size = d.Size * 0.3 }):Play()
		end
	end
	task.delay(0.4, function()
		model:Destroy()
	end)
	occupied[info.world][info.spot] = nil
	task.delay(math.random(Config.TreasureRespawn[1], Config.TreasureRespawn[2]), function()
		spawnTreasure(world)
	end)
end

function spawnTreasure(world)
	local list = WorldBuilder.Spots(world.id)
	occupied[world.id] = occupied[world.id] or {}
	local free = {}
	for i = 1, #list do
		if not occupied[world.id][i] then
			table.insert(free, i)
		end
	end
	if #free == 0 then
		return
	end
	local spot = free[math.random(#free)]
	occupied[world.id][spot] = true
	local def = pickDef()
	-- les 7 premiers emplacements du village sont dans la grotte : tresors plus riches
	if world.id == &quot;Village&quot; and spot &lt;= 7 and def.id == &quot;Vase&quot; then
		def = Config.Treasures[2]
	end
	counter += 1
	local model = Instance.new(&quot;Model&quot;)
	model.Name = &quot;Treasure&quot; .. counter
	local base = CFrame.new(list[spot]) * CFrame.Angles(0, math.random() * math.pi * 2, 0)
	local size = buildVisual(model, def, world, base)
	local hit = p(model, { Name = &quot;Hitbox&quot;, Size = size, CFrame = base * CFrame.new(0, size.Y / 2, 0), Transparency = 1, CanQuery = true })
	model.PrimaryPart = hit
	model:SetAttribute(&quot;TreasureType&quot;, def.id)
	model:SetAttribute(&quot;Label&quot;, def.name)
	Targets.Register(model, {
		kind = &quot;treasure&quot;,
		world = world.id,
		maxHp = math.floor(def.hp * world.mult),
		coins = def.coins * world.mult,
		spot = spot,
		onDeath = dropCoins,
	})
end

-- Ramassage des pieces (rayon = base + aimant)
local dirty = {}
local function collectLoop()
	local tickN = 0
	while true do
		task.wait(0.15)
		tickN += 1
		local now = os.clock()
		for c, info in pairs(coinData) do
			local player = info.owner
			local data = DataService.Get(player)
			local hrp = player.Character and player.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
			local expired = now &gt; info.expires
			if not data or player.Parent ~= Players then
				coinData[c] = nil
				c:Destroy()
			elseif now &gt;= info.ready and (expired or (hrp and (hrp.Position - c.Position).Magnitude &lt;= Config.CoinPickupRadius + (data.Upgrades.Magnet or 0) * F.UpgradeDef(&quot;Magnet&quot;).per)) then
				coinData[c] = nil
				DataService.AddCoins(player, info.value)
				Remotes.FX:FireClient(player, &quot;Coin&quot;, { position = c.Position, amount = info.value })
				c:Destroy()
				dirty[player] = true
			end
		end
		if tickN % 4 == 0 then
			for p2 in pairs(dirty) do
				dirty[p2] = nil
				if p2.Parent == Players then
					DataService.Sync(p2)
				end
			end
		end
	end
end

function TreasureService.Init()
	coinsFolder = Instance.new(&quot;Folder&quot;)
	coinsFolder.Name = &quot;Coins&quot;
	coinsFolder.Parent = workspace
	for _, w in ipairs(Config.Worlds) do
		for _ = 1, Config.TreasurePerWorld do
			spawnTreasure(w)
		end
	end
	task.spawn(collectLoop)
end

return TreasureService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">WorldBuilder</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Monde de RELIC RUSH : 7 iles (une par monde), eclairage, point d'arrivee, caisses de reliques,
-- portails, arene de boss, batiments interactifs (boutique, forge, autel de renaissance, tableau
-- des quetes) et emplacements des tresors.
-- Les invites (ProximityPrompt) ont un attribut &quot;Panel&quot; : le client ouvre l'interface correspondante.

local CollectionService = game:GetService(&quot;CollectionService&quot;)
local Lighting = game:GetService(&quot;Lighting&quot;)
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local RelicModel = require(ReplicatedStorage.Shared.RelicModel)
local Kit = require(script.Parent.MapKit)
local MapZones = require(script.Parent.MapZones)

local WorldBuilder = {}

local part, wedge, ball, cylinder, sign = Kit.part, Kit.wedge, Kit.ball, Kit.cylinder, Kit.sign
local R, rng = Kit.R, Kit.rng
local avoidCircle = Kit.avoidCircle
local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 200, 60)
local NAVY = Color3.fromRGB(30, 35, 80)
local PURPLE = Color3.fromRGB(130, 70, 220)
local STONE = Color3.fromRGB(165, 160, 175)

local spots = {} -- [worldId] = { positions des tresors }
local spawns = {} -- [worldId] = CFrame
local arenas = {} -- [worldId] = Vector3
local crates = {} -- [worldId] = Vector3

local PALETTES = {
	Village = { top = Color3.fromRGB(120, 210, 85), drip = Color3.fromRGB(100, 190, 70), dirt = Color3.fromRGB(165, 112, 70), dirt2 = Color3.fromRGB(135, 88, 55), path = Color3.fromRGB(240, 222, 175) },
	Forest = { top = Color3.fromRGB(80, 175, 85), drip = Color3.fromRGB(60, 150, 70), dirt = Color3.fromRGB(125, 90, 62), dirt2 = Color3.fromRGB(100, 72, 50), path = Color3.fromRGB(205, 170, 115) },
	Cave = { top = Color3.fromRGB(105, 85, 160), drip = Color3.fromRGB(85, 70, 140), dirt = Color3.fromRGB(70, 60, 100), dirt2 = Color3.fromRGB(55, 45, 80), path = Color3.fromRGB(180, 160, 230) },
	Desert = { top = Color3.fromRGB(250, 220, 150), drip = Color3.fromRGB(238, 200, 120), dirt = Color3.fromRGB(222, 155, 92), dirt2 = Color3.fromRGB(192, 128, 75), path = Color3.fromRGB(235, 190, 120) },
	Frozen = { top = Color3.fromRGB(240, 248, 255), drip = Color3.fromRGB(220, 236, 255), dirt = Color3.fromRGB(150, 175, 210), dirt2 = Color3.fromRGB(120, 145, 185), path = Color3.fromRGB(195, 220, 245) },
	Lava = { top = Color3.fromRGB(85, 70, 70), drip = Color3.fromRGB(70, 55, 55), dirt = Color3.fromRGB(55, 42, 42), dirt2 = Color3.fromRGB(40, 30, 30), path = Color3.fromRGB(130, 100, 90) },
	Celestial = { top = Color3.fromRGB(250, 248, 255), drip = Color3.fromRGB(235, 230, 255), dirt = Color3.fromRGB(220, 200, 150), dirt2 = Color3.fromRGB(200, 175, 120), path = Color3.fromRGB(255, 230, 160) },
}

-- Eclairage --------------------------------------------------------------------------------------
local function lighting()
	Lighting.ClockTime = 14.5
	Lighting.GeographicLatitude = 35
	Lighting.Brightness = 2.5
	Lighting.Ambient = Color3.fromRGB(120, 115, 150)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 145, 180)
	Lighting.EnvironmentDiffuseScale = 0.7
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.45
	pcall(function()
		Lighting.Technology = Enum.Technology.Future
	end)
	for _, c in ipairs(Lighting:GetChildren()) do
		c:Destroy()
	end
	local atm = Instance.new(&quot;Atmosphere&quot;)
	atm.Density = 0.22
	atm.Offset = 0.1
	atm.Color = Color3.fromRGB(190, 200, 255)
	atm.Decay = Color3.fromRGB(120, 110, 200)
	atm.Glare = 0.2
	atm.Haze = 0.8
	atm.Parent = Lighting
	local sky = Instance.new(&quot;Sky&quot;)
	sky.SunAngularSize = 13
	sky.Parent = Lighting
	local bloom = Instance.new(&quot;BloomEffect&quot;)
	bloom.Intensity = 0.4
	bloom.Size = 24
	bloom.Threshold = 1.3
	bloom.Parent = Lighting
	local cc = Instance.new(&quot;ColorCorrectionEffect&quot;)
	cc.Saturation = 0.18
	cc.Contrast = 0.06
	cc.Brightness = 0.02
	cc.Parent = Lighting
	local rays = Instance.new(&quot;SunRaysEffect&quot;)
	rays.Intensity = 0.05
	rays.Parent = Lighting
	local clouds = workspace.Terrain:FindFirstChildOfClass(&quot;Clouds&quot;) or Instance.new(&quot;Clouds&quot;)
	clouds.Cover = 0.5
	clouds.Density = 0.55
	clouds.Parent = workspace.Terrain
end

-- Ile ------------------------------------------------------------------------------------------
local function island(parent, world)
	local pal = PALETTES[world.id]
	local c, s = world.center, world.size
	local half = s / 2
	part({ Name = &quot;Ground&quot;, Size = Vector3.new(s, 4, s), CFrame = CFrame.new(c + Vector3.new(0, -2, 0)), Color = pal.top }, parent)
	for t = -half, half, 9 do
		for _, e in ipairs({ Vector3.new(t, -2.6, half), Vector3.new(t, -2.6, -half), Vector3.new(half, -2.6, t), Vector3.new(-half, -2.6, t) }) do
			ball(CFrame.new(c + e), R(5.5, 7.5), pal.drip, parent).CanCollide = false
		end
	end
	local y = -4
	for i, L in ipairs({ { s - 2, 9, pal.dirt }, { s - 22, 11, pal.dirt2 }, { s - 56, 13, pal.dirt }, { s - 104, 14, pal.dirt2 }, { s - 170, 12, pal.dirt } }) do
		if L[1] &gt; 20 then
			part({ Size = Vector3.new(L[1], L[2], L[1]), CFrame = CFrame.new(c + Vector3.new(0, y - L[2] / 2, 0)), Color = L[3] }, parent)
			part({ Size = Vector3.new(L[1] + 0.4, 1.2, L[1] + 0.4), CFrame = CFrame.new(c + Vector3.new(0, y - L[2] * 0.35, 0)), Color = L[3]:Lerp(WHITE, 0.15), CanCollide = false }, parent)
			y -= L[2]
		end
	end
	for k = 1, 10 do
		local a = R(0, math.pi * 2)
		local r = R(20, half - 50)
		ball(CFrame.new(c + Vector3.new(math.cos(a) * r, y - R(0, 10), math.sin(a) * r)), R(8, 16), pal.dirt2, parent)
	end
	-- murs invisibles
	for _, d in ipairs({ Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) }) do
		local p = c + d * (half + 1) + Vector3.new(0, 40, 0)
		part({ Name = &quot;Wall&quot;, Size = Vector3.new(d.Z ~= 0 and s or 2, 80, d.X ~= 0 and s or 2), CFrame = CFrame.new(p), Transparency = 1 }, parent)
	end
	return pal
end

local function path(parent, a, b, width, color)
	local d = b - a
	part({ Name = &quot;Path&quot;, Size = Vector3.new(width, 0.2, d.Magnitude), CFrame = CFrame.lookAt((a + b) / 2 + Vector3.new(0, 0.1, 0), b + Vector3.new(0, 0.1, 0)), Color = color, CanCollide = false }, parent)
	for t = 4, d.Magnitude - 4, 7 do
		part({ Size = Vector3.new(R(2.5, 4), 0.25, R(2, 3)), CFrame = CFrame.lookAt(a, b) * CFrame.new(R(-width / 3, width / 3), 0.18, -t) * CFrame.Angles(0, R(0, 3), 0), Color = color:Lerp(WHITE, 0.35), CanCollide = false }, parent)
	end
	Kit.avoidSegment(a, b, width / 2 + 3)
end

local function plaza(parent, c, radius, color)
	cylinder(CFrame.new(c + Vector3.new(0, 0.12, 0)), 0.25, radius, color, parent).CanCollide = false
	cylinder(CFrame.new(c + Vector3.new(0, 0.1, 0)), 0.25, radius + 1.6, color:Lerp(Color3.new(0, 0, 0), 0.15), parent).CanCollide = false
	for r = radius * 0.35, radius * 0.8, radius * 0.45 do
		cylinder(CFrame.new(c + Vector3.new(0, 0.14, 0)), 0.25, r, color:Lerp(GOLD, 0.25), parent).CanCollide = false
		cylinder(CFrame.new(c + Vector3.new(0, 0.15, 0)), 0.25, r - 1.2, color, parent).CanCollide = false
	end
	avoidCircle(c, radius + 3)
end

-- Invite d'ouverture d'interface
local function prompt(parentPart, action, object, panel, attrs)
	local p = Instance.new(&quot;ProximityPrompt&quot;)
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = 0
	p.MaxActivationDistance = 14
	p.RequiresLineOfSight = false
	p:SetAttribute(&quot;Panel&quot;, panel)
	for k, v in pairs(attrs or {}) do
		p:SetAttribute(k, v)
	end
	p.Parent = parentPart
	return p
end

local function billboard(parentPart, title, sub, color, height)
	local bb = Instance.new(&quot;BillboardGui&quot;)
	bb.Size = UDim2.fromOffset(220, 70)
	bb.StudsOffsetWorldSpace = Vector3.new(0, height or 8, 0)
	bb.MaxDistance = 140
	bb.LightInfluence = 0
	local t = Instance.new(&quot;TextLabel&quot;)
	t.Size = UDim2.new(1, 0, 0.55, 0)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextColor3 = color or GOLD
	t.Text = title
	t.Parent = bb
	Instance.new(&quot;UIStroke&quot;, t).Thickness = 3
	if sub then
		local s = Instance.new(&quot;TextLabel&quot;)
		s.Name = &quot;Sub&quot;
		s.Size = UDim2.new(1, 0, 0.4, 0)
		s.Position = UDim2.fromScale(0, 0.58)
		s.BackgroundTransparency = 1
		s.Font = Enum.Font.FredokaOne
		s.TextScaled = true
		s.TextColor3 = WHITE
		s.Text = sub
		s.Parent = bb
		Instance.new(&quot;UIStroke&quot;, s).Thickness = 2.5
	end
	bb.Parent = parentPart
	return bb
end

-- Caisse a reliques sur piedestal (le couvercle s'entrouvre en boucle)
local function crateStand(parent, pos, world, facing)
	local cf = CFrame.lookAt(pos, pos + facing)
	cylinder(cf * CFrame.new(0, 0.8, 0), 1.6, 9, STONE, parent, Enum.Material.Marble)
	cylinder(cf * CFrame.new(0, 1.7, 0), 0.3, 9.4, GOLD, parent, Enum.Material.Metal)
	local ring = cylinder(cf * CFrame.new(0, 1.9, 0), 0.2, 8, PURPLE, parent, Enum.Material.Neon)
	ring.Transparency = 0.3
	local base = part({ Name = &quot;Crate&quot;, Size = Vector3.new(7, 4.5, 5), CFrame = cf * CFrame.new(0, 4.25, 0), Color = Color3.fromRGB(150, 95, 55), Material = Enum.Material.WoodPlanks }, parent)
	for _, x in ipairs({ -2.2, 2.2 }) do
		part({ Size = Vector3.new(0.6, 4.6, 5.1), CFrame = cf * CFrame.new(x, 4.25, 0), Color = GOLD, Material = Enum.Material.Metal }, parent)
	end
	local lid = part({ Size = Vector3.new(7.3, 1.4, 5.3), CFrame = cf * CFrame.new(0, 7.2, 0), Color = Color3.fromRGB(120, 75, 45), Material = Enum.Material.WoodPlanks }, parent)
	part({ Size = Vector3.new(1.2, 1.2, 0.4), CFrame = cf * CFrame.new(0, 5.6, -2.6), Color = GOLD, Material = Enum.Material.Metal }, parent)
	local glow = part({ Size = Vector3.new(6.4, 0.2, 4.4), CFrame = cf * CFrame.new(0, 6.6, 0), Color = Config.WorldById[world.id].color, Material = Enum.Material.Neon }, parent)
	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = Color3.fromRGB(190, 130, 255)
	light.Range = 18
	light.Brightness = 2
	light.Parent = glow
	TweenService:Create(lid, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { CFrame = lid.CFrame * CFrame.new(0, 0.5, 1.8) * CFrame.Angles(math.rad(-25), 0, 0) }):Play()
	local e = Instance.new(&quot;ParticleEmitter&quot;)
	e.Rate = 8
	e.Lifetime = NumberRange.new(1, 1.6)
	e.Speed = NumberRange.new(2, 4)
	e.SpreadAngle = Vector2.new(25, 25)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	e.LightEmission = 1
	e.Color = ColorSequence.new(GOLD, Color3.fromRGB(190, 120, 255))
	e.Parent = glow
	local crate = Config.Crates[world.id]
	billboard(base, string.upper(crate.name), &quot;&quot;, GOLD, 9).Sub.Text = &quot;Ouvre pour obtenir une relique&quot;
	prompt(base, &quot;Ouvrir&quot;, crate.name, &quot;Crate&quot;, { World = world.id })
	-- reliques de ce monde qui flottent autour de la caisse (vitrine)
	local list = {}
	for _, r in ipairs(Config.Relics) do
		if r.world == world.id and not r.boss and not r.secret then
			table.insert(list, r.id)
		end
	end
	for i, id in ipairs(list) do
		local a = i / #list * math.pi * 2
		local m = RelicModel.Build(id)
		local p = cf * CFrame.new(math.cos(a) * 8, 6 + math.sin(i) * 0.8, math.sin(a) * 8)
		m:PivotTo(p)
		m.Parent = parent
		local parts = {}
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA(&quot;BasePart&quot;) then
				table.insert(parts, d)
			end
		end
		for _, d in ipairs(parts) do
			TweenService:Create(d, TweenInfo.new(2 + i * 0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { CFrame = d.CFrame + Vector3.new(0, 1.2, 0) }):Play()
		end
	end
	crates[world.id] = pos
	avoidCircle(pos, 13)
end

-- Portail vers un autre monde
local function portal(parent, pos, facing, target)
	local cf = CFrame.lookAt(pos, pos + facing)
	local n = 22
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		local stone = part({ Size = Vector3.new(3.4, 3.4, 3), CFrame = cf * CFrame.new(math.cos(a) * 10, 11 + math.sin(a) * 10, 0) * CFrame.Angles(0, 0, a), Color = (i % 4 == 0) and GOLD or STONE, Material = (i % 4 == 0) and Enum.Material.Metal or Enum.Material.Cobblestone }, parent)
	end
	local disk = part({ Name = &quot;PortalDisk&quot;, Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 18, 18), CFrame = cf * CFrame.new(0, 11, 0) * CFrame.Angles(0, math.rad(90), 0), Color = target.color:Lerp(Color3.fromRGB(80, 160, 255), 0.4), Material = Enum.Material.ForceField, CanCollide = false }, parent)
	local swirl = Instance.new(&quot;ParticleEmitter&quot;)
	swirl.Rate = 35
	swirl.Lifetime = NumberRange.new(1, 1.6)
	swirl.Speed = NumberRange.new(1, 3)
	swirl.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
	swirl.LightEmission = 1
	swirl.Color = ColorSequence.new(WHITE, target.color)
	swirl.Parent = disk
	local l = Instance.new(&quot;PointLight&quot;)
	l.Color = target.color
	l.Range = 24
	l.Brightness = 2
	l.Parent = disk
	part({ Size = Vector3.new(26, 1.6, 8), CFrame = cf * CFrame.new(0, 0.8, 0), Color = STONE, Material = Enum.Material.Cobblestone }, parent)
	local base = part({ Name = &quot;PortalBase&quot;, Size = Vector3.new(4, 4, 4), CFrame = cf * CFrame.new(0, 3, -2), Transparency = 1, CanCollide = false }, parent)
	billboard(base, string.upper(target.name), &quot;&quot;, target.color:Lerp(WHITE, 0.3), 20)
	local p = prompt(base, &quot;Voyager&quot;, target.name, &quot;Worlds&quot;, { Target = target.id })
	p.MaxActivationDistance = 16
	CollectionService:AddTag(p, &quot;Portal&quot;)
	avoidCircle(pos, 16)
end

-- Arene de boss (sol circulaire, colonnes, gradins)
local function arena(parent, pos, world)
	cylinder(CFrame.new(pos + Vector3.new(0, 0.3, 0)), 0.6, 34, Color3.fromRGB(150, 145, 165), parent, Enum.Material.Cobblestone)
	local inner = cylinder(CFrame.new(pos + Vector3.new(0, 0.45, 0)), 0.4, 26, Color3.fromRGB(110, 95, 150), parent, Enum.Material.Slate)
	local glow = cylinder(CFrame.new(pos + Vector3.new(0, 0.5, 0)), 0.4, 25, PURPLE, parent, Enum.Material.Neon)
	glow.Transparency = 0.7
	cylinder(CFrame.new(pos + Vector3.new(0, 0.55, 0)), 0.4, 24, Color3.fromRGB(110, 95, 150), parent, Enum.Material.Slate)
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		local p = pos + Vector3.new(math.cos(a) * 32, 0, math.sin(a) * 32)
		if i ~= 2 then
			cylinder(CFrame.new(p + Vector3.new(0, 7, 0)), 14, 1.6, STONE, parent, Enum.Material.Cobblestone)
			part({ Size = Vector3.new(4.2, 1.2, 4.2), CFrame = CFrame.new(p + Vector3.new(0, 14.6, 0)), Color = GOLD, Material = Enum.Material.Metal }, parent)
			local torch = ball(CFrame.new(p + Vector3.new(0, 16, 0)), 1.6, Color3.fromRGB(200, 120, 255), parent, Enum.Material.Neon)
			local f = Instance.new(&quot;Fire&quot;)
			f.Size = 3
			f.Color = Color3.fromRGB(180, 90, 255)
			f.SecondaryColor = Color3.fromRGB(255, 200, 255)
			f.Parent = torch
		end
	end
	local signPart = part({ Name = &quot;ArenaSign&quot;, Size = Vector3.new(2, 2, 2), CFrame = CFrame.new(pos + Vector3.new(0, 1, 0)), Transparency = 1, CanCollide = false }, parent)
	billboard(signPart, &quot;ARENE DU BOSS&quot;, Config.Boss[world.id].name, Color3.fromRGB(220, 150, 255), 22)
	local marker = part({ Name = &quot;BossArena&quot;, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(pos + Vector3.new(0, 1, 0)), Transparency = 1, CanCollide = false, CanQuery = false }, parent)
	marker:SetAttribute(&quot;World&quot;, world.id)
	CollectionService:AddTag(marker, &quot;BossArena&quot;)
	arenas[world.id] = pos
	avoidCircle(pos, 38)
end

-- Batiments du village -------------------------------------------------------------------------------
local function shopBuilding(parent, cf)
	part({ Size = Vector3.new(22, 1, 14), CFrame = cf * CFrame.new(0, 0.5, 0), Color = STONE, Material = Enum.Material.Cobblestone }, parent)
	part({ Size = Vector3.new(20, 10, 1), CFrame = cf * CFrame.new(0, 6, 6.5), Color = Color3.fromRGB(150, 100, 60), Material = Enum.Material.WoodPlanks }, parent)
	for _, x in ipairs({ -9.5, 9.5 }) do
		part({ Size = Vector3.new(1, 10, 13), CFrame = cf * CFrame.new(x, 6, 0), Color = Color3.fromRGB(150, 100, 60), Material = Enum.Material.WoodPlanks }, parent)
		part({ Size = Vector3.new(1.4, 13, 1.4), CFrame = cf * CFrame.new(x, 6.5, -6.6), Color = Color3.fromRGB(110, 70, 40), Material = Enum.Material.Wood }, parent)
	end
	local counter = part({ Name = &quot;ShopCounter&quot;, Size = Vector3.new(16, 3.4, 3), CFrame = cf * CFrame.new(0, 2.7, -4), Color = Color3.fromRGB(130, 85, 50), Material = Enum.Material.WoodPlanks }, parent)
	part({ Size = Vector3.new(16.6, 0.4, 3.6), CFrame = cf * CFrame.new(0, 4.6, -4), Color = GOLD, Material = Enum.Material.Metal }, parent)
	-- auvent raye turquoise et creme (comme l'icone)
	for k = 0, 9 do
		local w = wedge({ Size = Vector3.new(2.2, 2.4, 7), CFrame = cf * CFrame.new(-9.9 + k * 2.2, 12.5, -4.5) * CFrame.Angles(0, math.pi, 0), Color = (k % 2 == 0) and Color3.fromRGB(40, 170, 170) or Color3.fromRGB(250, 240, 220) }, parent)
		w.CanCollide = false
		ball(cf * CFrame.new(-9.9 + k * 2.2, 11.2, -8.1), 2.2, (k % 2 == 0) and Color3.fromRGB(40, 170, 170) or Color3.fromRGB(250, 240, 220), parent).CanCollide = false
	end
	local emblem = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 6, 6), CFrame = cf * CFrame.new(0, 15.5, -1) * CFrame.Angles(0, math.rad(90), 0), Color = GOLD, Material = Enum.Material.Metal }, parent)
	-- marchandises : pieces et cristaux
	for k = 1, 8 do
		ball(cf * CFrame.new(R(-6, 6), 5.1, R(-4.8, -3.2)), 0.9, GOLD, parent, Enum.Material.Metal)
	end
	for _, x in ipairs({ -4, 4 }) do
		part({ Size = Vector3.new(0.9, 1.8, 0.9), CFrame = cf * CFrame.new(x, 5.6, -4) * CFrame.Angles(0, math.rad(45), math.rad(10)), Color = Color3.fromRGB(150, 100, 255), Material = Enum.Material.Neon }, parent)
	end
	for _, x in ipairs({ -10.5, 10.5 }) do
		local lamp = part({ Size = Vector3.new(1, 1.4, 1), CFrame = cf * CFrame.new(x, 9, -7.4), Color = Color3.fromRGB(255, 210, 140), Material = Enum.Material.Neon }, parent)
		local l = Instance.new(&quot;PointLight&quot;)
		l.Range = 14
		l.Color = Color3.fromRGB(255, 200, 130)
		l.Parent = lamp
	end
	local banner = part({ Size = Vector3.new(3, 5, 0.2), CFrame = cf * CFrame.new(11.5, 7, -7.6), Color = Color3.fromRGB(200, 50, 60), Material = Enum.Material.Fabric }, parent)
	billboard(counter, &quot;BOUTIQUE&quot;, &quot;Potions et avantages&quot;, GOLD, 14)
	prompt(counter, &quot;Ouvrir&quot;, &quot;Boutique&quot;, &quot;Shop&quot;)
	avoidCircle(cf.Position, 16)
end

local function forge(parent, cf)
	part({ Size = Vector3.new(16, 1, 14), CFrame = cf * CFrame.new(0, 0.5, 0), Color = STONE, Material = Enum.Material.Cobblestone }, parent)
	local anvil = part({ Name = &quot;Anvil&quot;, Size = Vector3.new(6, 2.4, 2.8), CFrame = cf * CFrame.new(0, 4.8, 0), Color = Color3.fromRGB(110, 110, 120), Material = Enum.Material.Metal }, parent)
	part({ Size = Vector3.new(3, 3, 2.2), CFrame = cf * CFrame.new(0, 2.5, 0), Color = Color3.fromRGB(95, 95, 105), Material = Enum.Material.Metal }, parent)
	part({ Size = Vector3.new(5, 1, 3.6), CFrame = cf * CFrame.new(0, 1.3, 0), Color = Color3.fromRGB(85, 85, 95), Material = Enum.Material.Metal }, parent)
	wedge({ Size = Vector3.new(2.8, 1.4, 2.4), CFrame = cf * CFrame.new(-4.2, 5.3, 0) * CFrame.Angles(0, math.rad(-90), 0), Color = Color3.fromRGB(110, 110, 120), Material = Enum.Material.Metal }, parent)
	part({ Size = Vector3.new(1.4, 0.3, 1.4), CFrame = cf * CFrame.new(0.5, 6.1, 0), Color = GOLD, Material = Enum.Material.Neon }, parent)
	-- marteau pose
	part({ Size = Vector3.new(0.4, 0.4, 4), CFrame = cf * CFrame.new(1.8, 6.3, 0.6) * CFrame.Angles(0, math.rad(30), 0), Color = Color3.fromRGB(120, 80, 45), Material = Enum.Material.Wood }, parent)
	part({ Size = Vector3.new(1.4, 1, 1), CFrame = cf * CFrame.new(2.6, 6.4, -0.8) * CFrame.Angles(0, math.rad(30), 0), Color = Color3.fromRGB(90, 90, 100), Material = Enum.Material.Metal }, parent)
	-- foyer
	local fire = part({ Size = Vector3.new(4, 2, 4), CFrame = cf * CFrame.new(0, 1.5, 5), Color = Color3.fromRGB(80, 70, 70), Material = Enum.Material.Brick }, parent)
	local f = Instance.new(&quot;Fire&quot;)
	f.Size = 5
	f.Heat = 9
	f.Parent = fire
	local l = Instance.new(&quot;PointLight&quot;)
	l.Color = Color3.fromRGB(255, 160, 70)
	l.Range = 20
	l.Brightness = 2
	l.Parent = fire
	local arrow = part({ Size = Vector3.new(1.2, 4, 0.4), CFrame = cf * CFrame.new(0, 12, 0), Color = GOLD, Material = Enum.Material.Neon, CanCollide = false }, parent)
	TweenService:Create(arrow, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { CFrame = arrow.CFrame + Vector3.new(0, 1.5, 0) }):Play()
	billboard(anvil, &quot;FORGE&quot;, &quot;Ameliorations&quot;, GOLD, 9)
	prompt(anvil, &quot;Ameliorer&quot;, &quot;Forge&quot;, &quot;Upgrades&quot;)
	avoidCircle(cf.Position, 12)
end

local function rebirthAltar(parent, cf)
	cylinder(cf * CFrame.new(0, 0.6, 0), 1.2, 10, STONE, parent, Enum.Material.Cobblestone)
	local n = 16
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		part({ Size = Vector3.new(2.6, 2.6, 2.4), CFrame = cf * CFrame.new(math.cos(a) * 7, 8.5 + math.sin(a) * 7, 0) * CFrame.Angles(0, 0, a), Color = (i % 4 == 0) and GOLD or Color3.fromRGB(110, 100, 130), Material = Enum.Material.Cobblestone }, parent)
	end
	local disk = part({ Name = &quot;RebirthDisk&quot;, Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 12, 12), CFrame = cf * CFrame.new(0, 8.5, 0) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(170, 70, 255), Material = Enum.Material.Neon, Transparency = 0.25, CanCollide = false }, parent)
	TweenService:Create(disk, TweenInfo.new(6, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), { CFrame = disk.CFrame * CFrame.Angles(math.rad(-359), 0, 0) }):Play()
	for _, x in ipairs({ -6, 6 }) do
		part({ Size = Vector3.new(1.4, 3, 1.4), CFrame = cf * CFrame.new(x, 2, -2) * CFrame.Angles(0, math.rad(45), math.rad(15)), Color = Color3.fromRGB(110, 200, 255), Material = Enum.Material.Neon }, parent)
	end
	billboard(disk, &quot;RENAISSANCE&quot;, &quot;Bonus permanents&quot;, Color3.fromRGB(220, 160, 255), 10)
	prompt(disk, &quot;Renaitre&quot;, &quot;Autel&quot;, &quot;Rebirth&quot;)
	avoidCircle(cf.Position, 12)
end

local function questBoard(parent, cf)
	for _, x in ipairs({ -4, 4 }) do
		part({ Size = Vector3.new(0.8, 9, 0.8), CFrame = cf * CFrame.new(x, 4.5, 0), Color = Color3.fromRGB(110, 70, 40), Material = Enum.Material.Wood }, parent)
	end
	local board = part({ Name = &quot;QuestBoard&quot;, Size = Vector3.new(8, 5, 0.5), CFrame = cf * CFrame.new(0, 5.5, 0), Color = Color3.fromRGB(160, 110, 65), Material = Enum.Material.WoodPlanks }, parent)
	for i = 0, 2 do
		part({ Size = Vector3.new(2, 2.6, 0.1), CFrame = cf * CFrame.new(-2.6 + i * 2.6, 5.5, -0.3) * CFrame.Angles(0, 0, math.rad(R(-6, 6))), Color = Color3.fromRGB(245, 230, 195), Material = Enum.Material.SmoothPlastic }, parent)
	end
	wedge({ Size = Vector3.new(9.5, 1.5, 1.2), CFrame = cf * CFrame.new(0, 8.8, 0), Color = Color3.fromRGB(180, 60, 50) }, parent)
	billboard(board, &quot;QUETES&quot;, &quot;Missions du jour&quot;, GOLD, 6)
	prompt(board, &quot;Lire&quot;, &quot;Tableau des quetes&quot;, &quot;Quests&quot;)
	avoidCircle(cf.Position, 7)
end

local function fountain(parent, c)
	cylinder(CFrame.new(c + Vector3.new(0, 1, 0)), 2, 12, Color3.fromRGB(235, 232, 245), parent, Enum.Material.Marble)
	local w = cylinder(CFrame.new(c + Vector3.new(0, 1.8, 0)), 0.6, 11, Kit.WATER, parent, Enum.Material.Glass)
	w.Transparency = 0.25
	w.CanCollide = false
	cylinder(CFrame.new(c + Vector3.new(0, 5, 0)), 6, 2, Color3.fromRGB(235, 232, 245), parent, Enum.Material.Marble)
	cylinder(CFrame.new(c + Vector3.new(0, 8.3, 0)), 0.8, 6, GOLD, parent, Enum.Material.Metal)
	-- grande relique doree tournant au sommet
	local idol = RelicModel.Build(&quot;CouronneRoyale&quot;)
	idol:ScaleTo(2.6)
	idol:PivotTo(CFrame.new(c + Vector3.new(0, 13.5, 0)))
	idol.Parent = parent
	for _, d in ipairs(idol:GetDescendants()) do
		if d:IsA(&quot;BasePart&quot;) then
			local off = CFrame.new(c + Vector3.new(0, 13.5, 0)):ToObjectSpace(d.CFrame)
			local v = Instance.new(&quot;CFrameValue&quot;)
			v.Value = CFrame.new()
			v.Changed:Connect(function(val)
				d.CFrame = CFrame.new(c + Vector3.new(0, 13.5, 0)) * val * off
			end)
			TweenService:Create(v, TweenInfo.new(10, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), { Value = CFrame.Angles(0, math.rad(359), 0) }):Play()
			v.Parent = d
		end
	end
	local jet = part({ Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(c + Vector3.new(0, 9, 0)), Transparency = 1, CanCollide = false }, parent)
	local spray = Instance.new(&quot;ParticleEmitter&quot;)
	spray.Rate = 50
	spray.Lifetime = NumberRange.new(1, 1.3)
	spray.Speed = NumberRange.new(10, 14)
	spray.SpreadAngle = Vector2.new(30, 30)
	spray.Acceleration = Vector3.new(0, -35, 0)
	spray.Size = NumberSequence.new(0.5, 0.9)
	spray.Transparency = NumberSequence.new(0.2, 1)
	spray.Color = ColorSequence.new(Color3.fromRGB(200, 235, 255))
	spray.Parent = jet
	avoidCircle(c, 15)
end

-- Grotte aux tresors (village) : dome de rochers avec entree, cristaux lumineux a l'interieur
local function treasureCave(parent, c, facing)
	local rock = Color3.fromRGB(120, 110, 130)
	local R0 = 30
	local cf = CFrame.lookAt(c, c + facing)
	for i = 0, 27 do
		local a = i / 28 * math.pi * 2
		local local_ = Vector3.new(math.cos(a), 0, math.sin(a))
		local lp = cf:VectorToObjectSpace(local_)
		if not (lp.Z &lt; -0.8) then -- ouverture face a l'entree
			local p = c + local_ * R0
			part({ Size = Vector3.new(9, R(16, 22), 9), CFrame = CFrame.new(p + Vector3.new(0, 9, 0)) * CFrame.Angles(R(-0.2, 0.2), R(0, 3), R(-0.2, 0.2)), Color = rock:Lerp(Color3.new(0, 0, 0), R(0, 0.15)), Material = Enum.Material.Slate }, parent)
		end
	end
	-- toit
	for i = 1, 9 do
		local a = R(0, math.pi * 2)
		local r = R(0, R0 * 0.7)
		local b = ball(CFrame.new(c + Vector3.new(math.cos(a) * r, 22 + R(0, 4), math.sin(a) * r)), R(18, 26), rock, parent, Enum.Material.Slate)
		b.CanCollide = true
	end
	-- arche d'entree
	local entrance = (cf * CFrame.new(0, 0, -R0)).Position
	for _, x in ipairs({ -7, 7 }) do
		part({ Size = Vector3.new(4, 16, 5), CFrame = CFrame.lookAt(entrance, entrance + facing) * CFrame.new(x, 8, 0), Color = rock, Material = Enum.Material.Slate }, parent)
	end
	part({ Size = Vector3.new(18, 4, 5), CFrame = CFrame.lookAt(entrance, entrance + facing) * CFrame.new(0, 16, 0), Color = rock, Material = Enum.Material.Slate }, parent)
	billboard(part({ Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(entrance + Vector3.new(0, 18, 0)), Transparency = 1, CanCollide = false }, parent), &quot;GROTTE AUX TRESORS&quot;, &quot;Gros butin a l'interieur !&quot;, Color3.fromRGB(150, 220, 255), 3)
	-- cristaux lumineux
	local cols = { Color3.fromRGB(90, 200, 255), Color3.fromRGB(180, 100, 255), Color3.fromRGB(255, 120, 220) }
	for i = 1, 16 do
		local a = R(0, math.pi * 2)
		local r = R(R0 - 7, R0 - 3)
		local p = c + Vector3.new(math.cos(a) * r, R(0, 8), math.sin(a) * r)
		local col = cols[rng:NextInteger(1, 3)]
		for k = 1, 3 do
			local h = R(3, 7)
			part({ Size = Vector3.new(1.4, h, 1.4), CFrame = CFrame.new(p) * CFrame.Angles(R(-0.5, 0.5), R(0, 6), R(-0.5, 0.5)) * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, math.rad(45), 0), Color = col, Material = Enum.Material.Neon, Transparency = 0.15, CanCollide = false }, parent)
		end
		if i % 3 == 0 then
			local l = Instance.new(&quot;PointLight&quot;)
			l.Color = col
			l.Range = 22
			l.Brightness = 1.8
			l.Parent = parent:GetChildren()[#parent:GetChildren()]
		end
	end
	-- emplacements de tresors interieurs (plus riches)
	local inside = {}
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		table.insert(inside, c + Vector3.new(math.cos(a) * 14, 0, math.sin(a) * 14))
	end
	table.insert(inside, c)
	avoidCircle(c, R0 + 6)
	return inside
end

-- Starter Village ------------------------------------------------------------------------------------
local function buildVillage(folder, world)
	local c = world.center
	local pal = PALETTES.Village
	-- reservations
	plaza(folder, c, 34, Color3.fromRGB(240, 228, 195))
	fountain(folder, c)
	path(folder, c + Vector3.new(0, 0, 34), c + Vector3.new(0, 0, 165), 14, pal.path) -- vers la plage
	path(folder, c + Vector3.new(34, 0, 0), c + Vector3.new(150, 0, 0), 12, pal.path) -- vers le portail
	path(folder, c + Vector3.new(-34, 0, 0), c + Vector3.new(-100, 0, 40), 12, pal.path) -- vers l'arene
	path(folder, c + Vector3.new(24, 0, -24), c + Vector3.new(95, 0, -85), 10, pal.path) -- vers la grotte
	path(folder, c + Vector3.new(-24, 0, -24), c + Vector3.new(-90, 0, -90), 10, pal.path) -- vers la foret
	crateStand(folder, c + Vector3.new(0, 0, -52), world, Vector3.new(0, 0, 1))
	shopBuilding(folder, CFrame.lookAt(c + Vector3.new(56, 0, 26), c + Vector3.new(0, 0, 26)))
	forge(folder, CFrame.lookAt(c + Vector3.new(52, 0, -32), c))
	rebirthAltar(folder, CFrame.lookAt(c + Vector3.new(-52, 0, -32), c))
	questBoard(folder, CFrame.lookAt(c + Vector3.new(-40, 0, 26), c))
	portal(folder, c + Vector3.new(152, 0, 0), Vector3.new(-1, 0, 0), Config.Worlds[2])
	arena(folder, c + Vector3.new(-110, 0, 60), world)
	local caveSpots = treasureCave(folder, c + Vector3.new(105, 0, -100), Vector3.new(-1, 0, 1))
	-- lampadaires et bancs autour de la place
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2 + 0.3
		Kit.lantern(folder, c + Vector3.new(math.cos(a) * 38, 0, math.sin(a) * 38), Color3.fromRGB(255, 200, 140))
	end
	for i = 0, 3 do
		local a = math.rad(45 + i * 90)
		Kit.bench(folder, CFrame.lookAt(c + Vector3.new(math.cos(a) * 25, 0, math.sin(a) * 25), c))
		Kit.flowerBed(folder, c + Vector3.new(math.cos(a) * 30, 0, math.sin(a) * 30), 3.5)
	end
	-- plage (sud)
	local beach = part({ Name = &quot;Sand&quot;, Size = Vector3.new(world.size - 2, 0.3, 70), CFrame = CFrame.new(c + Vector3.new(0, 0.05, world.size / 2 - 36)), Color = Color3.fromRGB(250, 225, 160), CanCollide = false }, folder)
	local sea = part({ Size = Vector3.new(world.size - 2, 0.3, 22), CFrame = CFrame.new(c + Vector3.new(0, 0.12, world.size / 2 - 12)), Color = Color3.fromRGB(70, 200, 230), Material = Enum.Material.Glass, Transparency = 0.15, Reflectance = 0.2, CanCollide = false }, folder)
	Kit.avoidSegment(c + Vector3.new(-170, 0, 160), c + Vector3.new(170, 0, 160), 14)
	for i = 0, 3 do
		local x = -110 + i * 70
		if math.abs(x) &gt; 20 then
			local p = c + Vector3.new(x, 0, 120)
			cylinder(CFrame.new(p + Vector3.new(0, 4, 0)), 8, 0.25, WHITE, folder)
			for k = 0, 7 do
				part({ Size = Vector3.new(3.4, 0.3, 4.4), CFrame = CFrame.new(p + Vector3.new(0, 8, 0)) * CFrame.Angles(0, k * math.pi / 4, 0) * CFrame.new(0, -0.6, -2) * CFrame.Angles(math.rad(-20), 0, 0), Color = (k % 2 == 0) and Color3.fromRGB(40, 170, 170) or WHITE, CanCollide = false }, folder)
			end
			avoidCircle(p, 6)
		end
	end
	Kit.scatter({ center = c + Vector3.new(0, 0, 125), size = 60 }, 9, 0, 200, function(pos)
		if math.abs(pos.X - c.X) &gt; 14 then
			Kit.palmTree(folder, pos, R(1, 1.4))
			avoidCircle(pos, 4)
		end
	end, 3)
	-- foret (nord-ouest) : zone dense
	Kit.scatter({ center = c + Vector3.new(-105, 0, -95), size = 120 }, 38, 0, 200, function(pos)
		if rng:NextNumber() &lt; 0.55 then
			Kit.pineTree(folder, pos, R(1, 1.7))
		else
			Kit.roundTree(folder, pos, R(0.9, 1.4))
		end
		avoidCircle(pos, 4.5)
	end, 3)
	Kit.scatter({ center = c + Vector3.new(-105, 0, -95), size = 120 }, 16, 0, 200, function(pos)
		Kit.mushroom(folder, pos, R(0.7, 1.4))
	end, 1)
	-- decor general
	Kit.scatter(world, 30, 40, 250, function(pos)
		Kit.roundTree(folder, pos, R(0.8, 1.2))
		avoidCircle(pos, 4.5)
	end, 4)
	Kit.scatter(world, 40, 20, 250, function(pos)
		if rng:NextNumber() &lt; 0.5 then
			Kit.bush(folder, pos, R(0.8, 1.2), Color3.fromRGB(255, 130, 180))
		else
			Kit.flowerPatch(folder, pos)
		end
	end, 1)
	return caveSpots
end

-- Autres mondes --------------------------------------------------------------------------------------
local function buildOther(folder, world)
	local c = world.center
	local pal = PALETTES[world.id]
	plaza(folder, c, 26, pal.path)
	path(folder, c + Vector3.new(-26, 0, 0), c + Vector3.new(-150, 0, 0), 12, pal.path)
	path(folder, c + Vector3.new(0, 0, 26), c + Vector3.new(0, 0, 70), 12, pal.path)
	crateStand(folder, c + Vector3.new(0, 0, -44), world, Vector3.new(0, 0, 1))
	portal(folder, c + Vector3.new(-152, 0, 0), Vector3.new(1, 0, 0), Config.Worlds[1])
	local nextW = Config.Worlds[world.index + 1]
	if nextW then
		path(folder, c + Vector3.new(26, 0, 0), c + Vector3.new(150, 0, 0), 12, pal.path)
		portal(folder, c + Vector3.new(152, 0, 0), Vector3.new(-1, 0, 0), nextW)
	end
	arena(folder, c + Vector3.new(0, 0, 105), world)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2 + 0.39
		Kit.lantern(folder, c + Vector3.new(math.cos(a) * 30, 0, math.sin(a) * 30), world.color:Lerp(WHITE, 0.4))
	end
	local builder = MapZones[world.id]
	if builder then
		local ok, err = pcall(builder, folder, { center = c, size = world.size, id = world.id })
		if not ok then
			warn(&quot;[RelicRush] Decor de &quot; .. world.id .. &quot; : &quot; .. tostring(err))
		end
	end
end

local function computeSpots(world, extra)
	local list = {}
	for _, p in ipairs(extra or {}) do
		table.insert(list, p + Vector3.new(0, 0, 0))
	end
	local half = world.size / 2
	local tries = 0
	while #list &lt; Config.TreasurePerWorld + 10 and tries &lt; 4000 do
		tries += 1
		local p = world.center + Vector3.new(R(-half + 18, half - 18), 0, R(-half + 18, half - 18))
		if Kit.isFree(p, 3) then
			table.insert(list, p)
			avoidCircle(p, 7)
		end
	end
	spots[world.id] = list
end

function WorldBuilder.Build()
	for _, n in ipairs({ &quot;RelicRushWorld&quot;, &quot;Baseplate&quot; }) do
		local o = workspace:FindFirstChild(n)
		if o then
			o:Destroy()
		end
	end
	for _, s in ipairs(workspace:GetDescendants()) do
		if s:IsA(&quot;SpawnLocation&quot;) then
			s:Destroy()
		end
	end
	lighting()
	local root = Instance.new(&quot;Folder&quot;)
	root.Name = &quot;RelicRushWorld&quot;
	root.Parent = workspace
	for _, w in ipairs(Config.Worlds) do
		local folder = Instance.new(&quot;Folder&quot;)
		folder.Name = w.id
		folder.Parent = root
		island(folder, w)
		spawns[w.id] = CFrame.new(w.center + (w.id == &quot;Village&quot; and Config.SpawnOffset or Vector3.new(-120, 4, 0)))
		local extra
		local ok, err = pcall(function()
			if w.id == &quot;Village&quot; then
				extra = buildVillage(folder, w)
			else
				buildOther(folder, w)
			end
		end)
		if not ok then
			warn(&quot;[RelicRush] Monde &quot; .. w.id .. &quot; : &quot; .. tostring(err))
		end
		computeSpots(w, extra)
		-- nuages et mer autour de l'ile
		part({ Name = &quot;Sea&quot;, Size = Vector3.new(1100, 2, 1100), CFrame = CFrame.new(w.center + Vector3.new(0, -150, 0)), Color = Color3.fromRGB(80, 150, 240), CanCollide = false, CanQuery = false }, folder)
		for k = 1, 14 do
			local a = R(0, math.pi * 2)
			Kit.cloudPuff(folder, w.center + Vector3.new(math.cos(a) * R(220, 420), R(-60, 60), math.sin(a) * R(220, 420)), R(1, 2))
		end
		task.wait()
	end
	local spawn = Instance.new(&quot;SpawnLocation&quot;)
	spawn.Name = &quot;MainSpawn&quot;
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = spawns.Village - Vector3.new(0, 3.5, 0)
	spawn.Anchored = true
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = root
	Players.RespawnTime = 2
end

function WorldBuilder.Spots(worldId)
	return spots[worldId] or {}
end

function WorldBuilder.Spawn(worldId)
	return spawns[worldId]
end

function WorldBuilder.Crate(worldId)
	return crates[worldId]
end

function WorldBuilder.Arena(worldId)
	return arenas[worldId]
end

function WorldBuilder.WorldAt(position)
	for _, w in ipairs(Config.Worlds) do
		local half = w.size / 2 + 40
		if math.abs(position.X - w.center.X) &lt;= half and math.abs(position.Z - w.center.Z) &lt;= half then
			return w
		end
	end
	return nil
end

return WorldBuilder
</ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000025"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000024"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000023"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX00000018"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Point d'entree client de RELIC RUSH.
local Modules = script.Parent.Modules

local function start(name)
	local ok, err = pcall(function()
		local m = require(Modules[name])
		if m.Init then
			m.Init()
		end
	end)
	if not ok then
		warn(&quot;[RelicRush] Demarrage de &quot; .. name .. &quot; : &quot; .. tostring(err))
	end
end

start(&quot;HUD&quot;)
start(&quot;PanelsA&quot;)
start(&quot;PanelsB&quot;)
start(&quot;RelicOrbit&quot;)
start(&quot;Effects&quot;)
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000022"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">Effects</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Effets : animation d'ouverture de caisse, pieces qui volent vers le compteur, eclats a la
-- destruction, chiffres de degats, onde de choc du boss, flashs (renaissance, voyage), sons,
-- mode performance.

local Lighting = game:GetService(&quot;Lighting&quot;)
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local SoundService = game:GetService(&quot;SoundService&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local F = require(ReplicatedStorage.Shared.Formulas)
local Icons = require(ReplicatedStorage.Shared.Icons)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local HUD = require(script.Parent.HUD)
local RelicView = require(script.Parent.RelicView)
local Window = require(script.Parent.Window)

local Effects = {}
local C = UI.C
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local SOUNDS = {
	coin = &quot;rbxasset://sounds/electronicpingshort.wav&quot;,
	hit = &quot;rbxasset://sounds/action_jump_land.mp3&quot;,
	whoosh = &quot;rbxasset://sounds/swoosh.wav&quot;,
}

function Effects.Play(name, volume, pitch)
	local s = Instance.new(&quot;Sound&quot;)
	s.SoundId = SOUNDS[name] or name
	local sfx = State.data and State.data.Settings.Sfx or 0.7
	s.Volume = (volume or 0.5) * sfx
	s.PlaybackSpeed = pitch or 1
	s.Parent = SoundService
	s:Play()
	task.delay(4, function()
		s:Destroy()
	end)
end

local function burst(position, color, count, speed)
	local p = Instance.new(&quot;Part&quot;)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Transparency = 1
	p.Size = Vector3.one
	p.CFrame = CFrame.new(position)
	p.Parent = workspace
	local e = Instance.new(&quot;ParticleEmitter&quot;)
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.5, 1)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Acceleration = Vector3.new(0, -30, 0)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	e.LightEmission = 0.8
	e.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	e.Parent = p
	e:Emit(State.data and State.data.Settings.LowGraphics and math.floor(count / 3) or count)
	task.delay(1.5, function()
		p:Destroy()
	end)
end

-- Piece a l'ecran qui vole vers le compteur
local function coinFly(worldPos, amount)
	local sp, on = camera:WorldToViewportPoint(worldPos)
	if not on then
		return
	end
	local img = Icons.Image(&quot;coin&quot;, HUD.Screen, { Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(sp.X, sp.Y), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 50 })
	local target = UDim2.new(0.5, -200, 0, 36)
	local tw = UI.tween(img, 0.55, { Position = target, Size = UDim2.fromOffset(22, 22) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tw.Completed:Connect(function()
		img:Destroy()
	end)
end

local function floatingText(position, text, color, size)
	local a = Instance.new(&quot;Part&quot;)
	a.Anchored = true
	a.CanCollide = false
	a.CanQuery = false
	a.Transparency = 1
	a.Size = Vector3.one
	a.CFrame = CFrame.new(position + Vector3.new(math.random(-15, 15) / 10, 0, math.random(-15, 15) / 10))
	a.Parent = workspace
	local bb = Instance.new(&quot;BillboardGui&quot;)
	bb.Size = UDim2.fromOffset(160, 50)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Adornee = a
	bb.Parent = a
	local t = UI.text({ Size = UDim2.fromScale(1, 1), Text = text, TextColor3 = color, StrokeThickness = 3 }, bb)
	UI.tween(a, 0.9, { CFrame = a.CFrame + Vector3.new(0, 4, 0) })
	task.delay(0.5, function()
		UI.tween(t, 0.4, { TextTransparency = 1 })
	end)
	task.delay(1, function()
		a:Destroy()
	end)
end

-- Chiffres de degats : on suit la vie de la cible visee par le joueur
local lastHP = {}
local function watchDamage()
	local targets = workspace:WaitForChild(&quot;Targets&quot;)
	game:GetService(&quot;RunService&quot;).Heartbeat:Connect(function()
		local name = player:GetAttribute(&quot;Target&quot;)
		local m = name and targets:FindFirstChild(name)
		if not m then
			return
		end
		local hp = m:GetAttribute(&quot;HP&quot;)
		local prev = lastHP[m]
		lastHP[m] = hp
		if prev and hp and hp &lt; prev and m.PrimaryPart then
			Effects.Play(&quot;hit&quot;, 0.25, 1 + math.random() * 0.4)
			if State.data and State.data.Settings.DamageNumbers ~= false then
				floatingText(m.PrimaryPart.Position + Vector3.new(0, m.PrimaryPart.Size.Y / 2 + 1, 0), &quot;-&quot; .. F.Format(prev - hp), Color3.fromRGB(255, 230, 120))
			end
			burst(m.PrimaryPart.Position + Vector3.new(0, m.PrimaryPart.Size.Y * 0.3, 0), C.Gold, 6, 10)
		end
	end)
end

-- Ouverture de caisse ----------------------------------------------------------------------------------
local function crateAnimation(results)
	Window.Close()
	local overlay = UI.new(&quot;Frame&quot;, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, ZIndex = 80 }, HUD.Screen)
	UI.tween(overlay, 0.25, { BackgroundTransparency = 0.35 })
	local crate = Icons.Image(&quot;crate&quot;, overlay, { Size = UDim2.fromOffset(220, 220), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 81 })
	-- tremblement de plus en plus fort
	for i = 1, 10 do
		crate.Rotation = (i % 2 == 0 and 1 or -1) * i * 1.5
		crate.Size = UDim2.fromOffset(220 + i * 4, 220 + i * 4)
		Effects.Play(&quot;hit&quot;, 0.2, 0.8 + i * 0.05)
		task.wait(0.08)
	end
	local flash = UI.new(&quot;Frame&quot;, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0, ZIndex = 90 }, overlay)
	UI.tween(flash, 0.5, { BackgroundTransparency = 1 })
	crate:Destroy()
	Effects.Play(&quot;whoosh&quot;, 0.6, 1)
	local n = #results
	local cards = {}
	for i, r in ipairs(results) do
		local def = Config.RelicById[r.id]
		local rar = Config.RarityById[def.rarity]
		local x = (i - (n + 1) / 2) * 250
		local card = UI.new(&quot;Frame&quot;, { Size = UDim2.fromOffset(230, 300), Position = UDim2.new(0.5, x, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 82 }, overlay)
		-- rayons tournants a la couleur de la rarete
		local rays = UI.new(&quot;Frame&quot;, { Size = UDim2.fromOffset(300, 300), Position = UDim2.fromScale(0.5, 0.4), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 82 }, card)
		for k = 0, 7 do
			local ray = UI.new(&quot;Frame&quot;, { Size = UDim2.fromOffset(26, 300), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Rotation = k * 22.5, BackgroundColor3 = rar.color, BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = 82 }, rays)
			UI.gradient(ray, Color3.new(1, 1, 1), Color3.new(1, 1, 1), 90).Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) })
		end
		TweenService:Create(rays, TweenInfo.new(6, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), { Rotation = 360 }):Play()
		RelicView.Icon(r.id, card, { Size = UDim2.fromOffset(200, 200), Position = UDim2.new(0.5, -100, 0.4, -100), ZIndex = 84 }, false, true)
		UI.text({ Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 1, -92), Text = def.name, ZIndex = 85, StrokeThickness = 3 }, card)
		UI.text({ Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 1, -56), Text = rar.name .. &quot;  -  P &quot; .. F.Format(def.power), TextColor3 = rar.color, ZIndex = 85, StrokeThickness = 3 }, card)
		if r.first then
			local new = UI.text({ Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0, -10), Text = &quot;NOUVEAU !&quot;, TextColor3 = C.Gold, ZIndex = 86, StrokeThickness = 3, Rotation = -8 }, card)
		end
		if not r.uid then
			UI.text({ Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 1, -26), Text = &quot;Inventaire plein !&quot;, TextColor3 = C.Red, ZIndex = 85 }, card)
		end
		local s = UI.new(&quot;UIScale&quot;, { Scale = 0.2 }, card)
		UI.tween(s, 0.4 + i * 0.08, { Scale = 1 }, Enum.EasingStyle.Back)
		table.insert(cards, card)
		if rar.index &gt;= 5 then
			Effects.Play(&quot;coin&quot;, 1, 0.6)
			task.delay(0.15, Effects.Play, &quot;coin&quot;, 1, 0.9)
			task.delay(0.3, Effects.Play, &quot;coin&quot;, 1, 1.3)
		end
	end
	local hint = UI.text({ Size = UDim2.fromOffset(400, 30), Position = UDim2.new(0.5, -200, 1, -60), Text = &quot;Clique pour continuer&quot;, TextColor3 = C.Sub, ZIndex = 85 }, overlay)
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		UI.tween(overlay, 0.2, { BackgroundTransparency = 1 })
		for _, c in ipairs(cards) do
			UI.tween(c:FindFirstChildOfClass(&quot;UIScale&quot;), 0.2, { Scale = 0 })
		end
		task.wait(0.22)
		overlay:Destroy()
	end
	local btn = UI.new(&quot;TextButton&quot;, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = &quot;&quot;, ZIndex = 95 }, overlay)
	btn.Activated:Connect(close)
	task.delay(4.5, close)
end

local function screenFlash(color, t)
	local f = UI.new(&quot;Frame&quot;, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BackgroundTransparency = 0.2, ZIndex = 70 }, HUD.Screen)
	UI.tween(f, t or 0.8, { BackgroundTransparency = 1 })
	task.delay(t or 0.8, function()
		f:Destroy()
	end)
end

local function shockwave(position, radius)
	local ring = Instance.new(&quot;Part&quot;)
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(200, 120, 255)
	ring.Transparency = 0.3
	ring.Size = Vector3.new(0.4, 4, 4)
	ring.CFrame = CFrame.new(position + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace
	UI.tween(ring, 0.6, { Size = Vector3.new(0.4, radius * 2, radius * 2), Transparency = 1 })
	task.delay(0.7, function()
		ring:Destroy()
	end)
end

local function applySettings()
	local s = State.data and State.data.Settings
	if not s then
		return
	end
	Lighting.GlobalShadows = not s.LowGraphics
	local music = SoundService:FindFirstChild(&quot;RelicMusic&quot;)
	if music then
		music.Volume = (s.Music or 0.5) * 0.5
	end
end

function Effects.Init()
	if Config.MusicId and Config.MusicId ~= &quot;&quot; then
		local m = Instance.new(&quot;Sound&quot;)
		m.Name = &quot;RelicMusic&quot;
		m.SoundId = Config.MusicId
		m.Looped = true
		m.Volume = 0.25
		m.Parent = SoundService
		m:Play()
	end
	State.Changed.Event:Connect(function(what)
		if what == &quot;data&quot; then
			applySettings()
		end
	end)
	task.spawn(watchDamage)
	Remotes.FX.OnClientEvent:Connect(function(kind, d)
		d = d or {}
		if kind == &quot;Coin&quot; then
			Effects.Play(&quot;coin&quot;, 0.35, 1.2 + math.random() * 0.3)
			coinFly(d.position, d.amount)
		elseif kind == &quot;Break&quot; then
			burst(d.position + Vector3.new(0, 2, 0), C.Gold, 30, 25)
			Effects.Play(&quot;hit&quot;, 0.5, 0.7)
		elseif kind == &quot;CrateOpen&quot; then
			task.spawn(crateAnimation, d.results)
		elseif kind == &quot;Shockwave&quot; then
			shockwave(d.position, d.radius)
			Effects.Play(&quot;whoosh&quot;, 0.7, 0.6)
		elseif kind == &quot;BossDown&quot; then
			burst(d.position, Color3.fromRGB(200, 120, 255), 80, 40)
		elseif kind == &quot;BossReward&quot; then
			HUD.Big(d.boss .. &quot; vaincu !&quot;, &quot;+&quot; .. F.Format(d.coins) .. &quot; pieces (&quot; .. math.floor(d.share * 100) .. &quot; % des degats)&quot; .. (d.relic and &quot;  + RELIQUE DU BOSS !&quot; or &quot;&quot;), Color3.fromRGB(215, 160, 255))
		elseif kind == &quot;Teleport&quot; or kind == &quot;WorldUnlock&quot; then
			screenFlash(Color3.fromRGB(150, 200, 255), 0.8)
			Effects.Play(&quot;whoosh&quot;, 0.8, 1)
			if kind == &quot;WorldUnlock&quot; then
				HUD.Big(&quot;Nouveau monde !&quot;, Config.WorldById[d.world].name, C.Gold)
			end
		elseif kind == &quot;Rebirth&quot; then
			screenFlash(Color3.fromRGB(190, 90, 255), 1.2)
			HUD.Big(&quot;RENAISSANCE &quot; .. d.count, &quot;Bonus permanents augmentes !&quot;, Color3.fromRGB(215, 160, 255))
		elseif kind == &quot;Upgrade&quot; or kind == &quot;Purchase&quot; then
			Effects.Play(&quot;coin&quot;, 0.6, 1.5)
			if kind == &quot;Purchase&quot; then
				HUD.Toast(d.name .. &quot; achete !&quot;, &quot;good&quot;)
			end
		elseif kind == &quot;Daily&quot; then
			HUD.Big(&quot;Jour &quot; .. d.day .. &quot; !&quot;, d.text, C.Green)
		elseif kind == &quot;Reward&quot; then
			HUD.Big(d.title, d.text, C.Gold)
		elseif kind == &quot;TradeDone&quot; then
			HUD.Big(&quot;Echange reussi !&quot;, &quot;Tes nouvelles reliques sont dans l'inventaire&quot;, C.Green)
		end
	end)
end

return Effects
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">HUD</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- HUD de RELIC RUSH : pieces, puissance, reliques equipees, boutons des 12 interfaces (icones de la
-- planche), barre de vie de la cible, boss du monde, potions actives, notifications, recompenses.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local ProximityPromptService = game:GetService(&quot;ProximityPromptService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local F = require(ReplicatedStorage.Shared.Formulas)
local Icons = require(ReplicatedStorage.Shared.Icons)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local Window = require(script.Parent.Window)

local HUD = {}
local C = UI.C
local player = Players.LocalPlayer
local screen
local refs = {}

-- Notifications ------------------------------------------------------------------------------------
local KIND = { info = C.Blue, good = C.Green, gold = C.Gold, danger = C.Red }
function HUD.Toast(text, kind)
	local t = UI.panel({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 40 }, refs.toasts, true)
	t.BackgroundColor3 = C.Navy
	t.BackgroundTransparency = 0.05
	UI.stroke(t, KIND[kind] or C.Blue, 3)
	UI.pad(t, 10)
	UI.text({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = text, TextScaled = false, TextSize = 19, TextWrapped = true, ZIndex = 41 }, t)
	local s = UI.new(&quot;UIScale&quot;, { Scale = 0.5 }, t)
	UI.tween(s, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(4, function()
		UI.tween(s, 0.2, { Scale = 0 })
		task.wait(0.22)
		t:Destroy()
	end)
end

-- Grande annonce (recompense, renaissance...)
function HUD.Big(title, sub, color)
	local f = UI.panel({ Size = UDim2.fromOffset(460, 120), Position = UDim2.new(0.5, 0, 0.3, 0), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 60 }, screen)
	UI.stroke(f, color or C.Gold, 4)
	UI.text({ Size = UDim2.new(1, -30, 0, 52), Position = UDim2.fromOffset(15, 12), Text = title, TextColor3 = color or C.Gold, ZIndex = 61, StrokeThickness = 3 }, f)
	UI.text({ Size = UDim2.new(1, -30, 0, 32), Position = UDim2.fromOffset(15, 70), Text = sub or &quot;&quot;, ZIndex = 61 }, f)
	local s = UI.new(&quot;UIScale&quot;, { Scale = 0.3 }, f)
	UI.tween(s, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(2.8, function()
		UI.tween(s, 0.2, { Scale = 0 })
		task.wait(0.25)
		f:Destroy()
	end)
end

-- Barre du haut -------------------------------------------------------------------------------------
local function pill(icon, color, order)
	local f = UI.panel({ Size = UDim2.fromOffset(190, 54), LayoutOrder = order }, refs.top)
	Icons.Image(icon, f, { Size = UDim2.fromOffset(62, 62), Position = UDim2.fromOffset(-14, -5), ZIndex = 3 })
	local t = UI.text({ Size = UDim2.new(1, -62, 0, 34), Position = UDim2.fromOffset(52, 10), Text = &quot;0&quot;, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 3 }, f)
	return t, f
end

local function buildTop()
	refs.top = UI.new(&quot;Frame&quot;, { Size = UDim2.fromOffset(640, 60), Position = UDim2.new(0.5, 0, 0, 8), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1 }, screen)
	local l = UI.list(refs.top, 26, true)
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	refs.coins, refs.coinPill = pill(&quot;coin&quot;, C.Gold, 1)
	refs.power, refs.powerPill = pill(&quot;power&quot;, Color3.fromRGB(215, 160, 255), 2)
	refs.slots = pill(&quot;relic&quot;, Color3.fromRGB(140, 220, 255), 3)
	refs.boosts = UI.new(&quot;Frame&quot;, { Size = UDim2.fromOffset(640, 30), Position = UDim2.new(0.5, 0, 0, 74), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1 }, screen)
	UI.list(refs.boosts, 8, true).HorizontalAlignment = Enum.HorizontalAlignment.Center
end

-- Boutons lateraux (icones de la planche) ---------------------------------------------------------------
local BUTTONS_LEFT = { { &quot;index&quot;, &quot;Index&quot; }, { &quot;inventory&quot;, &quot;Inventory&quot; }, { &quot;shop&quot;, &quot;Shop&quot; }, { &quot;worlds&quot;, &quot;Worlds&quot; }, { &quot;upgrades&quot;, &quot;Upgrades&quot; }, { &quot;rebirth&quot;, &quot;Rebirth&quot; } }
local BUTTONS_RIGHT = { { &quot;quests&quot;, &quot;Quests&quot; }, { &quot;trading&quot;, &quot;Trading&quot; }, { &quot;boss&quot;, &quot;Boss&quot; }, { &quot;daily&quot;, &quot;Daily&quot; }, { &quot;leaderboard&quot;, &quot;Leaderboard&quot; }, { &quot;settings&quot;, &quot;Settings&quot; } }

local function sideColumn(list, right)
	local col = UI.new(&quot;Frame&quot;, { Size = UDim2.fromOffset(200, 330), Position = right and UDim2.new(1, -8, 0.5, 20) or UDim2.new(0, 8, 0.5, 20), AnchorPoint = Vector2.new(right and 1 or 0, 0.5), BackgroundTransparency = 1 }, screen)
	local grid = UI.new(&quot;UIGridLayout&quot;, { CellSize = UDim2.fromOffset(96, 104), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }, col)
	refs.badges = refs.badges or {}
	for i, b in ipairs(list) do
		local btn = Icons.Button(b[1], col, { LayoutOrder = i })
		local s = UI.new(&quot;UIScale&quot;, {}, btn)
		btn.MouseEnter:Connect(function()
			UI.tween(s, 0.12, { Scale = 1.1 })
		end)
		btn.MouseLeave:Connect(function()
			UI.tween(s, 0.12, { Scale = 1 })
		end)
		btn.MouseButton1Down:Connect(function()
			UI.tween(s, 0.06, { Scale = 0.92 })
		end)
		btn.Activated:Connect(function()
			UI.tween(s, 0.12, { Scale = 1.1 })
			Window.Open(b[2])
		end)
		local badge = UI.new(&quot;Frame&quot;, { Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -24, 0, 0), BackgroundColor3 = C.Red, Visible = false, ZIndex = 5 }, btn)
		UI.corner(badge, 14)
		UI.stroke(badge, Color3.new(1, 1, 1), 2)
		local bt = UI.text({ Size = UDim2.fromScale(1, 1), Text = &quot;!&quot;, ZIndex = 6 }, badge)
		refs.badges[b[2]] = { frame = badge, text = bt }
	end
	return col
end

local function fitColumns()
	local vs = workspace.CurrentCamera.ViewportSize
	local s = math.clamp(vs.Y / 820, 0.55, 1)
	for _, c in ipairs({ refs.left, refs.right }) do
		local sc = c:FindFirstChildOfClass(&quot;UIScale&quot;) or UI.new(&quot;UIScale&quot;, {}, c)
		sc.Scale = s
	end
	local tsc = refs.top:FindFirstChildOfClass(&quot;UIScale&quot;) or UI.new(&quot;UIScale&quot;, {}, refs.top)
	tsc.Scale = math.clamp(vs.X / 1100, 0.6, 1)
end

-- Barre de la cible ------------------------------------------------------------------------------------
local function buildTarget()
	local f = UI.panel({ Size = UDim2.fromOffset(420, 70), Position = UDim2.new(0.5, 0, 1, -24), AnchorPoint = Vector2.new(0.5, 1), Visible = false }, screen)
	refs.target = f
	refs.targetName = UI.text({ Size = UDim2.new(1, -24, 0, 26), Position = UDim2.fromOffset(12, 6), Text = &quot;&quot;, TextXAlignment = Enum.TextXAlignment.Left }, f)
	local _, set, fill = UI.bar({ Size = UDim2.new(1, -24, 0, 22), Position = UDim2.fromOffset(12, 38) }, f, C.Green)
	refs.setTarget = set
	refs.targetFill = fill
	refs.targetHP = UI.text({ Size = UDim2.new(1, -24, 0, 18), Position = UDim2.fromOffset(12, 40), Text = &quot;&quot;, ZIndex = 3 }, f)
	refs.boss = UI.panel({ Size = UDim2.fromOffset(300, 58), Position = UDim2.new(1, -12, 0, 8), AnchorPoint = Vector2.new(1, 0), Visible = false }, screen)
	UI.stroke(refs.boss, Color3.fromRGB(200, 110, 255), 3)
	Icons.Image(&quot;boss&quot;, refs.boss, { Size = UDim2.fromOffset(64, 64), Position = UDim2.fromOffset(-10, -6), ZIndex = 3 })
	refs.bossName = UI.text({ Size = UDim2.new(1, -70, 0, 22), Position = UDim2.fromOffset(60, 5), Text = &quot;&quot;, TextXAlignment = Enum.TextXAlignment.Left }, refs.boss)
	local _, setB = UI.bar({ Size = UDim2.new(1, -74, 0, 16), Position = UDim2.fromOffset(60, 33) }, refs.boss, Color3.fromRGB(190, 90, 255))
	refs.setBoss = setB
end

local function worldOfPlayer()
	local hrp = player.Character and player.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if not hrp then
		return nil
	end
	for _, w in ipairs(Config.Worlds) do
		if math.abs(hrp.Position.X - w.center.X) &lt; w.size / 2 + 40 and math.abs(hrp.Position.Z - w.center.Z) &lt; w.size / 2 + 40 then
			return w
		end
	end
end
HUD.WorldOfPlayer = worldOfPlayer

local function updateTarget()
	local name = player:GetAttribute(&quot;Target&quot;)
	local targets = workspace:FindFirstChild(&quot;Targets&quot;)
	local m = name and targets and targets:FindFirstChild(name)
	if m then
		refs.target.Visible = true
		local hp, max = m:GetAttribute(&quot;HP&quot;) or 0, m:GetAttribute(&quot;MaxHP&quot;) or 1
		refs.targetName.Text = m:GetAttribute(&quot;Label&quot;) or &quot;Tresor&quot;
		refs.setTarget(hp / max)
		refs.targetHP.Text = F.Format(hp) .. &quot; / &quot; .. F.Format(max)
		refs.targetFill.BackgroundColor3 = m:GetAttribute(&quot;Kind&quot;) == &quot;boss&quot; and Color3.fromRGB(190, 90, 255) or C.Green
	else
		refs.target.Visible = false
	end
	local w = worldOfPlayer()
	local st = w and State.boss[w.id]
	if st and st.alive and st.maxHp &gt; 0 then
		refs.boss.Visible = true
		refs.bossName.Text = st.name
		refs.setBoss(st.hp / st.maxHp)
	else
		refs.boss.Visible = false
	end
end

-- Mise a jour ---------------------------------------------------------------------------------------------
function HUD.Refresh()
	local d = State.data
	if not d then
		return
	end
	refs.coins.Text = F.Format(d.Coins)
	refs.power.Text = F.Format(State.extra.power)
	refs.slots.Text = #d.Equipped .. &quot; / &quot; .. F.Slots(d)
	-- potions actives
	refs.boosts:ClearAllChildren()
	UI.list(refs.boosts, 8, true).HorizontalAlignment = Enum.HorizontalAlignment.Center
	local now = State.Now()
	for kind, t in pairs(d.Boosts) do
		if t &gt; now then
			local b = UI.panel({ Size = UDim2.fromOffset(150, 28) }, refs.boosts, true)
			b.BackgroundColor3 = C.Purple2
			UI.stroke(b, C.Gold, 2)
			UI.text({ Size = UDim2.new(1, -10, 1, -6), Position = UDim2.fromOffset(5, 3), Text = ({ Coins = &quot;Pieces x2&quot;, Luck = &quot;Chance x2&quot;, Power = &quot;Force x2&quot; })[kind] .. &quot;  &quot; .. F.Time(t - now) }, b)
		end
	end
	-- pastilles
	local dailyReady = os.time() - d.LastDaily &gt;= Config.Daily.Cooldown
	refs.badges.Daily.frame.Visible = dailyReady
	local claimable = 0
	for _, q in ipairs(d.Quests.List or {}) do
		local def
		for _, x in ipairs(Config.DailyQuestPool) do
			if x.id == q.id then
				def = x
			end
		end
		if def and not q.claimed then
			local goal = def.worldScaled and math.floor(def.goal * F.BestWorld(d).mult) or def.goal
			if (d.Stats[def.stat] or 0) - (d.Quests.Base[def.stat] or 0) &gt;= goal then
				claimable += 1
			end
		end
	end
	refs.badges.Quests.frame.Visible = claimable &gt; 0
	refs.badges.Quests.text.Text = tostring(claimable)
	refs.badges.Trading.frame.Visible = next(State.requests) ~= nil or State.trade ~= nil
end

function HUD.Init()
	screen = UI.new(&quot;ScreenGui&quot;, { Name = &quot;RelicRushHUD&quot;, ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = false }, player:WaitForChild(&quot;PlayerGui&quot;))
	HUD.Screen = screen
	buildTop()
	refs.left = sideColumn(BUTTONS_LEFT, false)
	refs.right = sideColumn(BUTTONS_RIGHT, true)
	buildTarget()
	refs.toasts = UI.new(&quot;Frame&quot;, { Size = UDim2.fromOffset(420, 300), Position = UDim2.new(0.5, 0, 0, 110), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, ZIndex = 40 }, screen)
	UI.list(refs.toasts, 6).HorizontalAlignment = Enum.HorizontalAlignment.Center
	fitColumns()
	workspace.CurrentCamera:GetPropertyChangedSignal(&quot;ViewportSize&quot;):Connect(fitColumns)
	Window.Init(screen)

	Remotes.Sync.OnClientEvent:Connect(function(data, extra)
		local before = State.data and State.data.Coins
		State.data = data
		State.extra = extra
		State.syncClock = os.clock()
		HUD.Refresh()
		if before and data.Coins &gt; before then
			local s = refs.coinPill:FindFirstChildOfClass(&quot;UIScale&quot;) or UI.new(&quot;UIScale&quot;, {}, refs.coinPill)
			s.Scale = 1.15
			UI.tween(s, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		end
		State.Changed:Fire(&quot;data&quot;)
	end)
	Remotes.Notify.OnClientEvent:Connect(HUD.Toast)
	Remotes.Boss.OnClientEvent:Connect(function(status, t)
		State.boss = status
		State.bossTime = t
		State.Changed:Fire(&quot;boss&quot;)
	end)
	Remotes.Trade.OnClientEvent:Connect(function(kind, d)
		if kind == &quot;request&quot; then
			State.requests[d.fromId] = { name = d.from, at = os.clock() }
			HUD.Toast(d.from .. &quot; veut echanger avec toi ! (menu Trading)&quot;, &quot;gold&quot;)
		elseif kind == &quot;session&quot; then
			State.requests = {}
			State.trade = d
			if Window.Current ~= &quot;Trading&quot; then
				Window.Open(&quot;Trading&quot;)
			end
		elseif kind == &quot;closed&quot; then
			State.trade = nil
			HUD.Toast(d.reason, &quot;info&quot;)
		end
		HUD.Refresh()
		State.Changed:Fire(&quot;trade&quot;)
	end)
	-- invites du monde -&gt; interfaces
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local panel = prompt:GetAttribute(&quot;Panel&quot;)
		if not panel then
			return
		end
		if panel == &quot;Crate&quot; then
			Window.Open(&quot;Crate&quot;, { world = prompt:GetAttribute(&quot;World&quot;) })
		elseif panel == &quot;Worlds&quot; then
			local target = prompt:GetAttribute(&quot;Target&quot;)
			if not (State.data and State.data.Worlds[target]) then
				Window.Open(&quot;Worlds&quot;, { focus = target })
			end
		else
			Window.Open(panel, {})
		end
	end)
	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		updateTarget()
		acc += dt
		if acc &gt; 1 then
			acc = 0
			HUD.Refresh()
		end
	end)
end

return HUD
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">PanelsA</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Fenetres (1/2) : Caisse, Index, Inventory, Shop, Worlds, Upgrades, Rebirth.
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local F = require(ReplicatedStorage.Shared.Formulas)
local Icons = require(ReplicatedStorage.Shared.Icons)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local Window = require(script.Parent.Window)
local RelicView = require(script.Parent.RelicView)

local PanelsA = {}
local C = UI.C
local Z = 22

local function act(...)
	Remotes.Action:FireServer(...)
end

local function label(parent, props)
	props.ZIndex = props.ZIndex or Z
	return UI.text(props, parent)
end

local function shopPrice(item, data)
	if item.kind == &quot;potion&quot; and item.scale then
		return math.floor(item.price * F.BestWorld(data).mult ^ 0.85)
	elseif item.kind == &quot;inventory&quot; then
		return math.floor(item.price * item.growth ^ (data.BagLevel or 0))
	end
	return item.price
end

-- Tuile de relique (3D + cadre de rarete)
local function relicTile(parent, relicId, opts)
	opts = opts or {}
	local def = Config.RelicById[relicId]
	local rc = Config.RarityById[def.rarity].color
	local tile = UI.new(&quot;TextButton&quot;, { Text = &quot;&quot;, AutoButtonColor = false, BackgroundColor3 = opts.silhouette and C.Navy or rc:Lerp(C.Navy, 0.55), LayoutOrder = opts.order or 0, ZIndex = Z }, parent)
	UI.corner(tile, 14)
	UI.gradient(tile, Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 190), 90)
	UI.stroke(tile, opts.selected and Color3.new(1, 1, 1) or rc, opts.selected and 4 or 3)
	RelicView.Icon(relicId, tile, { Size = UDim2.new(1, -10, 1, -30), Position = UDim2.fromOffset(5, 4), ZIndex = Z + 1 }, opts.silhouette, opts.spin)
	label(tile, { Size = UDim2.new(1, -8, 0, 20), Position = UDim2.new(0, 4, 1, -24), Text = opts.caption or (opts.silhouette and &quot;???&quot; or F.Format(def.power)), TextColor3 = opts.captionColor or C.Text, ZIndex = Z + 2 })
	if opts.equipped then
		Icons.Image(&quot;check&quot;, tile, { Size = UDim2.fromOffset(28, 28), Position = UDim2.fromOffset(4, 4), ZIndex = Z + 3 })
	end
	if opts.locked then
		Icons.Image(&quot;lock&quot;, tile, { Size = UDim2.fromOffset(24, 24), Position = UDim2.new(1, -28, 0, 4), ZIndex = Z + 3 })
	end
	return tile
end
PanelsA.RelicTile = relicTile

-- CAISSE --------------------------------------------------------------------------------------------
Window.Register(&quot;Crate&quot;, {
	title = &quot;CAISSE DE RELIQUES&quot;,
	icon = &quot;inventory&quot;,
	refreshOn = { data = true },
	build = function(root, ctx)
		local d = State.data
		local worldId = ctx.world or &quot;Village&quot;
		local crate = Config.Crates[worldId]
		local luck = F.Luck(d, State.Now())
		label(root, { Size = UDim2.new(1, 0, 0, 34), Text = crate.name .. &quot;  -  chance x&quot; .. string.format(&quot;%.2f&quot;, luck), TextColor3 = C.Gold })
		local grid = UI.scroll({ Name = &quot;CrateGrid&quot;, Size = UDim2.new(1, 0, 1, -120), Position = UDim2.fromOffset(0, 40), ZIndex = Z }, root)
		UI.new(&quot;UIGridLayout&quot;, { CellSize = UDim2.fromOffset(132, 150), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
		local odds = F.CrateOdds(worldId, luck)
		local byRarity = {}
		for _, e in ipairs(odds) do
			byRarity[e.rarity] = e.pct
		end
		local i = 0
		for _, r in ipairs(Config.Relics) do
			if r.world == worldId and not r.boss and byRarity[r.rarity] then
				i += 1
				local count = 0
				for _, rel in ipairs(Config.Relics) do
					if rel.world == worldId and rel.rarity == r.rarity and not rel.boss then
						count += 1
					end
				end
				local pct = byRarity[r.rarity] / count
				local known = d.Index[r.id]
				relicTile(grid, r.id, { order = i, silhouette = not known, spin = true, caption = (pct &gt;= 0.1 and string.format(&quot;%.1f%%&quot;, pct) or string.format(&quot;%.4f%%&quot;, pct)), captionColor = Config.RarityById[r.rarity].color })
			end
		end
		local can = d.Worlds[worldId]
		local b1 = UI.button({ Size = UDim2.fromOffset(260, 62), Position = UDim2.new(0.5, -275, 1, -66), Text = &quot;OUVRIR x1  -  &quot; .. F.Format(crate.price), ZIndex = Z }, root, (can and d.Coins &gt;= crate.price) and C.Gold or Color3.fromRGB(110, 100, 130))
		b1.Activated:Connect(function()
			act(&quot;openCrate&quot;, worldId, 1)
		end)
		local b3 = UI.button({ Size = UDim2.fromOffset(260, 62), Position = UDim2.new(0.5, 15, 1, -66), Text = d.Perks.TripleOpen and (&quot;OUVRIR x3  -  &quot; .. F.Format(crate.price * 3)) or &quot;x3 : voir Boutique&quot;, ZIndex = Z }, root, d.Perks.TripleOpen and C.Purple or Color3.fromRGB(110, 100, 130))
		b3.Activated:Connect(function()
			if d.Perks.TripleOpen then
				act(&quot;openCrate&quot;, worldId, 3)
			else
				Window.Open(&quot;Shop&quot;)
			end
		end)
	end,
})

-- INDEX -----------------------------------------------------------------------------------------------
Window.Register(&quot;Index&quot;, {
	title = &quot;INDEX DES RELIQUES&quot;,
	icon = &quot;index&quot;,
	refreshOn = { data = true },
	build = function(root, ctx)
		local d = State.data
		ctx.world = ctx.world or &quot;Village&quot;
		local total, found = 0, 0
		for _, r in ipairs(Config.Relics) do
			total += 1
			if d.Index[r.id] then
				found += 1
			end
		end
		label(root, { Size = UDim2.new(0.6, 0, 0, 30), Text = &quot;Decouvertes : &quot; .. found .. &quot; / &quot; .. total, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Gold })
		label(root, { Size = UDim2.new(0.4, 0, 0, 24), Position = UDim2.new(0.6, 0, 0, 4), Text = &quot;Bonus d'index : +&quot; .. math.floor(F.IndexBonus(d) * 100) .. &quot; % puissance&quot;, TextColor3 = Color3.fromRGB(215, 160, 255), TextXAlignment = Enum.TextXAlignment.Right })
		local tabs = UI.new(&quot;Frame&quot;, { Size = UDim2.new(1, 0, 0, 52), Position = UDim2.fromOffset(0, 32), BackgroundTransparency = 1, ZIndex = Z }, root)
		UI.list(tabs, 6, true)
		for i, w in ipairs(Config.Worlds) do
			local b = Icons.Button(&quot;world_&quot; .. w.id, tabs, { Size = UDim2.fromOffset(100, 46), LayoutOrder = i, ZIndex = Z })
			if ctx.world ~= w.id then
				b.ImageColor3 = Color3.fromRGB(150, 145, 170)
			else
				UI.new(&quot;UIScale&quot;, { Scale = 1.12 }, b)
			end
			b.Activated:Connect(function()
				ctx.world = w.id
				Window.Render()
			end)
		end
		local grid = UI.scroll({ Name = &quot;IndexGrid&quot;, Size = UDim2.new(1, 0, 1, -92), Position = UDim2.fromOffset(0, 90), ZIndex = Z }, root)
		UI.new(&quot;UIGridLayout&quot;, { CellSize = UDim2.fromOffset(136, 160), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
		for i, r in ipairs(Config.Relics) do
			if r.world == ctx.world then
				local known = d.Index[r.id]
				local rar = Config.RarityById[r.rarity]
				local tile = relicTile(grid, r.id, { order = i, silhouette = not known, spin = known, caption = known and r.name or rar.name, captionColor = rar.color })
				label(tile, { Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 4), Text = known and (&quot;P &quot; .. F.Format(r.power)) or (r.boss and &quot;BOSS&quot; or (r.secret and &quot;SECRET&quot; or &quot;&quot;)), TextColor3 = C.Gold, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = Z + 3 })
			end
		end
	end,
})

-- INVENTORY --------------------------------------------------------------------------------------------
Window.Register(&quot;Inventory&quot;, {
	title = &quot;INVENTAIRE&quot;,
	icon = &quot;inventory&quot;,
	refreshOn = { data = true },
	build = function(root, ctx)
		local d = State.data
		ctx.selected = ctx.selected or {}
		local equipped = {}
		for _, uid in ipairs(d.Equipped) do
			equipped[uid] = true
		end
		local list = {}
		for k, item in pairs(d.Relics) do
			local def = Config.RelicById[item.id]
			if def then
				table.insert(list, { uid = tonumber(k), item = item, def = def })
			end
		end
		table.sort(list, function(a, b)
			if equipped[a.uid] ~= equipped[b.uid] then
				return equipped[a.uid] == true
			end
			return a.def.power &gt; b.def.power
		end)
		label(root, { Size = UDim2.new(0.5, 0, 0, 28), Text = &quot;Reliques &quot; .. #list .. &quot; / &quot; .. F.InventoryCap(d) .. &quot;    Equipees &quot; .. #d.Equipped .. &quot; / &quot; .. F.Slots(d), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Gold })
		local best = UI.button({ Size = UDim2.fromOffset(180, 40), Position = UDim2.new(1, -370, 0, -4), Text = &quot;EQUIPER MEILLEURES&quot;, ZIndex = Z }, root, C.Green)
		best.Activated:Connect(function()
			act(&quot;equipBest&quot;)
		end)
		local rec = UI.button({ Size = UDim2.fromOffset(180, 40), Position = UDim2.new(1, -180, 0, -4), Text = ctx.recycle and &quot;ANNULER&quot; or &quot;RECYCLER&quot;, ZIndex = Z }, root, ctx.recycle and C.Red or C.Purple)
		rec.Activated:Connect(function()
			ctx.recycle = not ctx.recycle
			ctx.selected = {}
			Window.Render()
		end)
		local grid = UI.scroll({ Name = &quot;InvGrid&quot;, Size = UDim2.new(1, -250, 1, -50), Position = UDim2.fromOffset(0, 46), ZIndex = Z }, root)
		UI.new(&quot;UIGridLayout&quot;, { CellSize = UDim2.fromOffset(110, 128), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
		for i, e in ipairs(list) do
			local tile = relicTile(grid, e.def.id, { order = i, equipped = equipped[e.uid], locked = e.item.locked, selected = ctx.recycle and ctx.selected[e.uid] or ctx.focus == e.uid })
			tile.Activated:Connect(function()
				if ctx.recycle then
					if not e.item.locked then
						ctx.selected[e.uid] = not ctx.selected[e.uid] or nil
					end
				else
					ctx.focus = e.uid
				end
				Window.Render()
			end)
		end
		-- panneau de detail
		local side = UI.card({ Size = UDim2.new(0, 238, 1, -50), Position = UDim2.new(1, -238, 0, 46), ZIndex = Z }, root, C.Navy2)
		if ctx.recycle then
			local n, value = 0, 0
			for uid in pairs(ctx.selected) do
				local item = d.Relics[tostring(uid)]
				if item then
					n += 1
					local def = Config.RelicById[item.id]
					value += math.floor(Config.Crates[def.world].price * 0.15 * Config.RarityById[def.rarity].index)
				end
			end
			label(side, { Size = UDim2.new(1, -20, 0, 60), Position = UDim2.fromOffset(10, 14), Text = &quot;Selectionne les reliques a recycler (les verrouillees sont protegees)&quot;, TextScaled = true })
			label(side, { Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 90), Text = n .. &quot; relique(s)&quot;, TextColor3 = C.Gold })
			label(side, { Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 128), Text = &quot;+&quot; .. F.Format(value) .. &quot; pieces&quot;, TextColor3 = C.Gold })
			local go = UI.button({ Size = UDim2.new(1, -20, 0, 50), Position = UDim2.new(0, 10, 1, -62), Text = &quot;RECYCLER&quot;, ZIndex = Z + 1 }, side, n &gt; 0 and C.Red or Color3.fromRGB(110, 100, 130))
			go.Activated:Connect(function()
				local uids = {}
				for uid in pairs(ctx.selected) do
					table.insert(uids, uid)
				end
				ctx.selected = {}
				ctx.recycle = false
				act(&quot;recycle&quot;, uids)
			end)
			return
		end
		local focus = ctx.focus and d.Relics[tostring(ctx.focus)]
		if not focus then
			label(side, { Size = UDim2.new(1, -20, 0, 80), Position = UDim2.fromOffset(10, 20), Text = #list == 0 and &quot;Ouvre des caisses pour obtenir tes premieres reliques !&quot; or &quot;Clique sur une relique pour voir ses details&quot; })
			return
		end
		local def = Config.RelicById[focus.id]
		local rar = Config.RarityById[def.rarity]
		RelicView.Icon(def.id, side, { Size = UDim2.new(1, -20, 0, 150), Position = UDim2.fromOffset(10, 8), ZIndex = Z + 1 }, false, true)
		label(side, { Size = UDim2.new(1, -20, 0, 28), Position = UDim2.fromOffset(10, 160), Text = def.name })
		label(side, { Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 190), Text = rar.name .. &quot;  -  &quot; .. Config.WorldById[def.world].name, TextColor3 = rar.color })
		label(side, { Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 216), Text = &quot;Puissance &quot; .. F.Format(def.power), TextColor3 = Color3.fromRGB(215, 160, 255) })
		local isEq = equipped[ctx.focus]
		local eb = UI.button({ Size = UDim2.new(1, -20, 0, 44), Position = UDim2.new(0, 10, 1, -150), Text = isEq and &quot;RETIRER&quot; or &quot;EQUIPER&quot;, ZIndex = Z + 1 }, side, isEq and C.Red or C.Green)
		eb.Activated:Connect(function()
			act(isEq and &quot;unequip&quot; or &quot;equip&quot;, ctx.focus)
		end)
		local lb = UI.button({ Size = UDim2.new(1, -20, 0, 40), Position = UDim2.new(0, 10, 1, -98), Text = focus.locked and &quot;DEVERROUILLER&quot; or &quot;VERROUILLER&quot;, ZIndex = Z + 1 }, side, C.Blue)
		lb.Activated:Connect(function()
			act(&quot;lock&quot;, ctx.focus)
		end)
		local value = math.floor(Config.Crates[def.world].price * 0.15 * rar.index)
		local rb = UI.button({ Size = UDim2.new(1, -20, 0, 40), Position = UDim2.new(0, 10, 1, -50), Text = &quot;RECYCLER  +&quot; .. F.Format(value), ZIndex = Z + 1 }, side, focus.locked and Color3.fromRGB(110, 100, 130) or C.Purple)
		rb.Activated:Connect(function()
			if not focus.locked then
				act(&quot;recycle&quot;, { ctx.focus })
				ctx.focus = nil
			end
		end)
	end,
})

-- SHOP -----------------------------------------------------------------------------------------------------
Window.Register(&quot;Shop&quot;, {
	title = &quot;BOUTIQUE&quot;,
	icon = &quot;shop&quot;,
	refreshOn = { data = true },
	build = function(root)
		local d = State.data
		local grid = UI.scroll({ Name = &quot;ShopGrid&quot;, Size = UDim2.fromScale(1, 1), ZIndex = Z }, root)
		UI.new(&quot;UIGridLayout&quot;, { CellSize = UDim2.fromOffset(236, 200), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
		local now = State.Now()
		for i, item in ipairs(Config.Shop) do
			local card = UI.card({ LayoutOrder = i, ZIndex = Z }, grid, item.kind == &quot;potion&quot; and C.Purple2 or C.Navy2)
			local icon = item.kind == &quot;potion&quot; and (item.boost == &quot;Coins&quot; and &quot;coin&quot; or item.boost == &quot;Luck&quot; and &quot;relic&quot; or &quot;power&quot;) or (item.kind == &quot;inventory&quot; and &quot;inventory&quot; or (item.id == &quot;TripleOpen&quot; and &quot;crate&quot; or &quot;upgrades&quot;))
			Icons.Image(icon, card, { Size = UDim2.fromOffset(64, 64), Position = UDim2.fromOffset(10, 8), ZIndex = Z + 1 })
			label(card, { Size = UDim2.new(1, -90, 0, 26), Position = UDim2.fromOffset(80, 12), Text = item.name, TextXAlignment = Enum.TextXAlignment.Left })
			label(card, { Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 78), Text = item.desc, TextColor3 = C.Sub, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true })
			local status = &quot;&quot;
			if item.kind == &quot;potion&quot; and (d.Boosts[item.boost] or 0) &gt; now then
				status = &quot;Actif : &quot; .. F.Time(d.Boosts[item.boost] - now)
			end
			label(card, { Size = UDim2.new(1, -90, 0, 20), Position = UDim2.fromOffset(80, 42), Text = status, TextColor3 = C.Green, TextXAlignment = Enum.TextXAlignment.Left })
			local owned = item.kind == &quot;perk&quot; and d.Perks[item.id]
			local price = shopPrice(item, d)
			local b = UI.button({ Size = UDim2.new(1, -20, 0, 46), Position = UDim2.new(0, 10, 1, -56), Text = owned and &quot;POSSEDE&quot; or F.Format(price), ZIndex = Z + 1 }, card, owned and C.Green or (d.Coins &gt;= price and C.Gold or Color3.fromRGB(110, 100, 130)))
			if not owned then
				Icons.Image(&quot;coin&quot;, b, { Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(0, 3), ZIndex = Z + 3 })
				b.Activated:Connect(function()
					act(&quot;buyShop&quot;, item.id)
				end)
			end
		end
	end,
})

-- WORLDS ---------------------------------------------------------------------------------------------------
Window.Register(&quot;Worlds&quot;, {
	title = &quot;MONDES&quot;,
	icon = &quot;worlds&quot;,
	refreshOn = { data = true },
	build = function(root)
		local d = State.data
		local list = UI.scroll({ Name = &quot;WorldList&quot;, Size = UDim2.fromScale(1, 1), ZIndex = Z }, root)
		UI.list(list, 10)
		for i, w in ipairs(Config.Worlds) do
			local unlocked = d.Worlds[w.id]
			local prev = Config.Worlds[i - 1]
			local available = not prev or d.Worlds[prev.id]
			local row = UI.card({ Size = UDim2.new(1, -14, 0, 92), LayoutOrder = i, ZIndex = Z }, list, w.color:Lerp(C.Navy, 0.35))
			local banner = Icons.Image(&quot;world_&quot; .. w.id, row, { Size = UDim2.fromOffset(120, 88), Position = UDim2.fromOffset(4, 2), ZIndex = Z + 1 })
			if not unlocked then
				banner.ImageColor3 = Color3.fromRGB(120, 115, 140)
			end
			label(row, { Size = UDim2.new(0.45, 0, 0, 36), Position = UDim2.fromOffset(134, 10), Text = w.name, TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 3 })
			label(row, { Size = UDim2.new(0.45, 0, 0, 24), Position = UDim2.fromOffset(134, 52), Text = &quot;Tresors x&quot; .. F.Format(w.mult) .. &quot;  -  Boss : &quot; .. Config.Boss[w.id].name, TextColor3 = C.Sub, TextXAlignment = Enum.TextXAlignment.Left })
			local text, color, fn
			if unlocked then
				text, color = &quot;VOYAGER&quot;, C.Green
				fn = function()
					act(&quot;teleport&quot;, w.id)
					Window.Close()
				end
			elseif available then
				text, color = F.Format(w.price), d.Coins &gt;= w.price and C.Gold or Color3.fromRGB(110, 100, 130)
				fn = function()
					act(&quot;unlockWorld&quot;, w.id)
				end
			else
				text, color = &quot;VERROUILLE&quot;, Color3.fromRGB(90, 85, 110)
			end
			local b = UI.button({ Size = UDim2.fromOffset(220, 56), Position = UDim2.new(1, -236, 0.5, -28), Text = text, ZIndex = Z + 1 }, row, color)
			if not unlocked and available then
				Icons.Image(&quot;coin&quot;, b, { Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(0, 6), ZIndex = Z + 3 })
			elseif not unlocked then
				Icons.Image(&quot;lock&quot;, b, { Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(0, 6), ZIndex = Z + 3 })
			end
			if fn then
				b.Activated:Connect(fn)
			end
		end
	end,
})

-- UPGRADES --------------------------------------------------------------------------------------------------
Window.Register(&quot;Upgrades&quot;, {
	title = &quot;AMELIORATIONS&quot;,
	icon = &quot;upgrades&quot;,
	refreshOn = { data = true },
	build = function(root)
		local d = State.data
		local list = UI.scroll({ Name = &quot;UpgList&quot;, Size = UDim2.fromScale(1, 1), ZIndex = Z }, root)
		UI.list(list, 8)
		local icons = { Power = &quot;power&quot;, Coins = &quot;coin&quot;, Luck = &quot;relic&quot;, Speed = &quot;worlds&quot;, Magnet = &quot;coin&quot;, Slots = &quot;slot&quot; }
		for i, u in ipairs(Config.Upgrades) do
			local lvl = d.Upgrades[u.id] or 0
			local row = UI.card({ Size = UDim2.new(1, -14, 0, 80), LayoutOrder = i, ZIndex = Z }, list, C.Navy2)
			Icons.Image(icons[u.id], row, { Size = UDim2.fromOffset(60, 60), Position = UDim2.fromOffset(10, 10), ZIndex = Z + 1 })
			label(row, { Size = UDim2.new(0.4, 0, 0, 30), Position = UDim2.fromOffset(82, 8), Text = u.name .. &quot;  &quot; .. lvl .. &quot;/&quot; .. u.max, TextXAlignment = Enum.TextXAlignment.Left })
			label(row, { Size = UDim2.new(0.45, 0, 0, 22), Position = UDim2.fromOffset(82, 44), Text = u.desc .. (u.keepOnRebirth and &quot;  (garde a la renaissance)&quot; or &quot;&quot;), TextColor3 = C.Sub, TextXAlignment = Enum.TextXAlignment.Left })
			local _, set = UI.bar({ Size = UDim2.new(0, 160, 0, 14), Position = UDim2.new(1, -400, 0.5, -7), ZIndex = Z + 1 }, row, C.Gold)
			set(lvl / u.max, true)
			local maxed = lvl &gt;= u.max
			local cost = F.UpgradeCost(u.id, lvl)
			local b = UI.button({ Size = UDim2.fromOffset(200, 52), Position = UDim2.new(1, -214, 0.5, -26), Text = maxed and &quot;MAX&quot; or F.Format(cost), ZIndex = Z + 1 }, row, maxed and C.Green or (d.Coins &gt;= cost and C.Gold or Color3.fromRGB(110, 100, 130)))
			if not maxed then
				Icons.Image(&quot;coin&quot;, b, { Size = UDim2.fromOffset(32, 32), Position = UDim2.fromOffset(0, 5), ZIndex = Z + 3 })
				b.Activated:Connect(function()
					act(&quot;buyUpgrade&quot;, u.id)
				end)
			end
		end
	end,
})

-- REBIRTH -------------------------------------------------------------------------------------------------
Window.Register(&quot;Rebirth&quot;, {
	title = &quot;RENAISSANCE&quot;,
	icon = &quot;rebirth&quot;,
	refreshOn = { data = true },
	build = function(root)
		local d = State.data
		local cost = F.RebirthCost(d.Rebirths)
		local R = Config.Rebirth
		label(root, { Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 6), Text = &quot;Renaissances : &quot; .. d.Rebirths, TextColor3 = Color3.fromRGB(215, 160, 255), StrokeThickness = 3 })
		local function stat(y, name, now, after)
			local row = UI.card({ Size = UDim2.new(1, -120, 0, 60), Position = UDim2.new(0, 60, 0, y), ZIndex = Z }, root, C.Navy2)
			label(row, { Size = UDim2.new(0.4, 0, 0, 30), Position = UDim2.fromOffset(16, 15), Text = name, TextXAlignment = Enum.TextXAlignment.Left })
			label(row, { Size = UDim2.new(0.5, -20, 0, 30), Position = UDim2.new(0.5, 0, 0, 15), Text = now .. &quot;   &gt;   &quot; .. after, TextColor3 = C.Green, TextXAlignment = Enum.TextXAlignment.Right })
		end
		stat(64, &quot;Bonus de pieces&quot;, &quot;+&quot; .. math.floor(d.Rebirths * R.CoinBonus * 100) .. &quot; %&quot;, &quot;+&quot; .. math.floor((d.Rebirths + 1) * R.CoinBonus * 100) .. &quot; %&quot;)
		stat(134, &quot;Bonus de puissance&quot;, &quot;+&quot; .. math.floor(d.Rebirths * R.PowerBonus * 100) .. &quot; %&quot;, &quot;+&quot; .. math.floor((d.Rebirths + 1) * R.PowerBonus * 100) .. &quot; %&quot;)
		label(root, { Size = UDim2.new(1, -60, 0, 50), Position = UDim2.fromOffset(30, 210), Text = &quot;Tu gardes tes reliques, tes mondes et tes emplacements. Tes pieces et tes autres ameliorations repartent a zero.&quot;, TextColor3 = C.Sub, TextWrapped = true })
		local _, set = UI.bar({ Size = UDim2.new(1, -120, 0, 26), Position = UDim2.fromOffset(60, 280), ZIndex = Z }, root, Color3.fromRGB(190, 90, 255))
		set(d.Coins / cost, true)
		label(root, { Size = UDim2.new(1, -120, 0, 22), Position = UDim2.fromOffset(60, 282), Text = F.Format(d.Coins) .. &quot; / &quot; .. F.Format(cost), ZIndex = Z + 2 })
		local b = UI.button({ Size = UDim2.fromOffset(320, 66), Position = UDim2.new(0.5, -160, 1, -80), Text = &quot;RENAITRE&quot;, ZIndex = Z }, root, d.Coins &gt;= cost and C.Purple or Color3.fromRGB(110, 100, 130))
		b.Activated:Connect(function()
			if d.Coins &gt;= cost then
				act(&quot;rebirth&quot;)
			end
		end)
	end,
})

return PanelsA
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">PanelsB</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Fenetres (2/2) : Quests, Trading, Boss, Daily, Leaderboard, Settings.
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local F = require(ReplicatedStorage.Shared.Formulas)
local Icons = require(ReplicatedStorage.Shared.Icons)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local Window = require(script.Parent.Window)
local RelicView = require(script.Parent.RelicView)
local PanelsA = require(script.Parent.PanelsA)

local PanelsB = {}
local C = UI.C
local Z = 22
local player = Players.LocalPlayer
local GREY = Color3.fromRGB(110, 100, 130)

local function act(...)
	Remotes.Action:FireServer(...)
end

local function label(parent, props)
	props.ZIndex = props.ZIndex or Z
	return UI.text(props, parent)
end

local function section(parent, text, order)
	return label(parent, { Size = UDim2.new(1, -14, 0, 32), Text = text, TextColor3 = C.Gold, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = order, StrokeThickness = 3 })
end

-- QUESTS ------------------------------------------------------------------------------------------------
local function milestoneValue(d, stat)
	if stat == &quot;Equipped&quot; then
		return #d.Equipped
	elseif stat == &quot;Worlds&quot; then
		local n = 0
		for _ in pairs(d.Worlds) do
			n += 1
		end
		return n
	elseif stat == &quot;Discovered&quot; then
		return State.extra.discovered or 0
	elseif stat == &quot;Rebirths&quot; then
		return d.Rebirths
	end
	return d.Stats[stat] or 0
end

Window.Register(&quot;Quests&quot;, {
	title = &quot;QUETES&quot;,
	icon = &quot;quests&quot;,
	refreshOn = { data = true },
	build = function(root)
		local d = State.data
		local list = UI.scroll({ Name = &quot;QuestList&quot;, Size = UDim2.fromScale(1, 1), ZIndex = Z }, root)
		UI.list(list, 8)
		local nextDay = (math.floor(State.Now() / 86400) + 1) * 86400
		section(list, &quot;Quetes du jour  (nouvelles dans &quot; .. F.Time(nextDay - State.Now()) .. &quot;)&quot;, 0)
		local mult = F.BestWorld(d).mult
		for i, q in ipairs(d.Quests.List or {}) do
			local def
			for _, x in ipairs(Config.DailyQuestPool) do
				if x.id == q.id then
					def = x
				end
			end
			if def then
				local goal = def.worldScaled and math.floor(def.goal * mult) or def.goal
				local progress = math.min(goal, (d.Stats[def.stat] or 0) - (d.Quests.Base[def.stat] or 0))
				local row = UI.card({ Size = UDim2.new(1, -14, 0, 76), LayoutOrder = i, ZIndex = Z }, list, C.Navy2)
				label(row, { Size = UDim2.new(0.6, 0, 0, 28), Position = UDim2.fromOffset(16, 8), Text = string.format(def.text, def.worldScaled and F.Format(goal) or goal), TextXAlignment = Enum.TextXAlignment.Left })
				local _, set = UI.bar({ Size = UDim2.new(0.55, 0, 0, 18), Position = UDim2.fromOffset(16, 46), ZIndex = Z + 1 }, row, C.Green)
				set(progress / goal, true)
				label(row, { Size = UDim2.new(0.55, 0, 0, 16), Position = UDim2.fromOffset(16, 47), Text = F.Format(progress) .. &quot; / &quot; .. F.Format(goal), ZIndex = Z + 3 })
				local reward = math.floor(Config.QuestRewardBase * def.reward * mult)
				local done = progress &gt;= goal
				local b = UI.button({ Size = UDim2.fromOffset(200, 50), Position = UDim2.new(1, -214, 0.5, -25), Text = q.claimed and &quot;RECUPEREE&quot; or F.Format(reward), ZIndex = Z + 1 }, row, q.claimed and GREY or (done and C.Green or C.Navy2))
				if not q.claimed then
					Icons.Image(&quot;coin&quot;, b, { Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(0, 5), ZIndex = Z + 3 })
					b.Activated:Connect(function()
						act(&quot;claimQuest&quot;, i)
					end)
				end
			end
		end
		section(list, &quot;Succes permanents&quot;, 10)
		for i, m in ipairs(Config.Milestones) do
			local claimed = d.Milestones[m.id]
			local value = milestoneValue(d, m.stat)
			local done = value &gt;= m.goal
			local row = UI.card({ Size = UDim2.new(1, -14, 0, 62), LayoutOrder = 10 + i, ZIndex = Z }, list, claimed and C.Purple2 or C.Navy2)
			label(row, { Size = UDim2.new(0.6, 0, 0, 26), Position = UDim2.fromOffset(16, 6), Text = m.text, TextXAlignment = Enum.TextXAlignment.Left })
			label(row, { Size = UDim2.new(0.6, 0, 0, 20), Position = UDim2.fromOffset(16, 34), Text = F.Format(math.min(value, m.goal)) .. &quot; / &quot; .. F.Format(m.goal), TextColor3 = C.Sub, TextXAlignment = Enum.TextXAlignment.Left })
			local b = UI.button({ Size = UDim2.fromOffset(200, 44), Position = UDim2.new(1, -214, 0.5, -22), Text = claimed and &quot;TERMINE&quot; or F.Format(m.coins), ZIndex = Z + 1 }, row, claimed and GREY or (done and C.Green or C.Navy2))
			if not claimed then
				Icons.Image(&quot;coin&quot;, b, { Size = UDim2.fromOffset(28, 28), Position = UDim2.fromOffset(0, 3), ZIndex = Z + 3 })
				b.Activated:Connect(function()
					act(&quot;claimMilestone&quot;, m.id)
				end)
			end
		end
	end,
})

-- TRADING ---------------------------------------------------------------------------------------------------
local function offerGrid(parent, items, pos, size, removable)
	local g = UI.new(&quot;Frame&quot;, { Size = size, Position = pos, BackgroundColor3 = C.Dark, BackgroundTransparency = 0.4, ZIndex = Z }, parent)
	UI.corner(g, 12)
	UI.pad(g, 6)
	UI.new(&quot;UIGridLayout&quot;, { CellSize = UDim2.fromOffset(72, 84), CellPadding = UDim2.fromOffset(6, 6) }, g)
	for i, it in ipairs(items) do
		local tile = PanelsA.RelicTile(g, it.id, { order = i })
		if removable then
			tile.Activated:Connect(function()
				act(&quot;tradeRemove&quot;, it.uid)
			end)
		end
	end
	return g
end

Window.Register(&quot;Trading&quot;, {
	title = &quot;ECHANGES&quot;,
	icon = &quot;trading&quot;,
	refreshOn = { data = true, trade = true },
	build = function(root)
		local d = State.data
		local t = State.trade
		if t then
			label(root, { Size = UDim2.new(0.5, -10, 0, 28), Text = &quot;Ton offre&quot;, TextColor3 = C.Gold, TextXAlignment = Enum.TextXAlignment.Left })
			label(root, { Size = UDim2.new(0.5, -10, 0, 28), Position = UDim2.new(0.5, 10, 0, 0), Text = &quot;Offre de &quot; .. t.partner, TextColor3 = C.Gold, TextXAlignment = Enum.TextXAlignment.Left })
			offerGrid(root, t.mine, UDim2.fromOffset(0, 32), UDim2.new(0.5, -10, 0, 186), true)
			offerGrid(root, t.theirs, UDim2.new(0.5, 10, 0, 32), UDim2.new(0.5, -10, 0, 186), false)
			label(root, { Size = UDim2.new(0.5, -10, 0, 22), Position = UDim2.fromOffset(0, 222), Text = t.myReady and &quot;Tu as valide&quot; or &quot;Pas encore valide&quot;, TextColor3 = t.myReady and C.Green or C.Sub })
			label(root, { Size = UDim2.new(0.5, -10, 0, 22), Position = UDim2.new(0.5, 10, 0, 222), Text = t.theirReady and (t.partner .. &quot; a valide&quot;) or &quot;En attente...&quot;, TextColor3 = t.theirReady and C.Green or C.Sub })
			-- inventaire pour ajouter
			local inv = UI.scroll({ Name = &quot;TradeInv&quot;, Size = UDim2.new(1, -240, 1, -258), Position = UDim2.fromOffset(0, 254), ZIndex = Z }, root)
			UI.new(&quot;UIGridLayout&quot;, { CellSize = UDim2.fromOffset(72, 84), CellPadding = UDim2.fromOffset(6, 6) }, inv)
			local offered = {}
			for _, it in ipairs(t.mine) do
				offered[it.uid] = true
			end
			local list = {}
			for k, item in pairs(d.Relics) do
				local def = Config.RelicById[item.id]
				if def and not offered[tonumber(k)] and not item.locked then
					table.insert(list, { uid = tonumber(k), def = def })
				end
			end
			table.sort(list, function(a, b)
				return a.def.power &gt; b.def.power
			end)
			for i, e in ipairs(list) do
				local tile = PanelsA.RelicTile(inv, e.def.id, { order = i })
				tile.Activated:Connect(function()
					act(&quot;tradeAdd&quot;, e.uid)
				end)
			end
			local status = t.countdown and (&quot;Echange dans &quot; .. math.max(0, t.countdown - os.time()) .. &quot; s...&quot;) or &quot;Clique sur tes reliques pour les proposer&quot;
			label(root, { Size = UDim2.fromOffset(220, 60), Position = UDim2.new(1, -220, 0, 254), Text = status, TextWrapped = true, TextColor3 = t.countdown and C.Gold or C.Sub })
			local ready = UI.button({ Size = UDim2.fromOffset(220, 56), Position = UDim2.new(1, -220, 1, -132), Text = t.myReady and &quot;ANNULER VALIDATION&quot; or &quot;VALIDER&quot;, ZIndex = Z }, root, t.myReady and C.Gold or C.Green)
			ready.Activated:Connect(function()
				act(&quot;tradeReady&quot;, not t.myReady)
			end)
			local cancel = UI.button({ Size = UDim2.fromOffset(220, 50), Position = UDim2.new(1, -220, 1, -62), Text = &quot;QUITTER&quot;, ZIndex = Z }, root, C.Red)
			cancel.Activated:Connect(function()
				act(&quot;tradeCancel&quot;)
			end)
			return
		end
		local list = UI.scroll({ Name = &quot;TradePlayers&quot;, Size = UDim2.fromScale(1, 1), ZIndex = Z }, root)
		UI.list(list, 8)
		local order = 0
		if next(State.requests) then
			section(list, &quot;Demandes recues&quot;, 0)
			for fromId, r in pairs(State.requests) do
				order += 1
				local row = UI.card({ Size = UDim2.new(1, -14, 0, 64), LayoutOrder = order, ZIndex = Z }, list, C.Purple2)
				label(row, { Size = UDim2.new(0.5, 0, 0, 30), Position = UDim2.fromOffset(16, 17), Text = r.name, TextXAlignment = Enum.TextXAlignment.Left })
				local a = UI.button({ Size = UDim2.fromOffset(150, 46), Position = UDim2.new(1, -330, 0.5, -23), Text = &quot;ACCEPTER&quot;, ZIndex = Z + 1 }, row, C.Green)
				a.Activated:Connect(function()
					act(&quot;tradeAccept&quot;, fromId)
					State.requests[fromId] = nil
				end)
				local dcl = UI.button({ Size = UDim2.fromOffset(150, 46), Position = UDim2.new(1, -164, 0.5, -23), Text = &quot;REFUSER&quot;, ZIndex = Z + 1 }, row, C.Red)
				dcl.Activated:Connect(function()
					act(&quot;tradeDecline&quot;, fromId)
					State.requests[fromId] = nil
					Window.Render()
				end)
			end
		end
		section(list, &quot;Joueurs du serveur&quot;, 100)
		local any = false
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				any = true
				order += 1
				local row = UI.card({ Size = UDim2.new(1, -14, 0, 64), LayoutOrder = 100 + order, ZIndex = Z }, list, C.Navy2)
				label(row, { Size = UDim2.new(0.5, 0, 0, 30), Position = UDim2.fromOffset(16, 6), Text = p.DisplayName, TextXAlignment = Enum.TextXAlignment.Left })
				label(row, { Size = UDim2.new(0.5, 0, 0, 20), Position = UDim2.fromOffset(16, 38), Text = &quot;Puissance &quot; .. F.Format(p:GetAttribute(&quot;Power&quot;) or 0), TextColor3 = C.Sub, TextXAlignment = Enum.TextXAlignment.Left })
				local b = UI.button({ Size = UDim2.fromOffset(180, 46), Position = UDim2.new(1, -194, 0.5, -23), Text = &quot;ECHANGER&quot;, ZIndex = Z + 1 }, row, C.Blue)
				b.Activated:Connect(function()
					act(&quot;tradeRequest&quot;, p.UserId)
				end)
			end
		end
		if not any then
			label(list, { Size = UDim2.new(1, -14, 0, 60), LayoutOrder = 200, Text = &quot;Aucun autre joueur sur ce serveur pour l'instant.&quot;, TextColor3 = C.Sub })
		end
	end,
})

-- BOSS ------------------------------------------------------------------------------------------------------
Window.Register(&quot;Boss&quot;, {
	title = &quot;BOSS&quot;,
	icon = &quot;boss&quot;,
	refreshOn = { boss = true },
	build = function(root)
		local d = State.data
		label(root, { Size = UDim2.new(1, 0, 0, 26), Text = &quot;Clique sur un boss pour que tes reliques l'attaquent. Recompenses partagees selon les degats !&quot;, TextColor3 = C.Sub })
		local list = UI.scroll({ Name = &quot;BossList&quot;, Size = UDim2.new(1, 0, 1, -34), Position = UDim2.fromOffset(0, 34), ZIndex = Z }, root)
		UI.list(list, 8)
		for i, w in ipairs(Config.Worlds) do
			local st = State.boss[w.id] or {}
			local bossRelic
			for _, r in ipairs(Config.Relics) do
				if r.boss and r.world == w.id then
					bossRelic = r
				end
			end
			local row = UI.card({ Size = UDim2.new(1, -14, 0, 96), LayoutOrder = i, ZIndex = Z }, list, w.color:Lerp(C.Navy, 0.55))
			RelicView.Viewport(bossRelic.id, row, { Size = UDim2.fromOffset(84, 84), Position = UDim2.fromOffset(6, 6), ZIndex = Z + 1 }, not d.Index[bossRelic.id], true)
			label(row, { Size = UDim2.new(0.45, 0, 0, 30), Position = UDim2.fromOffset(100, 8), Text = Config.Boss[w.id].name, TextXAlignment = Enum.TextXAlignment.Left })
			label(row, { Size = UDim2.new(0.45, 0, 0, 20), Position = UDim2.fromOffset(100, 40), Text = w.name .. &quot;  -  relique : &quot; .. bossRelic.name .. &quot; (&quot; .. math.floor(Config.BossRelicChance * 100) .. &quot; %)&quot;, TextColor3 = C.Sub, TextXAlignment = Enum.TextXAlignment.Left })
			if st.alive and (st.maxHp or 0) &gt; 0 then
				local _, set = UI.bar({ Size = UDim2.new(0.45, 0, 0, 16), Position = UDim2.fromOffset(100, 68), ZIndex = Z + 1 }, row, Color3.fromRGB(190, 90, 255))
				set(st.hp / st.maxHp, true)
			else
				local left = st.respawnAt and math.max(0, st.respawnAt - State.bossTime) or 0
				label(row, { Size = UDim2.new(0.45, 0, 0, 20), Position = UDim2.fromOffset(100, 66), Text = &quot;Reapparait dans &quot; .. F.Time(left), TextColor3 = C.Gold, TextXAlignment = Enum.TextXAlignment.Left })
			end
			local unlocked = d.Worlds[w.id]
			local b = UI.button({ Size = UDim2.fromOffset(180, 52), Position = UDim2.new(1, -194, 0.5, -26), Text = unlocked and &quot;Y ALLER&quot; or &quot;VERROUILLE&quot;, ZIndex = Z + 1 }, row, unlocked and C.Purple or GREY)
			if unlocked then
				b.Activated:Connect(function()
					act(&quot;teleport&quot;, w.id)
					Window.Close()
				end)
			end
		end
	end,
})

-- DAILY REWARDS ------------------------------------------------------------------------------------------------
Window.Register(&quot;Daily&quot;, {
	title = &quot;RECOMPENSES QUOTIDIENNES&quot;,
	icon = &quot;daily&quot;,
	refreshOn = { data = true },
	build = function(root)
		local d = State.data
		local since = os.time() - d.LastDaily
		local ready = since &gt;= Config.Daily.Cooldown
		local nextDay = (since &lt; Config.Daily.Reset) and (d.DailyStreak % #Config.Daily.Days) + 1 or 1
		local grid = UI.new(&quot;Frame&quot;, { Size = UDim2.new(1, 0, 0, 330), BackgroundTransparency = 1, ZIndex = Z }, root)
		local layout = UI.new(&quot;UIGridLayout&quot;, { CellSize = UDim2.fromOffset(170, 158), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		local mult = F.BestWorld(d).mult
		for i, day in ipairs(Config.Daily.Days) do
			local claimedToday = not ready and i == d.DailyStreak
			local isNext = ready and i == nextDay
			local passed = (i &lt; nextDay and ready) or (not ready and i &lt;= d.DailyStreak)
			local card = UI.card({ LayoutOrder = i, ZIndex = Z }, grid, isNext and C.Purple or (passed and Color3.fromRGB(60, 120, 80) or C.Navy2))
			if isNext then
				UI.stroke(card, C.Gold, 4)
			end
			label(card, { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 6), Text = &quot;Jour &quot; .. i, TextColor3 = C.Gold })
			local icon = day.crate and &quot;crate&quot; or (day.potion and &quot;power&quot; or &quot;coin&quot;)
			Icons.Image(icon, card, { Size = UDim2.fromOffset(64, 64), Position = UDim2.new(0.5, -32, 0, 38), ZIndex = Z + 1 })
			local text = day.coins and F.Format(day.coins * mult) or &quot;&quot;
			if day.potion then
				for _, it in ipairs(Config.Shop) do
					if it.id == day.potion then
						text = it.name
					end
				end
			end
			if day.crate then
				text = day.crate .. &quot; reliques + &quot; .. F.Format(day.coins * mult)
			end
			label(card, { Size = UDim2.new(1, -12, 0, 36), Position = UDim2.fromOffset(6, 108), Text = text, TextWrapped = true })
			if passed or claimedToday then
				Icons.Image(&quot;check&quot;, card, { Size = UDim2.fromOffset(36, 36), Position = UDim2.new(1, -40, 0, 4), ZIndex = Z + 2 })
			end
		end
		local b = UI.button({ Size = UDim2.fromOffset(340, 64), Position = UDim2.new(0.5, -170, 1, -72), Text = ready and &quot;RECUPERER&quot; or (&quot;Prochaine dans &quot; .. F.Time(Config.Daily.Cooldown - since)), ZIndex = Z }, root, ready and C.Green or GREY)
		b.Activated:Connect(function()
			if ready then
				act(&quot;daily&quot;)
			end
		end)
	end,
})

-- LEADERBOARD ------------------------------------------------------------------------------------------------
local topCache = {}
Window.Register(&quot;Leaderboard&quot;, {
	title = &quot;CLASSEMENT&quot;,
	icon = &quot;leaderboard&quot;,
	build = function(root, ctx)
		ctx.tab = ctx.tab or &quot;Server&quot;
		local tabs = UI.new(&quot;Frame&quot;, { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, ZIndex = Z }, root)
		UI.list(tabs, 8, true)
		for i, t in ipairs({ { &quot;Server&quot;, &quot;SERVEUR&quot; }, { &quot;Power&quot;, &quot;PUISSANCE&quot; }, { &quot;Rebirths&quot;, &quot;RENAISSANCES&quot; }, { &quot;Index&quot;, &quot;INDEX&quot; } }) do
			local b = UI.button({ Size = UDim2.fromOffset(170, 40), Text = t[2], LayoutOrder = i, ZIndex = Z }, tabs, ctx.tab == t[1] and C.Gold or C.Navy2)
			b.Activated:Connect(function()
				ctx.tab = t[1]
				Window.Render()
			end)
		end
		local list = UI.scroll({ Name = &quot;Board&quot;, Size = UDim2.new(1, 0, 1, -54), Position = UDim2.fromOffset(0, 54), ZIndex = Z }, root)
		UI.list(list, 6)
		local rows = {}
		if ctx.tab == &quot;Server&quot; then
			for _, p in ipairs(Players:GetPlayers()) do
				table.insert(rows, { name = p.DisplayName, value = p:GetAttribute(&quot;Power&quot;) or 0, me = p == player, extra = &quot;Renaissances &quot; .. (p:GetAttribute(&quot;Rebirths&quot;) or 0) })
			end
			table.sort(rows, function(a, b)
				return a.value &gt; b.value
			end)
		else
			local data = topCache[ctx.tab]
			if not data then
				label(list, { Size = UDim2.new(1, -14, 0, 40), Text = &quot;Chargement du classement mondial...&quot;, TextColor3 = C.Sub })
				task.spawn(function()
					local ok, res = pcall(function()
						return Remotes.Query:InvokeServer(&quot;top&quot;, ctx.tab)
					end)
					topCache[ctx.tab] = ok and res or {}
					task.delay(60, function()
						topCache[ctx.tab] = nil
					end)
					if Window.Current == &quot;Leaderboard&quot; then
						Window.Render()
					end
				end)
				return
			end
			for _, e in ipairs(data) do
				table.insert(rows, { name = e.name, value = e.value, me = e.userId == player.UserId })
			end
			if #rows == 0 then
				label(list, { Size = UDim2.new(1, -14, 0, 40), Text = &quot;Classement vide pour l'instant (sauvegarde requise).&quot;, TextColor3 = C.Sub })
			end
		end
		for i, r in ipairs(rows) do
			local medal = ({ C.Gold, Color3.fromRGB(200, 205, 220), Color3.fromRGB(220, 140, 80) })[i]
			local row = UI.card({ Size = UDim2.new(1, -14, 0, 54), LayoutOrder = i, ZIndex = Z }, list, r.me and C.Purple or C.Navy2)
			local badge = UI.new(&quot;Frame&quot;, { Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(8, 7), BackgroundColor3 = medal or C.Navy, ZIndex = Z + 1 }, row)
			UI.corner(badge, 20)
			label(badge, { Size = UDim2.fromScale(1, 1), Text = tostring(i), ZIndex = Z + 2 })
			label(row, { Size = UDim2.new(0.5, 0, 0, 28), Position = UDim2.fromOffset(60, 13), Text = r.name, TextXAlignment = Enum.TextXAlignment.Left })
			label(row, { Size = UDim2.new(0.4, -20, 0, 28), Position = UDim2.new(0.6, 0, 0, 13), Text = F.Format(r.value), TextColor3 = C.Gold, TextXAlignment = Enum.TextXAlignment.Right })
		end
	end,
})

-- SETTINGS ------------------------------------------------------------------------------------------------------
Window.Register(&quot;Settings&quot;, {
	title = &quot;PARAMETRES&quot;,
	icon = &quot;settings&quot;,
	refreshOn = { data = true },
	build = function(root)
		local d = State.data
		local s = d.Settings
		local list = UI.scroll({ Name = &quot;SettingsList&quot;, Size = UDim2.fromScale(1, 1), ZIndex = Z }, root)
		UI.list(list, 10)
		local function toggle(order, key, name, desc)
			local row = UI.card({ Size = UDim2.new(1, -14, 0, 70), LayoutOrder = order, ZIndex = Z }, list, C.Navy2)
			label(row, { Size = UDim2.new(0.6, 0, 0, 28), Position = UDim2.fromOffset(16, 8), Text = name, TextXAlignment = Enum.TextXAlignment.Left })
			label(row, { Size = UDim2.new(0.6, 0, 0, 20), Position = UDim2.fromOffset(16, 40), Text = desc, TextColor3 = C.Sub, TextXAlignment = Enum.TextXAlignment.Left })
			local on = s[key] ~= false
			local b = UI.button({ Size = UDim2.fromOffset(150, 48), Position = UDim2.new(1, -164, 0.5, -24), Text = on and &quot;ACTIVE&quot; or &quot;DESACTIVE&quot;, ZIndex = Z + 1 }, row, on and C.Green or GREY)
			b.Activated:Connect(function()
				act(&quot;settings&quot;, { [key] = not on })
			end)
		end
		local function slider(order, key, name)
			local row = UI.card({ Size = UDim2.new(1, -14, 0, 70), LayoutOrder = order, ZIndex = Z }, list, C.Navy2)
			label(row, { Size = UDim2.new(0.4, 0, 0, 28), Position = UDim2.fromOffset(16, 20), Text = name, TextXAlignment = Enum.TextXAlignment.Left })
			local v = s[key] or 0.5
			local _, set = UI.bar({ Size = UDim2.new(0, 220, 0, 20), Position = UDim2.new(1, -380, 0.5, -10), ZIndex = Z + 1 }, row, C.Gold)
			set(v, true)
			local minus = UI.button({ Size = UDim2.fromOffset(56, 48), Position = UDim2.new(1, -140, 0.5, -24), Text = &quot;-&quot;, ZIndex = Z + 1 }, row, C.Purple)
			minus.Activated:Connect(function()
				act(&quot;settings&quot;, { [key] = math.max(0, math.floor((v - 0.1) * 10 + 0.5) / 10) })
			end)
			local plus = UI.button({ Size = UDim2.fromOffset(56, 48), Position = UDim2.new(1, -72, 0.5, -24), Text = &quot;+&quot;, ZIndex = Z + 1 }, row, C.Purple)
			plus.Activated:Connect(function()
				act(&quot;settings&quot;, { [key] = math.min(1, math.floor((v + 0.1) * 10 + 0.5) / 10) })
			end)
		end
		slider(1, &quot;Music&quot;, &quot;Musique&quot;)
		slider(2, &quot;Sfx&quot;, &quot;Effets sonores&quot;)
		toggle(3, &quot;ShowOthers&quot;, &quot;Reliques des autres joueurs&quot;, &quot;Afficher les reliques qui flottent autour des autres&quot;)
		toggle(4, &quot;LowGraphics&quot;, &quot;Mode performance&quot;, &quot;Moins de particules et d'ombres (appareils modestes)&quot;)
		toggle(5, &quot;DamageNumbers&quot;, &quot;Chiffres de degats&quot;, &quot;Afficher les degats au-dessus des cibles&quot;)
		if d.Perks.AutoHit then
			toggle(6, &quot;AutoHit&quot;, &quot;Frappe automatique&quot;, &quot;Tes reliques attaquent seules le tresor le plus proche&quot;)
		end
	end,
})

return PanelsB
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">RelicOrbit</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Reliques equipees de TOUS les joueurs : elles tournent et flottent autour du personnage.
-- Quand le joueur vise un tresor ou un boss, elles volent autour de la cible et foncent dessus
-- a chaque coup (etincelles). Calcul local, aucun cout reseau ; parametre &quot;voir les reliques des autres&quot;.

local HttpService = game:GetService(&quot;HttpService&quot;)
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local RelicModel = require(ReplicatedStorage.Shared.RelicModel)
local State = require(script.Parent.State)

local RelicOrbit = {}

local local_ = Players.LocalPlayer
local folder
local entries = {} -- [player] = { json, relics = { {model, parts, offsets, pos} } }

local function settings()
	return State.data and State.data.Settings or {}
end

local function clear(entry)
	for _, r in ipairs(entry.relics) do
		r.model:Destroy()
	end
	entry.relics = {}
end

local function rebuild(player)
	local entry = entries[player]
	if not entry then
		entry = { json = &quot;&quot;, relics = {} }
		entries[player] = entry
	end
	local json = player:GetAttribute(&quot;Relics&quot;) or &quot;[]&quot;
	local hidden = player ~= local_ and settings().ShowOthers == false
	local key = json .. tostring(hidden) .. tostring(settings().LowGraphics)
	if key == entry.json then
		return
	end
	entry.json = key
	clear(entry)
	if hidden then
		return
	end
	local ok, ids = pcall(HttpService.JSONDecode, HttpService, json)
	if not ok or type(ids) ~= &quot;table&quot; then
		return
	end
	local hrp = player.Character and player.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
	for i, id in ipairs(ids) do
		local model = RelicModel.Build(id, { effects = not settings().LowGraphics })
		model:ScaleTo(0.85)
		local parts, offsets = RelicModel.Parts(model)
		model.Parent = folder
		table.insert(entry.relics, {
			model = model,
			parts = parts,
			offsets = offsets,
			pos = hrp and hrp.Position or Vector3.zero,
			phase = i * 1.7,
			rarity = Config.RarityById[Config.RelicById[id] and Config.RelicById[id].rarity or &quot;Common&quot;].index,
		})
	end
end

local function hook(player)
	player:GetAttributeChangedSignal(&quot;Relics&quot;):Connect(function()
		rebuild(player)
	end)
	rebuild(player)
end

local lastHit = 0
local function update(dt)
	local now = os.clock()
	local targets = workspace:FindFirstChild(&quot;Targets&quot;)
	local allParts, allCFs = {}, {}
	local camPos = workspace.CurrentCamera.CFrame.Position
	local hitPhase = (now % Config.HitInterval) / Config.HitInterval
	for player, entry in pairs(entries) do
		local hrp = player.Character and player.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
		if player.Parent ~= Players then
			clear(entry)
			entries[player] = nil
		elseif hrp and #entry.relics &gt; 0 and (hrp.Position - camPos).Magnitude &lt; 300 then
			local tname = player:GetAttribute(&quot;Target&quot;)
			local target = tname and targets and targets:FindFirstChild(tname)
			local tbox = target and target.PrimaryPart
			local n = #entry.relics
			for i, r in ipairs(entry.relics) do
				local a = now * 1.4 + i / n * math.pi * 2
				local goal
				if tbox then
					local radius = math.max(tbox.Size.X, tbox.Size.Z) / 2 + 2.5
					local dash = math.sin(hitPhase * math.pi) ^ 4 -- foncer sur la cible a chaque coup
					local rr = radius * (1 - dash * 0.55)
					goal = tbox.Position + Vector3.new(math.cos(a) * rr, -tbox.Size.Y * 0.15 + math.sin(now * 3 + i) * 0.8, math.sin(a) * rr)
				else
					local radius = 3.6 + n * 0.25
					goal = hrp.Position + Vector3.new(math.cos(a) * radius, 1.2 + math.sin(now * 2 + r.phase) * 0.7, math.sin(a) * radius)
				end
				local alpha = math.clamp(dt * (tbox and 10 or 7), 0, 1)
				r.pos = r.pos:Lerp(goal, alpha)
				if (r.pos - goal).Magnitude &gt; 120 then
					r.pos = goal
				end
				local cf = CFrame.new(r.pos) * CFrame.Angles(math.sin(now + i) * 0.3, now * (1.5 + r.rarity * 0.15) + i, 0)
				for k, p in ipairs(r.parts) do
					table.insert(allParts, p)
					table.insert(allCFs, cf * r.offsets[k])
				end
			end
		end
	end
	if #allParts &gt; 0 then
		workspace:BulkMoveTo(allParts, allCFs, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function RelicOrbit.Refresh()
	for p in pairs(entries) do
		rebuild(p)
	end
end

function RelicOrbit.Init()
	folder = Instance.new(&quot;Folder&quot;)
	folder.Name = &quot;ClientRelics&quot;
	folder.Parent = workspace
	for _, p in ipairs(Players:GetPlayers()) do
		hook(p)
	end
	Players.PlayerAdded:Connect(hook)
	State.Changed.Event:Connect(function(what)
		if what == &quot;data&quot; then
			RelicOrbit.Refresh()
		end
	end)
	RunService.RenderStepped:Connect(update)
end

return RelicOrbit
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">RelicView</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Icones 3D des reliques dans l'interface (ViewportFrame) + cadre colore de rarete.
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local RelicModel = require(ReplicatedStorage.Shared.RelicModel)
local Icons = require(ReplicatedStorage.Shared.Icons)

local RelicView = {}
local spinning = {}
local bobbing = {}

-- Cree un ViewportFrame montrant la relique ; silhouette = relique non decouverte
function RelicView.Viewport(relicId, parent, props, silhouette, spin)
	local vp = Instance.new(&quot;ViewportFrame&quot;)
	vp.BackgroundTransparency = 1
	vp.Ambient = Color3.fromRGB(200, 200, 220)
	vp.LightColor = Color3.fromRGB(255, 250, 240)
	vp.LightDirection = Vector3.new(-1, -1.2, -0.8)
	for k, v in pairs(props or {}) do
		vp[k] = v
	end
	local model = RelicModel.Build(relicId, { effects = false, silhouette = silhouette })
	model:PivotTo(CFrame.new())
	model.Parent = vp
	local cam = Instance.new(&quot;Camera&quot;)
	cam.FieldOfView = 30
	cam.CFrame = CFrame.lookAt(Vector3.new(0, 0.6, -5.4), Vector3.zero)
	cam.Parent = vp
	vp.CurrentCamera = cam
	if spin then
		spinning[vp] = { model = model, angle = math.random() * 6 }
		vp.Destroying:Connect(function()
			spinning[vp] = nil
		end)
	end
	vp.Parent = parent
	return vp
end

-- Icone de la relique : l'illustration de la planche si elle existe, sinon le modele 3D.
-- silhouette = relique non decouverte (ombre sombre)
function RelicView.Icon(relicId, parent, props, silhouette, spin)
	local def = Config.RelicById[relicId]
	local key = def and def.img and (&quot;relic_&quot; .. def.img)
	if key and Icons.Has(key) then
		local img = Icons.Image(key, parent, props)
		if silhouette then
			img.ImageColor3 = Color3.fromRGB(14, 10, 32)
		end
		if spin then
			-- leger balancement pour donner de la vie a l'illustration
			bobbing[img] = { base = img.Rotation, phase = math.random() * 6 }
			img.Destroying:Connect(function()
				bobbing[img] = nil
			end)
		end
		return img
	end
	return RelicView.Viewport(relicId, parent, props, silhouette, spin)
end

function RelicView.RarityColor(relicId)
	local def = Config.RelicById[relicId]
	return def and Config.RarityById[def.rarity].color or Color3.new(1, 1, 1)
end

RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	for img, b in pairs(bobbing) do
		if img.Parent then
			img.Rotation = math.sin(t * 2 + b.phase) * 6
		end
	end
	for vp, s in pairs(spinning) do
		if vp.Parent and vp.Visible then
			s.angle += dt * 1.2
			s.model:PivotTo(CFrame.Angles(0, s.angle, 0))
		end
	end
end)

return RelicView
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">State</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Etat local : donnees du joueur, boss, echange en cours.
local State = {
	data = nil,
	extra = { power = 0, discovered = 0, count = 0, serverTime = os.time() },
	syncClock = os.clock(),
	boss = {},
	bossTime = os.time(),
	trade = nil,
	requests = {},
}
State.Changed = Instance.new(&quot;BindableEvent&quot;) -- (&quot;data&quot; | &quot;boss&quot; | &quot;trade&quot;)

function State.Now()
	return State.extra.serverTime + (os.clock() - State.syncClock)
end

return State
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">UI</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Kit d'interface RELIC RUSH : bleu nuit, violet, or ; coins arrondis, contours dores, animations.
local TweenService = game:GetService(&quot;TweenService&quot;)

local UI = {}

UI.C = {
	Navy = Color3.fromRGB(18, 20, 52),
	Navy2 = Color3.fromRGB(30, 30, 80),
	Purple = Color3.fromRGB(110, 60, 200),
	Purple2 = Color3.fromRGB(70, 35, 140),
	Gold = Color3.fromRGB(255, 200, 60),
	Gold2 = Color3.fromRGB(230, 150, 30),
	Text = Color3.fromRGB(255, 250, 240),
	Sub = Color3.fromRGB(185, 180, 225),
	Green = Color3.fromRGB(90, 210, 100),
	Red = Color3.fromRGB(235, 80, 90),
	Blue = Color3.fromRGB(70, 160, 255),
	Dark = Color3.fromRGB(20, 12, 35),
}
local C = UI.C
UI.Font = Enum.Font.FredokaOne

-- cles de configuration propres au kit (pas des proprietes Roblox)
local CUSTOM = { Stroke = true, StrokeThickness = true, Radius = true }

function UI.new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		if not CUSTOM[k] then
			o[k] = v
		end
	end
	if parent then
		o.Parent = parent
	end
	return o
end

function UI.corner(o, r)
	return UI.new(&quot;UICorner&quot;, { CornerRadius = UDim.new(0, r or 14) }, o)
end

function UI.stroke(o, color, t, transp)
	return UI.new(&quot;UIStroke&quot;, { Color = color or C.Gold, Thickness = t or 3, Transparency = transp or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end

function UI.gradient(o, a, b, rot)
	return UI.new(&quot;UIGradient&quot;, { Color = ColorSequence.new(a, b), Rotation = rot or 90 }, o)
end

function UI.pad(o, p)
	return UI.new(&quot;UIPadding&quot;, { PaddingTop = UDim.new(0, p), PaddingBottom = UDim.new(0, p), PaddingLeft = UDim.new(0, p), PaddingRight = UDim.new(0, p) }, o)
end

-- Panneau : degrade bleu nuit -&gt; violet, contour dore
function UI.panel(props, parent, flat)
	local f = UI.new(&quot;Frame&quot;, props, parent)
	f.BorderSizePixel = 0
	f.BackgroundColor3 = props.BackgroundColor3 or Color3.new(1, 1, 1)
	UI.corner(f, props.Radius or 18)
	if not flat then
		UI.gradient(f, C.Navy2, C.Navy, 90)
		UI.stroke(f, C.Gold, 3)
	end
	return f
end

-- Carte interieure (plus sombre)
function UI.card(props, parent, color)
	local f = UI.new(&quot;Frame&quot;, props, parent)
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color or C.Purple2
	UI.corner(f, props.Radius or 14)
	UI.gradient(f, Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 200), 90)
	UI.stroke(f, Color3.fromRGB(255, 255, 255), 2, 0.75)
	return f
end

function UI.text(props, parent)
	local t = UI.new(&quot;TextLabel&quot;, props, parent)
	t.BackgroundTransparency = 1
	t.Font = props.Font or UI.Font
	t.TextColor3 = props.TextColor3 or C.Text
	if props.TextSize == nil then
		t.TextScaled = true
	end
	if props.Stroke ~= false then
		UI.new(&quot;UIStroke&quot;, { Color = C.Dark, Thickness = props.StrokeThickness or 2, Transparency = 0.1 }, t)
	end
	return t
end

-- Bouton 3D (degrade + ombre portee + rebond)
function UI.button(props, parent, color)
	color = color or C.Gold
	local holder = UI.new(&quot;Frame&quot;, { Size = props.Size, Position = props.Position, AnchorPoint = props.AnchorPoint or Vector2.zero, BackgroundTransparency = 1, LayoutOrder = props.LayoutOrder or 0, ZIndex = props.ZIndex or 1 }, parent)
	local shadow = UI.new(&quot;Frame&quot;, { Size = UDim2.new(1, 0, 1, 0), Position = UDim2.fromOffset(0, 4), BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.45), BorderSizePixel = 0, ZIndex = holder.ZIndex }, holder)
	UI.corner(shadow, props.Radius or 12)
	local b = UI.new(&quot;TextButton&quot;, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BorderSizePixel = 0, AutoButtonColor = false, Text = props.Text or &quot;&quot;, Font = UI.Font, TextScaled = true, TextColor3 = props.TextColor3 or Color3.new(1, 1, 1), ZIndex = holder.ZIndex + 1 }, holder)
	UI.corner(b, props.Radius or 12)
	UI.gradient(b, color:Lerp(Color3.new(1, 1, 1), 0.25), color:Lerp(Color3.new(0, 0, 0), 0.1), 90)
	UI.new(&quot;UIStroke&quot;, { Color = C.Dark, Thickness = 2, Transparency = 0.2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, b)
	UI.new(&quot;UIStroke&quot;, { Color = C.Dark, Thickness = 2, Transparency = 0.1 }, b)
	UI.new(&quot;UIPadding&quot;, { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5) }, b)
	local scale = UI.new(&quot;UIScale&quot;, {}, holder)
	b.MouseEnter:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1.05 })
	end)
	b.MouseLeave:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		UI.tween(scale, 0.06, { Scale = 0.93 })
	end)
	b.MouseButton1Up:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1.05 })
	end)
	holder:SetAttribute(&quot;Button&quot;, true)
	return b, holder
end

function UI.setButtonColor(b, color)
	b.BackgroundColor3 = color
	local g = b:FindFirstChildOfClass(&quot;UIGradient&quot;)
	if g then
		g.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.25), color:Lerp(Color3.new(0, 0, 0), 0.1))
	end
	local shadow = b.Parent:FindFirstChildWhichIsA(&quot;Frame&quot;)
	if shadow then
		shadow.BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.45)
	end
end

function UI.tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

function UI.bar(props, parent, color)
	local back = UI.new(&quot;Frame&quot;, props, parent)
	back.BackgroundColor3 = C.Dark
	back.BorderSizePixel = 0
	UI.corner(back, 99)
	UI.new(&quot;UIStroke&quot;, { Color = C.Dark, Thickness = 2 }, back)
	local fill = UI.new(&quot;Frame&quot;, { Size = UDim2.fromScale(0, 1), BackgroundColor3 = color or C.Green, BorderSizePixel = 0, ZIndex = back.ZIndex }, back)
	UI.corner(fill, 99)
	UI.gradient(fill, (color or C.Green):Lerp(Color3.new(1, 1, 1), 0.3), color or C.Green, 90)
	return back, function(r, instant)
		r = math.clamp(r, 0, 1)
		if instant then
			fill.Size = UDim2.fromScale(r, 1)
		else
			UI.tween(fill, 0.2, { Size = UDim2.fromScale(r, 1) })
		end
	end, fill
end

function UI.list(parent, padding, horizontal)
	return UI.new(&quot;UIListLayout&quot;, { Padding = UDim.new(0, padding or 8), FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder }, parent)
end

function UI.scroll(props, parent)
	local s = UI.new(&quot;ScrollingFrame&quot;, props, parent)
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.ScrollBarThickness = 8
	s.ScrollBarImageColor3 = C.Gold
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.CanvasSize = UDim2.new()
	return s
end

return UI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">Window</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Fenetres de l'interface : une seule ouverte a la fois, en-tete avec l'icone de la planche,
-- titre, bouton fermer, contenu reconstruit a chaque synchronisation.
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local Icons = require(ReplicatedStorage.Shared.Icons)
local UI = require(script.Parent.UI)
local State = require(script.Parent.State)

local Window = {}
local C = UI.C

local defs = {} -- [name] = { title, icon, build(content, ctx), refreshOn }
local frame, titleLabel, iconHolder, content, scale
Window.Current = nil
Window.Ctx = {}
Window.Opened = Instance.new(&quot;BindableEvent&quot;)

function Window.Register(name, def)
	defs[name] = def
end

local function fit()
	local vs = workspace.CurrentCamera.ViewportSize
	scale.Scale = math.min(1, (vs.X - 20) / 780, (vs.Y - 30) / 540)
end

function Window.Init(screen)
	frame = UI.panel({ Name = &quot;Window&quot;, Size = UDim2.fromOffset(780, 520), Position = UDim2.new(0.5, 0, 0.5, 8), AnchorPoint = Vector2.new(0.5, 0.5), Visible = false, ZIndex = 20 }, screen)
	scale = UI.new(&quot;UIScale&quot;, {}, frame)
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal(&quot;ViewportSize&quot;):Connect(fit)
	local header = UI.new(&quot;Frame&quot;, { Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = C.Purple, BorderSizePixel = 0, ZIndex = 21 }, frame)
	UI.corner(header, 18)
	UI.gradient(header, C.Purple, C.Purple2, 90)
	UI.new(&quot;Frame&quot;, { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -20), BackgroundColor3 = C.Purple2, BorderSizePixel = 0, ZIndex = 21 }, header)
	iconHolder = UI.new(&quot;Frame&quot;, { Size = UDim2.fromOffset(110, 110), Position = UDim2.fromOffset(-26, -42), BackgroundTransparency = 1, ZIndex = 25 }, frame)
	titleLabel = UI.text({ Size = UDim2.new(1, -200, 0, 40), Position = UDim2.fromOffset(96, 12), Text = &quot;&quot;, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 22, StrokeThickness = 3 }, frame)
	local close = Icons.Button(&quot;close&quot;, frame, { Size = UDim2.fromOffset(54, 54), Position = UDim2.new(1, -30, 0, -14), ZIndex = 26 })
	close.Activated:Connect(function()
		Window.Close()
	end)
	content = UI.new(&quot;Frame&quot;, { Name = &quot;Content&quot;, Size = UDim2.new(1, -32, 1, -84), Position = UDim2.fromOffset(16, 74), BackgroundTransparency = 1, ZIndex = 21 }, frame)
	State.Changed.Event:Connect(function(what)
		if Window.Current then
			local def = defs[Window.Current]
			if def.refreshOn and def.refreshOn[what] then
				Window.Render()
			end
		end
	end)
end

function Window.Render()
	local def = defs[Window.Current]
	if not def then
		return
	end
	local scrollPos = {}
	for _, d in ipairs(content:GetDescendants()) do
		if d:IsA(&quot;ScrollingFrame&quot;) and d.Name ~= &quot;&quot; then
			scrollPos[d.Name] = d.CanvasPosition
		end
	end
	content:ClearAllChildren()
	if State.data then
		local ok, err = pcall(def.build, content, Window.Ctx)
		if not ok then
			warn(&quot;[RelicRush] Fenetre &quot; .. Window.Current .. &quot; : &quot; .. tostring(err))
		end
	end
	for _, d in ipairs(content:GetDescendants()) do
		if d:IsA(&quot;ScrollingFrame&quot;) and scrollPos[d.Name] then
			d.CanvasPosition = scrollPos[d.Name]
		end
	end
end

function Window.Open(name, ctx)
	local def = defs[name]
	if not def then
		return
	end
	if Window.Current == name and not ctx then
		return Window.Close()
	end
	Window.Current = name
	Window.Ctx = ctx or {}
	titleLabel.Text = def.title
	iconHolder:ClearAllChildren()
	Icons.Image(def.icon, iconHolder, { Size = UDim2.fromScale(1, 1), ZIndex = 25 })
	frame.Visible = true
	Window.Render()
	local s = scale.Scale
	scale.Scale = s * 0.8
	UI.tween(scale, 0.25, { Scale = s }, Enum.EasingStyle.Back)
	Window.Opened:Fire(name)
end

function Window.Close()
	Window.Current = nil
	if frame then
		frame.Visible = false
	end
end

return Window
</ProtectedString></Properties></Item></Item></Item></Item></Item>
