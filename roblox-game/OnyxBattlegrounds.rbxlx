<Item class="ReplicatedStorage" referent="RBX00000003"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000002"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000000"><Properties><string name="Name">Config</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Configuration centrale d'ONYX BATTLEGROUNDS.
-- Personnages, competences, progression, cosmetiques : tout l'equilibrage est ici.

local Config = {}

Config.GameName = &quot;ONYX BATTLEGROUNDS&quot;

Config.Colors = {
	Accent = Color3.fromRGB(0, 229, 255),
	Accent2 = Color3.fromRGB(255, 90, 40),
	Gold = Color3.fromRGB(255, 200, 40),
	Danger = Color3.fromRGB(255, 60, 60),
	Dark = Color3.fromRGB(16, 18, 26),
	Health = Color3.fromRGB(80, 230, 110),
	Ult = Color3.fromRGB(200, 80, 255),
}

Config.Combat = {
	M1Cooldown = 0.32, -- delai entre deux coups
	ComboReset = 1.1, -- temps avant que le combo retombe a 0
	ComboEndCooldown = 0.9, -- delai apres le 4e coup
	M1Range = 7,
	M1Hitbox = Vector3.new(6, 6, 7),
	HitStun = 0.45,
	FinisherStun = 1.2,
	FinisherKnockback = 55,
	BlockReduction = 0.7, -- 70 % de degats en moins
	BlockSkillReduction = 0.5,
	BlockMoveSpeed = 6,
	DashCooldown = 1.6,
	DashSpeed = 85,
	DashDuration = 0.22,
	UltPerDamageDealt = 0.55, -- points d'ultimate par point de degats infliges
	UltPerDamageTaken = 0.3,
	UltDuration = 16,
	UltDamageMultiplier = 1.25,
	RespawnTime = 4,
	StreakForWin = 3, -- 3 eliminations d'affilee = 1 victoire
}

