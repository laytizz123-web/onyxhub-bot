<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Item class="ReplicatedStorage" referent="RBX00000003"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000002"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000000"><Properties><string name="Name">Config</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Configuration centrale d'ONYX ARENA.
-- Modifie ces valeurs pour equilibrer le jeu sans toucher au reste du code.

local Config = {}

Config.GameName = &quot;ONYX ARENA&quot;

Config.Round = {
	MinPlayers = 2, -- en dessous : mode entrainement automatique
	Intermission = 12,
	Countdown = 4,
	Duration = 150, -- secondes avant le mode OVERDRIVE
	EndDelay = 6,
}

Config.Ball = {
	BaseSpeed = 42,
	SpeedPerDeflect = 1.09, -- multiplicateur a chaque renvoi
	SpeedBonus = 2, -- bonus fixe a chaque renvoi
	MaxSpeed = 240,
	TurnRate = 5, -- reactivite du guidage (plus haut = plus dur a esquiver)
	HitRadius = 4.5,
	DeflectRange = 16, -- distance max pour renvoyer le ballon
	DeflectCooldown = 0.5,
	GraceTime = 0.35, -- temps d'invulnerabilite apres un changement de cible
	OverdriveMultiplier = 1.8,
	Size = 4,
	Height = 3, -- hauteur visee par rapport au centre du joueur
}

Config.Abilities = {
	Dash = { Cooldown = 4, Speed = 95, Lift = 8 },
	DoubleJump = { Power = 55 },
	Pulse = { Cooldown = 18, Duration = 2.5, SlowFactor = 0.3, Radius = 45 },
}

Config.Rewards = {
	Win = 75,
	Deflect = 2,
	Survive = 10,
	StreakBonus = 15,
}

Config.Arena = {
	Center = Vector3.new(0, 0, 0),
	Radius = 60,
	WallHeight = 26,
	WallSegments = 36,
	PillarCount = 8,
	PillarRadius = 32,
	JumpPadCount = 6,
	JumpPadRadius = 47,
	JumpPadPower = 95,
	SpawnRadius = 44,
	KillHeight = -40,
}

Config.Lobby = {
	Center = Vector3.new(0, 150, -170),
	Size = Vector3.new(80, 2, 80),
}

Config.Colors = {
	Accent = Color3.fromRGB(0, 229, 255),
	Accent2 = Color3.fromRGB(170, 0, 255),
	Danger = Color3.fromRGB(255, 60, 60),
	Gold = Color3.fromRGB(255, 200, 40),
	Dark = Color3.fromRGB(18, 18, 26),
	Floor = Color3.fromRGB(30, 30, 42),
}

return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Remotes</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Cree (serveur) ou recupere (client) les RemoteEvents du jeu.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)

local NAMES = { &quot;Deflect&quot;, &quot;Ability&quot;, &quot;BallEvent&quot;, &quot;RoundState&quot;, &quot;Notify&quot; }

local Remotes = {}

local folder: Folder
if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild(&quot;Remotes&quot;)
	if existing and existing:IsA(&quot;Folder&quot;) then
		folder = existing
	else
		folder = Instance.new(&quot;Folder&quot;)
		folder.Name = &quot;Remotes&quot;
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(NAMES) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new(&quot;RemoteEvent&quot;)
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild(&quot;Remotes&quot;) :: Folder
end

for _, name in ipairs(NAMES) do
	Remotes[name] = folder:WaitForChild(name) :: RemoteEvent
end

return Remotes
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000000C"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX0000000B"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX00000004"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Point d'entree serveur d'ONYX ARENA.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

require(ReplicatedStorage.Shared.Remotes) -- cree les RemoteEvents avant tout

local Modules = script.Parent.Modules
local MapBuilder = require(Modules.MapBuilder)
local DataService = require(Modules.DataService)
local RoundManager = require(Modules.RoundManager)
local AbilityService = require(Modules.AbilityService)

MapBuilder.Build()
DataService.Init()
AbilityService.Init(RoundManager)
RoundManager.Start()

print(&quot;[OnyxArena] Serveur pret.&quot;)
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000000A"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">AbilityService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Capacites validees cote serveur (Pulse) et relais des effets (Dash).

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Players = game:GetService(&quot;Players&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local AbilityService = {}

local cooldowns = {} -- [player] = { [ability] = time }

local function onCooldown(player, name, duration)
	local now = os.clock()
	cooldowns[player] = cooldowns[player] or {}
	local last = cooldowns[player][name] or 0
	if now - last &lt; duration then
		return true
	end
	cooldowns[player][name] = now
	return false
end

function AbilityService.Init(roundManager)
	Players.PlayerRemoving:Connect(function(player)
		cooldowns[player] = nil
	end)

	Remotes.Ability.OnServerEvent:Connect(function(player, name)
		local char = player.Character
		local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
		if not hrp then
			return
		end

		if name == &quot;Pulse&quot; then
			if onCooldown(player, &quot;Pulse&quot;, Config.Abilities.Pulse.Cooldown - 0.5) then
				return
			end
			local ball = roundManager.GetBall()
			if not ball or not roundManager.IsAlive(player) then
				return
			end
			local pos = ball:getPosition()
			if pos and (pos - hrp.Position).Magnitude &lt;= Config.Abilities.Pulse.Radius then
				ball:slow(Config.Abilities.Pulse.Duration)
				Remotes.BallEvent:FireAllClients(&quot;Pulse&quot;, { userId = player.UserId, position = hrp.Position, hit = true })
			else
				Remotes.BallEvent:FireAllClients(&quot;Pulse&quot;, { userId = player.UserId, position = hrp.Position, hit = false })
			end
		elseif name == &quot;Dash&quot; then
			if onCooldown(player, &quot;Dash&quot;, 0.5) then
				return
			end
			Remotes.BallEvent:FireAllClients(&quot;Dash&quot;, { userId = player.UserId })
		end
	end)

	Remotes.Deflect.OnServerEvent:Connect(function(player)
		if onCooldown(player, &quot;DeflectSpam&quot;, 0.1) then
			return
		end
		roundManager.HandleDeflect(player)
	end)
end

return AbilityService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">BallController</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Le ballon : guidage vers la cible, renvois, vitesse croissante, overdrive.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local Players = game:GetService(&quot;Players&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Ball = {}
Ball.__index = Ball

local function lerpColor(a, b, t)
	return Color3.new(a.R + (b.R - a.R) * t, a.G + (b.G - a.G) * t, a.B + (b.B - a.B) * t)
end

local function getRoot(player)
	local char = player and player.Character
	if not char then
		return nil
	end
	local hrp = char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	local hum = char:FindFirstChildOfClass(&quot;Humanoid&quot;)
	if hrp and hum and hum.Health &gt; 0 then
		return hrp
	end
	return nil
end

function Ball.new(options)
	local self = setmetatable({}, Ball)
	self.isAlive = options.isAlive -- function(player) -&gt; bool
	self.getAlive = options.getAlive -- function() -&gt; {Player}
	self.onHit = options.onHit -- function(player, position)
	self.onDeflect = options.onDeflect -- function(player, newTarget, speed)
	self.practice = options.practice == true

	self.baseSpeed = Config.Ball.BaseSpeed
	self.speed = self.baseSpeed
	self.direction = Vector3.new(0, 0, 1)
	self.deflects = 0
	self.target = nil
	self.graceUntil = 0
	self.slowUntil = 0
	self.burstUntil = 0
	self.lastDeflect = {}
	self.overdrive = false
	self.destroyed = false

	self:_build(options.position or (Config.Arena.Center + Vector3.new(0, 8, 0)))
	self.connection = RunService.Heartbeat:Connect(function(dt)
		self:_step(dt)
	end)
	return self
end

function Ball:_build(position)
	local s = Config.Ball.Size
	local part = Instance.new(&quot;Part&quot;)
	part.Name = &quot;ArenaBall&quot;
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(s, s, s)
	part.Material = Enum.Material.Neon
	part.Color = Color3.new(1, 1, 1)
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CustomPhysicalProperties = PhysicalProperties.new(0.2, 0, 0)
	part.CFrame = CFrame.new(position)
	part:SetAttribute(&quot;Speed&quot;, self.speed)
	part:SetAttribute(&quot;TargetUserId&quot;, 0)
	part:SetAttribute(&quot;Deflects&quot;, 0)
	part:SetAttribute(&quot;Overdrive&quot;, false)

	local center = Instance.new(&quot;Attachment&quot;)
	center.Name = &quot;Center&quot;
	center.Parent = part
	local top = Instance.new(&quot;Attachment&quot;)
	top.Position = Vector3.new(0, s / 2, 0)
	top.Parent = part
	local bottom = Instance.new(&quot;Attachment&quot;)
	bottom.Position = Vector3.new(0, -s / 2, 0)
	bottom.Parent = part

	local trail = Instance.new(&quot;Trail&quot;)
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Lifetime = 0.4
	trail.MinLength = 0.1
	trail.LightEmission = 1
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	trail.Color = ColorSequence.new(Config.Colors.Accent, Config.Colors.Accent2)
	trail.Parent = part

	local light = Instance.new(&quot;PointLight&quot;)
	light.Brightness = 4
	light.Range = 30
	light.Color = Config.Colors.Accent
	light.Parent = part

	local particles = Instance.new(&quot;ParticleEmitter&quot;)
	particles.Rate = 25
	particles.Lifetime = NumberRange.new(0.3, 0.6)
	particles.Speed = NumberRange.new(2, 5)
	particles.SpreadAngle = Vector2.new(180, 180)
	particles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
	particles.Transparency = NumberSequence.new(0.2, 1)
	particles.LightEmission = 1
	particles.Color = ColorSequence.new(Color3.new(1, 1, 1), Config.Colors.Accent)
	particles.Parent = part

	part.Parent = workspace

	-- Annule la gravite
	local force = Instance.new(&quot;VectorForce&quot;)
	force.Attachment0 = center
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.ApplyAtCenterOfMass = true
	force.Force = Vector3.new(0, part:GetMass() * workspace.Gravity, 0)
	force.Parent = part

	pcall(function()
		part:SetNetworkOwner(nil)
	end)

	self.part = part
	self.light = light
	self.trail = trail
	self.particles = particles
end

function Ball:_updateLook()
	local t = math.clamp((self.speed - Config.Ball.BaseSpeed) / (Config.Ball.MaxSpeed - Config.Ball.BaseSpeed), 0, 1)
	local color
	if self.overdrive then
		color = lerpColor(Config.Colors.Accent2, Config.Colors.Danger, t)
	elseif t &lt; 0.5 then
		color = lerpColor(Color3.new(1, 1, 1), Config.Colors.Gold, t * 2)
	else
		color = lerpColor(Config.Colors.Gold, Config.Colors.Danger, (t - 0.5) * 2)
	end
	self.part.Color = color
	self.light.Color = color
	self.trail.Color = ColorSequence.new(color, self.overdrive and Config.Colors.Accent2 or Config.Colors.Accent)
	self.trail.Lifetime = 0.4 + t * 0.6
	self.part:SetAttribute(&quot;Speed&quot;, math.floor(self.speed + 0.5))
	self.part:SetAttribute(&quot;Deflects&quot;, self.deflects)
end

function Ball:_isValidTarget(player)
	if not player or player.Parent ~= Players then
		return false
	end
	if not self.isAlive(player) then
		return false
	end
	return getRoot(player) ~= nil
end

function Ball:_setTarget(player)
	self.target = player
	local now = os.clock()
	self.graceUntil = math.max(self.graceUntil, now + Config.Ball.GraceTime)
	self.part:SetAttribute(&quot;TargetUserId&quot;, player and player.UserId or 0)
	local hrp = player and getRoot(player)
	if hrp then
		local dir = hrp.Position - self.part.Position
		if dir.Magnitude &gt; 0.01 then
			self.direction = dir.Unit
		end
	end
	Remotes.BallEvent:FireAllClients(&quot;Target&quot;, { userId = player and player.UserId or 0 })
end

function Ball:_retarget(exclude)
	local candidates = {}
	for _, p in ipairs(self.getAlive()) do
		if p ~= exclude and self:_isValidTarget(p) then
			table.insert(candidates, p)
		end
	end
	if #candidates == 0 then
		if exclude and self:_isValidTarget(exclude) then
			candidates = { exclude }
		else
			self:_setTarget(nil)
			return
		end
	end
	-- Evite de viser quelqu'un colle au ballon (coup impossible a parer)
	local far = {}
	for _, p in ipairs(candidates) do
		local hrp = getRoot(p)
		if hrp and (hrp.Position - self.part.Position).Magnitude &gt; 14 then
			table.insert(far, p)
		end
	end
	local pool = (#far &gt; 0) and far or candidates
	self:_setTarget(pool[math.random(#pool)])
end

function Ball:_hit(target)
	local now = os.clock()
	self.graceUntil = now + 0.5
	local pos = self.part.Position
	Remotes.BallEvent:FireAllClients(&quot;Hit&quot;, { userId = target.UserId, position = pos })

	self.speed = self.baseSpeed
	self.deflects = 0
	self.burstUntil = 0
	self.slowUntil = 0
	self:_updateLook()

	-- Le ballon repart du centre pour laisser le temps de reagir
	self.part.CFrame = CFrame.new(Config.Arena.Center + Vector3.new(0, 8, 0))
	self.part.AssemblyLinearVelocity = Vector3.zero

	if self.onHit then
		self.onHit(target, pos)
	end
	local exclude = target
	if self.practice then
		exclude = nil
	end
	self:_retarget(exclude)
end

function Ball:_step(dt)
	if self.destroyed then
		return
	end
	local now = os.clock()
	local target = self.target
	if not self:_isValidTarget(target) then
		self:_retarget(nil)
		target = self.target
		if not target then
			self.part.AssemblyLinearVelocity = Vector3.zero
			return
		end
	end

	local hrp = getRoot(target)
	if not hrp then
		return
	end
	local targetPos = hrp.Position + Vector3.new(0, Config.Ball.Height - 2, 0)
	local toTarget = targetPos - self.part.Position
	local dist = toTarget.Magnitude

	local speed = self.speed
	if now &lt; self.burstUntil then
		speed = speed * 1.4
	end
	if now &lt; self.slowUntil then
		speed = speed * Config.Abilities.Pulse.SlowFactor
	end

	if now &gt;= self.graceUntil and dist &lt;= Config.Ball.HitRadius + speed * dt then
		self:_hit(target)
		return
	end

	local desired = toTarget / math.max(dist, 0.001)
	local turnRate = Config.Ball.TurnRate * (1 + speed / 120)
	local turn = math.clamp(dt * turnRate, 0, 1)
	local dir = self.direction:Lerp(desired, turn)
	if dir.Magnitude &lt; 0.01 then
		dir = desired
	end
	self.direction = dir.Unit

	self.part.AssemblyLinearVelocity = self.direction * speed
	self.part.AssemblyAngularVelocity = Vector3.zero

	-- Securite : si le ballon s'est echappe
	local offset = self.part.Position - Config.Arena.Center
	if offset.Magnitude &gt; Config.Arena.Radius * 2 or self.part.Position.Y &lt; Config.Arena.KillHeight then
		self.part.CFrame = CFrame.new(Config.Arena.Center + Vector3.new(0, 8, 0))
	end
end

-- Tentative de renvoi par un joueur. Retourne true si reussi.
function Ball:deflect(player)
	if self.destroyed then
		return false, &quot;no-ball&quot;
	end
	local now = os.clock()
	local last = self.lastDeflect[player] or 0
	if now - last &lt; Config.Ball.DeflectCooldown then
		return false, &quot;cooldown&quot;
	end
	self.lastDeflect[player] = now

	local hrp = getRoot(player)
	if not hrp then
		return false, &quot;dead&quot;
	end
	local dist = (hrp.Position - self.part.Position).Magnitude
	if dist &gt; Config.Ball.DeflectRange or self.target ~= player then
		Remotes.BallEvent:FireAllClients(&quot;Swing&quot;, { userId = player.UserId, hit = false })
		return false, (dist &gt; Config.Ball.DeflectRange) and &quot;far&quot; or &quot;not-target&quot;
	end

	self.deflects += 1
	self.speed = math.min(self.speed * Config.Ball.SpeedPerDeflect + Config.Ball.SpeedBonus, Config.Ball.MaxSpeed)
	self.burstUntil = now + 0.25
	self.slowUntil = 0
	self:_updateLook()

	-- Petit recul instantane pour que le ballon parte du joueur
	local away = (self.part.Position - hrp.Position)
	if away.Magnitude &gt; 0.01 then
		self.part.CFrame = CFrame.new(hrp.Position + away.Unit * math.max(dist, 5) + Vector3.new(0, 1, 0))
	end

	self:_retarget(player)

	Remotes.BallEvent:FireAllClients(&quot;Deflect&quot;, {
		userId = player.UserId,
		position = self.part.Position,
		speed = math.floor(self.speed + 0.5),
		deflects = self.deflects,
		newTarget = self.target and self.target.UserId or 0,
	})
	if self.onDeflect then
		self.onDeflect(player, self.target, self.speed)
	end
	return true
end

function Ball:slow(duration)
	if self.destroyed then
		return
	end
	self.slowUntil = os.clock() + duration
end

function Ball:setOverdrive(enabled)
	if self.destroyed then
		return
	end
	self.overdrive = enabled
	self.baseSpeed = Config.Ball.BaseSpeed * (enabled and Config.Ball.OverdriveMultiplier or 1)
	self.speed = math.max(self.speed, self.baseSpeed)
	self.part:SetAttribute(&quot;Overdrive&quot;, enabled)
	self:_updateLook()
	Remotes.BallEvent:FireAllClients(&quot;Overdrive&quot;, { enabled = enabled })
end

function Ball:getPosition()
	if self.destroyed then
		return nil
	end
	return self.part.Position
end

function Ball:destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	if self.connection then
		self.connection:Disconnect()
	end
	Remotes.BallEvent:FireAllClients(&quot;Target&quot;, { userId = 0 })
	if self.part then
		self.part:Destroy()
	end
end

return Ball
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">DataService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Sauvegarde des pieces / victoires (DataStore) + leaderstats.

local DataStoreService = game:GetService(&quot;DataStoreService&quot;)
local Players = game:GetService(&quot;Players&quot;)
local RunService = game:GetService(&quot;RunService&quot;)

local DataService = {}

local STORE_NAME = &quot;OnyxArena_v1&quot;
local DEFAULT = { Coins = 0, Wins = 0, Deflects = 0, BestStreak = 0 }

local store = nil
pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)

local cache = {}
local values = {}

local function key(player)
	return &quot;p_&quot; .. player.UserId
end

local function syncValues(player)
	local data = cache[player]
	local v = values[player]
	if not data or not v then
		return
	end
	v.Coins.Value = data.Coins
	v.Wins.Value = data.Wins
	v.Deflects.Value = data.Deflects
end

function DataService.Setup(player)
	local data = table.clone(DEFAULT)
	if store then
		local ok, result = pcall(function()
			return store:GetAsync(key(player))
		end)
		if ok and type(result) == &quot;table&quot; then
			for k, v in pairs(DEFAULT) do
				if type(result[k]) == &quot;number&quot; then
					data[k] = result[k]
				end
			end
		elseif not ok then
			warn(&quot;[OnyxArena] Chargement impossible pour &quot; .. player.Name .. &quot; : &quot; .. tostring(result))
		end
	end
	cache[player] = data

	local leaderstats = Instance.new(&quot;Folder&quot;)
	leaderstats.Name = &quot;leaderstats&quot;

	local wins = Instance.new(&quot;IntValue&quot;)
	wins.Name = &quot;Wins&quot;
	wins.Parent = leaderstats
	local coins = Instance.new(&quot;IntValue&quot;)
	coins.Name = &quot;Coins&quot;
	coins.Parent = leaderstats
	local streak = Instance.new(&quot;IntValue&quot;)
	streak.Name = &quot;Streak&quot;
	streak.Parent = leaderstats
	local deflects = Instance.new(&quot;IntValue&quot;)
	deflects.Name = &quot;Deflects&quot;
	deflects.Parent = player -- hors leaderstats (visible dans le HUD seulement)

	values[player] = { Coins = coins, Wins = wins, Streak = streak, Deflects = deflects }
	leaderstats.Parent = player
	syncValues(player)
end

function DataService.Get(player, field)
	local data = cache[player]
	return data and data[field] or 0
end

function DataService.Add(player, field, amount)
	local data = cache[player]
	if not data or DEFAULT[field] == nil then
		return
	end
	data[field] = math.max(0, data[field] + amount)
	syncValues(player)
end

function DataService.SetStreak(player, streak)
	local v = values[player]
	local data = cache[player]
	if v then
		v.Streak.Value = streak
	end
	if data and streak &gt; data.BestStreak then
		data.BestStreak = streak
	end
end

function DataService.GetStreak(player)
	local v = values[player]
	return v and v.Streak.Value or 0
end

function DataService.Save(player)
	local data = cache[player]
	if not data or not store then
		return
	end
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function()
			return data
		end)
	end)
	if not ok then
		warn(&quot;[OnyxArena] Sauvegarde impossible pour &quot; .. player.Name .. &quot; : &quot; .. tostring(err))
	end
end

function DataService.Init()
	Players.PlayerAdded:Connect(DataService.Setup)
	for _, p in ipairs(Players:GetPlayers()) do
		if not cache[p] then
			DataService.Setup(p)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		DataService.Save(player)
		cache[player] = nil
		values[player] = nil
	end)
	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		for _, p in ipairs(Players:GetPlayers()) do
			DataService.Save(p)
		end
	end)
	-- Sauvegarde automatique
	task.spawn(function()
		while true do
			task.wait(120)
			for _, p in ipairs(Players:GetPlayers()) do
				DataService.Save(p)
			end
		end
	end)
end

return DataService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">MapBuilder</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Construit l'arene, le lobby et l'eclairage entierement par script.
-- Aucun asset externe : tout est fait avec des Parts.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local CollectionService = game:GetService(&quot;CollectionService&quot;)
local Lighting = game:GetService(&quot;Lighting&quot;)
local Players = game:GetService(&quot;Players&quot;)

local Config = require(ReplicatedStorage.Shared.Config)

local MapBuilder = {}

local function makePart(props)
	local p = Instance.new(&quot;Part&quot;)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		p[key] = value
	end
	return p
end

local function flatCylinder(name, radius, thickness, position, color, material, transparency)
	return makePart({
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, radius * 2, radius * 2),
		CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		Transparency = transparency or 0,
	})
end

local function addLabel(parent, text, face, size)
	local gui = Instance.new(&quot;SurfaceGui&quot;)
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	local label = Instance.new(&quot;TextLabel&quot;)
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Config.Colors.Accent
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextStrokeTransparency = 0.5
	label.TextStrokeColor3 = Config.Colors.Accent2
	label.Parent = gui
	gui.Parent = parent
	return gui
end

local function buildLighting()
	Lighting.ClockTime = 0
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(45, 45, 70)
	Lighting.OutdoorAmbient = Color3.fromRGB(60, 60, 95)
	Lighting.FogColor = Color3.fromRGB(10, 10, 20)
	Lighting.FogStart = 200
	Lighting.FogEnd = 900
	Lighting.GlobalShadows = true

	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA(&quot;PostEffect&quot;) or child:IsA(&quot;Atmosphere&quot;) or child:IsA(&quot;Sky&quot;) then
			child:Destroy()
		end
	end

	local bloom = Instance.new(&quot;BloomEffect&quot;)
	bloom.Intensity = 0.8
	bloom.Size = 32
	bloom.Threshold = 1.1
	bloom.Parent = Lighting

	local cc = Instance.new(&quot;ColorCorrectionEffect&quot;)
	cc.Name = &quot;ArenaColor&quot;
	cc.Contrast = 0.12
	cc.Saturation = 0.15
	cc.TintColor = Color3.fromRGB(255, 255, 255)
	cc.Parent = Lighting

	local atmosphere = Instance.new(&quot;Atmosphere&quot;)
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(120, 90, 200)
	atmosphere.Decay = Color3.fromRGB(40, 20, 80)
	atmosphere.Glare = 0.3
	atmosphere.Haze = 2
	atmosphere.Parent = Lighting

	local sky = Instance.new(&quot;Sky&quot;)
	sky.StarCount = 4000
	sky.CelestialBodiesShown = false
	sky.Parent = Lighting
end

local function buildArena(root)
	local arena = Config.Arena
	local center = arena.Center
	local R = arena.Radius

	-- Sol principal
	local floor = flatCylinder(&quot;ArenaFloor&quot;, R, 4, center - Vector3.new(0, 2, 0), Config.Colors.Floor, Enum.Material.Slate)
	floor.Parent = root

	-- Anneau neon sous le sol
	local ring = flatCylinder(&quot;ArenaRing&quot;, R + 2.5, 2.5, center - Vector3.new(0, 4.5, 0), Config.Colors.Accent, Enum.Material.Neon)
	ring.Parent = root

	-- Cercles decoratifs au sol (neon + disque sombre par dessus = anneau)
	for _, radius in ipairs({ 44, 22 }) do
		local glow = flatCylinder(&quot;FloorGlow&quot;, radius, 0.2, center + Vector3.new(0, 0.05, 0), Config.Colors.Accent2, Enum.Material.Neon, 0.2)
		glow.CanCollide = false
		glow.Parent = root
		local cover = flatCylinder(&quot;FloorCover&quot;, radius - 1.2, 0.2, center + Vector3.new(0, 0.12, 0), Config.Colors.Floor, Enum.Material.Slate)
		cover.CanCollide = false
		cover.Parent = root
	end
	local core = flatCylinder(&quot;ArenaCore&quot;, 6, 0.3, center + Vector3.new(0, 0.2, 0), Config.Colors.Accent, Enum.Material.Neon)
	core.CanCollide = false
	core.Parent = root

	-- Murs en verre tout autour
	local segments = arena.WallSegments
	local wallRadius = R + 1
	local segWidth = (2 * math.pi * wallRadius) / segments + 0.8
	for i = 1, segments do
		local angle = (i / segments) * math.pi * 2
		local wall = makePart({
			Name = &quot;ArenaWall&quot;,
			Size = Vector3.new(segWidth, arena.WallHeight, 1.5),
			CFrame = CFrame.new(center) * CFrame.Angles(0, angle, 0) * CFrame.new(0, arena.WallHeight / 2, -wallRadius),
			Material = Enum.Material.Glass,
			Color = Config.Colors.Accent,
			Transparency = 0.75,
		})
		wall.Parent = root
		if i % 3 == 0 then
			local bar = makePart({
				Name = &quot;WallBar&quot;,
				Size = Vector3.new(0.6, arena.WallHeight, 0.6),
				CFrame = wall.CFrame * CFrame.new(segWidth / 2, 0, 0),
				Material = Enum.Material.Neon,
				Color = Config.Colors.Accent2,
				CanCollide = false,
			})
			bar.Parent = root
		end
	end
	-- Anneau superieur
	local topRing = flatCylinder(&quot;ArenaTopRing&quot;, R + 3, 1, center + Vector3.new(0, arena.WallHeight + 0.5, 0), Config.Colors.Accent2, Enum.Material.Neon, 0.3)
	topRing.CanCollide = false
	topRing.Parent = root
	local topCover = flatCylinder(&quot;ArenaTopCover&quot;, R - 1, 1.2, center + Vector3.new(0, arena.WallHeight + 0.5, 0), Config.Colors.Dark, Enum.Material.SmoothPlastic, 1)
	topCover.CanCollide = false
	topCover.Parent = root

	-- Piliers mobiles (montent et descendent en continu)
	for i = 1, arena.PillarCount do
		local angle = (i / arena.PillarCount) * math.pi * 2
		local x = math.cos(angle) * arena.PillarRadius
		local z = math.sin(angle) * arena.PillarRadius
		local h = 16
		local downCF = CFrame.new(center + Vector3.new(x, -h / 2 + 0.8, z))
		local upCF = CFrame.new(center + Vector3.new(x, h / 2, z))
		local pillar = makePart({
			Name = &quot;Pillar&quot;,
			Size = Vector3.new(7, h, 7),
			CFrame = downCF,
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(50, 50, 70),
		})
		pillar.Parent = root
		local cap = makePart({
			Name = &quot;PillarCap&quot;,
			Size = Vector3.new(7.4, 0.5, 7.4),
			CFrame = downCF * CFrame.new(0, h / 2 + 0.25, 0),
			Material = Enum.Material.Neon,
			Color = Config.Colors.Accent,
		})
		local weld = Instance.new(&quot;WeldConstraint&quot;)
		weld.Part0 = pillar
		weld.Part1 = cap
		weld.Parent = cap
		cap.Anchored = false
		cap.Parent = root

		local duration = 3 + (i % 4) * 0.9
		local info = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, (i % 3) * 1.1)
		TweenService:Create(pillar, info, { CFrame = upCF }):Play()
	end

	-- Jump pads (geres cote client via le tag &quot;JumpPad&quot;)
	for i = 1, arena.JumpPadCount do
		local angle = (i / arena.JumpPadCount) * math.pi * 2 + math.pi / arena.JumpPadCount
		local x = math.cos(angle) * arena.JumpPadRadius
		local z = math.sin(angle) * arena.JumpPadRadius
		local pad = flatCylinder(&quot;JumpPad&quot;, 3.5, 0.6, center + Vector3.new(x, 0.3, z), Config.Colors.Gold, Enum.Material.Neon)
		pad:SetAttribute(&quot;Power&quot;, arena.JumpPadPower)
		CollectionService:AddTag(pad, &quot;JumpPad&quot;)
		pad.Parent = root
		local light = Instance.new(&quot;PointLight&quot;)
		light.Color = Config.Colors.Gold
		light.Range = 12
		light.Brightness = 2
		light.Parent = pad
	end

	-- Cubes flottants decoratifs en rotation
	for i = 1, 14 do
		local angle = (i / 14) * math.pi * 2
		local radius = R - 6
		local y = 10 + (i % 4) * 4
		local cube = makePart({
			Name = &quot;FloatingCube&quot;,
			Size = Vector3.new(2, 2, 2),
			CFrame = CFrame.new(center + Vector3.new(math.cos(angle) * radius, y, math.sin(angle) * radius)),
			Material = Enum.Material.Neon,
			Color = (i % 2 == 0) and Config.Colors.Accent or Config.Colors.Accent2,
			CanCollide = false,
		})
		cube.Parent = root
		local info = TweenInfo.new(4 + (i % 3), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
		TweenService:Create(cube, info, {
			CFrame = cube.CFrame * CFrame.new(0, 3, 0) * CFrame.Angles(math.rad(90), math.rad(90), 0),
		}):Play()
	end
end

local function buildLobby(root)
	local lobby = Config.Lobby
	local center = lobby.Center
	local size = lobby.Size

	local floor = makePart({
		Name = &quot;LobbyFloor&quot;,
		Size = size,
		CFrame = CFrame.new(center),
		Material = Enum.Material.Slate,
		Color = Config.Colors.Floor,
	})
	floor.Parent = root

	local trim = makePart({
		Name = &quot;LobbyTrim&quot;,
		Size = Vector3.new(size.X + 2, 1, size.Z + 2),
		CFrame = CFrame.new(center - Vector3.new(0, 1.2, 0)),
		Material = Enum.Material.Neon,
		Color = Config.Colors.Accent,
	})
	trim.Parent = root

	-- Murs invisibles
	local h = 30
	local walls = {
		{ Vector3.new(size.X + 2, h, 1), Vector3.new(0, h / 2, size.Z / 2 + 0.5) },
		{ Vector3.new(size.X + 2, h, 1), Vector3.new(0, h / 2, -size.Z / 2 - 0.5) },
		{ Vector3.new(1, h, size.Z + 2), Vector3.new(size.X / 2 + 0.5, h / 2, 0) },
		{ Vector3.new(1, h, size.Z + 2), Vector3.new(-size.X / 2 - 0.5, h / 2, 0) },
	}
	for _, w in ipairs(walls) do
		local wall = makePart({
			Name = &quot;LobbyWall&quot;,
			Size = w[1],
			CFrame = CFrame.new(center + w[2]),
			Transparency = 1,
		})
		wall.Parent = root
	end

	-- Panneau titre
	local sign = makePart({
		Name = &quot;LobbySign&quot;,
		Size = Vector3.new(40, 10, 1),
		CFrame = CFrame.new(center + Vector3.new(0, 14, -size.Z / 2 + 2)),
		Material = Enum.Material.SmoothPlastic,
		Color = Config.Colors.Dark,
	})
	sign.Parent = root
	addLabel(sign, Config.GameName, Enum.NormalId.Front)
	addLabel(sign, Config.GameName, Enum.NormalId.Back)

	local hint = makePart({
		Name = &quot;LobbyHint&quot;,
		Size = Vector3.new(40, 3, 1),
		CFrame = CFrame.new(center + Vector3.new(0, 7.5, -size.Z / 2 + 2)),
		Material = Enum.Material.SmoothPlastic,
		Color = Config.Colors.Dark,
	})
	hint.Parent = root
	local hintGui = addLabel(hint, &quot;F / Clic : RENVOYER   |   Q : DASH   |   E : PULSE   |   Double saut&quot;, Enum.NormalId.Front)
	hintGui.TextLabel.TextColor3 = Color3.new(1, 1, 1)
	hintGui.TextLabel.Font = Enum.Font.GothamBold

	-- Spawn
	local existingSpawn = workspace:FindFirstChildOfClass(&quot;SpawnLocation&quot;)
	if existingSpawn then
		existingSpawn:Destroy()
	end
	local spawn = Instance.new(&quot;SpawnLocation&quot;)
	spawn.Name = &quot;LobbySpawn&quot;
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.CFrame = CFrame.new(center + Vector3.new(0, 1.5, 0))
	spawn.Anchored = true
	spawn.Material = Enum.Material.Neon
	spawn.Color = Config.Colors.Accent2
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = root
end

function MapBuilder.Build()
	local old = workspace:FindFirstChild(&quot;OnyxArena&quot;)
	if old then
		old:Destroy()
	end
	local baseplate = workspace:FindFirstChild(&quot;Baseplate&quot;)
	if baseplate then
		baseplate:Destroy()
	end

	local root = Instance.new(&quot;Folder&quot;)
	root.Name = &quot;OnyxArena&quot;
	root.Parent = workspace

	buildLighting()
	buildArena(root)
	buildLobby(root)

	Players.RespawnTime = 3
	return root
end

-- Positions de depart reparties en cercle autour de l'arene.
function MapBuilder.GetSpawnPoints(count)
	local points = {}
	local offset = math.random() * math.pi * 2
	for i = 1, count do
		local angle = offset + (i / count) * math.pi * 2
		local pos = Config.Arena.Center + Vector3.new(
			math.cos(angle) * Config.Arena.SpawnRadius,
			4,
			math.sin(angle) * Config.Arena.SpawnRadius
		)
		table.insert(points, pos)
	end
	return points
end

function MapBuilder.GetLobbySpawn()
	return Config.Lobby.Center + Vector3.new(0, 5, 0)
end

return MapBuilder
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">RoundManager</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Boucle de jeu : attente -&gt; intermission -&gt; manche -&gt; fin.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Players = game:GetService(&quot;Players&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Ball = require(script.Parent.BallController)
local MapBuilder = require(script.Parent.MapBuilder)
local DataService = require(script.Parent.DataService)

local RoundManager = {}

local alive = {} -- [Player] = true
local participants = {}
local ball = nil
local practice = false
local roundDeflects = {}

local state = {
	phase = &quot;Waiting&quot;,
	message = &quot;&quot;,
	timer = 0,
	aliveCount = 0,
	totalCount = 0,
	practice = false,
	winnerUserId = 0,
}

local function countAlive()
	local n = 0
	for p in pairs(alive) do
		if p.Parent == Players then
			n += 1
		else
			alive[p] = nil
		end
	end
	return n
end

local function getAliveList()
	local list = {}
	for p in pairs(alive) do
		if p.Parent == Players then
			table.insert(list, p)
		end
	end
	return list
end

local function broadcast()
	state.aliveCount = countAlive()
	state.totalCount = #participants
	state.practice = practice
	Remotes.RoundState:FireAllClients(state)
end

local function setPhase(phase, message, timer, winnerUserId)
	state.phase = phase
	state.message = message or &quot;&quot;
	state.timer = timer or 0
	state.winnerUserId = winnerUserId or 0
	broadcast()
end

local function notify(player, text, kind)
	if player then
		Remotes.Notify:FireClient(player, text, kind or &quot;info&quot;)
	else
		Remotes.Notify:FireAllClients(text, kind or &quot;info&quot;)
	end
end

local function getRoot(player)
	local char = player.Character
	local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	local hum = char and char:FindFirstChildOfClass(&quot;Humanoid&quot;)
	if hrp and hum and hum.Health &gt; 0 then
		return hrp, hum
	end
	return nil, nil
end

local function getReadyPlayers()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if getRoot(p) then
			table.insert(list, p)
		end
	end
	return list
end

local function eliminate(player, reason)
	if not alive[player] then
		return
	end
	alive[player] = nil
	local _, hum = getRoot(player)
	if hum then
		hum.Health = 0
	end
	notify(nil, player.DisplayName .. &quot; &quot; .. reason, &quot;danger&quot;)
	broadcast()
end

local function teleportToLobby(player)
	local hrp = getRoot(player)
	if hrp then
		hrp.CFrame = CFrame.new(MapBuilder.GetLobbySpawn())
	end
end

local function runRound(ready)
	participants = ready
	alive = {}
	roundDeflects = {}
	for _, p in ipairs(ready) do
		alive[p] = true
		roundDeflects[p] = 0
	end

	-- Placement et gel des joueurs
	local spawns = MapBuilder.GetSpawnPoints(#ready)
	for i, p in ipairs(ready) do
		local hrp = getRoot(p)
		if hrp then
			hrp.CFrame = CFrame.lookAt(spawns[i], Config.Arena.Center + Vector3.new(0, 4, 0))
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.Anchored = true
		end
	end

	for t = Config.Round.Countdown, 1, -1 do
		setPhase(&quot;Starting&quot;, practice and &quot;MODE ENTRAINEMENT&quot; or &quot;PREPAREZ-VOUS&quot;, t)
		task.wait(1)
	end

	for _, p in ipairs(ready) do
		local hrp = getRoot(p)
		if hrp then
			hrp.Anchored = false
		end
	end

	ball = Ball.new({
		practice = practice,
		isAlive = function(p)
			return alive[p] == true
		end,
		getAlive = getAliveList,
		onHit = function(p)
			if practice then
				notify(p, &quot;Touche ! Le ballon repart du centre.&quot;, &quot;danger&quot;)
			else
				eliminate(p, &quot;a ete elimine !&quot;)
			end
		end,
		onDeflect = function(p)
			roundDeflects[p] = (roundDeflects[p] or 0) + 1
			DataService.Add(p, &quot;Coins&quot;, Config.Rewards.Deflect)
			DataService.Add(p, &quot;Deflects&quot;, 1)
		end,
	})

	setPhase(&quot;Playing&quot;, practice and &quot;ENTRAINEMENT : renvoie le ballon !&quot; or &quot;SURVIS !&quot;, Config.Round.Duration)

	local startTime = os.clock()
	local overdrive = false
	local lastBroadcast = 0
	while true do
		task.wait(0.2)
		local elapsed = os.clock() - startTime
		local remaining = math.max(0, Config.Round.Duration - elapsed)
		state.timer = math.ceil(remaining)

		if not overdrive and remaining &lt;= 0 then
			overdrive = true
			ball:setOverdrive(true)
			state.message = &quot;OVERDRIVE !&quot;
			notify(nil, &quot;OVERDRIVE ! Le ballon est dechaine !&quot;, &quot;overdrive&quot;)
			broadcast()
		end

		local count = countAlive()
		if practice then
			if #Players:GetPlayers() &gt;= Config.Round.MinPlayers or count == 0 then
				break
			end
		elseif count &lt;= 1 then
			break
		end

		if os.clock() - lastBroadcast &gt;= 1 then
			lastBroadcast = os.clock()
			broadcast()
		end
	end

	ball:destroy()
	ball = nil

	-- Fin de manche
	local winner = nil
	if not practice then
		winner = getAliveList()[1]
	end

	if winner then
		local streak = DataService.GetStreak(winner) + 1
		DataService.SetStreak(winner, streak)
		DataService.Add(winner, &quot;Wins&quot;, 1)
		local reward = Config.Rewards.Win + (streak &gt; 1 and Config.Rewards.StreakBonus * (streak - 1) or 0)
		DataService.Add(winner, &quot;Coins&quot;, reward)
		notify(winner, &quot;+&quot; .. reward .. &quot; pieces (serie x&quot; .. streak .. &quot;)&quot;, &quot;gold&quot;)
		for _, p in ipairs(participants) do
			if p ~= winner and p.Parent == Players then
				DataService.SetStreak(p, 0)
				DataService.Add(p, &quot;Coins&quot;, Config.Rewards.Survive)
			end
		end
		setPhase(&quot;Ending&quot;, winner.DisplayName .. &quot; remporte la manche !&quot;, Config.Round.EndDelay, winner.UserId)
	elseif practice then
		setPhase(&quot;Ending&quot;, &quot;Entrainement termine&quot;, 3)
	else
		setPhase(&quot;Ending&quot;, &quot;Match nul !&quot;, Config.Round.EndDelay)
	end

	task.wait(practice and 3 or Config.Round.EndDelay)

	for p in pairs(alive) do
		if p.Parent == Players then
			teleportToLobby(p)
		end
	end
	alive = {}
	participants = {}
	broadcast()
end

local function mainLoop()
	while true do
		while #Players:GetPlayers() == 0 do
			setPhase(&quot;Waiting&quot;, &quot;En attente de joueurs...&quot;, 0)
			task.wait(1)
		end

		for t = Config.Round.Intermission, 1, -1 do
			local n = #getReadyPlayers()
			local msg
			if n &gt;= Config.Round.MinPlayers then
				msg = &quot;Prochaine manche dans&quot;
			else
				msg = &quot;Entrainement dans (&quot; .. n .. &quot;/&quot; .. Config.Round.MinPlayers .. &quot; joueurs)&quot;
			end
			setPhase(&quot;Intermission&quot;, msg, t)
			task.wait(1)
		end

		local ready = getReadyPlayers()
		if #ready == 0 then
			continue
		end
		practice = #ready &lt; Config.Round.MinPlayers
		local ok, err = pcall(runRound, ready)
		if not ok then
			warn(&quot;[OnyxArena] Erreur pendant la manche : &quot; .. tostring(err))
			if ball then
				ball:destroy()
				ball = nil
			end
			alive = {}
			participants = {}
		end
	end
end

-- Chute hors de la carte
local function fallWatcher()
	while true do
		task.wait(0.5)
		for _, p in ipairs(Players:GetPlayers()) do
			local hrp, hum = getRoot(p)
			if hrp and hrp.Position.Y &lt; Config.Arena.KillHeight then
				if alive[p] then
					eliminate(p, &quot;est tombe dans le vide !&quot;)
				else
					hum.Health = 0
				end
			end
		end
	end
end

function RoundManager.HandleDeflect(player)
	if ball and alive[player] then
		ball:deflect(player)
	end
end

function RoundManager.GetBall()
	return ball
end

function RoundManager.IsAlive(player)
	return alive[player] == true
end

function RoundManager.GetState()
	return state
end

function RoundManager.Start()
	Players.PlayerRemoving:Connect(function(player)
		alive[player] = nil
	end)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.1)
			broadcast()
		end)
		Remotes.RoundState:FireClient(player, state)
	end)
	task.spawn(fallWatcher)
	task.spawn(mainLoop)
end

return RoundManager
</ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000015"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000014"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000013"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX0000000D"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Point d'entree client d'ONYX ARENA.

local Modules = script.Parent.Modules
local Input = require(Modules.Input)
local HUD = require(Modules.HUD)
local Effects = require(Modules.Effects)

Input.Init()
HUD.Init(Input)
Effects.Init()
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000012"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Effects</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Effets visuels et sonores : renvois, eliminations, cible, pulse, dash, overdrive.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local Lighting = game:GetService(&quot;Lighting&quot;)
local Debris = game:GetService(&quot;Debris&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)

local Effects = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local sounds = {}
local function playSound(id, volume, pitch, position)
	local s = Instance.new(&quot;Sound&quot;)
	s.SoundId = id
	s.Volume = volume or 0.5
	s.PlaybackSpeed = pitch or 1
	if position then
		local holder = Instance.new(&quot;Part&quot;)
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.Transparency = 1
		holder.Size = Vector3.new(1, 1, 1)
		holder.Position = position
		holder.Parent = workspace
		s.RollOffMaxDistance = 250
		s.Parent = holder
		Debris:AddItem(holder, 4)
	else
		s.Parent = workspace
		Debris:AddItem(s, 4)
	end
	s:Play()
	table.insert(sounds, s)
end

local function getCharacter(userId)
	local p = Players:GetPlayerByUserId(userId)
	return p and p.Character
end

-- Tremblement de camera
local shakeAmount = 0
RunService.RenderStepped:Connect(function(dt)
	if shakeAmount &gt; 0.01 then
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass(&quot;Humanoid&quot;)
		if hum then
			hum.CameraOffset = Vector3.new(
				(math.random() - 0.5) * shakeAmount,
				(math.random() - 0.5) * shakeAmount,
				(math.random() - 0.5) * shakeAmount
			)
		end
		shakeAmount = shakeAmount * math.max(0, 1 - dt * 8)
	elseif shakeAmount ~= 0 then
		shakeAmount = 0
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass(&quot;Humanoid&quot;)
		if hum then
			hum.CameraOffset = Vector3.zero
		end
	end
end)

function Effects.shake(amount)
	shakeAmount = math.max(shakeAmount, amount)
end

local function shockwave(position, color, size, duration, flat)
	local ring = Instance.new(&quot;Part&quot;)
	ring.Shape = flat and Enum.PartType.Cylinder or Enum.PartType.Ball
	ring.Size = Vector3.new(1, 1, 1)
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.2
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CFrame = flat and (CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))) or CFrame.new(position)
	ring.Parent = workspace
	local goalSize = flat and Vector3.new(0.4, size, size) or Vector3.new(size, size, size)
	TweenService:Create(ring, TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = goalSize,
		Transparency = 1,
	}):Play()
	Debris:AddItem(ring, duration + 0.1)
end

local function burstParticles(parent, color, count)
	local att = Instance.new(&quot;Attachment&quot;)
	att.Parent = parent
	local emitter = Instance.new(&quot;ParticleEmitter&quot;)
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.4, 0.8)
	emitter.Speed = NumberRange.new(15, 35)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new(0, 1)
	emitter.LightEmission = 1
	emitter.Drag = 4
	emitter.Color = ColorSequence.new(color)
	emitter.Parent = att
	emitter:Emit(count)
	Debris:AddItem(att, 2)
end

local function flashScreen(color, transparency, duration)
	local gui = player.PlayerGui:FindFirstChild(&quot;OnyxFlash&quot;)
	if not gui then
		gui = Instance.new(&quot;ScreenGui&quot;)
		gui.Name = &quot;OnyxFlash&quot;
		gui.IgnoreGuiInset = true
		gui.ResetOnSpawn = false
		gui.DisplayOrder = 50
		gui.Parent = player.PlayerGui
		local frame = Instance.new(&quot;Frame&quot;)
		frame.Name = &quot;Flash&quot;
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundTransparency = 1
		frame.BorderSizePixel = 0
		frame.Parent = gui
	end
	local frame = gui.Flash
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency
	TweenService:Create(frame, TweenInfo.new(duration), { BackgroundTransparency = 1 }):Play()
end

-- Surbrillance de la cible
local highlight = Instance.new(&quot;Highlight&quot;)
highlight.Name = &quot;TargetHighlight&quot;
highlight.FillColor = Config.Colors.Danger
highlight.OutlineColor = Color3.new(1, 1, 1)
highlight.FillTransparency = 0.6
highlight.OutlineTransparency = 0
highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
highlight.Enabled = false

local billboard = Instance.new(&quot;BillboardGui&quot;)
billboard.Name = &quot;TargetTag&quot;
billboard.Size = UDim2.fromOffset(120, 40)
billboard.StudsOffset = Vector3.new(0, 3.5, 0)
billboard.AlwaysOnTop = true
billboard.Enabled = false
local tag = Instance.new(&quot;TextLabel&quot;)
tag.Size = UDim2.fromScale(1, 1)
tag.BackgroundTransparency = 1
tag.Text = &quot;CIBLE&quot;
tag.Font = Enum.Font.GothamBlack
tag.TextScaled = true
tag.TextColor3 = Config.Colors.Danger
tag.TextStrokeTransparency = 0.3
tag.Parent = billboard

local function setTarget(userId)
	State.targetUserId = userId
	local char = userId ~= 0 and getCharacter(userId) or nil
	if char then
		highlight.Parent = char
		highlight.Enabled = true
		local head = char:FindFirstChild(&quot;Head&quot;)
		billboard.Adornee = head
		billboard.Parent = head
		billboard.Enabled = userId ~= player.UserId
		if userId == player.UserId then
			playSound(&quot;rbxasset://sounds/electronicpingshort.wav&quot;, 0.8, 1.1)
		end
	else
		highlight.Enabled = false
		highlight.Parent = nil
		billboard.Enabled = false
		billboard.Parent = nil
	end
end

local handlers = {}

handlers.Target = function(data)
	setTarget(data.userId or 0)
end

handlers.Deflect = function(data)
	local color = data.deflects and (data.deflects &gt; 12 and Config.Colors.Danger or (data.deflects &gt; 6 and Config.Colors.Gold or Config.Colors.Accent)) or Config.Colors.Accent
	shockwave(data.position, color, 26, 0.45, false)
	shockwave(data.position, Color3.new(1, 1, 1), 34, 0.35, true)
	local pitch = 0.9 + math.min((data.speed or 40) / 240, 1) * 0.6
	playSound(&quot;rbxasset://sounds/swoosh.wav&quot;, 1, pitch, data.position)
	playSound(&quot;rbxasset://sounds/snap.wav&quot;, 0.6, pitch, data.position)
	local char = getCharacter(data.userId)
	local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if hrp then
		burstParticles(hrp, color, 25)
	end
	if data.userId == player.UserId then
		Effects.shake(1.2)
		flashScreen(Config.Colors.Accent, 0.85, 0.3)
	else
		local myChar = player.Character
		local myHrp = myChar and myChar:FindFirstChild(&quot;HumanoidRootPart&quot;)
		if myHrp and (myHrp.Position - data.position).Magnitude &lt; 40 then
			Effects.shake(0.4)
		end
	end
end

handlers.Swing = function(data)
	if data.userId == player.UserId then
		return -- deja affiche localement
	end
	local char = getCharacter(data.userId)
	local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if hrp then
		shockwave(hrp.Position, Color3.new(1, 1, 1), 10, 0.25, true)
		playSound(&quot;rbxasset://sounds/swoosh.wav&quot;, 0.4, 1.3, hrp.Position)
	end
end

handlers.Hit = function(data)
	local explosion = Instance.new(&quot;Explosion&quot;)
	explosion.Position = data.position
	explosion.BlastPressure = 0
	explosion.BlastRadius = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.ExplosionType = Enum.ExplosionType.NoCraters
	explosion.Parent = workspace
	shockwave(data.position, Config.Colors.Danger, 40, 0.6, false)
	playSound(&quot;rbxasset://sounds/collide.wav&quot;, 1, 0.8, data.position)
	playSound(&quot;rbxasset://sounds/splat.wav&quot;, 0.7, 0.9, data.position)
	if data.userId == player.UserId then
		Effects.shake(3)
		flashScreen(Config.Colors.Danger, 0.5, 0.8)
	else
		Effects.shake(0.8)
	end
end

handlers.Pulse = function(data)
	local color = Config.Colors.Accent2
	shockwave(data.position, color, Config.Abilities.Pulse.Radius * 2, 0.8, false)
	shockwave(data.position, color, Config.Abilities.Pulse.Radius * 2.2, 1, true)
	playSound(&quot;rbxasset://sounds/bass.wav&quot;, 1, 0.8, data.position)
	if data.userId == player.UserId then
		Effects.shake(1)
		flashScreen(color, 0.8, 0.5)
	end
end

handlers.Dash = function(data)
	local char = getCharacter(data.userId)
	local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if hrp then
		burstParticles(hrp, Config.Colors.Gold, 15)
	end
end

handlers.Overdrive = function(data)
	State.overdrive = data.enabled
	local cc = Lighting:FindFirstChild(&quot;ArenaColor&quot;)
	if cc then
		TweenService:Create(cc, TweenInfo.new(1), {
			TintColor = data.enabled and Color3.fromRGB(255, 200, 230) or Color3.new(1, 1, 1),
			Saturation = data.enabled and 0.5 or 0.15,
		}):Play()
	end
	if data.enabled then
		playSound(&quot;rbxasset://sounds/HalloweenGhost.wav&quot;, 1, 0.6)
		flashScreen(Config.Colors.Accent2, 0.6, 1)
		Effects.shake(2)
	end
end

function Effects.Init()
	Remotes.BallEvent.OnClientEvent:Connect(function(kind, data)
		local handler = handlers[kind]
		if handler then
			handler(data or {})
		end
	end)

	State.Changed.Event:Connect(function(what, data)
		if what == &quot;round&quot; and data.phase == &quot;Ending&quot; then
			setTarget(0)
			if data.winnerUserId == player.UserId then
				playSound(&quot;rbxasset://sounds/victory.wav&quot;, 1, 1)
				flashScreen(Config.Colors.Gold, 0.7, 1.2)
			end
		elseif what == &quot;doublejump&quot; then
			local char = player.Character
			local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
			if hrp then
				shockwave(hrp.Position - Vector3.new(0, 2.5, 0), Config.Colors.Accent, 8, 0.3, true)
			end
		elseif what == &quot;dash&quot; then
			local char = player.Character
			local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
			if hrp then
				burstParticles(hrp, Config.Colors.Gold, 20)
			end
		end
	end)

	-- Si la cible a deja ete choisie avant le chargement du client
	local ball = State.getBall()
	if ball then
		setTarget(ball:GetAttribute(&quot;TargetUserId&quot;) or 0)
	end
end

return Effects
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">HUD</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Interface : phase/timer, cible, vitesse du ballon, capacites, stats, notifications.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)

local HUD = {}

local player = Players.LocalPlayer
local playerGui = player:WaitForChild(&quot;PlayerGui&quot;)
local FONT = Enum.Font.GothamBlack
local FONT_BOLD = Enum.Font.GothamBold

local ui = {}
local Input -- injecte par Init

local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

local function corner(parent, radius)
	return new(&quot;UICorner&quot;, { CornerRadius = UDim.new(0, radius or 10) }, parent)
end

local function stroke(parent, color, thickness, transparency)
	return new(&quot;UIStroke&quot;, { Color = color, Thickness = thickness or 2, Transparency = transparency or 0 }, parent)
end

local function label(props, parent)
	local base = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = Color3.new(0, 0, 0),
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return new(&quot;TextLabel&quot;, base, parent)
end

local function buildAbilityButton(parent, name, title, key, color, order)
	local button = new(&quot;TextButton&quot;, {
		Name = name,
		Size = UDim2.fromOffset(84, 84),
		BackgroundColor3 = Config.Colors.Dark,
		BackgroundTransparency = 0.15,
		Text = &quot;&quot;,
		AutoButtonColor = false,
		LayoutOrder = order,
	}, parent)
	corner(button, 14)
	stroke(button, color, 3)

	local fill = new(&quot;Frame&quot;, {
		Name = &quot;Cooldown&quot;,
		Size = UDim2.fromScale(1, 0),
		Position = UDim2.fromScale(0, 1),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.65,
		BorderSizePixel = 0,
	}, button)
	corner(fill, 14)

	label({
		Name = &quot;Title&quot;,
		Size = UDim2.new(1, -8, 0, 26),
		Position = UDim2.new(0, 4, 0, 10),
		Text = title,
		TextColor3 = color,
	}, button)
	label({
		Name = &quot;Key&quot;,
		Size = UDim2.new(1, -8, 0, 22),
		Position = UDim2.new(0, 4, 0, 40),
		Text = key,
		Font = FONT_BOLD,
		TextColor3 = Color3.fromRGB(220, 220, 230),
	}, button)
	label({
		Name = &quot;Timer&quot;,
		Size = UDim2.new(1, -8, 0, 20),
		Position = UDim2.new(0, 4, 1, -24),
		Text = &quot;&quot;,
		Font = FONT_BOLD,
		TextColor3 = Color3.new(1, 1, 1),
	}, button)
	return button
end

local function build()
	local gui = new(&quot;ScreenGui&quot;, {
		Name = &quot;OnyxHUD&quot;,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, playerGui)
	ui.gui = gui

	-- Bandeau haut
	local top = new(&quot;Frame&quot;, {
		Name = &quot;Top&quot;,
		Size = UDim2.fromOffset(420, 86),
		Position = UDim2.new(0.5, 0, 0, 58),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Config.Colors.Dark,
		BackgroundTransparency = 0.25,
	}, gui)
	corner(top, 16)
	stroke(top, Config.Colors.Accent, 2, 0.3)
	ui.phase = label({
		Size = UDim2.new(1, -16, 0, 30),
		Position = UDim2.new(0, 8, 0, 8),
		Text = Config.GameName,
		TextColor3 = Config.Colors.Accent,
	}, top)
	ui.timer = label({
		Size = UDim2.new(1, -16, 0, 40),
		Position = UDim2.new(0, 8, 0, 40),
		Text = &quot;&quot;,
	}, top)

	-- Compteur de survivants
	local aliveFrame = new(&quot;Frame&quot;, {
		Size = UDim2.fromOffset(170, 44),
		Position = UDim2.new(1, -14, 0, 58),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Config.Colors.Dark,
		BackgroundTransparency = 0.25,
	}, gui)
	corner(aliveFrame, 12)
	stroke(aliveFrame, Config.Colors.Accent2, 2, 0.3)
	ui.alive = label({ Size = UDim2.new(1, -12, 1, -8), Position = UDim2.new(0, 6, 0, 4), Text = &quot;&quot; }, aliveFrame)

	-- Stats joueur
	local stats = new(&quot;Frame&quot;, {
		Size = UDim2.fromOffset(190, 96),
		Position = UDim2.new(0, 14, 0, 58),
		BackgroundColor3 = Config.Colors.Dark,
		BackgroundTransparency = 0.25,
	}, gui)
	corner(stats, 12)
	stroke(stats, Config.Colors.Gold, 2, 0.3)
	ui.coins = label({ Size = UDim2.new(1, -12, 0, 28), Position = UDim2.new(0, 8, 0, 4), Text = &quot;0 pieces&quot;, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Config.Colors.Gold }, stats)
	ui.wins = label({ Size = UDim2.new(1, -12, 0, 28), Position = UDim2.new(0, 8, 0, 34), Text = &quot;0 victoires&quot;, TextXAlignment = Enum.TextXAlignment.Left }, stats)
	ui.streak = label({ Size = UDim2.new(1, -12, 0, 26), Position = UDim2.new(0, 8, 0, 64), Text = &quot;Serie : 0&quot;, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Config.Colors.Accent, Font = FONT_BOLD }, stats)

	-- Banniere CIBLE
	ui.targetBanner = label({
		Name = &quot;TargetBanner&quot;,
		Size = UDim2.fromOffset(520, 70),
		Position = UDim2.new(0.5, 0, 0, 160),
		AnchorPoint = Vector2.new(0.5, 0),
		Text = &quot;TU ES LA CIBLE !&quot;,
		TextColor3 = Config.Colors.Danger,
		Visible = false,
	}, gui)

	-- Vignette rouge
	ui.vignette = new(&quot;Frame&quot;, {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Config.Colors.Danger,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 0,
	}, gui)
	new(&quot;UIGradient&quot;, {
		Color = ColorSequence.new(Color3.new(1, 1, 1)),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.25, 1),
			NumberSequenceKeypoint.new(0.75, 1),
			NumberSequenceKeypoint.new(1, 0),
		}),
	}, ui.vignette)

	-- Barre de vitesse du ballon
	local speedFrame = new(&quot;Frame&quot;, {
		Size = UDim2.fromOffset(300, 40),
		Position = UDim2.new(0.5, 0, 1, -140),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Config.Colors.Dark,
		BackgroundTransparency = 0.25,
		Visible = false,
	}, gui)
	corner(speedFrame, 10)
	stroke(speedFrame, Config.Colors.Accent, 2, 0.3)
	ui.speedFrame = speedFrame
	ui.speedFill = new(&quot;Frame&quot;, {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Config.Colors.Accent,
		BorderSizePixel = 0,
	}, speedFrame)
	corner(ui.speedFill, 10)
	ui.speedText = label({ Size = UDim2.fromScale(1, 1), Text = &quot;Vitesse 0&quot;, Font = FONT_BOLD }, speedFrame)
	ui.speedText.ZIndex = 2

	-- Capacites
	local abilities = new(&quot;Frame&quot;, {
		Name = &quot;Abilities&quot;,
		Size = UDim2.fromOffset(300, 90),
		Position = UDim2.new(0.5, 0, 1, -30),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
	}, gui)
	new(&quot;UIListLayout&quot;, {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 14),
	}, abilities)

	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	ui.buttons = {
		Deflect = buildAbilityButton(abilities, &quot;Deflect&quot;, &quot;RENVOI&quot;, touch and &quot;TAP&quot; or &quot;F / CLIC&quot;, Config.Colors.Accent, 1),
		Dash = buildAbilityButton(abilities, &quot;Dash&quot;, &quot;DASH&quot;, touch and &quot;TAP&quot; or &quot;Q&quot;, Config.Colors.Gold, 2),
		Pulse = buildAbilityButton(abilities, &quot;Pulse&quot;, &quot;PULSE&quot;, touch and &quot;TAP&quot; or &quot;E&quot;, Config.Colors.Accent2, 3),
	}
	if touch then
		abilities.Position = UDim2.new(1, -20, 1, -40)
		abilities.AnchorPoint = Vector2.new(1, 1)
		for _, b in pairs(ui.buttons) do
			b.Size = UDim2.fromOffset(96, 96)
		end
	end

	-- Overdrive
	ui.overdrive = label({
		Size = UDim2.fromOffset(400, 40),
		Position = UDim2.new(0.5, 0, 0, 148),
		AnchorPoint = Vector2.new(0.5, 0),
		Text = &quot;OVERDRIVE&quot;,
		TextColor3 = Config.Colors.Accent2,
		Visible = false,
	}, gui)

	-- Notifications
	local toasts = new(&quot;Frame&quot;, {
		Name = &quot;Toasts&quot;,
		Size = UDim2.fromOffset(460, 200),
		Position = UDim2.new(0.5, 0, 0, 240),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
	}, gui)
	new(&quot;UIListLayout&quot;, {
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
	}, toasts)
	ui.toasts = toasts

	-- Ecran de fin
	ui.endScreen = label({
		Size = UDim2.fromOffset(700, 90),
		Position = UDim2.new(0.5, 0, 0.42, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = &quot;&quot;,
		TextColor3 = Config.Colors.Gold,
		Visible = false,
	}, gui)
end

local toastCount = 0
function HUD.toast(text, kind)
	toastCount += 1
	local color = Color3.new(1, 1, 1)
	if kind == &quot;danger&quot; then
		color = Config.Colors.Danger
	elseif kind == &quot;gold&quot; then
		color = Config.Colors.Gold
	elseif kind == &quot;overdrive&quot; then
		color = Config.Colors.Accent2
	elseif kind == &quot;good&quot; then
		color = Config.Colors.Accent
	end
	local frame = new(&quot;Frame&quot;, {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Config.Colors.Dark,
		BackgroundTransparency = 0.3,
		LayoutOrder = toastCount,
	}, ui.toasts)
	corner(frame, 8)
	stroke(frame, color, 2, 0.4)
	local l = label({ Size = UDim2.new(1, -12, 1, -6), Position = UDim2.new(0, 6, 0, 3), Text = text, TextColor3 = color, Font = FONT_BOLD }, frame)
	task.delay(3, function()
		TweenService:Create(frame, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.wait(0.45)
		frame:Destroy()
	end)
end

local function updateStats()
	local ls = player:FindFirstChild(&quot;leaderstats&quot;)
	if not ls then
		return
	end
	local coins = ls:FindFirstChild(&quot;Coins&quot;)
	local wins = ls:FindFirstChild(&quot;Wins&quot;)
	local streak = ls:FindFirstChild(&quot;Streak&quot;)
	ui.coins.Text = (coins and coins.Value or 0) .. &quot; pieces&quot;
	ui.wins.Text = (wins and wins.Value or 0) .. &quot; victoires&quot;
	ui.streak.Text = &quot;Serie : &quot; .. (streak and streak.Value or 0)
end

local function hookStats()
	local ls = player:WaitForChild(&quot;leaderstats&quot;, 30)
	if not ls then
		return
	end
	for _, v in ipairs(ls:GetChildren()) do
		v.Changed:Connect(updateStats)
	end
	ls.ChildAdded:Connect(function(v)
		v.Changed:Connect(updateStats)
		updateStats()
	end)
	updateStats()
end

local function onRoundState(round)
	local previous = State.round
	State.round = round
	local phaseText = {
		Waiting = &quot;EN ATTENTE&quot;,
		Intermission = &quot;LOBBY&quot;,
		Starting = &quot;DEPART&quot;,
		Playing = round.practice and &quot;ENTRAINEMENT&quot; or &quot;MANCHE EN COURS&quot;,
		Ending = &quot;FIN DE MANCHE&quot;,
	}
	ui.phase.Text = phaseText[round.phase] or Config.GameName
	if round.timer and round.timer &gt; 0 then
		if round.phase == &quot;Playing&quot; then
			local m = math.floor(round.timer / 60)
			local s = round.timer % 60
			ui.timer.Text = string.format(&quot;%d:%02d&quot;, m, s)
		elseif round.phase == &quot;Starting&quot; then
			ui.timer.Text = round.message .. &quot;  &quot; .. round.timer
		else
			ui.timer.Text = round.message .. &quot;  &quot; .. round.timer .. &quot;s&quot;
		end
	else
		ui.timer.Text = round.message or &quot;&quot;
	end

	ui.alive.Text = (round.aliveCount or 0) .. &quot; / &quot; .. (round.totalCount or 0) .. &quot; en vie&quot;
	ui.alive.Parent.Visible = round.phase == &quot;Playing&quot; or round.phase == &quot;Starting&quot;
	ui.speedFrame.Visible = round.phase == &quot;Playing&quot;

	if round.phase ~= &quot;Playing&quot; then
		State.targetUserId = 0
		ui.targetBanner.Visible = false
		ui.overdrive.Visible = false
		State.overdrive = false
	end

	if round.phase == &quot;Ending&quot; then
		ui.endScreen.Text = round.message
		ui.endScreen.Visible = true
		ui.endScreen.TextColor3 = (round.winnerUserId == player.UserId) and Config.Colors.Gold or Color3.new(1, 1, 1)
		ui.endScreen.Size = UDim2.fromOffset(100, 20)
		TweenService:Create(ui.endScreen, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(700, 90) }):Play()
	else
		ui.endScreen.Visible = false
	end

	if round.phase == &quot;Starting&quot; and previous.phase ~= &quot;Starting&quot; then
		HUD.toast(round.practice and &quot;Entrainement solo : le ballon ne t'elimine pas&quot; or &quot;Dernier survivant gagne !&quot;, &quot;good&quot;)
	end
	State.Changed:Fire(&quot;round&quot;, round)
end

local function updateCooldowns()
	local durations = {
		Deflect = Config.Ball.DeflectCooldown,
		Dash = Config.Abilities.Dash.Cooldown,
		Pulse = Config.Abilities.Pulse.Cooldown,
	}
	for name, button in pairs(ui.buttons) do
		local left = State.cooldownLeft(name)
		local ratio = math.clamp(left / durations[name], 0, 1)
		button.Cooldown.Size = UDim2.fromScale(1, ratio)
		button.Timer.Text = left &gt; 0.05 and string.format(&quot;%.1f&quot;, left) or &quot;&quot;
		button.BackgroundTransparency = left &gt; 0 and 0.4 or 0.15
	end
end

local function updateBall()
	local ball = State.getBall()
	if not ball then
		ui.speedFill.Size = UDim2.fromScale(0, 1)
		return
	end
	local speed = ball:GetAttribute(&quot;Speed&quot;) or 0
	local ratio = math.clamp((speed - Config.Ball.BaseSpeed) / (Config.Ball.MaxSpeed - Config.Ball.BaseSpeed), 0, 1)
	ui.speedFill.Size = UDim2.fromScale(math.max(ratio, 0.03), 1)
	ui.speedFill.BackgroundColor3 = Config.Colors.Accent:Lerp(Config.Colors.Danger, ratio)
	ui.speedText.Text = &quot;Vitesse &quot; .. speed .. &quot;  |  Renvois &quot; .. (ball:GetAttribute(&quot;Deflects&quot;) or 0)

	local targeted = State.targetUserId == player.UserId
	ui.targetBanner.Visible = targeted
	if targeted then
		local pulse = 0.5 + 0.5 * math.sin(os.clock() * 10)
		ui.targetBanner.TextTransparency = pulse * 0.4
		local dist = 999
		local char = player.Character
		local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
		if hrp then
			dist = (hrp.Position - ball.Position).Magnitude
		end
		local close = math.clamp(1 - (dist - Config.Ball.DeflectRange) / 40, 0, 1)
		ui.vignette.BackgroundTransparency = 1 - close * 0.55
		ui.targetBanner.Text = dist &lt;= Config.Ball.DeflectRange and &quot;RENVOIE MAINTENANT !&quot; or &quot;TU ES LA CIBLE !&quot;
		ui.targetBanner.TextColor3 = dist &lt;= Config.Ball.DeflectRange and Config.Colors.Accent or Config.Colors.Danger
	else
		ui.vignette.BackgroundTransparency = 1
	end

	if State.overdrive then
		ui.overdrive.Visible = true
		ui.overdrive.TextTransparency = 0.3 + 0.3 * math.sin(os.clock() * 6)
	end
end

function HUD.Init(inputModule)
	Input = inputModule
	build()
	task.spawn(hookStats)

	ui.buttons.Deflect.Activated:Connect(function()
		Input.deflect()
	end)
	ui.buttons.Dash.Activated:Connect(function()
		Input.dash()
	end)
	ui.buttons.Pulse.Activated:Connect(function()
		Input.pulse()
	end)

	Remotes.RoundState.OnClientEvent:Connect(onRoundState)
	Remotes.Notify.OnClientEvent:Connect(HUD.toast)

	RunService.RenderStepped:Connect(function()
		updateCooldowns()
		updateBall()
	end)
end

return HUD
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Input</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Controles : renvoi, dash, double saut, pulse, jump pads, boutons tactiles.

local Players = game:GetService(&quot;Players&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)
local ContextActionService = game:GetService(&quot;ContextActionService&quot;)
local CollectionService = game:GetService(&quot;CollectionService&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)

local Input = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local character, humanoid, rootPart
local canDoubleJump = false
local lastJumpTime = 0
local lastSwing = 0

local sounds = {}
local function playSound(id, volume, pitch)
	local s = sounds[id]
	if not s then
		s = Instance.new(&quot;Sound&quot;)
		s.SoundId = id
		s.Parent = workspace
		sounds[id] = s
	end
	s.Volume = volume or 0.5
	s.PlaybackSpeed = pitch or 1
	s:Play()
end

local function fovPunch(amount, duration)
	local base = 70
	camera.FieldOfView = base + amount
	TweenService:Create(camera, TweenInfo.new(duration or 0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = base }):Play()
end

-- Onde locale instantanee (feedback avant la reponse serveur)
local function localSwingRing()
	if not rootPart then
		return
	end
	local ring = Instance.new(&quot;Part&quot;)
	ring.Shape = Enum.PartType.Ball
	ring.Size = Vector3.new(3, 3, 3)
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.new(1, 1, 1)
	ring.Transparency = 0.4
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CFrame = rootPart.CFrame
	ring.Parent = workspace
	TweenService:Create(ring, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(Config.Ball.DeflectRange * 1.6, 1, Config.Ball.DeflectRange * 1.6),
		Transparency = 1,
	}):Play()
	task.delay(0.3, function()
		ring:Destroy()
	end)
end

function Input.deflect()
	local now = os.clock()
	if now - lastSwing &lt; Config.Ball.DeflectCooldown then
		return
	end
	lastSwing = now
	State.setCooldown(&quot;Deflect&quot;, Config.Ball.DeflectCooldown)
	localSwingRing()
	playSound(&quot;rbxasset://sounds/swoosh.wav&quot;, 0.6, 1.2)
	Remotes.Deflect:FireServer()
end

function Input.dash()
	if not rootPart or not humanoid or humanoid.Health &lt;= 0 then
		return
	end
	if State.cooldownLeft(&quot;Dash&quot;) &gt; 0 then
		return
	end
	State.setCooldown(&quot;Dash&quot;, Config.Abilities.Dash.Cooldown)

	local dir = humanoid.MoveDirection
	if dir.Magnitude &lt; 0.1 then
		dir = camera.CFrame.LookVector * Vector3.new(1, 0, 1)
	end
	if dir.Magnitude &lt; 0.01 then
		dir = rootPart.CFrame.LookVector
	end
	dir = dir.Unit
	rootPart.AssemblyLinearVelocity = dir * Config.Abilities.Dash.Speed + Vector3.new(0, Config.Abilities.Dash.Lift, 0)

	fovPunch(14, 0.4)
	playSound(&quot;rbxasset://sounds/swoosh.wav&quot;, 0.8, 0.8)
	Remotes.Ability:FireServer(&quot;Dash&quot;)
	State.Changed:Fire(&quot;dash&quot;)
end

function Input.pulse()
	if not rootPart or State.cooldownLeft(&quot;Pulse&quot;) &gt; 0 then
		return
	end
	if State.round.phase ~= &quot;Playing&quot; then
		return
	end
	State.setCooldown(&quot;Pulse&quot;, Config.Abilities.Pulse.Cooldown)
	Remotes.Ability:FireServer(&quot;Pulse&quot;)
	fovPunch(-8, 0.5)
end

local function tryDoubleJump()
	if not humanoid or not rootPart or humanoid.Health &lt;= 0 then
		return
	end
	local stateName = humanoid:GetState()
	if stateName ~= Enum.HumanoidStateType.Freefall then
		return
	end
	if not canDoubleJump or os.clock() - lastJumpTime &lt; 0.2 then
		return
	end
	canDoubleJump = false
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	local v = rootPart.AssemblyLinearVelocity
	rootPart.AssemblyLinearVelocity = Vector3.new(v.X, Config.Abilities.DoubleJump.Power, v.Z)
	playSound(&quot;rbxasset://sounds/action_jump.mp3&quot;, 0.5, 1.3)
	State.Changed:Fire(&quot;doublejump&quot;)
end

local function onCharacter(char)
	character = char
	humanoid = char:WaitForChild(&quot;Humanoid&quot;)
	rootPart = char:WaitForChild(&quot;HumanoidRootPart&quot;)
	canDoubleJump = false

	humanoid.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
			canDoubleJump = true
		elseif new == Enum.HumanoidStateType.Jumping then
			lastJumpTime = os.clock()
		end
	end)
end

-- Jump pads
local padDebounce = 0
local function hookPad(pad)
	pad.Touched:Connect(function(hit)
		if not character or hit.Parent ~= character or not rootPart then
			return
		end
		if os.clock() - padDebounce &lt; 0.6 then
			return
		end
		padDebounce = os.clock()
		local power = pad:GetAttribute(&quot;Power&quot;) or Config.Arena.JumpPadPower
		local v = rootPart.AssemblyLinearVelocity
		rootPart.AssemblyLinearVelocity = Vector3.new(v.X * 0.6, power, v.Z * 0.6)
		canDoubleJump = true
		playSound(&quot;rbxasset://sounds/action_jump.mp3&quot;, 0.7, 0.7)
		fovPunch(10, 0.5)
	end)
end

function Input.Init()
	if player.Character then
		onCharacter(player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)

	for _, pad in ipairs(CollectionService:GetTagged(&quot;JumpPad&quot;)) do
		hookPad(pad)
	end
	CollectionService:GetInstanceAddedSignal(&quot;JumpPad&quot;):Connect(hookPad)

	UserInputService.JumpRequest:Connect(tryDoubleJump)

	ContextActionService:BindAction(&quot;OnyxDeflect&quot;, function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			Input.deflect()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.F, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)

	ContextActionService:BindAction(&quot;OnyxDash&quot;, function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			Input.dash()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.Q, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL2)

	ContextActionService:BindAction(&quot;OnyxPulse&quot;, function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			Input.pulse()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.E, Enum.KeyCode.ButtonY)
end

return Input
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">State</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Etat partage entre les modules client.

local State = {}

State.round = { phase = &quot;Waiting&quot;, message = &quot;&quot;, timer = 0, aliveCount = 0, totalCount = 0, practice = false, winnerUserId = 0 }
State.cooldowns = {} -- [name] = os.clock() de fin
State.targetUserId = 0
State.overdrive = false

State.Changed = Instance.new(&quot;BindableEvent&quot;) -- (what, data)

function State.setCooldown(name, duration)
	State.cooldowns[name] = os.clock() + duration
	State.Changed:Fire(&quot;cooldown&quot;, name)
end

function State.cooldownLeft(name)
	local untilTime = State.cooldowns[name]
	if not untilTime then
		return 0
	end
	return math.max(0, untilTime - os.clock())
end

function State.getBall()
	return workspace:FindFirstChild(&quot;ArenaBall&quot;)
end

return State
</ProtectedString></Properties></Item></Item></Item></Item></Item>
</roblox>
