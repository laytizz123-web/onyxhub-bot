<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Item class="ReplicatedStorage" referent="RBX00000004"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000003"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000000"><Properties><string name="Name">Config</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Configuration centrale d'ONYX FARM.
-- Tout l'equilibrage du jeu se regle ici.

local Config = {}

Config.GameName = &quot;ONYX FARM&quot;
Config.StartCoins = 60

Config.Colors = {
	Accent = Color3.fromRGB(80, 220, 120),
	Accent2 = Color3.fromRGB(255, 150, 60),
	Gold = Color3.fromRGB(255, 200, 40),
	Danger = Color3.fromRGB(255, 80, 80),
	Sky = Color3.fromRGB(90, 190, 255),
	Dark = Color3.fromRGB(28, 36, 30),
	Grass = Color3.fromRGB(96, 170, 70),
	Soil = Color3.fromRGB(96, 66, 42),
	SoilWet = Color3.fromRGB(70, 46, 30),
	Wood = Color3.fromRGB(150, 105, 60),
}

-- Plantes : ordre = ordre d'affichage dans la boutique.
-- price : prix de la graine | growTime : secondes | value : prix de vente de base
-- baseWeight : poids moyen (kg) | multi : repousse apres recolte | stock : {chance, min, max}
Config.Plants = {
	{ id = &quot;Carotte&quot;, price = 10, growTime = 25, value = 18, baseWeight = 0.3, multi = false, shape = &quot;root&quot;, color = Color3.fromRGB(255, 130, 30), stock = { 1, 5, 20 } },
	{ id = &quot;Fraise&quot;, price = 50, growTime = 50, value = 14, baseWeight = 0.3, multi = true, shape = &quot;bush&quot;, color = Color3.fromRGB(255, 60, 80), stock = { 1, 2, 8 } },
	{ id = &quot;Myrtille&quot;, price = 400, growTime = 80, value = 20, baseWeight = 0.2, multi = true, shape = &quot;bush&quot;, color = Color3.fromRGB(70, 90, 220), stock = { 1, 1, 5 } },
	{ id = &quot;Tomate&quot;, price = 800, growTime = 120, value = 30, baseWeight = 0.5, multi = true, shape = &quot;bush&quot;, color = Color3.fromRGB(230, 40, 40), stock = { 0.8, 1, 3 } },
	{ id = &quot;Citrouille&quot;, price = 2500, growTime = 240, value = 350, baseWeight = 7, multi = false, shape = &quot;big&quot;, color = Color3.fromRGB(255, 140, 20), stock = { 0.6, 1, 2 } },
	{ id = &quot;Pasteque&quot;, price = 5000, growTime = 300, value = 800, baseWeight = 8, multi = false, shape = &quot;big&quot;, color = Color3.fromRGB(60, 170, 70), stock = { 0.5, 1, 2 } },
	{ id = &quot;Bambou&quot;, price = 15000, growTime = 200, value = 1400, baseWeight = 4, multi = false, shape = &quot;tall&quot;, color = Color3.fromRGB(120, 200, 80), stock = { 0.4, 1, 2 } },
	{ id = &quot;Cactus&quot;, price = 30000, growTime = 400, value = 3200, baseWeight = 6, multi = true, shape = &quot;cactus&quot;, color = Color3.fromRGB(60, 150, 70), stock = { 0.3, 1, 1 } },
	{ id = &quot;Fruit du dragon&quot;, price = 80000, growTime = 600, value = 9000, baseWeight = 1.2, multi = true, shape = &quot;bush&quot;, color = Color3.fromRGB(255, 70, 160), stock = { 0.2, 1, 1 } },
	{ id = &quot;Fleur de lune&quot;, price = 250000, growTime = 900, value = 40000, baseWeight = 0.8, multi = true, shape = &quot;bush&quot;, color = Color3.fromRGB(180, 120, 255), stock = { 0.08, 1, 1 } },
}

Config.PlantById = {}
for index, plant in ipairs(Config.Plants) do
	plant.index = index
	Config.PlantById[plant.id] = plant
end

-- Mutations : multiplicateur de valeur et couleur du fruit.
Config.Mutations = {
	Mouille = { mult = 2, color = Color3.fromRGB(120, 200, 255), label = &quot;Mouille&quot; },
	Gele = { mult = 10, color = Color3.fromRGB(190, 240, 255), label = &quot;Gele&quot; },
	Choc = { mult = 100, color = Color3.fromRGB(255, 255, 120), label = &quot;Choc&quot; },
	Dore = { mult = 20, color = Color3.fromRGB(255, 215, 0), label = &quot;Dore&quot; },
	ArcEnCiel = { mult = 50, color = Color3.fromRGB(255, 120, 255), label = &quot;Arc-en-ciel&quot; },
}
Config.MutationOrder = { &quot;Dore&quot;, &quot;ArcEnCiel&quot;, &quot;Mouille&quot;, &quot;Gele&quot;, &quot;Choc&quot; }

-- Chances a la maturation d'une plante
Config.RipeMutationChance = { Dore = 0.02, ArcEnCiel = 0.002 }

-- Meteo : duree, multiplicateur de croissance et mutation appliquee
Config.Weather = {
	MinInterval = 150,
	MaxInterval = 280,
	Events = {
		{ id = &quot;Pluie&quot;, label = &quot;PLUIE&quot;, growth = 2, duration = 90, mutation = &quot;Mouille&quot;, mutationChance = 0.08, tick = 5, weight = 5 },
		{ id = &quot;Orage&quot;, label = &quot;ORAGE&quot;, growth = 2.5, duration = 75, mutation = &quot;Mouille&quot;, mutationChance = 0.05, tick = 5, lightning = 9, weight = 3 },
		{ id = &quot;Gel&quot;, label = &quot;VAGUE DE FROID&quot;, growth = 0.6, duration = 70, mutation = &quot;Gele&quot;, mutationChance = 0.06, tick = 6, weight = 2 },
	},
}

Config.Plot = {
	Count = 8,
	Grid = 7, -- 7x7 cases
	TileSize = 4,
	TileGap = 0.6,
	-- Au depart : le carre central 3x3 (9 cases). Chaque palier debloque une couronne :
	-- palier 1 = 25 cases (800), palier 2 = 49 cases (15000)
	ExpandPrices = { 800, 15000 },
	Distance = 90, -- distance du centre
}

Config.Shop = {
	RestockInterval = 300, -- secondes
}

Config.Water = {
	Cooldown = 6,
	Boost = 0.2, -- +20 % de croissance par arrosage
}

Config.Weight = {
	Min = 0.6,
	Max = 3.5, -- un fruit peut peser jusqu'a 3,5x le poids moyen (rare)
	GiantThreshold = 2, -- affichage &quot;Geant&quot;
}

Config.OfflineGrowthCap = 2 * 3600 -- 2 h de croissance hors ligne max

return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Economy</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Calculs partages client/serveur : valeur d'un fruit, libelles.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Config = require(ReplicatedStorage.Shared.Config)

local Economy = {}

function Economy.value(fruit)
	local plant = Config.PlantById[fruit.id]
	if not plant then
		return 0
	end
	local value = plant.value * (fruit.weight / plant.baseWeight)
	for _, name in ipairs(fruit.mutations or {}) do
		local mutation = Config.Mutations[name]
		if mutation then
			value = value * mutation.mult
		end
	end
	return math.floor(value + 0.5)
end

function Economy.mutationLabel(mutations)
	local labels = {}
	for _, name in ipairs(Config.MutationOrder) do
		if table.find(mutations or {}, name) then
			local mutation = Config.Mutations[name]
			table.insert(labels, mutation and mutation.label or name)
		end
	end
	return table.concat(labels, &quot; &quot;)
end

function Economy.fruitName(fruit)
	local plant = Config.PlantById[fruit.id]
	local base = plant and plant.id or fruit.id
	local label = Economy.mutationLabel(fruit.mutations)
	local giant = plant and (fruit.weight / plant.baseWeight) &gt;= Config.Weight.GiantThreshold
	local name = base
	if label ~= &quot;&quot; then
		name = label .. &quot; &quot; .. name
	end
	if giant then
		name = name .. &quot; GEANT&quot;
	end
	return name
end

function Economy.formatWeight(weight)
	if weight &gt;= 1 then
		return string.format(&quot;%.1f kg&quot;, weight)
	end
	return string.format(&quot;%d g&quot;, math.floor(weight * 1000 + 0.5))
end

function Economy.formatCoins(amount)
	local s = tostring(math.floor(amount))
	local formatted = s:reverse():gsub(&quot;(%d%d%d)&quot;, &quot;%1 &quot;):reverse()
	return (formatted:gsub(&quot;^%s+&quot;, &quot;&quot;))
end

-- Poids aleatoire : la plupart des fruits sont proches de la moyenne, rares geants.
function Economy.rollWeight(plant)
	local r = math.random()
	local factor = Config.Weight.Min + (Config.Weight.Max - Config.Weight.Min) * (r ^ 4)
	return math.floor(plant.baseWeight * factor * 1000 + 0.5) / 1000
end

return Economy
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Remotes</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Cree (serveur) ou recupere (client) les RemoteEvents du jeu.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)

local NAMES = { &quot;Action&quot;, &quot;Shop&quot;, &quot;ShopState&quot;, &quot;Weather&quot;, &quot;Inventory&quot;, &quot;Notify&quot;, &quot;FX&quot; }

local Remotes = {}

local folder: Folder
if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild(&quot;Remotes&quot;)
	if existing and existing:IsA(&quot;Folder&quot;) then
		folder = existing
	else
		folder = Instance.new(&quot;Folder&quot;)
		folder.Name = &quot;Remotes&quot;
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(NAMES) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new(&quot;RemoteEvent&quot;)
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild(&quot;Remotes&quot;) :: Folder
end

for _, name in ipairs(NAMES) do
	Remotes[name] = folder:WaitForChild(name) :: RemoteEvent
end

return Remotes
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000000E"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX0000000D"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX00000005"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Point d'entree serveur d'ONYX FARM.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

require(ReplicatedStorage.Shared.Remotes) -- cree les RemoteEvents avant tout

local Modules = script.Parent.Modules
local MapBuilder = require(Modules.MapBuilder)
local DataService = require(Modules.DataService)
local PlotService = require(Modules.PlotService)
local WeatherService = require(Modules.WeatherService)
local ShopService = require(Modules.ShopService)

MapBuilder.Build()
DataService.Init()
PlotService.Init(WeatherService)
WeatherService.Init(PlotService)
ShopService.Init(PlotService)

print(&quot;[OnyxFarm] Serveur pret.&quot;)
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000000C"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">DataService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Sauvegarde DataStore (pieces, graines, fruits, parcelle) + leaderstats.

local DataStoreService = game:GetService(&quot;DataStoreService&quot;)
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local STORE_NAME = &quot;OnyxFarm_v1&quot;

local store = nil
pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)

local cache = {}
local stats = {}

DataService.BeforeSave = nil -- function(player, data) rempli par PlotService

local function defaultData()
	return {
		Coins = Config.StartCoins,
		Seeds = { Carotte = 3 },
		Fruits = {},
		Tiles = {},
		ExpandLevel = 0,
		Harvests = 0,
		Earned = 0,
		SavedAt = os.time(),
	}
end

local function key(player)
	return &quot;p_&quot; .. player.UserId
end

function DataService.Load(player)
	local data = defaultData()
	if store then
		local ok, result = pcall(function()
			return store:GetAsync(key(player))
		end)
		if ok and type(result) == &quot;table&quot; then
			for k, v in pairs(result) do
				data[k] = v
			end
		elseif not ok then
			warn(&quot;[OnyxFarm] Chargement impossible pour &quot; .. player.Name .. &quot; : &quot; .. tostring(result))
		end
	end
	cache[player] = data

	local leaderstats = Instance.new(&quot;Folder&quot;)
	leaderstats.Name = &quot;leaderstats&quot;
	local coins = Instance.new(&quot;IntValue&quot;)
	coins.Name = &quot;Pieces&quot;
	coins.Value = data.Coins
	coins.Parent = leaderstats
	local harvests = Instance.new(&quot;IntValue&quot;)
	harvests.Name = &quot;Recoltes&quot;
	harvests.Value = data.Harvests
	harvests.Parent = leaderstats
	leaderstats.Parent = player
	stats[player] = { Coins = coins, Harvests = harvests }
	return data
end

function DataService.Get(player)
	return cache[player]
end

function DataService.Sync(player)
	local data = cache[player]
	local s = stats[player]
	if data and s then
		s.Coins.Value = math.floor(data.Coins)
		s.Harvests.Value = data.Harvests
	end
end

function DataService.Save(player)
	local data = cache[player]
	if not data then
		return
	end
	if DataService.BeforeSave then
		DataService.BeforeSave(player, data)
	end
	data.SavedAt = os.time()
	if not store then
		return
	end
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function()
			return data
		end)
	end)
	if not ok then
		warn(&quot;[OnyxFarm] Sauvegarde impossible pour &quot; .. player.Name .. &quot; : &quot; .. tostring(err))
	end
end

function DataService.Release(player)
	cache[player] = nil
	stats[player] = nil
end

function DataService.Init()
	game:BindToClose(function()
		for _, p in ipairs(Players:GetPlayers()) do
			DataService.Save(p)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(90)
			for _, p in ipairs(Players:GetPlayers()) do
				DataService.Save(p)
			end
		end
	end)
end

return DataService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">MapBuilder</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Construit la ferme : terrain, place centrale, boutique, stand de vente, 8 parcelles.
-- Aucun asset externe : tout est fait avec des Parts.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local CollectionService = game:GetService(&quot;CollectionService&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local Lighting = game:GetService(&quot;Lighting&quot;)
local Players = game:GetService(&quot;Players&quot;)

local Config = require(ReplicatedStorage.Shared.Config)

local MapBuilder = {}

local function makePart(props)
	local p = Instance.new(&quot;Part&quot;)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		p[key] = value
	end
	return p
end

local function addLabel(parent, text, face, color, font)
	local gui = Instance.new(&quot;SurfaceGui&quot;)
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0
	local label = Instance.new(&quot;TextLabel&quot;)
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.Font = font or Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextStrokeTransparency = 0.6
	label.Parent = gui
	gui.Parent = parent
	return label
end

local function buildLighting()
	Lighting.ClockTime = 13.5
	Lighting.Brightness = 2.5
	Lighting.Ambient = Color3.fromRGB(120, 130, 120)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 150, 140)
	Lighting.FogColor = Color3.fromRGB(200, 225, 255)
	Lighting.FogStart = 300
	Lighting.FogEnd = 1200
	Lighting.GlobalShadows = true
	Lighting.ExposureCompensation = 0.1

	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA(&quot;PostEffect&quot;) or child:IsA(&quot;Atmosphere&quot;) or child:IsA(&quot;Sky&quot;) then
			child:Destroy()
		end
	end

	local bloom = Instance.new(&quot;BloomEffect&quot;)
	bloom.Intensity = 0.4
	bloom.Size = 24
	bloom.Threshold = 1.5
	bloom.Parent = Lighting

	local cc = Instance.new(&quot;ColorCorrectionEffect&quot;)
	cc.Name = &quot;FarmColor&quot;
	cc.Contrast = 0.08
	cc.Saturation = 0.25
	cc.Parent = Lighting

	local atmosphere = Instance.new(&quot;Atmosphere&quot;)
	atmosphere.Density = 0.25
	atmosphere.Offset = 0.1
	atmosphere.Color = Color3.fromRGB(199, 220, 255)
	atmosphere.Decay = Color3.fromRGB(120, 160, 220)
	atmosphere.Glare = 0.4
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting

	local sky = Instance.new(&quot;Sky&quot;)
	sky.SunAngularSize = 14
	sky.Parent = Lighting
end

local function buildTree(root, position, scale)
	scale = scale or 1
	local trunk = makePart({
		Name = &quot;Tree&quot;,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(7 * scale, 1.6 * scale, 1.6 * scale),
		CFrame = CFrame.new(position + Vector3.new(0, 3.5 * scale, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(110, 75, 45),
	})
	trunk.Parent = root
	for i = 1, 3 do
		local r = (5.5 - i * 0.9) * scale
		local leaves = makePart({
			Name = &quot;Leaves&quot;,
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(r * 2, r * 2, r * 2),
			CFrame = CFrame.new(position + Vector3.new(0, (6 + i * 2.2) * scale, 0)),
			Material = Enum.Material.Grass,
			Color = Color3.fromRGB(60 + i * 15, 150 + i * 15, 60),
			CanCollide = false,
		})
		leaves.Parent = root
	end
end

local function buildStand(root, position, lookAt, title, color, promptText, tag)
	local base = makePart({
		Name = tag,
		Size = Vector3.new(12, 4, 5),
		CFrame = CFrame.lookAt(position + Vector3.new(0, 2, 0), Vector3.new(lookAt.X, position.Y + 2, lookAt.Z)),
		Material = Enum.Material.WoodPlanks,
		Color = Config.Colors.Wood,
	})
	base.Parent = root
	local roof = makePart({
		Name = &quot;Roof&quot;,
		Size = Vector3.new(14, 0.6, 8),
		CFrame = base.CFrame * CFrame.new(0, 6, 0),
		Material = Enum.Material.Fabric,
		Color = color,
	})
	roof.Parent = root
	for _, x in ipairs({ -6, 6 }) do
		local pole = makePart({
			Name = &quot;Pole&quot;,
			Size = Vector3.new(0.6, 8, 0.6),
			CFrame = base.CFrame * CFrame.new(x, 2.5, 2.5),
			Material = Enum.Material.Wood,
			Color = Config.Colors.Wood,
		})
		pole.Parent = root
	end
	local sign = makePart({
		Name = &quot;Sign&quot;,
		Size = Vector3.new(12, 2.4, 0.4),
		CFrame = base.CFrame * CFrame.new(0, 4.6, -3.2),
		Material = Enum.Material.SmoothPlastic,
		Color = Config.Colors.Dark,
	})
	sign.Parent = root
	addLabel(sign, title, Enum.NormalId.Front, color)

	local prompt = Instance.new(&quot;ProximityPrompt&quot;)
	prompt.ActionText = promptText
	prompt.ObjectText = title
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = base
	CollectionService:AddTag(base, tag)
	return base
end

local function buildHub(root)
	local ground = makePart({
		Name = &quot;Ground&quot;,
		Size = Vector3.new(520, 4, 520),
		CFrame = CFrame.new(0, -2, 0),
		Material = Enum.Material.Grass,
		Color = Config.Colors.Grass,
	})
	ground.Parent = root

	local plaza = makePart({
		Name = &quot;Plaza&quot;,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 70, 70),
		CFrame = CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Cobblestone,
		Color = Color3.fromRGB(190, 180, 160),
	})
	plaza.Parent = root

	-- Fontaine centrale
	local fountain = makePart({
		Name = &quot;Fountain&quot;,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 14, 14),
		CFrame = CFrame.new(0, 1.2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Marble,
		Color = Color3.fromRGB(230, 230, 235),
	})
	fountain.Parent = root
	local water = makePart({
		Name = &quot;Water&quot;,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 12, 12),
		CFrame = CFrame.new(0, 2.1, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Glass,
		Color = Color3.fromRGB(80, 170, 255),
		Transparency = 0.3,
		CanCollide = false,
	})
	water.Parent = root
	local jet = makePart({
		Name = &quot;Jet&quot;,
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(0, 3, 0),
		Transparency = 1,
		CanCollide = false,
	})
	jet.Parent = root
	local emitter = Instance.new(&quot;ParticleEmitter&quot;)
	emitter.Rate = 40
	emitter.Lifetime = NumberRange.new(1, 1.4)
	emitter.Speed = NumberRange.new(18, 24)
	emitter.SpreadAngle = Vector2.new(8, 8)
	emitter.Acceleration = Vector3.new(0, -40, 0)
	emitter.Size = NumberSequence.new(0.6)
	emitter.Transparency = NumberSequence.new(0.3, 1)
	emitter.Color = ColorSequence.new(Color3.fromRGB(170, 220, 255))
	emitter.Parent = jet

	-- Boutique et stand de vente
	buildStand(root, Vector3.new(-22, 0.4, -14), Vector3.new(0, 0, 0), &quot;GRAINES&quot;, Config.Colors.Accent, &quot;Ouvrir&quot;, &quot;ShopStand&quot;)
	buildStand(root, Vector3.new(22, 0.4, -14), Vector3.new(0, 0, 0), &quot;VENTE&quot;, Config.Colors.Gold, &quot;Tout vendre&quot;, &quot;SellStand&quot;)

	-- Spawn
	local existingSpawn = workspace:FindFirstChildOfClass(&quot;SpawnLocation&quot;)
	if existingSpawn then
		existingSpawn:Destroy()
	end
	local spawn = Instance.new(&quot;SpawnLocation&quot;)
	spawn.Name = &quot;HubSpawn&quot;
	spawn.Size = Vector3.new(10, 0.4, 10)
	spawn.CFrame = CFrame.new(0, 0.5, 16)
	spawn.Anchored = true
	spawn.Material = Enum.Material.Cobblestone
	spawn.Color = Color3.fromRGB(210, 200, 180)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = root

	-- Decor
	for i = 1, 26 do
		local angle = (i / 26) * math.pi * 2 + 0.3
		local radius = 150 + (i % 3) * 25
		buildTree(root, Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius), 0.9 + (i % 4) * 0.25)
	end
	for i = 1, 40 do
		local angle = math.random() * math.pi * 2
		local radius = 40 + math.random() * 200
		local flower = makePart({
			Name = &quot;Flower&quot;,
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.8, 0.8, 0.8),
			CFrame = CFrame.new(math.cos(angle) * radius, 0.4, math.sin(angle) * radius),
			Material = Enum.Material.Neon,
			Color = ({ Color3.fromRGB(255, 120, 180), Color3.fromRGB(255, 230, 80), Color3.fromRGB(150, 150, 255) })[(i % 3) + 1],
			CanCollide = false,
		})
		flower.Parent = root
	end
end

-- Parcelles --------------------------------------------------------------

local plotFolders = {}
local plotSpawns = {}

local function plotOrigin(plotId)
	local angle = ((plotId - 1) / Config.Plot.Count) * math.pi * 2
	return Vector3.new(math.cos(angle) * Config.Plot.Distance, 0, math.sin(angle) * Config.Plot.Distance), angle
end

local function buildPlot(root, plotId)
	local plot = Config.Plot
	local origin, angle = plotOrigin(plotId)
	local pitch = plot.TileSize + plot.TileGap
	local span = plot.Grid * pitch

	local folder = Instance.new(&quot;Folder&quot;)
	folder.Name = &quot;Plot&quot; .. plotId
	folder:SetAttribute(&quot;PlotId&quot;, plotId)
	folder:SetAttribute(&quot;OwnerId&quot;, 0)
	folder:SetAttribute(&quot;OwnerName&quot;, &quot;&quot;)
	folder:SetAttribute(&quot;ExpandLevel&quot;, 0)

	local rotation = CFrame.new(origin) * CFrame.Angles(0, -angle + math.pi / 2, 0)

	local base = makePart({
		Name = &quot;PlotBase&quot;,
		Size = Vector3.new(span + 8, 0.6, span + 8),
		CFrame = rotation * CFrame.new(0, 0.3, 0),
		Material = Enum.Material.Grass,
		Color = Color3.fromRGB(120, 190, 85),
	})
	base.Parent = folder

	-- Cloture
	local half = (span + 8) / 2
	local fenceLen = span + 8
	for _, side in ipairs({ { 0, half }, { 0, -half }, { half, 0 }, { -half, 0 } }) do
		local horizontal = side[2] ~= 0
		local fence = makePart({
			Name = &quot;Fence&quot;,
			Size = horizontal and Vector3.new(fenceLen, 2.2, 0.4) or Vector3.new(0.4, 2.2, fenceLen),
			CFrame = rotation * CFrame.new(side[1], 1.5, side[2]),
			Material = Enum.Material.WoodPlanks,
			Color = Color3.fromRGB(220, 200, 160),
			CanCollide = false,
		})
		fence.Parent = folder
	end

	-- Panneau du proprietaire
	local sign = makePart({
		Name = &quot;Sign&quot;,
		Size = Vector3.new(14, 3, 0.5),
		CFrame = rotation * CFrame.new(0, 4.5, -half - 1),
		Material = Enum.Material.WoodPlanks,
		Color = Config.Colors.Wood,
	})
	sign.Parent = folder
	local label = addLabel(sign, &quot;Parcelle libre&quot;, Enum.NormalId.Front, Color3.new(1, 1, 1))
	label.Name = &quot;OwnerLabel&quot;
	addLabel(sign, &quot;Parcelle libre&quot;, Enum.NormalId.Back, Color3.new(1, 1, 1)).Name = &quot;OwnerLabelBack&quot;

	-- Point d'apparition du joueur devant sa parcelle (cote centre)
	local spawnPoint = rotation * CFrame.new(0, 3, -half - 5)
	plotSpawns[plotId] = spawnPoint

	-- Cases
	local tiles = Instance.new(&quot;Folder&quot;)
	tiles.Name = &quot;Tiles&quot;
	tiles.Parent = folder
	local center = (plot.Grid + 1) / 2
	for row = 1, plot.Grid do
		for col = 1, plot.Grid do
			local index = (row - 1) * plot.Grid + col
			local ring = math.max(math.abs(row - center), math.abs(col - center)) -- 0 = centre, 1, 2
			local tile = makePart({
				Name = &quot;Tile&quot; .. index,
				Size = Vector3.new(plot.TileSize, 0.5, plot.TileSize),
				CFrame = rotation * CFrame.new((col - center) * pitch, 0.75, (row - center) * pitch),
				Material = Enum.Material.Ground,
				Color = Config.Colors.Soil,
			})
			tile:SetAttribute(&quot;PlotId&quot;, plotId)
			tile:SetAttribute(&quot;Index&quot;, index)
			tile:SetAttribute(&quot;Ring&quot;, ring)
			tile:SetAttribute(&quot;Plant&quot;, &quot;&quot;)
			tile:SetAttribute(&quot;Progress&quot;, 0)
			tile:SetAttribute(&quot;Ripe&quot;, false)
			tile:SetAttribute(&quot;Mutations&quot;, &quot;&quot;)
			tile:SetAttribute(&quot;Locked&quot;, ring &gt;= 1)
			CollectionService:AddTag(tile, &quot;Tile&quot;)
			tile.Parent = tiles
		end
	end

	folder.Parent = root
	plotFolders[plotId] = folder
	return folder
end

function MapBuilder.Build()
	local old = workspace:FindFirstChild(&quot;OnyxFarm&quot;)
	if old then
		old:Destroy()
	end
	local baseplate = workspace:FindFirstChild(&quot;Baseplate&quot;)
	if baseplate then
		baseplate:Destroy()
	end

	local root = Instance.new(&quot;Folder&quot;)
	root.Name = &quot;OnyxFarm&quot;
	root.Parent = workspace

	buildLighting()
	buildHub(root)
	for plotId = 1, Config.Plot.Count do
		buildPlot(root, plotId)
	end

	Players.RespawnTime = 2
	return root
end

function MapBuilder.GetPlotFolder(plotId)
	return plotFolders[plotId]
end

function MapBuilder.GetTile(plotId, index)
	local folder = plotFolders[plotId]
	return folder and folder.Tiles:FindFirstChild(&quot;Tile&quot; .. index)
end

function MapBuilder.SetPlotOwner(plotId, player)
	local folder = plotFolders[plotId]
	if not folder then
		return
	end
	folder:SetAttribute(&quot;OwnerId&quot;, player and player.UserId or 0)
	folder:SetAttribute(&quot;OwnerName&quot;, player and player.DisplayName or &quot;&quot;)
	local text = player and (&quot;Ferme de &quot; .. player.DisplayName) or &quot;Parcelle libre&quot;
	for _, gui in ipairs(folder.Sign:GetChildren()) do
		local label = gui:IsA(&quot;SurfaceGui&quot;) and gui:FindFirstChildOfClass(&quot;TextLabel&quot;)
		if label then
			label.Text = text
			label.TextColor3 = player and Config.Colors.Accent or Color3.new(1, 1, 1)
		end
	end
end

function MapBuilder.GetPlotSpawn(plotId)
	return plotSpawns[plotId]
end

return MapBuilder
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">PlantVisuals</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Construit le modele visuel d'une plante sur une case (4 stades + mutations).

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Config = require(ReplicatedStorage.Shared.Config)

local PlantVisuals = {}

local GREEN = Color3.fromRGB(80, 170, 70)
local DARK_GREEN = Color3.fromRGB(50, 130, 60)

local function part(model, props)
	local p = Instance.new(&quot;Part&quot;)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = true
	p.CanTouch = false
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = model
	return p
end

local function ball(model, cf, size, color, material)
	return part(model, { Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), CFrame = cf, Color = color, Material = material })
end

local function stem(model, cf, height, radius, color)
	return part(model, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, radius * 2, radius * 2),
		CFrame = cf * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color or GREEN,
	})
end

local function fruitStyle(mutations)
	local color, material = nil, Enum.Material.SmoothPlastic
	for _, name in ipairs(Config.MutationOrder) do
		if table.find(mutations, name) then
			local m = Config.Mutations[name]
			if not color then
				color = m.color
			end
			if name == &quot;Dore&quot; or name == &quot;ArcEnCiel&quot; or name == &quot;Choc&quot; then
				material = Enum.Material.Neon
			elseif name == &quot;Gele&quot; then
				material = Enum.Material.Ice
			elseif name == &quot;Mouille&quot; then
				material = Enum.Material.Glass
			end
		end
	end
	return color, material
end

local function addMutationFx(model, cf, mutations)
	if #mutations == 0 then
		return
	end
	local holder = part(model, { Size = Vector3.new(0.2, 0.2, 0.2), CFrame = cf * CFrame.new(0, 1.5, 0), Transparency = 1, CanQuery = false })
	local att = Instance.new(&quot;Attachment&quot;)
	att.Parent = holder
	for _, name in ipairs(mutations) do
		local m = Config.Mutations[name]
		if m then
			local e = Instance.new(&quot;ParticleEmitter&quot;)
			e.Color = ColorSequence.new(m.color)
			e.LightEmission = 1
			e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
			e.Transparency = NumberSequence.new(0.2, 1)
			e.Lifetime = NumberRange.new(0.8, 1.4)
			e.Rate = (name == &quot;ArcEnCiel&quot;) and 14 or 6
			e.Speed = NumberRange.new(1, 2.5)
			e.SpreadAngle = Vector2.new(180, 180)
			e.Acceleration = (name == &quot;Mouille&quot;) and Vector3.new(0, -8, 0) or Vector3.new(0, 1.5, 0)
			if name == &quot;ArcEnCiel&quot; then
				e.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
					ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 240, 80)),
					ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 255, 120)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 120, 255)),
				})
			end
			e.Parent = att
		end
	end
end

local function fruits(model, cf, count, size, radius, height, color, material)
	for i = 1, count do
		local a = (i / count) * math.pi * 2
		ball(model, cf * CFrame.new(math.cos(a) * radius, height, math.sin(a) * radius), size, color, material)
	end
end

local builders = {}

builders.bush = function(model, cf, stage, plant, fcolor, fmat)
	if stage == 0 then
		ball(model, cf * CFrame.new(0, 0.3, 0), 0.7, GREEN)
	elseif stage == 1 then
		stem(model, cf, 1.2, 0.15)
		ball(model, cf * CFrame.new(0, 1.3, 0), 1.2, GREEN)
	elseif stage == 2 then
		stem(model, cf, 1.6, 0.2)
		ball(model, cf * CFrame.new(0, 1.8, 0), 2.4, DARK_GREEN)
		fruits(model, cf, 3, 0.4, 1.1, 1.7, Color3.fromRGB(150, 200, 120))
	else
		stem(model, cf, 1.8, 0.25)
		ball(model, cf * CFrame.new(0, 2, 0), 2.8, DARK_GREEN)
		fruits(model, cf, 5, 0.7, 1.3, 1.9, fcolor or plant.color, fmat)
		ball(model, cf * CFrame.new(0, 3.2, 0), 0.7, fcolor or plant.color, fmat)
	end
end

builders.root = function(model, cf, stage, plant, fcolor, fmat)
	local leaves = math.max(stage, 1) + 1
	for i = 1, leaves do
		local a = (i / leaves) * math.pi * 2
		part(model, {
			Size = Vector3.new(0.25, 0.9 + stage * 0.4, 0.5),
			CFrame = cf * CFrame.new(math.cos(a) * 0.3, 0.6 + stage * 0.2, math.sin(a) * 0.3) * CFrame.Angles(math.rad(25) * math.sin(a), -a, math.rad(25) * math.cos(a)),
			Color = GREEN,
		})
	end
	if stage &gt;= 2 then
		local size = stage == 2 and 0.8 or 1.3
		part(model, {
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size * 0.7, size),
			CFrame = cf * CFrame.new(0, 0.25, 0),
			Color = stage == 2 and Color3.fromRGB(230, 190, 120) or (fcolor or plant.color),
			Material = stage == 3 and fmat or Enum.Material.SmoothPlastic,
		})
	end
end

builders.big = function(model, cf, stage, plant, fcolor, fmat)
	if stage == 0 then
		ball(model, cf * CFrame.new(0, 0.3, 0), 0.7, GREEN)
		return
	end
	stem(model, cf * CFrame.new(-1, 0, 0), 0.6 + stage * 0.3, 0.15)
	ball(model, cf * CFrame.new(-1, 1 + stage * 0.3, 0), 1 + stage * 0.3, GREEN)
	if stage &gt;= 2 then
		local size = stage == 2 and 1.6 or 3
		part(model, {
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size * 0.8, size),
			CFrame = cf * CFrame.new(0.6, size * 0.4 + 0.1, 0),
			Color = stage == 2 and Color3.fromRGB(140, 190, 100) or (fcolor or plant.color),
			Material = stage == 3 and fmat or Enum.Material.SmoothPlastic,
		})
	end
end

builders.tall = function(model, cf, stage, plant, fcolor, fmat)
	local heights = ({ { 0.8 }, { 2, 1.2 }, { 4, 3, 2 }, { 7, 5.5, 4 } })[stage + 1]
	for i, h in ipairs(heights) do
		local a = i * 2.1
		stem(model, cf * CFrame.new(math.cos(a) * 0.7, 0, math.sin(a) * 0.7), h, 0.3, stage == 3 and (fcolor or plant.color) or GREEN).Material = stage == 3 and fmat or Enum.Material.SmoothPlastic
	end
end

builders.cactus = function(model, cf, stage, plant, fcolor, fmat)
	local h = ({ 0.8, 1.6, 3, 4 })[stage + 1]
	stem(model, cf, h, 0.5 + stage * 0.1, plant.color)
	if stage &gt;= 2 then
		for _, side in ipairs({ -1, 1 }) do
			part(model, { Size = Vector3.new(0.8, 0.8, 0.8), CFrame = cf * CFrame.new(side * 0.9, h * 0.5, 0), Color = plant.color })
			stem(model, cf * CFrame.new(side * 0.9, h * 0.5, 0), h * 0.5, 0.35, plant.color)
		end
	end
	if stage == 3 then
		fruits(model, cf, 3, 0.6, 0.6, h + 0.3, fcolor or Color3.fromRGB(255, 90, 160), fmat)
	end
end

function PlantVisuals.Clear(tile)
	local existing = tile:FindFirstChild(&quot;Plant&quot;)
	if existing then
		existing:Destroy()
	end
end

-- stage : 0 graine, 1 pousse, 2 en croissance, 3 mur
function PlantVisuals.Build(tile, plant, stage, mutations)
	PlantVisuals.Clear(tile)
	mutations = mutations or {}
	local model = Instance.new(&quot;Model&quot;)
	model.Name = &quot;Plant&quot;
	local cf = tile.CFrame * CFrame.new(0, 0.25, 0)
	local fcolor, fmat = fruitStyle(mutations)
	local builder = builders[plant.shape] or builders.bush
	builder(model, cf, stage, plant, fcolor, fmat)
	if stage == 3 then
		addMutationFx(model, cf, mutations)
	end
	model.Parent = tile
	return model
end

return PlantVisuals
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">PlotService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Parcelles : attribution, plantation, croissance, arrosage, recolte, mutations, expansion.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Players = game:GetService(&quot;Players&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Economy = require(ReplicatedStorage.Shared.Economy)
local MapBuilder = require(script.Parent.MapBuilder)
local PlantVisuals = require(script.Parent.PlantVisuals)
local DataService = require(script.Parent.DataService)

local PlotService = {}

local WeatherService -- injecte

-- plots[plotId] = { owner = Player?, tiles = { [index] = record } }
-- record = { id, progress, mutations = {}, ripe = bool, stage = n }
local plots = {}
local playerPlot = {} -- [Player] = plotId
local waterCooldown = {} -- [Player] = os.clock()

for plotId = 1, Config.Plot.Count do
	plots[plotId] = { owner = nil, tiles = {} }
end

local function stageFor(progress)
	if progress &gt;= 1 then
		return 3
	elseif progress &gt;= 0.6 then
		return 2
	elseif progress &gt;= 0.25 then
		return 1
	end
	return 0
end

local function tileOf(plotId, index)
	return MapBuilder.GetTile(plotId, index)
end

local function tileIsUnlocked(plotId, tile)
	local folder = MapBuilder.GetPlotFolder(plotId)
	local level = folder and folder:GetAttribute(&quot;ExpandLevel&quot;) or 0
	return (tile:GetAttribute(&quot;Ring&quot;) or 0) &lt;= level + 1
end

local function refreshTile(plotId, index, rebuild)
	local tile = tileOf(plotId, index)
	if not tile then
		return
	end
	local record = plots[plotId].tiles[index]
	if not record then
		tile:SetAttribute(&quot;Plant&quot;, &quot;&quot;)
		tile:SetAttribute(&quot;Progress&quot;, 0)
		tile:SetAttribute(&quot;Ripe&quot;, false)
		tile:SetAttribute(&quot;Mutations&quot;, &quot;&quot;)
		PlantVisuals.Clear(tile)
		return
	end
	tile:SetAttribute(&quot;Plant&quot;, record.id)
	tile:SetAttribute(&quot;Progress&quot;, math.floor(math.min(record.progress, 1) * 100) / 100)
	tile:SetAttribute(&quot;Ripe&quot;, record.ripe)
	tile:SetAttribute(&quot;Mutations&quot;, table.concat(record.mutations, &quot;,&quot;))
	local stage = stageFor(record.progress)
	if rebuild or stage ~= record.stage then
		record.stage = stage
		PlantVisuals.Build(tile, Config.PlantById[record.id], stage, record.mutations)
	end
end

local function setTileLocks(plotId)
	local folder = MapBuilder.GetPlotFolder(plotId)
	if not folder then
		return
	end
	for _, tile in ipairs(folder.Tiles:GetChildren()) do
		local locked = not tileIsUnlocked(plotId, tile)
		tile:SetAttribute(&quot;Locked&quot;, locked)
		tile.Material = locked and Enum.Material.Cobblestone or Enum.Material.Ground
		tile.Color = locked and Color3.fromRGB(120, 120, 115) or Config.Colors.Soil
		tile.Transparency = locked and 0.35 or 0
	end
end

local function ripen(plotId, index, record)
	record.progress = 1
	record.ripe = true
	-- Mutations rares a la maturation
	for name, chance in pairs(Config.RipeMutationChance) do
		if math.random() &lt; chance and not table.find(record.mutations, name) then
			table.insert(record.mutations, name)
		end
	end
	refreshTile(plotId, index, true)
	local tile = tileOf(plotId, index)
	local owner = plots[plotId].owner
	if tile then
		Remotes.FX:FireAllClients(&quot;Ripe&quot;, { position = tile.Position, mutations = record.mutations, owner = owner and owner.UserId or 0 })
	end
end

-- Inventaire -------------------------------------------------------------

function PlotService.SyncInventory(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local fruits = {}
	local totalValue = 0
	for i, fruit in ipairs(data.Fruits) do
		local value = Economy.value(fruit)
		totalValue += value
		fruits[i] = { id = fruit.id, mutations = fruit.mutations, weight = fruit.weight, value = value }
	end
	Remotes.Inventory:FireClient(player, {
		coins = math.floor(data.Coins),
		seeds = data.Seeds,
		fruits = fruits,
		fruitValue = totalValue,
		plotId = playerPlot[player] or 0,
		expandLevel = data.ExpandLevel or 0,
		expandPrice = Config.Plot.ExpandPrices[(data.ExpandLevel or 0) + 1],
		harvests = data.Harvests or 0,
	})
end

-- Actions joueur -----------------------------------------------------------

local function plant(player, plotId, index, seedId)
	local data = DataService.Get(player)
	local def = Config.PlantById[seedId]
	if not data or not def then
		Remotes.Notify:FireClient(player, &quot;Choisis une graine dans ta barre (touches 1-9).&quot;, &quot;info&quot;)
		return
	end
	if (data.Seeds[seedId] or 0) &lt;= 0 then
		Remotes.Notify:FireClient(player, &quot;Tu n'as plus de graine de &quot; .. def.id .. &quot;.&quot;, &quot;danger&quot;)
		return
	end
	data.Seeds[seedId] -= 1
	if data.Seeds[seedId] &lt;= 0 then
		data.Seeds[seedId] = nil
	end
	plots[plotId].tiles[index] = { id = seedId, progress = 0, mutations = {}, ripe = false, stage = -1 }
	refreshTile(plotId, index, true)
	local tile = tileOf(plotId, index)
	Remotes.FX:FireAllClients(&quot;Plant&quot;, { position = tile.Position })
	PlotService.SyncInventory(player)
end

local function harvest(player, plotId, index, record)
	local data = DataService.Get(player)
	local def = Config.PlantById[record.id]
	if not data or not def then
		return
	end
	if #data.Fruits &gt;= 300 then
		Remotes.Notify:FireClient(player, &quot;Ton sac est plein ! Va vendre au stand.&quot;, &quot;danger&quot;)
		return
	end
	local fruit = { id = record.id, mutations = table.clone(record.mutations), weight = Economy.rollWeight(def) }
	table.insert(data.Fruits, fruit)
	data.Harvests += 1
	DataService.Sync(player)

	local tile = tileOf(plotId, index)
	local value = Economy.value(fruit)
	Remotes.FX:FireAllClients(&quot;Harvest&quot;, {
		position = tile.Position,
		color = def.color,
		name = Economy.fruitName(fruit),
		weight = fruit.weight,
		value = value,
		owner = player.UserId,
		mutations = fruit.mutations,
	})

	if def.multi then
		record.progress = 0.55
		record.ripe = false
		record.mutations = {}
		refreshTile(plotId, index, true)
	else
		plots[plotId].tiles[index] = nil
		refreshTile(plotId, index, true)
	end
	PlotService.SyncInventory(player)
end

local function water(player, plotId, index, record)
	local now = os.clock()
	local last = waterCooldown[player] or 0
	if now - last &lt; Config.Water.Cooldown then
		Remotes.Notify:FireClient(player, string.format(&quot;Arrosoir en recharge (%.0fs)&quot;, Config.Water.Cooldown - (now - last)), &quot;info&quot;)
		return
	end
	waterCooldown[player] = now
	record.progress = math.min(record.progress + Config.Water.Boost, 1)
	if record.progress &gt;= 1 then
		ripen(plotId, index, record)
	else
		refreshTile(plotId, index, false)
	end
	local tile = tileOf(plotId, index)
	Remotes.FX:FireAllClients(&quot;Water&quot;, { position = tile.Position, owner = player.UserId })
end

local function onAction(player, plotId, index, seedId)
	plotId = tonumber(plotId)
	index = tonumber(index)
	if not plotId or not index or playerPlot[player] ~= plotId then
		return
	end
	local tile = tileOf(plotId, index)
	if not tile then
		return
	end
	if not tileIsUnlocked(plotId, tile) then
		local price = Config.Plot.ExpandPrices[(DataService.Get(player).ExpandLevel or 0) + 1]
		Remotes.Notify:FireClient(player, price and (&quot;Case verrouillee : agrandis ta parcelle (&quot; .. Economy.formatCoins(price) .. &quot; pieces)&quot;) or &quot;Case verrouillee&quot;, &quot;info&quot;)
		return
	end
	local record = plots[plotId].tiles[index]
	if not record then
		plant(player, plotId, index, tostring(seedId))
	elseif record.ripe then
		harvest(player, plotId, index, record)
	else
		water(player, plotId, index, record)
	end
end

-- Meteo ------------------------------------------------------------------

function PlotService.AddMutation(tile, name)
	local plotId = tile:GetAttribute(&quot;PlotId&quot;)
	local index = tile:GetAttribute(&quot;Index&quot;)
	local record = plots[plotId] and plots[plotId].tiles[index]
	if not record or table.find(record.mutations, name) then
		return
	end
	if name == &quot;Gele&quot; then
		local i = table.find(record.mutations, &quot;Mouille&quot;)
		if i then
			table.remove(record.mutations, i)
		end
	end
	table.insert(record.mutations, name)
	refreshTile(plotId, index, true)
	local owner = plots[plotId].owner
	if owner then
		Remotes.Notify:FireClient(owner, &quot;Mutation &quot; .. Config.Mutations[name].label .. &quot; sur ta &quot; .. record.id .. &quot; !&quot;, &quot;mutation&quot;)
	end
end

function PlotService.ApplyWeatherMutation(name, chance)
	for plotId, plot in pairs(plots) do
		if plot.owner then
			for index, record in pairs(plot.tiles) do
				if record.progress &gt; 0.05 and math.random() &lt; chance then
					local tile = tileOf(plotId, index)
					if tile then
						PlotService.AddMutation(tile, name)
					end
				end
			end
		end
	end
end

function PlotService.RandomPlantedTile()
	local candidates = {}
	for plotId, plot in pairs(plots) do
		if plot.owner then
			for index, record in pairs(plot.tiles) do
				if record.progress &gt; 0.05 then
					table.insert(candidates, tileOf(plotId, index))
				end
			end
		end
	end
	if #candidates == 0 then
		return nil
	end
	return candidates[math.random(#candidates)]
end

-- Expansion ---------------------------------------------------------------

function PlotService.ApplyExpandLevel(player)
	local plotId = playerPlot[player]
	local data = DataService.Get(player)
	local folder = plotId and MapBuilder.GetPlotFolder(plotId)
	if not folder or not data then
		return
	end
	folder:SetAttribute(&quot;ExpandLevel&quot;, data.ExpandLevel or 0)
	setTileLocks(plotId)
end

-- Croissance --------------------------------------------------------------

local function growthLoop()
	local last = os.clock()
	while true do
		task.wait(1)
		local now = os.clock()
		local dt = now - last
		last = now
		local mult = WeatherService and WeatherService.GetGrowthMultiplier() or 1
		for plotId, plot in pairs(plots) do
			if plot.owner then
				for index, record in pairs(plot.tiles) do
					if not record.ripe then
						local def = Config.PlantById[record.id]
						record.progress += (dt / def.growTime) * mult
						if record.progress &gt;= 1 then
							ripen(plotId, index, record)
						else
							refreshTile(plotId, index, false)
						end
					end
				end
			end
		end
	end
end

-- Joueurs ---------------------------------------------------------------------

local function findFreePlot()
	for plotId = 1, Config.Plot.Count do
		if not plots[plotId].owner then
			return plotId
		end
	end
	return nil
end

local function loadTiles(player, plotId, data)
	local elapsed = math.clamp(os.time() - (data.SavedAt or os.time()), 0, Config.OfflineGrowthCap)
	local grown = 0
	for key, saved in pairs(data.Tiles or {}) do
		local index = tonumber(key)
		local def = Config.PlantById[saved.id]
		if index and def and tileOf(plotId, index) then
			local record = { id = saved.id, progress = saved.progress or 0, mutations = saved.mutations or {}, ripe = saved.ripe == true, stage = -1 }
			if not record.ripe then
				record.progress += elapsed / def.growTime
				if record.progress &gt;= 1 then
					record.progress = 1
					record.ripe = true
					grown += 1
				end
			end
			plots[plotId].tiles[index] = record
			refreshTile(plotId, index, true)
		end
	end
	if grown &gt; 0 then
		task.delay(2, function()
			if player.Parent ~= Players then
				return
			end
			Remotes.Notify:FireClient(player, grown .. &quot; plante(s) ont muri pendant ton absence !&quot;, &quot;good&quot;)
		end)
	end
end

local function serializeTiles(player, data)
	local plotId = playerPlot[player]
	if not plotId then
		return
	end
	local tiles = {}
	for index, record in pairs(plots[plotId].tiles) do
		tiles[tostring(index)] = { id = record.id, progress = record.progress, mutations = record.mutations, ripe = record.ripe }
	end
	data.Tiles = tiles
end

local function onPlayerAdded(player)
	local data = DataService.Load(player)
	local plotId = findFreePlot()
	if not plotId then
		Remotes.Notify:FireClient(player, &quot;Toutes les parcelles sont occupees sur ce serveur.&quot;, &quot;danger&quot;)
		return
	end
	plots[plotId].owner = player
	plots[plotId].tiles = {}
	playerPlot[player] = plotId
	MapBuilder.SetPlotOwner(plotId, player)
	local folder = MapBuilder.GetPlotFolder(plotId)
	folder:SetAttribute(&quot;ExpandLevel&quot;, data.ExpandLevel or 0)
	setTileLocks(plotId)
	loadTiles(player, plotId, data)

	local function onCharacter(character)
		local hrp = character:WaitForChild(&quot;HumanoidRootPart&quot;, 5)
		task.wait(0.2)
		local spawnCF = MapBuilder.GetPlotSpawn(plotId)
		if hrp and spawnCF then
			hrp.CFrame = spawnCF
		end
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		onCharacter(player.Character)
	end

	task.wait(1)
	if player.Parent ~= Players then
		return
	end
	PlotService.SyncInventory(player)
	if (data.Harvests or 0) == 0 then
		Remotes.Notify:FireClient(player, &quot;Bienvenue ! Clique sur une case de ta parcelle pour planter une carotte.&quot;, &quot;good&quot;)
	else
		Remotes.Notify:FireClient(player, &quot;Bon retour sur ta ferme, &quot; .. player.DisplayName .. &quot; !&quot;, &quot;good&quot;)
	end
end

local function onPlayerRemoving(player)
	DataService.Save(player)
	local plotId = playerPlot[player]
	if plotId then
		plots[plotId].owner = nil
		for index in pairs(plots[plotId].tiles) do
			local tile = tileOf(plotId, index)
			if tile then
				PlantVisuals.Clear(tile)
				tile:SetAttribute(&quot;Plant&quot;, &quot;&quot;)
				tile:SetAttribute(&quot;Progress&quot;, 0)
				tile:SetAttribute(&quot;Ripe&quot;, false)
				tile:SetAttribute(&quot;Mutations&quot;, &quot;&quot;)
			end
		end
		plots[plotId].tiles = {}
		MapBuilder.SetPlotOwner(plotId, nil)
		local folder = MapBuilder.GetPlotFolder(plotId)
		folder:SetAttribute(&quot;ExpandLevel&quot;, 0)
		setTileLocks(plotId)
	end
	playerPlot[player] = nil
	waterCooldown[player] = nil
	DataService.Release(player)
end

function PlotService.Init(weatherService)
	WeatherService = weatherService
	DataService.BeforeSave = serializeTiles
	for plotId = 1, Config.Plot.Count do
		setTileLocks(plotId)
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, p)
	end
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	Remotes.Action.OnServerEvent:Connect(onAction)
	task.spawn(growthLoop)
end

return PlotService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">ShopService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Boutique de graines avec reassort periodique, achat, vente, agrandissement.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Players = game:GetService(&quot;Players&quot;)
local CollectionService = game:GetService(&quot;CollectionService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Economy = require(ReplicatedStorage.Shared.Economy)
local DataService = require(script.Parent.DataService)

local ShopService = {}

local stock = {}
local nextRestock = 0
local PlotService

local function broadcastStock(player)
	local payload = { stock = stock, nextRestock = nextRestock, serverTime = workspace:GetServerTimeNow() }
	if player then
		Remotes.ShopState:FireClient(player, payload)
	else
		Remotes.ShopState:FireAllClients(payload)
	end
end

local function restock()
	for _, plant in ipairs(Config.Plants) do
		local chance, minQ, maxQ = plant.stock[1], plant.stock[2], plant.stock[3]
		if math.random() &lt; chance then
			stock[plant.id] = math.random(minQ, maxQ)
		else
			stock[plant.id] = 0
		end
	end
	-- La carotte est toujours disponible
	if stock.Carotte &lt; 5 then
		stock.Carotte = 5
	end
	nextRestock = workspace:GetServerTimeNow() + Config.Shop.RestockInterval
	broadcastStock()
	Remotes.Notify:FireAllClients(&quot;La boutique a ete reapprovisionnee !&quot;, &quot;shop&quot;)
end

local function buy(player, plantId, amount)
	local data = DataService.Get(player)
	local plant = Config.PlantById[plantId]
	if not data or not plant then
		return
	end
	amount = math.clamp(math.floor(tonumber(amount) or 1), 1, 99)
	local available = stock[plantId] or 0
	if available &lt;= 0 then
		Remotes.Notify:FireClient(player, &quot;Rupture de stock !&quot;, &quot;danger&quot;)
		return
	end
	amount = math.min(amount, available)
	local affordable = math.floor(data.Coins / plant.price)
	if affordable &lt;= 0 then
		Remotes.Notify:FireClient(player, &quot;Pas assez de pieces (&quot; .. Economy.formatCoins(plant.price) .. &quot; necessaires)&quot;, &quot;danger&quot;)
		return
	end
	amount = math.min(amount, affordable)
	data.Coins -= plant.price * amount
	data.Seeds[plantId] = (data.Seeds[plantId] or 0) + amount
	stock[plantId] = available - amount
	DataService.Sync(player)
	PlotService.SyncInventory(player)
	broadcastStock()
	Remotes.Notify:FireClient(player, &quot;+&quot; .. amount .. &quot; graine(s) de &quot; .. plant.id, &quot;good&quot;)
	Remotes.FX:FireClient(player, &quot;Buy&quot;, {})
end

local function sellAll(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	if #data.Fruits == 0 then
		Remotes.Notify:FireClient(player, &quot;Ton sac est vide. Recolte d'abord !&quot;, &quot;danger&quot;)
		return
	end
	local total = 0
	local count = #data.Fruits
	for _, fruit in ipairs(data.Fruits) do
		total += Economy.value(fruit)
	end
	data.Fruits = {}
	data.Coins += total
	data.Earned += total
	DataService.Sync(player)
	PlotService.SyncInventory(player)
	Remotes.Notify:FireClient(player, count .. &quot; fruit(s) vendu(s) pour &quot; .. Economy.formatCoins(total) .. &quot; pieces !&quot;, &quot;gold&quot;)
	Remotes.FX:FireClient(player, &quot;Sell&quot;, { total = total })
end

local function expand(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local level = data.ExpandLevel or 0
	local price = Config.Plot.ExpandPrices[level + 1]
	if not price then
		Remotes.Notify:FireClient(player, &quot;Ta parcelle est deja au maximum !&quot;, &quot;info&quot;)
		return
	end
	if data.Coins &lt; price then
		Remotes.Notify:FireClient(player, &quot;Il te faut &quot; .. Economy.formatCoins(price) .. &quot; pieces pour agrandir.&quot;, &quot;danger&quot;)
		return
	end
	data.Coins -= price
	data.ExpandLevel = level + 1
	DataService.Sync(player)
	PlotService.ApplyExpandLevel(player)
	PlotService.SyncInventory(player)
	Remotes.Notify:FireClient(player, &quot;Parcelle agrandie !&quot;, &quot;gold&quot;)
	Remotes.FX:FireClient(player, &quot;Expand&quot;, {})
end

function ShopService.Init(plotService)
	PlotService = plotService
	restock()
	task.spawn(function()
		while true do
			task.wait(Config.Shop.RestockInterval)
			restock()
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		task.wait(1)
		broadcastStock(player)
	end)

	Remotes.Shop.OnServerEvent:Connect(function(player, action, a, b)
		if action == &quot;buy&quot; then
			buy(player, tostring(a), b)
		elseif action == &quot;sell&quot; then
			sellAll(player)
		elseif action == &quot;expand&quot; then
			expand(player)
		elseif action == &quot;state&quot; then
			broadcastStock(player)
		end
	end)

	for _, stand in ipairs(CollectionService:GetTagged(&quot;SellStand&quot;)) do
		local prompt = stand:FindFirstChildOfClass(&quot;ProximityPrompt&quot;)
		if prompt then
			prompt.Triggered:Connect(sellAll)
		end
	end
end

return ShopService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">WeatherService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Meteo dynamique : pluie, orage (eclairs), vague de froid. Mutations sur les plantes.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Players = game:GetService(&quot;Players&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local WeatherService = {}

local current = nil -- event table ou nil
local endsAt = 0
local PlotService -- injecte

local function broadcast(player)
	local payload = {
		id = current and current.id or &quot;Clair&quot;,
		label = current and current.label or &quot;&quot;,
		endsAt = current and endsAt or 0,
		serverTime = workspace:GetServerTimeNow(),
	}
	if player then
		Remotes.Weather:FireClient(player, payload)
	else
		Remotes.Weather:FireAllClients(payload)
	end
end

local function pickEvent()
	local total = 0
	for _, e in ipairs(Config.Weather.Events) do
		total += e.weight
	end
	local r = math.random() * total
	for _, e in ipairs(Config.Weather.Events) do
		r -= e.weight
		if r &lt;= 0 then
			return e
		end
	end
	return Config.Weather.Events[1]
end

local function runEvent(event)
	current = event
	endsAt = workspace:GetServerTimeNow() + event.duration
	broadcast()
	Remotes.Notify:FireAllClients(event.label .. &quot; ! Croissance x&quot; .. event.growth, &quot;weather&quot;)

	local lastTick = os.clock()
	local lastLightning = os.clock()
	local startTime = os.clock()
	while os.clock() - startTime &lt; event.duration do
		task.wait(0.5)
		if event.mutation and os.clock() - lastTick &gt;= event.tick then
			lastTick = os.clock()
			PlotService.ApplyWeatherMutation(event.mutation, event.mutationChance)
		end
		if event.lightning and os.clock() - lastLightning &gt;= event.lightning then
			lastLightning = os.clock()
			local tile = PlotService.RandomPlantedTile()
			if tile then
				PlotService.AddMutation(tile, &quot;Choc&quot;)
				Remotes.FX:FireAllClients(&quot;Lightning&quot;, { position = tile.Position })
			else
				local angle = math.random() * math.pi * 2
				Remotes.FX:FireAllClients(&quot;Lightning&quot;, { position = Vector3.new(math.cos(angle) * 120, 0, math.sin(angle) * 120) })
			end
		end
	end

	current = nil
	endsAt = 0
	broadcast()
	Remotes.Notify:FireAllClients(&quot;Le ciel se degage.&quot;, &quot;info&quot;)
end

function WeatherService.GetGrowthMultiplier()
	return current and current.growth or 1
end

function WeatherService.GetCurrent()
	return current
end

function WeatherService.Init(plotService)
	PlotService = plotService
	Players.PlayerAdded:Connect(function(player)
		task.wait(1)
		broadcast(player)
	end)
	task.spawn(function()
		task.wait(45) -- premiere meteo rapide pour montrer le systeme
		while true do
			runEvent(pickEvent())
			task.wait(math.random(Config.Weather.MinInterval, Config.Weather.MaxInterval))
		end
	end)
end

return WeatherService
</ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000017"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000016"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000015"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX0000000F"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Point d'entree client d'ONYX FARM.

