</ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000014"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Effects</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Effets : plantation, arrosage, recolte, maturation, eclairs, meteo, sons.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local Lighting = game:GetService(&quot;Lighting&quot;)
local Debris = game:GetService(&quot;Debris&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Economy = require(ReplicatedStorage.Shared.Economy)
local State = require(script.Parent.State)

local Effects = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local function playSound(id, volume, pitch, position)
	local s = Instance.new(&quot;Sound&quot;)
	s.SoundId = id
	s.Volume = volume or 0.5
	s.PlaybackSpeed = pitch or 1
	if position then
		local holder = Instance.new(&quot;Part&quot;)
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.Transparency = 1
		holder.Size = Vector3.new(1, 1, 1)
		holder.Position = position
		holder.Parent = workspace
		s.RollOffMaxDistance = 120
		s.Parent = holder
		Debris:AddItem(holder, 4)
	else
		s.Parent = workspace
		Debris:AddItem(s, 4)
	end
	s:Play()
end

local function burst(position, color, count, speed, size, gravity)
	local holder = Instance.new(&quot;Part&quot;)
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.new(1, 1, 1)
	holder.Position = position
	holder.Parent = workspace
	local att = Instance.new(&quot;Attachment&quot;)
	att.Parent = holder
	local e = Instance.new(&quot;ParticleEmitter&quot;)
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.5, 1)
	e.Speed = NumberRange.new(speed * 0.6, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new(0, 1)
	e.LightEmission = 0.6
	e.Acceleration = Vector3.new(0, gravity or -20, 0)
	e.Drag = 2
	e.Color = ColorSequence.new(color)
	e.Parent = att
	e:Emit(count)
	Debris:AddItem(holder, 2)
end

local function floatingText(position, text, color, size)
	local holder = Instance.new(&quot;Part&quot;)
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.new(1, 1, 1)
	holder.Position = position + Vector3.new(0, 3, 0)
	holder.Parent = workspace
	local gui = Instance.new(&quot;BillboardGui&quot;)
	gui.Size = UDim2.fromOffset(size or 200, 40)
	gui.AlwaysOnTop = true
	gui.Parent = holder
	local l = Instance.new(&quot;TextLabel&quot;)
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Text = text
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.2
	l.Parent = gui
	TweenService:Create(holder, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = holder.Position + Vector3.new(0, 5, 0) }):Play()
	task.delay(0.9, function()
		TweenService:Create(l, TweenInfo.new(0.5), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
	Debris:AddItem(holder, 1.6)
end

local function flashScreen(color, transparency, duration)
	local gui = player.PlayerGui:FindFirstChild(&quot;OnyxFlash&quot;)
	if not gui then
		gui = Instance.new(&quot;ScreenGui&quot;)
		gui.Name = &quot;OnyxFlash&quot;
		gui.IgnoreGuiInset = true
		gui.ResetOnSpawn = false
		gui.DisplayOrder = 50
		gui.Parent = player.PlayerGui
		local frame = Instance.new(&quot;Frame&quot;)
		frame.Name = &quot;Flash&quot;
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundTransparency = 1
		frame.BorderSizePixel = 0
		frame.Parent = gui
	end
	local frame = gui.Flash
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency
	TweenService:Create(frame, TweenInfo.new(duration), { BackgroundTransparency = 1 }):Play()
end

local shakeAmount = 0
RunService.RenderStepped:Connect(function(dt)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass(&quot;Humanoid&quot;)
	if not hum then
		return
	end
	if shakeAmount &gt; 0.01 then
		hum.CameraOffset = Vector3.new((math.random() - 0.5) * shakeAmount, (math.random() - 0.5) * shakeAmount, 0)
		shakeAmount = shakeAmount * math.max(0, 1 - dt * 6)
	elseif hum.CameraOffset ~= Vector3.zero then
		hum.CameraOffset = Vector3.zero
	end
end)

-- Meteo ---------------------------------------------------------------------

local rainPart = Instance.new(&quot;Part&quot;)
rainPart.Name = &quot;RainEmitter&quot;
rainPart.Anchored = true
rainPart.CanCollide = false
rainPart.CanQuery = false
rainPart.Transparency = 1
rainPart.Size = Vector3.new(120, 1, 120)
rainPart.Parent = workspace
local rainAtt = Instance.new(&quot;Attachment&quot;)
rainAtt.Parent = rainPart
local rain = Instance.new(&quot;ParticleEmitter&quot;)
rain.Enabled = false
rain.Rate = 500
rain.Lifetime = NumberRange.new(1.2, 1.5)
rain.Speed = NumberRange.new(60, 70)
rain.EmissionDirection = Enum.NormalId.Bottom
rain.Size = NumberSequence.new(0.15)
rain.Transparency = NumberSequence.new(0.4)
rain.Color = ColorSequence.new(Color3.fromRGB(180, 210, 255))
rain.Shape = Enum.ParticleEmitterShape.Box
rain.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
rain.Parent = rainPart
local snow = rain:Clone()
snow.Rate = 150
snow.Speed = NumberRange.new(8, 12)
snow.Lifetime = NumberRange.new(5, 7)
snow.Size = NumberSequence.new(0.35)
snow.Color = ColorSequence.new(Color3.new(1, 1, 1))
snow.Parent = rainPart

RunService.Heartbeat:Connect(function()
	rainPart.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 45, 0))
end)

local function applyWeather(weather)
	local cc = Lighting:FindFirstChild(&quot;FarmColor&quot;)
	local atmosphere = Lighting:FindFirstChildOfClass(&quot;Atmosphere&quot;)
	rain.Enabled = weather.id == &quot;Pluie&quot; or weather.id == &quot;Orage&quot;
	snow.Enabled = weather.id == &quot;Gel&quot;
	local goals = {
		Clair = { tint = Color3.new(1, 1, 1), sat = 0.25, bright = 2.5, density = 0.25 },
		Pluie = { tint = Color3.fromRGB(190, 205, 230), sat = -0.1, bright = 1.4, density = 0.45 },
		Orage = { tint = Color3.fromRGB(150, 160, 190), sat = -0.3, bright = 0.9, density = 0.55 },
		Gel = { tint = Color3.fromRGB(200, 230, 255), sat = -0.2, bright = 2, density = 0.4 },
	}
	local g = goals[weather.id] or goals.Clair
	if cc then
		TweenService:Create(cc, TweenInfo.new(2), { TintColor = g.tint, Saturation = g.sat }):Play()
	end
	TweenService:Create(Lighting, TweenInfo.new(2), { Brightness = g.bright }):Play()
	if atmosphere then
		TweenService:Create(atmosphere, TweenInfo.new(2), { Density = g.density }):Play()
	end
end

-- Evenements ------------------------------------------------------------------

local handlers = {}

handlers.Plant = function(data)
	burst(data.position + Vector3.new(0, 0.5, 0), Config.Colors.Soil, 18, 10, 0.5)
	playSound(&quot;rbxasset://sounds/impact_water.mp3&quot;, 0.5, 1.4, data.position)
end

handlers.Water = function(data)
	burst(data.position + Vector3.new(0, 2, 0), Color3.fromRGB(120, 190, 255), 30, 8, 0.4)
	playSound(&quot;rbxasset://sounds/impact_water.mp3&quot;, 0.7, 1, data.position)
	if data.owner == player.UserId then
		floatingText(data.position, &quot;+&quot; .. math.floor(Config.Water.Boost * 100) .. &quot; %&quot;, Color3.fromRGB(120, 190, 255), 120)
	end
end

handlers.Ripe = function(data)
	burst(data.position + Vector3.new(0, 2, 0), Config.Colors.Gold, 20, 6, 0.4, 2)
	if data.owner == player.UserId then
		playSound(&quot;rbxasset://sounds/electronicpingshort.wav&quot;, 0.6, 1.4, data.position)
		if data.mutations and #data.mutations &gt; 0 then
			floatingText(data.position, Economy.mutationLabel(data.mutations) .. &quot; !&quot;, Color3.fromRGB(255, 150, 255), 220)
			playSound(&quot;rbxasset://sounds/victory.wav&quot;, 0.5, 1.6)
		end
	end
end

handlers.Harvest = function(data)
	burst(data.position + Vector3.new(0, 1.5, 0), data.color or Config.Colors.Accent, 28, 14, 0.6)
	playSound(&quot;rbxasset://sounds/snap.wav&quot;, 0.8, 1.2, data.position)
	if data.owner == player.UserId then
		local rare = data.mutations and #data.mutations &gt; 0
		floatingText(data.position, data.name .. &quot;  &quot; .. Economy.formatWeight(data.weight), rare and Color3.fromRGB(255, 150, 255) or Color3.new(1, 1, 1), 260)
		task.delay(0.25, function()
			floatingText(data.position + Vector3.new(0, 1.5, 0), &quot;+&quot; .. Economy.formatCoins(data.value) .. &quot; pieces&quot;, Config.Colors.Gold, 200)
		end)
		if rare then
			shakeAmount = 1
			flashScreen(Color3.fromRGB(255, 150, 255), 0.8, 0.6)
			playSound(&quot;rbxasset://sounds/victory.wav&quot;, 0.6, 1.3)
		end
	end
end

handlers.Lightning = function(data)
	local pos = data.position
	local top = pos + Vector3.new(0, 120, 0)
	local segments = 7
	local last = top
	for i = 1, segments do
		local t = i / segments
		local target = top:Lerp(pos, t) + Vector3.new((math.random() - 0.5) * 8 * (1 - t), 0, (math.random() - 0.5) * 8 * (1 - t))
		if i == segments then
			target = pos
		end
		local len = (target - last).Magnitude
		local bolt = Instance.new(&quot;Part&quot;)
		bolt.Anchored = true
		bolt.CanCollide = false
		bolt.CanQuery = false
		bolt.Material = Enum.Material.Neon
		bolt.Color = Color3.fromRGB(255, 255, 180)
		bolt.Size = Vector3.new(0.5, 0.5, len)
		bolt.CFrame = CFrame.lookAt((last + target) / 2, target)
		bolt.Parent = workspace
		TweenService:Create(bolt, TweenInfo.new(0.35), { Transparency = 1 }):Play()
		Debris:AddItem(bolt, 0.4)
		last = target
	end
	local light = Instance.new(&quot;PointLight&quot;)
	light.Brightness = 10
	light.Range = 60
	light.Color = Color3.fromRGB(255, 255, 200)
	local holder = Instance.new(&quot;Part&quot;)
	holder.Anchored = true
	holder.CanCollide = false
	holder.Transparency = 1
	holder.Position = pos + Vector3.new(0, 5, 0)
	holder.Parent = workspace
	light.Parent = holder
	Debris:AddItem(holder, 0.3)
	burst(pos + Vector3.new(0, 1, 0), Color3.fromRGB(255, 255, 120), 40, 20, 0.5)
	flashScreen(Color3.new(1, 1, 1), 0.6, 0.4)
	local char = player.Character
	local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	local dist = hrp and (hrp.Position - pos).Magnitude or 999
	task.delay(math.clamp(dist / 150, 0.05, 1), function()
		playSound(&quot;rbxasset://sounds/bass.wav&quot;, math.clamp(1.2 - dist / 300, 0.2, 1), 0.5)
	end)
	shakeAmount = math.max(shakeAmount, math.clamp(2 - dist / 60, 0.3, 2))
end

handlers.Sell = function(data)
	playSound(&quot;rbxasset://sounds/electronicpingshort.wav&quot;, 0.8, 0.9)
	flashScreen(Config.Colors.Gold, 0.85, 0.5)
	local char = player.Character
	local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if hrp then
		burst(hrp.Position + Vector3.new(0, 2, 0), Config.Colors.Gold, 40, 16, 0.5, -5)
		floatingText(hrp.Position, &quot;+&quot; .. Economy.formatCoins(data.total or 0) .. &quot; pieces&quot;, Config.Colors.Gold, 240)
	end
end

handlers.Buy = function()
	playSound(&quot;rbxasset://sounds/button.wav&quot;, 0.6, 1.2)
end

handlers.Expand = function()
	playSound(&quot;rbxasset://sounds/victory.wav&quot;, 0.7, 1.2)
	flashScreen(Config.Colors.Accent, 0.8, 0.6)
end

function Effects.Init()
	Remotes.FX.OnClientEvent:Connect(function(kind, data)
		local handler = handlers[kind]
		if handler then
			handler(data or {})
		end
	end)
	State.Changed.Event:Connect(function(what, data)
		if what == &quot;weather&quot; then
			applyWeather(data)
		elseif what == &quot;tileAction&quot; then
			playSound(&quot;rbxasset://sounds/clickfast.wav&quot;, 0.3, 1.5)
		end
	end)
end

return Effects
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">HUD</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Interface : pieces, meteo, barre de graines, sac, boutique, agrandissement, notifications.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)
local CollectionService = game:GetService(&quot;CollectionService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Economy = require(ReplicatedStorage.Shared.Economy)
local State = require(script.Parent.State)

local HUD = {}

local player = Players.LocalPlayer
local playerGui = player:WaitForChild(&quot;PlayerGui&quot;)
local FONT = Enum.Font.FredokaOne
local FONT_BOLD = Enum.Font.GothamBold
local TOUCH = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local ui = {}

local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

local function corner(parent, radius)
	return new(&quot;UICorner&quot;, { CornerRadius = UDim.new(0, radius or 10) }, parent)
end

local function stroke(parent, color, thickness, transparency)
	return new(&quot;UIStroke&quot;, { Color = color, Thickness = thickness or 2, Transparency = transparency or 0 }, parent)
end

local function label(props, parent)
	local base = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		TextStrokeTransparency = 0.7,
		TextStrokeColor3 = Color3.new(0, 0, 0),
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return new(&quot;TextLabel&quot;, base, parent)
end

local function button(props, parent)
	local base = {
		BackgroundColor3 = Config.Colors.Accent,
		Font = FONT,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		AutoButtonColor = true,
		Text = &quot;&quot;,
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	local b = new(&quot;TextButton&quot;, base, parent)
	corner(b, 10)
	return b
end

local function panel(name, size, parent)
	local frame = new(&quot;Frame&quot;, {
		Name = name,
		Size = size,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Config.Colors.Dark,
		BackgroundTransparency = 0.08,
		Visible = false,
	}, parent)
	corner(frame, 18)
	stroke(frame, Config.Colors.Accent, 3, 0.2)
	local close = button({
		Size = UDim2.fromOffset(36, 36),
		Position = UDim2.new(1, -8, 0, 8),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Config.Colors.Danger,
		Text = &quot;X&quot;,
	}, frame)
	close.Activated:Connect(function()
		frame.Visible = false
	end)
	return frame
end

local function scrollList(parent, top)
	local scroll = new(&quot;ScrollingFrame&quot;, {
		Size = UDim2.new(1, -24, 1, -(top + 12)),
		Position = UDim2.new(0, 12, 0, top),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}, parent)
	new(&quot;UIListLayout&quot;, { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
	return scroll
end

-- Construction ---------------------------------------------------------------

local function build()
	local gui = new(&quot;ScreenGui&quot;, { Name = &quot;OnyxHUD&quot;, ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, playerGui)
	ui.gui = gui

	-- Pieces (haut gauche)
	local coins = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(230, 52), Position = UDim2.new(0, 14, 0, 14), BackgroundColor3 = Config.Colors.Dark, BackgroundTransparency = 0.2 }, gui)
	corner(coins, 14)
	stroke(coins, Config.Colors.Gold, 2, 0.2)
	ui.coins = label({ Size = UDim2.new(1, -16, 1, -10), Position = UDim2.new(0, 8, 0, 5), Text = &quot;0 pieces&quot;, TextColor3 = Config.Colors.Gold, TextXAlignment = Enum.TextXAlignment.Left }, coins)
	ui.harvests = label({ Size = UDim2.fromOffset(230, 24), Position = UDim2.new(0, 14, 0, 70), Text = &quot;&quot;, Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(230, 230, 230) }, gui)

	-- Meteo (haut centre)
	local weather = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(320, 50), Position = UDim2.new(0.5, 0, 0, 14), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Config.Colors.Dark, BackgroundTransparency = 0.2 }, gui)
	corner(weather, 14)
	ui.weatherStroke = stroke(weather, Config.Colors.Sky, 2, 0.2)
	ui.weather = label({ Size = UDim2.new(1, -16, 1, -10), Position = UDim2.new(0, 8, 0, 5), Text = &quot;Ciel clair&quot;, TextColor3 = Config.Colors.Sky }, weather)
	ui.restock = label({ Size = UDim2.fromOffset(320, 22), Position = UDim2.new(0.5, 0, 0, 68), AnchorPoint = Vector2.new(0.5, 0), Text = &quot;&quot;, Font = FONT_BOLD, TextColor3 = Color3.fromRGB(230, 230, 230) }, gui)

	-- Boutons droite
	local right = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(150, 200), Position = UDim2.new(1, -14, 0, 14), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1 }, gui)
	new(&quot;UIListLayout&quot;, { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right }, right)
	ui.backpackButton = button({ Size = UDim2.fromOffset(150, 44), Text = TOUCH and &quot;SAC&quot; or &quot;SAC (B)&quot;, BackgroundColor3 = Config.Colors.Accent2, LayoutOrder = 1 }, right)
	ui.shopButton = button({ Size = UDim2.fromOffset(150, 44), Text = &quot;BOUTIQUE&quot;, BackgroundColor3 = Config.Colors.Accent, LayoutOrder = 2 }, right)
	ui.expandButton = button({ Size = UDim2.fromOffset(150, 44), Text = &quot;AGRANDIR&quot;, BackgroundColor3 = Config.Colors.Gold, LayoutOrder = 3 }, right)
	ui.sellButton = button({ Size = UDim2.fromOffset(150, 44), Text = &quot;VENDRE&quot;, BackgroundColor3 = Config.Colors.Gold, LayoutOrder = 4, Visible = false }, right)
	for _, b in ipairs({ ui.backpackButton, ui.shopButton, ui.expandButton, ui.sellButton }) do
		stroke(b, Color3.new(0, 0, 0), 2, 0.6)
	end

	-- Barre de graines (bas)
	local hotbar = new(&quot;Frame&quot;, { Name = &quot;Hotbar&quot;, Size = UDim2.fromOffset(700, 86), Position = UDim2.new(0.5, 0, 1, -16), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1 }, gui)
	new(&quot;UIListLayout&quot;, { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, hotbar)
	ui.hotbar = hotbar
	ui.hotbarHint = label({ Size = UDim2.fromOffset(700, 22), Position = UDim2.new(0.5, 0, 1, -106), AnchorPoint = Vector2.new(0.5, 1), Text = &quot;&quot;, Font = FONT_BOLD, TextColor3 = Color3.fromRGB(235, 235, 235) }, gui)

	-- Notifications
	local toasts = new(&quot;Frame&quot;, { Name = &quot;Toasts&quot;, Size = UDim2.fromOffset(520, 220), Position = UDim2.new(0.5, 0, 0, 100), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1 }, gui)
	new(&quot;UIListLayout&quot;, { HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }, toasts)
	ui.toasts = toasts

	-- Panneau SAC
	ui.backpack = panel(&quot;Backpack&quot;, UDim2.fromOffset(460, 440), gui)
	label({ Size = UDim2.new(1, -60, 0, 36), Position = UDim2.new(0, 16, 0, 10), Text = &quot;MON SAC&quot;, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Config.Colors.Accent2 }, ui.backpack)
	ui.backpackTotal = label({ Size = UDim2.new(1, -32, 0, 24), Position = UDim2.new(0, 16, 0, 48), Text = &quot;&quot;, Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Config.Colors.Gold }, ui.backpack)
	ui.backpackList = scrollList(ui.backpack, 80)
	ui.backpackHint = label({ Size = UDim2.new(1, -32, 0, 22), Position = UDim2.new(0, 16, 1, -30), Text = &quot;Va au stand VENTE pour tout vendre&quot;, Font = FONT_BOLD, TextColor3 = Color3.fromRGB(200, 200, 200) }, ui.backpack)
	ui.backpackList.Size = UDim2.new(1, -24, 1, -120)

	-- Panneau BOUTIQUE
	ui.shop = panel(&quot;Shop&quot;, UDim2.fromOffset(520, 520), gui)
	label({ Size = UDim2.new(1, -60, 0, 36), Position = UDim2.new(0, 16, 0, 10), Text = &quot;BOUTIQUE DE GRAINES&quot;, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Config.Colors.Accent }, ui.shop)
	ui.shopRestock = label({ Size = UDim2.new(1, -32, 0, 24), Position = UDim2.new(0, 16, 0, 48), Text = &quot;&quot;, Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(210, 210, 210) }, ui.shop)
	ui.shopList = scrollList(ui.shop, 80)
end

-- Notifications ---------------------------------------------------------------

local toastCount = 0
function HUD.toast(text, kind)
	toastCount += 1
	local colors = {
		danger = Config.Colors.Danger,
		gold = Config.Colors.Gold,
		good = Config.Colors.Accent,
		weather = Config.Colors.Sky,
		shop = Config.Colors.Accent2,
		mutation = Color3.fromRGB(255, 120, 255),
	}
	local color = colors[kind] or Color3.new(1, 1, 1)
	local frame = new(&quot;Frame&quot;, { Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Config.Colors.Dark, BackgroundTransparency = 0.25, LayoutOrder = toastCount }, ui.toasts)
	corner(frame, 10)
	stroke(frame, color, 2, 0.3)
	local l = label({ Size = UDim2.new(1, -16, 1, -8), Position = UDim2.new(0, 8, 0, 4), Text = text, TextColor3 = color, Font = FONT_BOLD }, frame)
	task.delay(3.5, function()
		TweenService:Create(frame, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.wait(0.45)
		frame:Destroy()
	end)
end

-- Barre de graines ----------------------------------------------------------------

local hotbarSlots = {}

local function rebuildHotbar()
	for _, slot in ipairs(hotbarSlots) do
		slot:Destroy()
	end
	hotbarSlots = {}
	local seeds = {}
	for _, plant in ipairs(Config.Plants) do
		local count = State.inventory.seeds[plant.id]
		if count and count &gt; 0 then
			table.insert(seeds, { plant = plant, count = count })
		end
	end
	if State.selectedSeed and not State.inventory.seeds[State.selectedSeed] then
		State.selectedSeed = nil
	end
	if #seeds == 0 then
		ui.hotbarHint.Text = &quot;Aucune graine : passe a la BOUTIQUE !&quot;
	else
		ui.hotbarHint.Text = State.selectedSeed and (&quot;Graine : &quot; .. State.selectedSeed .. &quot;  |  Clique sur une case de ta parcelle&quot;) or &quot;Choisis une graine (clic ou touches 1-9)&quot;
	end
	for i, entry in ipairs(seeds) do
		if i &gt; 9 then
			break
		end
		local selected = State.selectedSeed == entry.plant.id
		local slot = button({
			Size = UDim2.fromOffset(78, 78),
			BackgroundColor3 = Config.Colors.Dark,
			BackgroundTransparency = selected and 0 or 0.3,
			LayoutOrder = i,
		}, ui.hotbar)
		stroke(slot, selected and Config.Colors.Gold or entry.plant.color, selected and 4 or 2)
		local dot = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(26, 26), Position = UDim2.new(0.5, 0, 0, 10), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = entry.plant.color }, slot)
		corner(dot, 13)
		label({ Size = UDim2.new(1, -4, 0, 18), Position = UDim2.new(0, 2, 0, 40), Text = entry.plant.id, Font = FONT_BOLD }, slot)
		label({ Size = UDim2.new(1, -4, 0, 16), Position = UDim2.new(0, 2, 1, -18), Text = &quot;x&quot; .. entry.count, TextColor3 = Config.Colors.Gold, Font = FONT_BOLD }, slot)
		if not TOUCH then
			label({ Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 4, 0, 2), Text = tostring(i), TextColor3 = Color3.fromRGB(200, 200, 200), Font = FONT_BOLD }, slot)
		end
		slot.Activated:Connect(function()
			State.selectedSeed = (State.selectedSeed == entry.plant.id) and nil or entry.plant.id
			rebuildHotbar()
		end)
		table.insert(hotbarSlots, slot)
	end
	ui.hotbarSeeds = seeds
end

-- Sac ---------------------------------------------------------------------------

local function rebuildBackpack()
	for _, child in ipairs(ui.backpackList:GetChildren()) do
		if child:IsA(&quot;Frame&quot;) then
			child:Destroy()
		end
	end
	local fruits = State.inventory.fruits
	ui.backpackTotal.Text = #fruits .. &quot; fruit(s)  |  Valeur : &quot; .. Economy.formatCoins(State.inventory.fruitValue) .. &quot; pieces&quot;
	-- Tri par valeur decroissante
	local sorted = table.clone(fruits)
	table.sort(sorted, function(a, b)
		return a.value &gt; b.value
	end)
	for i, fruit in ipairs(sorted) do
		if i &gt; 60 then
			break
		end
		local plant = Config.PlantById[fruit.id]
		local row = new(&quot;Frame&quot;, { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Color3.fromRGB(40, 50, 42), LayoutOrder = i }, ui.backpackList)
		corner(row, 8)
		local hasMutation = fruit.mutations and #fruit.mutations &gt; 0
		local dot = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(22, 22), Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = plant and plant.color or Color3.new(1, 1, 1) }, row)
		corner(dot, 11)
		label({ Size = UDim2.new(0.55, 0, 1, -10), Position = UDim2.new(0, 42, 0, 5), Text = Economy.fruitName(fruit), Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = hasMutation and Color3.fromRGB(255, 200, 255) or Color3.new(1, 1, 1) }, row)
		label({ Size = UDim2.new(0.18, 0, 1, -10), Position = UDim2.new(0.6, 0, 0, 5), Text = Economy.formatWeight(fruit.weight), Font = FONT_BOLD, TextColor3 = Color3.fromRGB(200, 200, 200) }, row)
		label({ Size = UDim2.new(0.2, -10, 1, -10), Position = UDim2.new(0.8, 0, 0, 5), Text = Economy.formatCoins(fruit.value), Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Config.Colors.Gold }, row)
	end
	if #sorted &gt; 60 then
		label({ Size = UDim2.new(1, 0, 0, 24), Text = &quot;... et &quot; .. (#sorted - 60) .. &quot; autres&quot;, Font = FONT_BOLD, LayoutOrder = 999 }, ui.backpackList)
	end
end

-- Boutique ---------------------------------------------------------------------------

local function rebuildShop()
	for _, child in ipairs(ui.shopList:GetChildren()) do
		if child:IsA(&quot;Frame&quot;) then
			child:Destroy()
		end
	end
	for i, plant in ipairs(Config.Plants) do
		local stock = State.shop.stock[plant.id] or 0
		local row = new(&quot;Frame&quot;, { Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = stock &gt; 0 and Color3.fromRGB(40, 50, 42) or Color3.fromRGB(45, 40, 40), LayoutOrder = i }, ui.shopList)
		corner(row, 8)
		local dot = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(26, 26), Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = plant.color }, row)
		corner(dot, 13)
		label({ Size = UDim2.new(0.42, 0, 0, 24), Position = UDim2.new(0, 46, 0, 6), Text = plant.id, TextXAlignment = Enum.TextXAlignment.Left }, row)
		local info = string.format(&quot;%s pieces  |  %ds  |  vend %s&quot;, Economy.formatCoins(plant.price), plant.growTime, Economy.formatCoins(plant.value))
		if plant.multi then
			info = info .. &quot;  |  repousse&quot;
		end
		label({ Size = UDim2.new(0.6, 0, 0, 18), Position = UDim2.new(0, 46, 0, 32), Text = info, Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(200, 200, 200) }, row)
		label({ Size = UDim2.new(0.14, 0, 0, 22), Position = UDim2.new(0.62, 0, 0, 6), Text = stock &gt; 0 and (&quot;Stock &quot; .. stock) or &quot;Epuise&quot;, Font = FONT_BOLD, TextColor3 = stock &gt; 0 and Config.Colors.Accent or Config.Colors.Danger }, row)
		if stock &gt; 0 then
			local b1 = button({ Size = UDim2.fromOffset(44, 36), Position = UDim2.new(1, -100, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Text = &quot;x1&quot;, BackgroundColor3 = Config.Colors.Accent }, row)
			local bAll = button({ Size = UDim2.fromOffset(46, 36), Position = UDim2.new(1, -52, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Text = &quot;MAX&quot;, BackgroundColor3 = Config.Colors.Accent2 }, row)
			b1.Activated:Connect(function()
				Remotes.Shop:FireServer(&quot;buy&quot;, plant.id, 1)
			end)
			bAll.Activated:Connect(function()
				Remotes.Shop:FireServer(&quot;buy&quot;, plant.id, 99)
			end)
		end
	end
end

-- Mises a jour ----------------------------------------------------------------------

local function onInventory(inv)
	State.inventory = inv
	ui.coins.Text = Economy.formatCoins(inv.coins) .. &quot; pieces&quot;
	ui.harvests.Text = inv.harvests .. &quot; recoltes  |  Parcelle &quot; .. inv.plotId
	if inv.expandPrice then
		ui.expandButton.Text = &quot;AGRANDIR &quot; .. Economy.formatCoins(inv.expandPrice)
		ui.expandButton.Visible = true
	else
		ui.expandButton.Visible = false
	end
	ui.backpackButton.Text = (TOUCH and &quot;SAC &quot; or &quot;SAC (B) &quot;) .. #inv.fruits
	rebuildHotbar()
	if ui.backpack.Visible then
		rebuildBackpack()
	end
	State.fire(&quot;inventory&quot;, inv)
end

local function onShopState(shop)
	State.shop = shop
	if ui.shop.Visible then
		rebuildShop()
	end
end

local function onWeather(weather)
	State.weather = weather
	if weather.id == &quot;Clair&quot; then
		ui.weather.Text = &quot;Ciel clair&quot;
		ui.weather.TextColor3 = Config.Colors.Sky
		ui.weatherStroke.Color = Config.Colors.Sky
	else
		local color = weather.id == &quot;Gel&quot; and Color3.fromRGB(190, 240, 255) or (weather.id == &quot;Orage&quot; and Color3.fromRGB(255, 240, 120) or Color3.fromRGB(120, 180, 255))
		ui.weather.TextColor3 = color
		ui.weatherStroke.Color = color
	end
	State.fire(&quot;weather&quot;, weather)
end

local function isNear(tag, distance)
	local char = player.Character
	local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if not hrp then
		return false
	end
	for _, stand in ipairs(CollectionService:GetTagged(tag)) do
		if (stand.Position - hrp.Position).Magnitude &lt;= distance then
			return true
		end
	end
	return false
end

local function toggle(name)
	if name == &quot;close&quot; then
		ui.shop.Visible = false
		ui.backpack.Visible = false
	elseif name == &quot;backpack&quot; then
		ui.backpack.Visible = not ui.backpack.Visible
		ui.shop.Visible = false
		if ui.backpack.Visible then
			rebuildBackpack()
		end
	elseif name == &quot;shop&quot; then
		if not ui.shop.Visible and not isNear(&quot;ShopStand&quot;, 40) then
			HUD.toast(&quot;Va au stand GRAINES pour ouvrir la boutique.&quot;, &quot;info&quot;)
			return
		end
		ui.shop.Visible = not ui.shop.Visible
		ui.backpack.Visible = false
		if ui.shop.Visible then
			rebuildShop()
			Remotes.Shop:FireServer(&quot;state&quot;)
		end
	end
end

function HUD.Init()
	build()
	Remotes.Inventory.OnClientEvent:Connect(onInventory)
	Remotes.ShopState.OnClientEvent:Connect(onShopState)
	Remotes.Weather.OnClientEvent:Connect(onWeather)
	Remotes.Notify.OnClientEvent:Connect(HUD.toast)

	ui.backpackButton.Activated:Connect(function()
		toggle(&quot;backpack&quot;)
	end)
	ui.shopButton.Activated:Connect(function()
		toggle(&quot;shop&quot;)
	end)
	ui.expandButton.Activated:Connect(function()
		Remotes.Shop:FireServer(&quot;expand&quot;)
	end)
	ui.sellButton.Activated:Connect(function()
		Remotes.Shop:FireServer(&quot;sell&quot;)
	end)

	State.Changed.Event:Connect(function(what, data)
		if what == &quot;toggle&quot; then
			toggle(data)
		elseif what == &quot;hotbar&quot; then
			local entry = ui.hotbarSeeds and ui.hotbarSeeds[data]
			if entry then
				State.selectedSeed = (State.selectedSeed == entry.plant.id) and nil or entry.plant.id
				rebuildHotbar()
			end
		elseif what == &quot;notify&quot; then
			HUD.toast(data.text, data.kind)
		end
	end)

	-- Timers (meteo, reassort, bouton vendre a proximite)
	RunService.Heartbeat:Connect(function()
		local now = workspace:GetServerTimeNow()
		if State.weather.id ~= &quot;Clair&quot; then
			local left = math.max(0, math.floor(State.weather.endsAt - now))
			ui.weather.Text = State.weather.label .. &quot;  &quot; .. left .. &quot;s&quot;
		end
		local restockLeft = math.max(0, math.floor((State.shop.nextRestock or 0) - now))
		local text = string.format(&quot;Reassort dans %d:%02d&quot;, math.floor(restockLeft / 60), restockLeft % 60)
		ui.restock.Text = text
		ui.shopRestock.Text = text
		ui.sellButton.Visible = #State.inventory.fruits &gt; 0 and isNear(&quot;SellStand&quot;, 40)
	end)
end

return HUD
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">Input</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Clic / tap sur les cases, survol avec info-bulle, raccourcis clavier.

local Players = game:GetService(&quot;Players&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local ProximityPromptService = game:GetService(&quot;ProximityPromptService&quot;)
local CollectionService = game:GetService(&quot;CollectionService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)

local Input = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local hoverBox = Instance.new(&quot;SelectionBox&quot;)
hoverBox.LineThickness = 0.06
hoverBox.Color3 = Config.Colors.Accent
hoverBox.SurfaceTransparency = 0.85
hoverBox.SurfaceColor3 = Config.Colors.Accent
hoverBox.Parent = workspace

local billboard = Instance.new(&quot;BillboardGui&quot;)
billboard.Name = &quot;TileInfo&quot;
billboard.Size = UDim2.fromOffset(200, 64)
billboard.StudsOffset = Vector3.new(0, 4.5, 0)
billboard.AlwaysOnTop = true
billboard.Enabled = false
billboard.Parent = player:WaitForChild(&quot;PlayerGui&quot;)
local infoTitle = Instance.new(&quot;TextLabel&quot;)
infoTitle.Size = UDim2.new(1, 0, 0.5, 0)
infoTitle.BackgroundTransparency = 1
infoTitle.Font = Enum.Font.FredokaOne
infoTitle.TextScaled = true
infoTitle.TextColor3 = Color3.new(1, 1, 1)
infoTitle.TextStrokeTransparency = 0.3
infoTitle.Parent = billboard
local infoSub = Instance.new(&quot;TextLabel&quot;)
infoSub.Size = UDim2.new(1, 0, 0.5, 0)
infoSub.Position = UDim2.new(0, 0, 0.5, 0)
infoSub.BackgroundTransparency = 1
infoSub.Font = Enum.Font.GothamBold
infoSub.TextScaled = true
infoSub.TextColor3 = Config.Colors.Accent
infoSub.TextStrokeTransparency = 0.3
infoSub.Parent = billboard

local function findTile(instance)
	local current = instance
	while current and current ~= workspace do
		if current:GetAttribute(&quot;PlotId&quot;) and current:GetAttribute(&quot;Index&quot;) then
			return current
		end
		current = current.Parent
	end
	return nil
end

local mouse = player:GetMouse()
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude

-- screenPos = nil : utilise la souris ; sinon position d'un tap (coordonnees ecran)
local function tileAt(screenPos)
	if not screenPos then
		return findTile(mouse.Target)
	end
	local char = player.Character
	params.FilterDescendantsInstances = char and { char } or {}
	local ray = camera:ScreenPointToRay(screenPos.X, screenPos.Y)
	local result = workspace:Raycast(ray.Origin, ray.Direction * 300, params)
	if not result then
		return nil
	end
	return findTile(result.Instance)
end

local function describeTile(tile)
	local plantId = tile:GetAttribute(&quot;Plant&quot;) or &quot;&quot;
	local locked = tile:GetAttribute(&quot;Locked&quot;)
	if locked then
		return &quot;Case verrouillee&quot;, State.inventory.expandPrice and (&quot;Agrandir : &quot; .. State.inventory.expandPrice .. &quot; pieces&quot;) or &quot;&quot;
	end
	if plantId == &quot;&quot; then
		if State.selectedSeed then
			return &quot;Planter : &quot; .. State.selectedSeed, &quot;Clique pour planter&quot;
		end
		return &quot;Case vide&quot;, &quot;Choisis une graine (1-9)&quot;
	end
	local progress = tile:GetAttribute(&quot;Progress&quot;) or 0
	local ripe = tile:GetAttribute(&quot;Ripe&quot;)
	local mutations = tile:GetAttribute(&quot;Mutations&quot;) or &quot;&quot;
	local title = plantId
	if mutations ~= &quot;&quot; then
		title = mutations:gsub(&quot;,&quot;, &quot; &quot;) .. &quot; &quot; .. plantId
	end
	if ripe then
		return title, &quot;MUR ! Clique pour recolter&quot;
	end
	local waterLeft = math.max(0, State.waterReadyAt - os.clock())
	local sub = math.floor(progress * 100) .. &quot; %  |  &quot; .. (waterLeft &gt; 0 and string.format(&quot;arrosoir %.0fs&quot;, waterLeft) or &quot;clique pour arroser&quot;)
	return title, sub
end

local function updateHover()
	local tile = tileAt(nil)
	if tile and tile:GetAttribute(&quot;PlotId&quot;) == State.inventory.plotId then
		hoverBox.Adornee = tile
		billboard.Adornee = tile
		billboard.Enabled = true
		local title, sub = describeTile(tile)
		infoTitle.Text = title
		infoSub.Text = sub
		local ripe = tile:GetAttribute(&quot;Ripe&quot;)
		local locked = tile:GetAttribute(&quot;Locked&quot;)
		local color = locked and Color3.fromRGB(160, 160, 160) or (ripe and Config.Colors.Gold or Config.Colors.Accent)
		hoverBox.Color3 = color
		hoverBox.SurfaceColor3 = color
		infoSub.TextColor3 = color
	else
		hoverBox.Adornee = nil
		billboard.Enabled = false
	end
end

local function act(screenPos)
	local tile = tileAt(screenPos)
	if not tile then
		return
	end
	if tile:GetAttribute(&quot;PlotId&quot;) ~= State.inventory.plotId then
		State.fire(&quot;notify&quot;, { text = &quot;Ce n'est pas ta parcelle !&quot;, kind = &quot;danger&quot; })
		return
	end
	local plantId = tile:GetAttribute(&quot;Plant&quot;) or &quot;&quot;
	if plantId == &quot;&quot; and not State.selectedSeed and not tile:GetAttribute(&quot;Locked&quot;) then
		State.fire(&quot;notify&quot;, { text = &quot;Selectionne une graine dans ta barre (touches 1-9).&quot;, kind = &quot;info&quot; })
		return
	end
	if plantId ~= &quot;&quot; and not tile:GetAttribute(&quot;Ripe&quot;) and not tile:GetAttribute(&quot;Locked&quot;) then
		if State.waterReadyAt &gt; os.clock() then
			return
		end
		State.waterReadyAt = os.clock() + Config.Water.Cooldown
	end
	Remotes.Action:FireServer(tile:GetAttribute(&quot;PlotId&quot;), tile:GetAttribute(&quot;Index&quot;), State.selectedSeed)
	State.fire(&quot;tileAction&quot;, tile)
end

local touchStart = nil -- { pos = Vector2, time = number }

function Input.Init()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			act(nil)
		elseif input.UserInputType == Enum.UserInputType.Touch then
			touchStart = { pos = Vector2.new(input.Position.X, input.Position.Y), time = os.clock() }
		elseif input.UserInputType == Enum.UserInputType.Keyboard then
			local code = input.KeyCode
			if code.Value &gt;= Enum.KeyCode.One.Value and code.Value &lt;= Enum.KeyCode.Nine.Value then
				State.fire(&quot;hotbar&quot;, code.Value - Enum.KeyCode.One.Value + 1)
			elseif code == Enum.KeyCode.B then
				State.fire(&quot;toggle&quot;, &quot;backpack&quot;)
			elseif code == Enum.KeyCode.Escape then
				State.fire(&quot;toggle&quot;, &quot;close&quot;)
			end
		end
	end)

	-- Tap court sur mobile (pas un glissement de camera)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch or not touchStart then
			return
		end
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		local moved = (pos - touchStart.pos).Magnitude
		local held = os.clock() - touchStart.time
		touchStart = nil
		if moved &lt; 12 and held &lt; 0.35 then
			act(pos)
		end
	end)

	if UserInputService.MouseEnabled then
		RunService.RenderStepped:Connect(updateHover)
	end

	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local stand = prompt.Parent
		if stand and CollectionService:HasTag(stand, &quot;ShopStand&quot;) then
			State.fire(&quot;toggle&quot;, &quot;shop&quot;)
		end
	end)
end

return Input
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">State</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Etat partage entre les modules client.

local State = {}

State.inventory = { coins = 0, seeds = {}, fruits = {}, fruitValue = 0, plotId = 0, expandLevel = 0, expandPrice = nil, harvests = 0 }
State.shop = { stock = {}, nextRestock = 0 }
State.weather = { id = &quot;Clair&quot;, label = &quot;&quot;, endsAt = 0 }
State.selectedSeed = nil
State.waterReadyAt = 0

State.Changed = Instance.new(&quot;BindableEvent&quot;) -- (what, data)

function State.fire(what, data)
	State.Changed:Fire(what, data)
end

return State
</ProtectedString></Properties></Item></Item></Item></Item></Item>
</roblox>
