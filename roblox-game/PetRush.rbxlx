</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Remotes</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Cree (serveur) ou recupere (client) les RemoteEvents du jeu.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)

local NAMES = { &quot;Pets&quot;, &quot;PetsSync&quot;, &quot;Race&quot;, &quot;RaceSync&quot;, &quot;Notify&quot;, &quot;FX&quot; }

local Remotes = {}

local folder: Folder
if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild(&quot;Remotes&quot;)
	if existing and existing:IsA(&quot;Folder&quot;) then
		folder = existing
	else
		folder = Instance.new(&quot;Folder&quot;)
		folder.Name = &quot;Remotes&quot;
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(NAMES) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new(&quot;RemoteEvent&quot;)
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild(&quot;Remotes&quot;) :: Folder
end

for _, name in ipairs(NAMES) do
	Remotes[name] = folder:WaitForChild(name) :: RemoteEvent
end

return Remotes
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000012"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000011"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX0000000A"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Point d'entree serveur de PET RUSH.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

require(ReplicatedStorage.Shared.Remotes) -- cree les RemoteEvents avant tout

local Modules = script.Parent.Modules

local function start(name, method)
	local ok, err = pcall(function()
		require(Modules[name])[method or &quot;Init&quot;]()
	end)
	if not ok then
		warn(&quot;[PetRush] Erreur au demarrage de &quot; .. name .. &quot; : &quot; .. tostring(err))
	end
end

start(&quot;MapBuilder&quot;, &quot;Build&quot;)
start(&quot;DataService&quot;)
start(&quot;PetService&quot;)
start(&quot;CoinService&quot;)
start(&quot;RaceService&quot;)

print(&quot;[PetRush] Serveur pret.&quot;)
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000010"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">CoinService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Coins dans les zones, collecte automatique par les pets, coffres rares.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)
local PetService = require(script.Parent.PetService)

local CoinService = {}

local coinsFolder
local coins = {} -- [part] = { zone = zone, value = n, chest = bool }

local function spawnCoin(zone, position)
	local coin = Instance.new(&quot;Part&quot;)
	coin.Name = &quot;Coin&quot;
	coin.Shape = Enum.PartType.Cylinder
	coin.Size = Vector3.new(0.4, 2.2, 2.2)
	coin.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	coin.Material = Enum.Material.Neon
	coin.Color = Config.Colors.Gold
	coin.Anchored = true
	coin.CanCollide = false
	coin.CanQuery = false
	coin:SetAttribute(&quot;Value&quot;, zone.coinValue)
	coin.Parent = coinsFolder
	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = Config.Colors.Gold
	light.Range = 8
	light.Brightness = 1
	light.Parent = coin
	coins[coin] = { zone = zone, value = zone.coinValue }
	return coin
end

local function spawnChest(zone)
	local half = zone.size / 2
	local a = math.random() * math.pi * 2
	local r = 20 + math.random() * (half - 40)
	local pos = zone.center + Vector3.new(math.cos(a) * r, 2.5, math.sin(a) * r)
	local chest = Instance.new(&quot;Part&quot;)
	chest.Name = &quot;Chest&quot;
	chest.Size = Vector3.new(4, 3, 3)
	chest.CFrame = CFrame.new(pos)
	chest.Material = Enum.Material.Neon
	chest.Color = Config.Colors.Accent2
	chest.Anchored = true
	chest.CanCollide = false
	chest.CanQuery = false
	chest:SetAttribute(&quot;Value&quot;, zone.chestValue)
	chest:SetAttribute(&quot;Chest&quot;, true)
	chest.Parent = coinsFolder
	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = Config.Colors.Accent2
	light.Range = 30
	light.Brightness = 3
	light.Parent = chest
	local beam = Instance.new(&quot;Part&quot;)
	beam.Name = &quot;ChestBeam&quot;
	beam.Size = Vector3.new(1.5, 200, 1.5)
	beam.CFrame = CFrame.new(pos + Vector3.new(0, 100, 0))
	beam.Material = Enum.Material.Neon
	beam.Color = Config.Colors.Accent2
	beam.Transparency = 0.6
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.Parent = chest
	coins[chest] = { zone = zone, value = zone.chestValue, chest = true }
	Remotes.Notify:FireAllClients(&quot;🎁 Un coffre rare est apparu dans &quot; .. zone.icon .. &quot; &quot; .. zone.name .. &quot; ! (&quot; .. zone.chestValue .. &quot; coins)&quot;, &quot;gold&quot;)
	Remotes.FX:FireAllClients(&quot;ChestSpawn&quot;, { position = pos, zoneId = zone.id })
	task.delay(Config.Collect.ChestLifetime, function()
		if coins[chest] then
			coins[chest] = nil
			chest:Destroy()
		end
	end)
end

local function collect(player, coin, info)
	coins[coin] = nil
	local data = DataService.Get(player)
	if not data then
		coin:Destroy()
		return
	end
	local power = PetService.GetPower(player)
	local amount = math.floor(info.value * (1 + power * 0.08) + 0.5)
	PetService.AddCoins(player, amount)
	Remotes.FX:FireAllClients(&quot;Collect&quot;, { position = coin.Position, userId = player.UserId, amount = amount, chest = info.chest or false })
	if info.chest then
		Remotes.Notify:FireAllClients(&quot;🎁 &quot; .. player.DisplayName .. &quot; a ouvert le coffre et gagne &quot; .. amount .. &quot; coins !&quot;, &quot;gold&quot;)
	end
	coin:Destroy()
	PetService.Sync(player)
	if not info.chest then
		task.delay(Config.Collect.CoinRespawn + math.random() * 4, function()
			local spots = MapBuilder.GetCoinSpots(info.zone.id)
			spawnCoin(info.zone, spots[math.random(#spots)])
		end)
	end
end

local function collectLoop()
	while true do
		task.wait(Config.Collect.Tick)
		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
			local data = DataService.Get(player)
			if hrp and data then
				local equipped = PetService.GetEquippedPets(player)
				local radius = Config.Collect.BaseRadius + #equipped * Config.Collect.RadiusPerPet
				for coin, info in pairs(coins) do
					if coin.Parent then
						local dist = (coin.Position - hrp.Position).Magnitude
						local reach = info.chest and 8 or radius
						if dist &lt;= reach and (info.chest or data.Zones[info.zone.id]) then
							collect(player, coin, info)
						end
					else
						coins[coin] = nil
					end
				end
			end
		end
	end
end

function CoinService.Init()
	coinsFolder = workspace:FindFirstChild(&quot;Coins&quot;) or Instance.new(&quot;Folder&quot;)
	coinsFolder.Name = &quot;Coins&quot;
	coinsFolder.Parent = workspace
	for _, zone in ipairs(Config.Zones) do
		for _, spot in ipairs(MapBuilder.GetCoinSpots(zone.id)) do
			spawnCoin(zone, spot)
		end
	end
	task.spawn(collectLoop)
	task.spawn(function()
		task.wait(60)
		while true do
			local zone = Config.Zones[math.random(#Config.Zones)]
			spawnChest(zone)
			task.wait(math.random(Config.Collect.ChestInterval[1], Config.Collect.ChestInterval[2]))
		end
	end)
end

return CoinService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">DataService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Sauvegarde DataStore + leaderstats + classement global coins.

local DataStoreService = game:GetService(&quot;DataStoreService&quot;)
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local store, topStore
pcall(function()
	store = DataStoreService:GetDataStore(&quot;PetRush_v1&quot;)
	topStore = DataStoreService:GetOrderedDataStore(&quot;PetRush_Coins_v1&quot;)
end)

local cache = {}
local stats = {}

local function defaultData()
	return {
		Coins = Config.StartCoins,
		TotalCoins = 0,
		Pets = {}, -- { uid = n, id = &quot;Chaton&quot;, evo = 1 }
		NextUid = 1,
		Equipped = {}, -- liste d'uids
		Zones = { Village = true },
		Index = {}, -- [petId] = true (decouverts)
		Hatched = 0,
		RaceWins = 0,
		Races = 0,
		LastDaily = 0,
	}
end

local function key(player)
	return &quot;p_&quot; .. player.UserId
end

function DataService.Load(player)
	local data = defaultData()
	if store then
		local ok, result = pcall(function()
			return store:GetAsync(key(player))
		end)
		if ok and type(result) == &quot;table&quot; then
			for k, v in pairs(result) do
				data[k] = v
			end
		elseif not ok then
			warn(&quot;[PetRush] Chargement impossible pour &quot; .. player.Name .. &quot; : &quot; .. tostring(result))
		end
	end
	data.Zones = data.Zones or { Village = true }
	data.Zones.Village = true
	data.Pets = data.Pets or {}
	data.Equipped = data.Equipped or {}
	data.Index = data.Index or {}
	cache[player] = data

	local leaderstats = Instance.new(&quot;Folder&quot;)
	leaderstats.Name = &quot;leaderstats&quot;
	local values = {}
	for _, name in ipairs({ &quot;Coins&quot;, &quot;Pets&quot;, &quot;RaceWins&quot; }) do
		local v = Instance.new(&quot;IntValue&quot;)
		v.Name = name
		v.Parent = leaderstats
		values[name] = v
	end
	leaderstats.Parent = player
	stats[player] = values
	DataService.Sync(player)
	return data
end

function DataService.Get(player)
	return cache[player]
end

function DataService.Sync(player)
	local data = cache[player]
	local values = stats[player]
	if data and values then
		values.Coins.Value = math.floor(data.Coins)
		values.Pets.Value = #data.Pets
		values.RaceWins.Value = data.RaceWins
	end
end

function DataService.Save(player)
	local data = cache[player]
	if not data or not store then
		return
	end
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function()
			return data
		end)
	end)
	if not ok then
		warn(&quot;[PetRush] Sauvegarde impossible pour &quot; .. player.Name .. &quot; : &quot; .. tostring(err))
	end
	if topStore then
		pcall(function()
			topStore:SetAsync(tostring(player.UserId), math.floor(data.TotalCoins))
		end)
	end
end

function DataService.Release(player)
	cache[player] = nil
	stats[player] = nil
end

function DataService.GetTop(count)
	if not topStore then
		return {}
	end
	local ok, pages = pcall(function()
		return topStore:GetSortedAsync(false, count)
	end)
	if not ok then
		return {}
	end
	local result = {}
	for _, entry in ipairs(pages:GetCurrentPage()) do
		table.insert(result, { userId = tonumber(entry.key), value = entry.value })
	end
	return result
end

function DataService.Init()
	game:BindToClose(function()
		for _, p in ipairs(Players:GetPlayers()) do
			DataService.Save(p)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(120)
			for _, p in ipairs(Players:GetPlayers()) do
				DataService.Save(p)
			end
		end
	end)
end

return DataService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">MapBuilder</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Map de PET RUSH : iles flottantes cartoon (plastique lisse), ponts, cascades, nuages, props.
-- 3 zones (Village, Foret, Desert), arches de passage, stands, piste de course, classement.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local CollectionService = game:GetService(&quot;CollectionService&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local Lighting = game:GetService(&quot;Lighting&quot;)
local Players = game:GetService(&quot;Players&quot;)

local Config = require(ReplicatedStorage.Shared.Config)

local MapBuilder = {}

local Terrain = workspace.Terrain
local rng = Random.new(42) -- decor identique a chaque lancement

local function R(a, b)
	return rng:NextNumber(a, b)
end

local KEEP_MATERIAL = { [Enum.Material.Neon] = true, [Enum.Material.Glass] = true, [Enum.Material.ForceField] = true }

local function part(props, parent)
	local p = Instance.new(&quot;Part&quot;)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		p[k] = v
	end
	if not KEEP_MATERIAL[p.Material] then
		p.Material = Enum.Material.SmoothPlastic
	end
	p.Parent = parent
	return p
end

local function wedge(props, parent)
	local w = Instance.new(&quot;WedgePart&quot;)
	w.Anchored = true
	w.TopSurface = Enum.SurfaceType.Smooth
	w.BottomSurface = Enum.SurfaceType.Smooth
	w.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		w[k] = v
	end
	w.Material = Enum.Material.SmoothPlastic
	w.Parent = parent
	return w
end

local function ballPart(cf, size, color, parent, material)
	return part({ Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic, CanCollide = false }, parent)
end

local function cylinder(cf, height, radius, color, parent, material)
	-- cylindre vertical
	return part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, radius * 2, radius * 2), CFrame = cf * CFrame.Angles(0, 0, math.rad(90)), Color = color, Material = material or Enum.Material.SmoothPlastic }, parent)
end

local function sign(parent, cf, size, text, textColor, bg)
	local board = part({ Name = &quot;Sign&quot;, Size = size, CFrame = cf, Color = bg or Color3.fromRGB(150, 100, 60), Material = Enum.Material.WoodPlanks }, parent)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = Instance.new(&quot;SurfaceGui&quot;)
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 30
		gui.LightInfluence = 0
		local l = Instance.new(&quot;TextLabel&quot;)
		l.Size = UDim2.fromScale(0.94, 0.86)
		l.Position = UDim2.fromScale(0.03, 0.07)
		l.BackgroundTransparency = 1
		l.Text = text
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.TextColor3 = textColor or Color3.new(1, 1, 1)
		l.Parent = gui
		local st = Instance.new(&quot;UIStroke&quot;)
		st.Color = Color3.fromRGB(22, 24, 52)
		st.Thickness = 4
		st.Parent = l
		gui.Parent = board
	end
	return board
end

-- Eclairage ------------------------------------------------------------------------------

local function buildLighting()
	Lighting.ClockTime = 14
	Lighting.GeographicLatitude = 30
	Lighting.Brightness = 2.4
	Lighting.Ambient = Color3.fromRGB(140, 140, 160)
	Lighting.OutdoorAmbient = Color3.fromRGB(165, 165, 185)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.ShadowSoftness = 0.5
	Lighting.GlobalShadows = true
	Lighting.FogEnd = 100000
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA(&quot;PostEffect&quot;) or child:IsA(&quot;Atmosphere&quot;) or child:IsA(&quot;Sky&quot;) then
			child:Destroy()
		end
	end
	local atmosphere = Instance.new(&quot;Atmosphere&quot;)
	atmosphere.Density = 0.18
	atmosphere.Offset = 0
	atmosphere.Color = Color3.fromRGB(170, 215, 255)
	atmosphere.Decay = Color3.fromRGB(120, 180, 255)
	atmosphere.Glare = 0
	atmosphere.Haze = 0
	atmosphere.Parent = Lighting
	local sky = Instance.new(&quot;Sky&quot;)
	sky.SunAngularSize = 12
	sky.Parent = Lighting
	local bloom = Instance.new(&quot;BloomEffect&quot;)
	bloom.Intensity = 0.25
	bloom.Size = 18
	bloom.Threshold = 1.8
	bloom.Parent = Lighting
	local cc = Instance.new(&quot;ColorCorrectionEffect&quot;)
	cc.Name = &quot;PetColor&quot;
	cc.Saturation = 0.22
	cc.Contrast = 0.05
	cc.Brightness = 0.03
	cc.Parent = Lighting
	local clouds = Terrain:FindFirstChildOfClass(&quot;Clouds&quot;) or Instance.new(&quot;Clouds&quot;)
	clouds.Cover = 0.45
	clouds.Density = 0.5
	clouds.Color = Color3.new(1, 1, 1)
	clouds.Parent = Terrain
end

-- Iles flottantes ----------------------------------------------------------------------

local avoid = {} -- zones ou les coins ne doivent pas apparaitre { pos, radius }

local function avoidCircle(pos, radius)
	table.insert(avoid, { pos = pos, radius = radius })
end

local PALETTES = {
	Village = { top = Color3.fromRGB(125, 215, 85), drip = Color3.fromRGB(105, 195, 70), dirt = Color3.fromRGB(165, 110, 65), dirt2 = Color3.fromRGB(135, 88, 52), path = Color3.fromRGB(245, 225, 175) },
	Foret = { top = Color3.fromRGB(85, 180, 80), drip = Color3.fromRGB(65, 155, 65), dirt = Color3.fromRGB(130, 92, 62), dirt2 = Color3.fromRGB(105, 74, 50), path = Color3.fromRGB(205, 165, 110) },
	Desert = { top = Color3.fromRGB(252, 222, 150), drip = Color3.fromRGB(240, 200, 120), dirt = Color3.fromRGB(225, 155, 90), dirt2 = Color3.fromRGB(195, 128, 75), path = Color3.fromRGB(235, 185, 115) },
}

local WATER = Color3.fromRGB(80, 190, 255)

local function pond(parent, center, radius, rimColor)
	local rim = cylinder(CFrame.new(center + Vector3.new(0, 0.05, 0)), 0.3, radius + 3, rimColor, parent)
	rim.CanCollide = false
	local water = cylinder(CFrame.new(center + Vector3.new(0, 0.12, 0)), 0.3, radius, WATER, parent, Enum.Material.Glass)
	water.Transparency = 0.1
	water.Reflectance = 0.15
	water.CanCollide = false
	for k = 1, 4 do
		local a = k * 1.7
		local pad = cylinder(CFrame.new(center + Vector3.new(math.cos(a) * radius * 0.55, 0.3, math.sin(a) * radius * 0.55)), 0.2, R(1.4, 2.2), Color3.fromRGB(90, 190, 80), parent)
		pad.CanCollide = false
		if k % 2 == 0 then
			ballPart(pad.CFrame * CFrame.new(0, 0.4, 0), 0.8, Color3.fromRGB(255, 140, 190), parent)
		end
	end
	avoidCircle(center, radius + 6)
end

local function waterfall(parent, edgePoint)
	-- ruisseau qui coule vers le bord puis cascade dans le vide
	local stream = part({ Size = Vector3.new(26, 0.3, 9), CFrame = CFrame.new(edgePoint + Vector3.new(-13, 0.14, 0)), Color = WATER, Material = Enum.Material.Glass, Transparency = 0.1, CanCollide = false }, parent)
	stream.Reflectance = 0.15
	local fall = part({ Size = Vector3.new(1.5, 90, 9), CFrame = CFrame.new(edgePoint + Vector3.new(1, -45, 0)), Color = Color3.fromRGB(150, 215, 255), Material = Enum.Material.Glass, Transparency = 0.15, CanCollide = false }, parent)
	local foam = part({ Size = Vector3.new(2, 2, 9), CFrame = CFrame.new(edgePoint + Vector3.new(1, 0, 0)), Transparency = 1, CanCollide = false }, parent)
	local spray = Instance.new(&quot;ParticleEmitter&quot;)
	spray.Rate = 40
	spray.Lifetime = NumberRange.new(0.6, 1)
	spray.Speed = NumberRange.new(4, 8)
	spray.SpreadAngle = Vector2.new(60, 60)
	spray.Acceleration = Vector3.new(0, -20, 0)
	spray.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1.4) })
	spray.Transparency = NumberSequence.new(0.2, 1)
	spray.Color = ColorSequence.new(Color3.new(1, 1, 1))
	spray.Parent = foam
	avoidCircle(edgePoint + Vector3.new(-13, 0, 0), 10)
end

local function cloudPuff(parent, pos, scale)
	local puffs = {}
	for k = 1, 5 do
		local b = ballPart(CFrame.new(pos + Vector3.new((k - 3) * 6 * scale, R(-1, 3) * scale, R(-3, 3) * scale)), R(8, 13) * scale, Color3.fromRGB(255, 255, 255), parent)
		b.CastShadow = false
		b.CanQuery = false
		table.insert(puffs, b)
	end
	local offset = Vector3.new(R(30, 60), 0, 0)
	for _, b in ipairs(puffs) do
		TweenService:Create(b, TweenInfo.new(R(30, 50), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { CFrame = b.CFrame + offset }):Play()
	end
end

-- Ile : dessus d'herbe, bord festonne, falaises de terre en escalier, rochers suspendus
local function island(parent, zone)
	local pal = PALETTES[zone.id]
	local c = zone.center
	local s = zone.size
	part({ Name = &quot;Ground&quot;, Size = Vector3.new(s, 4, s), CFrame = CFrame.new(c + Vector3.new(0, -2, 0)), Color = pal.top }, parent)
	-- bord d'herbe arrondi qui deborde
	local half = s / 2
	for t = -half, half, 9 do
		for _, edge in ipairs({ Vector3.new(t, -2.6, half), Vector3.new(t, -2.6, -half), Vector3.new(half, -2.6, t), Vector3.new(-half, -2.6, t) }) do
			local drip = ballPart(CFrame.new(c + edge), R(5.5, 7.5), pal.drip, parent)
			drip.CanCollide = false
		end
	end
	-- falaises
	local y = -4
	local layers = { { s - 2, 9, pal.dirt }, { s - 18, 11, pal.dirt2 }, { s - 46, 13, pal.dirt }, { s - 90, 14, pal.dirt2 }, { s - 140, 12, pal.dirt } }
	for _, L in ipairs(layers) do
		part({ Name = &quot;Cliff&quot;, Size = Vector3.new(L[1], L[2], L[1]), CFrame = CFrame.new(c + Vector3.new(0, y - L[2] / 2, 0)), Color = L[3] }, parent)
		-- bandes de couleur sur les falaises
		part({ Name = &quot;CliffBand&quot;, Size = Vector3.new(L[1] + 0.4, 1.2, L[1] + 0.4), CFrame = CFrame.new(c + Vector3.new(0, y - L[2] * 0.35, 0)), Color = L[3]:Lerp(Color3.new(1, 1, 1), 0.15), CanCollide = false }, parent)
		y -= L[2]
	end
	-- rochers suspendus sous l'ile
	for k = 1, 10 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = R(20, s / 2 - 50)
		ballPart(CFrame.new(c + Vector3.new(math.cos(a) * r, y - R(0, 8), math.sin(a) * r)), R(8, 16), pal.dirt2, parent)
	end
	-- petites collines decoratives
	for k = 1, 6 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = R(55, half - 18)
		local pos = c + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		if math.abs(pos.X) &gt; 24 then
			local mound = ballPart(CFrame.new(pos), R(16, 26), pal.top:Lerp(Color3.new(0, 0, 0), 0.05), parent)
			local mesh = Instance.new(&quot;SpecialMesh&quot;)
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Scale = Vector3.new(1, 0.35, 1)
			mesh.Parent = mound
			avoidCircle(pos, mound.Size.X / 2 + 2)
		end
	end
	-- allee centrale
	part({ Name = &quot;Path&quot;, Size = Vector3.new(14, 0.2, s), CFrame = CFrame.new(c + Vector3.new(0, 0.1, 0)), Color = pal.path, CanCollide = false }, parent)
	for z = -half + 6, half - 6, 7 do
		part({ Name = &quot;PathStone&quot;, Size = Vector3.new(R(2.5, 4), 0.25, R(2, 3)), CFrame = CFrame.new(c + Vector3.new(R(-5, 5), 0.18, z)) * CFrame.Angles(0, R(0, 3), 0), Color = pal.path:Lerp(Color3.new(1, 1, 1), 0.35), CanCollide = false }, parent)
	end
end

-- Pont en bois entre deux iles
local function bridge(parent, z0, z1)
	local len = math.abs(z0 - z1)
	local count = math.floor(len / 2.2)
	for k = 0, count do
		local z = z1 + 1.1 + k * (len / (count + 1))
		part({ Name = &quot;Plank&quot;, Size = Vector3.new(15, 0.8, 2), CFrame = CFrame.new(0, -0.4, z) * CFrame.Angles(0, math.rad(R(-1.5, 1.5)), 0), Color = (k % 2 == 0) and Color3.fromRGB(205, 145, 85) or Color3.fromRGB(185, 125, 70) }, parent)
	end
	for _, x in ipairs({ -6, 6 }) do
		part({ Name = &quot;Beam&quot;, Size = Vector3.new(1, 1, len), CFrame = CFrame.new(x, -1.2, (z0 + z1) / 2), Color = Color3.fromRGB(140, 90, 55) }, parent)
	end
	for _, x in ipairs({ -7.8, 7.8 }) do
		for z = z1, z0, 10 do
			part({ Name = &quot;Post&quot;, Size = Vector3.new(0.9, 4.5, 0.9), CFrame = CFrame.new(x, 1.8, z), Color = Color3.fromRGB(150, 100, 60) }, parent)
			ballPart(CFrame.new(x, 4.3, z), 1.2, Color3.fromRGB(255, 205, 70), parent)
		end
		part({ Name = &quot;Rope&quot;, Size = Vector3.new(0.35, 0.35, len), CFrame = CFrame.new(x, 3.6, (z0 + z1) / 2), Color = Color3.fromRGB(240, 220, 180), CanCollide = false }, parent)
	end
end

local function buildWorld(root)
	Terrain:Clear()
	local world = Instance.new(&quot;Folder&quot;)
	world.Name = &quot;World&quot;
	world.Parent = root
	for i, zone in ipairs(Config.Zones) do
		island(world, zone)
		local nextZone = Config.Zones[i + 1]
		if nextZone then
			bridge(world, zone.center.Z - zone.size / 2, nextZone.center.Z + nextZone.size / 2)
		end
		waterfall(world, zone.center + Vector3.new(zone.size / 2, 0, R(-40, 40)))
	end
	pond(world, Config.ZoneById.Village.center + Vector3.new(-62, 0, -55), 18, Color3.fromRGB(250, 230, 170))
	pond(world, Config.ZoneById.Foret.center + Vector3.new(55, 0, 40), 16, Color3.fromRGB(150, 110, 75))
	pond(world, Config.ZoneById.Desert.center + Vector3.new(-50, 0, -40), 16, Color3.fromRGB(120, 210, 90))
	-- mer tres loin en dessous + nuages autour des iles
	part({ Name = &quot;Sea&quot;, Size = Vector3.new(2000, 2, 2000), CFrame = CFrame.new(0, -160, -300), Color = Color3.fromRGB(70, 170, 245), Reflectance = 0.1, CanCollide = false, CanQuery = false }, world)
	for k = 1, 26 do
		local z = R(-800, 200)
		local x = (k % 2 == 0 and 1 or -1) * R(150, 420)
		cloudPuff(world, Vector3.new(x, R(-70, 40), z), R(0.8, 1.6))
	end
	for k = 1, 12 do
		cloudPuff(world, Vector3.new(R(-400, 400), R(70, 120), R(-800, 250)), R(1.2, 2))
	end
end

-- Props ---------------------------------------------------------------------------------

local LEAF_COLORS = { Color3.fromRGB(95, 200, 75), Color3.fromRGB(120, 220, 85), Color3.fromRGB(75, 180, 70) }

local function roundTree(parent, pos, scale)
	scale = scale or 1
	cylinder(CFrame.new(pos + Vector3.new(0, 4 * scale, 0)), 8 * scale, 0.9 * scale, Color3.fromRGB(120, 80, 45), parent, Enum.Material.Wood)
	local base = pos + Vector3.new(0, 9 * scale, 0)
	ballPart(CFrame.new(base), 9 * scale, LEAF_COLORS[rng:NextInteger(1, 3)], parent, Enum.Material.Grass)
	for k = 1, 4 do
		local a = k * 1.7
		ballPart(CFrame.new(base + Vector3.new(math.cos(a) * 3 * scale, R(-1, 2) * scale, math.sin(a) * 3 * scale)), R(5, 7) * scale, LEAF_COLORS[rng:NextInteger(1, 3)], parent, Enum.Material.Grass)
	end
	-- petits fruits
	for k = 1, 3 do
		local a = k * 2.1
		ballPart(CFrame.new(base + Vector3.new(math.cos(a) * 4.2 * scale, R(-1, 1.5) * scale, math.sin(a) * 4.2 * scale)), 0.9 * scale, Color3.fromRGB(255, 80, 80), parent)
	end
end

local function pineTree(parent, pos, scale)
	scale = scale or 1
	cylinder(CFrame.new(pos + Vector3.new(0, 3 * scale, 0)), 6 * scale, 0.8 * scale, Color3.fromRGB(100, 65, 40), parent, Enum.Material.Wood)
	for k = 0, 3 do
		local r = (5.5 - k * 1.2) * scale
		local tier = cylinder(CFrame.new(pos + Vector3.new(0, (5 + k * 3) * scale, 0)), 3.2 * scale, r, Color3.fromRGB(40, 120 + k * 12, 60), parent, Enum.Material.Grass)
		tier.CanCollide = false
	end
	ballPart(CFrame.new(pos + Vector3.new(0, 16.5 * scale, 0)), 1.6 * scale, Color3.fromRGB(60, 160, 80), parent, Enum.Material.Grass)
end

local function palmTree(parent, pos, scale)
	scale = scale or 1
	local lean = R(-0.25, 0.25)
	local cf = CFrame.new(pos) * CFrame.Angles(0, R(0, 6.28), 0)
	for k = 0, 5 do
		cylinder(cf * CFrame.Angles(lean * k * 0.4, 0, 0) * CFrame.new(0, (1.2 + k * 2) * scale, 0), 2.2 * scale, (0.9 - k * 0.06) * scale, k % 2 == 0 and Color3.fromRGB(160, 115, 70) or Color3.fromRGB(140, 95, 55), parent, Enum.Material.Wood)
	end
	local top = (cf * CFrame.Angles(lean * 2.2, 0, 0) * CFrame.new(0, 13 * scale, 0)).Position
	for k = 1, 7 do
		local a = (k / 7) * math.pi * 2
		part({ Size = Vector3.new(1.6 * scale, 0.3 * scale, 7 * scale), CFrame = CFrame.new(top) * CFrame.Angles(0, a, 0) * CFrame.Angles(math.rad(-25), 0, 0) * CFrame.new(0, 0, -3.2 * scale), Color = Color3.fromRGB(70, 175, 70), Material = Enum.Material.Grass, CanCollide = false }, parent)
	end
	for k = 1, 3 do
		ballPart(CFrame.new(top + Vector3.new(math.cos(k * 2) * 0.8, -0.8, math.sin(k * 2) * 0.8)), 1 * scale, Color3.fromRGB(120, 80, 40), parent)
	end
end

local function bush(parent, pos, scale, flowerColor)
	scale = scale or 1
	for k = 1, 3 do
		ballPart(CFrame.new(pos + Vector3.new((k - 2) * 1.6 * scale, 1.2 * scale, R(-0.6, 0.6))), R(2.8, 3.6) * scale, LEAF_COLORS[rng:NextInteger(1, 3)], parent, Enum.Material.Grass)
	end
	if flowerColor then
		for k = 1, 4 do
			ballPart(CFrame.new(pos + Vector3.new(R(-2.5, 2.5) * scale, R(2, 3) * scale, R(-1.2, 1.2) * scale)), 0.7 * scale, flowerColor, parent)
		end
	end
end

local function flowerPatch(parent, pos)
	local colors = { Color3.fromRGB(255, 120, 170), Color3.fromRGB(255, 230, 80), Color3.fromRGB(150, 140, 255), Color3.new(1, 1, 1) }
	for k = 1, 6 do
		local p = pos + Vector3.new(R(-3, 3), 0, R(-3, 3))
		part({ Size = Vector3.new(0.15, 1, 0.15), CFrame = CFrame.new(p + Vector3.new(0, 0.5, 0)), Color = Color3.fromRGB(70, 160, 60), CanCollide = false }, parent)
		ballPart(CFrame.new(p + Vector3.new(0, 1.1, 0)), 0.6, colors[rng:NextInteger(1, #colors)], parent)
	end
end

local function rock(parent, pos, scale, color)
	scale = scale or 1
	part({ Size = Vector3.new(R(3, 5), R(2, 3.5), R(3, 5)) * scale, CFrame = CFrame.new(pos + Vector3.new(0, 0.6 * scale, 0)) * CFrame.Angles(R(-0.3, 0.3), R(0, 6.28), R(-0.3, 0.3)), Color = color or Color3.fromRGB(140, 140, 155), Material = Enum.Material.Slate }, parent)
end

local function mushroom(parent, pos, scale)
	scale = scale or 1
	cylinder(CFrame.new(pos + Vector3.new(0, 1 * scale, 0)), 2 * scale, 0.45 * scale, Color3.fromRGB(245, 235, 220), parent)
	local cap = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(3, 3, 3) * scale, CFrame = CFrame.new(pos + Vector3.new(0, 2.2 * scale, 0)), Color = Color3.fromRGB(235, 60, 70), CanCollide = false }, parent)
	local mesh = Instance.new(&quot;SpecialMesh&quot;)
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 0.6, 1)
	mesh.Parent = cap
	for k = 1, 4 do
		local a = k * 1.6
		ballPart(CFrame.new(pos + Vector3.new(math.cos(a) * 0.8 * scale, 2.75 * scale, math.sin(a) * 0.8 * scale)), 0.5 * scale, Color3.new(1, 1, 1), parent)
	end
end

local function lamp(parent, pos)
	cylinder(CFrame.new(pos + Vector3.new(0, 0.3, 0)), 0.6, 0.8, Color3.fromRGB(50, 50, 60), parent, Enum.Material.Metal)
	cylinder(CFrame.new(pos + Vector3.new(0, 4.5, 0)), 9, 0.25, Color3.fromRGB(50, 50, 60), parent, Enum.Material.Metal)
	local bulb = ballPart(CFrame.new(pos + Vector3.new(0, 9.4, 0)), 1.6, Color3.fromRGB(255, 230, 170), parent, Enum.Material.Neon)
	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = Color3.fromRGB(255, 220, 160)
	light.Range = 18
	light.Brightness = 1.5
	light.Parent = bulb
end

local function fenceLine(parent, from, to)
	local dir = to - from
	local len = dir.Magnitude
	local posts = math.floor(len / 6)
	for k = 0, posts do
		local p = from + dir * (k / posts)
		part({ Size = Vector3.new(0.6, 3.2, 0.6), CFrame = CFrame.new(p + Vector3.new(0, 1.6, 0)), Color = Color3.fromRGB(240, 235, 225), Material = Enum.Material.WoodPlanks }, parent)
	end
	for _, h in ipairs({ 1.2, 2.4 }) do
		part({ Size = Vector3.new(0.3, 0.4, len), CFrame = CFrame.lookAt((from + to) / 2 + Vector3.new(0, h, 0), to + Vector3.new(0, h, 0)), Color = Color3.fromRGB(240, 235, 225), Material = Enum.Material.WoodPlanks }, parent)
	end
end

local HOUSE_WALLS = { Color3.fromRGB(255, 225, 180), Color3.fromRGB(190, 225, 255), Color3.fromRGB(255, 200, 215), Color3.fromRGB(215, 245, 190) }
local HOUSE_ROOFS = { Color3.fromRGB(220, 75, 65), Color3.fromRGB(70, 120, 210), Color3.fromRGB(230, 140, 50), Color3.fromRGB(150, 80, 190) }

local function house(parent, cf, k)
	local w, d, h = 14, 12, 9
	local wall = HOUSE_WALLS[(k % #HOUSE_WALLS) + 1]
	local roof = HOUSE_ROOFS[(k % #HOUSE_ROOFS) + 1]
	part({ Size = Vector3.new(w + 1, 1, d + 1), CFrame = cf * CFrame.new(0, 0.5, 0), Color = Color3.fromRGB(150, 150, 160), Material = Enum.Material.Cobblestone }, parent)
	part({ Size = Vector3.new(w, h, d), CFrame = cf * CFrame.new(0, h / 2 + 1, 0), Color = wall }, parent)
	-- poutres
	for _, x in ipairs({ -w / 2, w / 2 }) do
		for _, z in ipairs({ -d / 2, d / 2 }) do
			part({ Size = Vector3.new(0.8, h, 0.8), CFrame = cf * CFrame.new(x, h / 2 + 1, z), Color = Color3.fromRGB(130, 85, 50), Material = Enum.Material.Wood }, parent)
		end
	end
	-- toit a deux pans
	local rh = 6
	wedge({ Size = Vector3.new(w + 2, rh, d / 2 + 1), CFrame = cf * CFrame.new(0, h + 1 + rh / 2, -(d / 4 + 0.5)), Color = roof }, parent)
	wedge({ Size = Vector3.new(w + 2, rh, d / 2 + 1), CFrame = cf * CFrame.new(0, h + 1 + rh / 2, d / 4 + 0.5) * CFrame.Angles(0, math.pi, 0), Color = roof }, parent)
	-- cheminee
	part({ Size = Vector3.new(1.8, 4, 1.8), CFrame = cf * CFrame.new(w / 3, h + rh, d / 5), Color = Color3.fromRGB(170, 90, 70), Material = Enum.Material.Brick }, parent)
	-- porte (face -Z, vers l'avant de cf)
	part({ Size = Vector3.new(3.2, 5.5, 0.4), CFrame = cf * CFrame.new(0, 3.75, -d / 2 - 0.2), Color = Color3.fromRGB(140, 90, 50), Material = Enum.Material.WoodPlanks }, parent)
	ballPart(cf * CFrame.new(1, 3.6, -d / 2 - 0.5), 0.4, Color3.fromRGB(255, 210, 60), parent, Enum.Material.Metal)
	-- fenetres
	for _, x in ipairs({ -w / 3.2, w / 3.2 }) do
		part({ Size = Vector3.new(2.8, 2.6, 0.3), CFrame = cf * CFrame.new(x, 5.5, -d / 2 - 0.15), Color = Color3.fromRGB(170, 220, 255), Material = Enum.Material.Glass, Transparency = 0.2 }, parent)
		part({ Size = Vector3.new(3.4, 0.4, 0.6), CFrame = cf * CFrame.new(x, 4, -d / 2 - 0.3), Color = Color3.new(1, 1, 1) }, parent)
		bush(parent, (cf * CFrame.new(x, 0, -d / 2 - 1.8)).Position, 0.45, Color3.fromRGB(255, 120, 170))
	end
end

-- Stand avec auvent raye (style boutique)
local function stand(parent, pos, lookAt, title, color, tag, attrs, promptText)
	local cf = CFrame.lookAt(pos, Vector3.new(lookAt.X, pos.Y, lookAt.Z))
	local counter = part({ Name = tag, Size = Vector3.new(12, 3.4, 4), CFrame = cf * CFrame.new(0, 1.7, 0), Color = Color3.fromRGB(170, 115, 65), Material = Enum.Material.WoodPlanks }, parent)
	part({ Size = Vector3.new(12.6, 0.5, 4.6), CFrame = cf * CFrame.new(0, 3.6, 0), Color = Color3.fromRGB(240, 235, 225), Material = Enum.Material.WoodPlanks }, parent)
	for _, x in ipairs({ -6, 6 }) do
		part({ Size = Vector3.new(0.7, 9, 0.7), CFrame = cf * CFrame.new(x, 4.5, 1.5), Color = Color3.fromRGB(240, 235, 225), Material = Enum.Material.Wood }, parent)
	end
	-- auvent raye incline
	for k = 0, 7 do
		local stripe = wedge({ Size = Vector3.new(1.6, 2, 6), CFrame = cf * CFrame.new(-5.6 + k * 1.6, 9.8, -0.5) * CFrame.Angles(0, math.pi, 0), Color = (k % 2 == 0) and color or Color3.new(1, 1, 1) }, parent)
		stripe.CanCollide = false
		local scallop = ballPart(cf * CFrame.new(-5.6 + k * 1.6, 8.8, -3.5), 1.6, (k % 2 == 0) and color or Color3.new(1, 1, 1), parent)
		scallop.CanCollide = false
	end
	sign(parent, cf * CFrame.new(0, 12, 0.5), Vector3.new(11, 2.6, 0.5), title, Color3.new(1, 1, 1), color)
	local prompt = Instance.new(&quot;ProximityPrompt&quot;)
	prompt.ActionText = promptText or &quot;Ouvrir&quot;
	prompt.ObjectText = title
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = counter
	for k, v in pairs(attrs or {}) do
		counter:SetAttribute(k, v)
	end
	CollectionService:AddTag(counter, tag)
	avoidCircle(pos, 12)
	return counter, cf
end

-- Grand oeuf decoratif tournant sur un piedestal
local function eggDisplay(parent, pos, color)
	cylinder(CFrame.new(pos + Vector3.new(0, 1, 0)), 2, 4, Color3.fromRGB(240, 240, 245), parent, Enum.Material.Marble)
	local ring = cylinder(CFrame.new(pos + Vector3.new(0, 2.1, 0)), 0.3, 4.3, color, parent, Enum.Material.Neon)
	ring.CanCollide = false
	local egg = part({ Name = &quot;EggDisplay&quot;, Shape = Enum.PartType.Ball, Size = Vector3.new(5, 5, 5), CFrame = CFrame.new(pos + Vector3.new(0, 6, 0)), Color = color, CanCollide = false }, parent)
	local mesh = Instance.new(&quot;SpecialMesh&quot;)
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 1.3, 1)
	mesh.Parent = egg
	for k = 1, 5 do
		local a = k * 1.25
		local spot = ballPart(egg.CFrame * CFrame.new(math.cos(a) * 2.35, R(-1.5, 2), math.sin(a) * 2.35), 1.2, color:Lerp(Color3.new(1, 1, 1), 0.55), parent)
		local weld = Instance.new(&quot;WeldConstraint&quot;)
		weld.Part0 = egg
		weld.Part1 = spot
		weld.Parent = spot
		spot.Anchored = false
	end
	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = color
	light.Range = 14
	light.Brightness = 1.5
	light.Parent = egg
	local sparkles = Instance.new(&quot;ParticleEmitter&quot;)
	sparkles.Rate = 6
	sparkles.Lifetime = NumberRange.new(1, 1.6)
	sparkles.Speed = NumberRange.new(1, 2)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
	sparkles.LightEmission = 1
	sparkles.Color = ColorSequence.new(Color3.new(1, 1, 1), color)
	sparkles.Parent = egg
	TweenService:Create(egg, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { CFrame = egg.CFrame * CFrame.new(0, 1.2, 0) * CFrame.Angles(0, math.pi, 0) }):Play()
end

-- Arche de pierre + barriere magique (tag Gate)
local function gateArch(parent, pos, nextZone)
	local stone = Color3.fromRGB(175, 170, 180)
	for _, x in ipairs({ -12, 12 }) do
		part({ Size = Vector3.new(5, 20, 5), CFrame = CFrame.new(pos + Vector3.new(x, 10, 0)), Color = stone, Material = Enum.Material.Cobblestone }, parent)
		part({ Size = Vector3.new(6.4, 1.6, 6.4), CFrame = CFrame.new(pos + Vector3.new(x, 0.8, 0)), Color = stone:Lerp(Color3.new(0, 0, 0), 0.15), Material = Enum.Material.Cobblestone }, parent)
		ballPart(CFrame.new(pos + Vector3.new(x, 21.6, 0)), 3.2, Config.Colors.Gold, parent, Enum.Material.Neon)
	end
	part({ Size = Vector3.new(30, 4, 6), CFrame = CFrame.new(pos + Vector3.new(0, 21, 0)), Color = stone, Material = Enum.Material.Cobblestone }, parent)
	sign(parent, CFrame.new(pos + Vector3.new(0, 21, -3.3)), Vector3.new(20, 3, 0.4), string.upper(nextZone.name), Config.Colors.Gold, Color3.fromRGB(60, 50, 80))
	local barrier = part({ Name = &quot;Gate&quot;, Size = Vector3.new(19, 19, 1), CFrame = CFrame.new(pos + Vector3.new(0, 9.5, 0)), Color = Color3.fromRGB(120, 200, 255), Material = Enum.Material.ForceField, Transparency = 0.2 }, parent)
	barrier:SetAttribute(&quot;ZoneId&quot;, nextZone.id)
	CollectionService:AddTag(barrier, &quot;Gate&quot;)
	local prompt = Instance.new(&quot;ProximityPrompt&quot;)
	prompt.ActionText = &quot;Debloquer (&quot; .. nextZone.price .. &quot;)&quot;
	prompt.ObjectText = nextZone.name
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = barrier
end

-- Murs invisibles avec ouverture pour les couloirs
local function walls(parent, zone, index)
	local c = zone.center
	local half = zone.size / 2
	local hasNorth = Config.Zones[index + 1] ~= nil
	local hasSouth = index &gt; 1
	local h = 60
	part({ Size = Vector3.new(2, h, zone.size), CFrame = CFrame.new(c + Vector3.new(half, h / 2, 0)), Transparency = 1 }, parent)
	part({ Size = Vector3.new(2, h, zone.size), CFrame = CFrame.new(c + Vector3.new(-half, h / 2, 0)), Transparency = 1 }, parent)
	for _, side in ipairs({ { -1, hasNorth }, { 1, hasSouth } }) do
		local z = side[1] * half
		if side[2] then
			local seg = (zone.size - 24) / 2
			part({ Size = Vector3.new(seg, h, 2), CFrame = CFrame.new(c + Vector3.new(-(12 + seg / 2), h / 2, z)), Transparency = 1 }, parent)
			part({ Size = Vector3.new(seg, h, 2), CFrame = CFrame.new(c + Vector3.new(12 + seg / 2, h / 2, z)), Transparency = 1 }, parent)
		else
			part({ Size = Vector3.new(zone.size, h, 2), CFrame = CFrame.new(c + Vector3.new(0, h / 2, z)), Transparency = 1 }, parent)
		end
	end
	if hasNorth then
		local nextZone = Config.Zones[index + 1]
		local z0 = c.Z - half
		local z1 = nextZone.center.Z + nextZone.size / 2
		for _, x in ipairs({ -12, 12 }) do
			part({ Size = Vector3.new(2, h, math.abs(z0 - z1)), CFrame = CFrame.new(x, h / 2, (z0 + z1) / 2), Transparency = 1 }, parent)
		end
	end
end

-- Zones -----------------------------------------------------------------------------------

local coinSpots = {}

local function scatter(zone, count, minR, maxR, fn)
	local half = zone.size / 2
	for k = 1, count do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = R(minR or 20, maxR or (half - 12))
		local pos = zone.center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		local blocked = math.abs(pos.X) &lt; 14 -- allee centrale
		for _, av in ipairs(avoid) do
			if (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(av.pos.X, 0, av.pos.Z)).Magnitude &lt; av.radius then
				blocked = true
			end
		end
		if not blocked then
			fn(pos, k)
		end
	end
end

local function buildVillage(folder, zone)
	local c = zone.center
	-- Place centrale avec fontaine
	local plaza = cylinder(CFrame.new(c + Vector3.new(0, 0.15, 20)), 0.3, 22, Color3.fromRGB(245, 225, 175), folder)
	plaza.CanCollide = false
	local plazaRing = cylinder(CFrame.new(c + Vector3.new(0, 0.12, 20)), 0.3, 23.5, Color3.fromRGB(215, 190, 140), folder)
	plazaRing.CanCollide = false
	avoidCircle(c + Vector3.new(0, 0, 20), 14)
	local fc = c + Vector3.new(0, 0, 20)
	cylinder(CFrame.new(fc + Vector3.new(0, 1, 0)), 2, 9, Color3.fromRGB(235, 235, 240), folder, Enum.Material.Marble)
	local water = cylinder(CFrame.new(fc + Vector3.new(0, 1.8, 0)), 0.6, 8, Color3.fromRGB(80, 180, 255), folder, Enum.Material.Glass)
	water.Transparency = 0.25
	water.CanCollide = false
	cylinder(CFrame.new(fc + Vector3.new(0, 4, 0)), 5, 1.2, Color3.fromRGB(235, 235, 240), folder, Enum.Material.Marble)
	cylinder(CFrame.new(fc + Vector3.new(0, 6.6, 0)), 0.8, 3.6, Color3.fromRGB(235, 235, 240), folder, Enum.Material.Marble)
	local jet = part({ Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(fc + Vector3.new(0, 7.2, 0)), Transparency = 1, CanCollide = false }, folder)
	local spray = Instance.new(&quot;ParticleEmitter&quot;)
	spray.Rate = 60
	spray.Lifetime = NumberRange.new(1, 1.3)
	spray.Speed = NumberRange.new(14, 18)
	spray.SpreadAngle = Vector2.new(14, 14)
	spray.Acceleration = Vector3.new(0, -40, 0)
	spray.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0.9) })
	spray.Transparency = NumberSequence.new(0.2, 1)
	spray.Color = ColorSequence.new(Color3.fromRGB(200, 235, 255))
	spray.Parent = jet

	-- Maisons
	local spots = {
		{ Vector3.new(-75, 0, 70), 0.6 }, { Vector3.new(-80, 0, 20), 1.2 }, { Vector3.new(80, 0, 75), -0.6 },
		{ Vector3.new(-30, 0, 92), math.pi }, { Vector3.new(85, 0, -85), -2.3 }, { Vector3.new(-85, 0, -95), 2.3 },
	}
	for k, s in ipairs(spots) do
		local pos = c + s[1]
		house(folder, CFrame.new(pos) * CFrame.Angles(0, s[2], 0) * CFrame.Angles(0, math.pi, 0), k)
		avoidCircle(pos, 14)
	end
	-- Lampadaires le long de l'allee
	for z = -90, 90, 30 do
		lamp(folder, c + Vector3.new(-10, 0, z))
		lamp(folder, c + Vector3.new(10, 0, z))
	end
	-- Barrieres decoratives autour de l'etang
	fenceLine(folder, c + Vector3.new(-90, 0, -30), c + Vector3.new(-40, 0, -30))
	scatter(zone, 30, 20, 100, function(pos)
		roundTree(folder, pos, R(0.8, 1.2))
		avoidCircle(pos, 5)
	end)
	scatter(zone, 26, 15, 100, function(pos)
		if rng:NextNumber() &lt; 0.5 then
			bush(folder, pos, R(0.8, 1.2), rng:NextNumber() &lt; 0.6 and Color3.fromRGB(255, 120, 170) or nil)
		else
			flowerPatch(folder, pos)
		end
	end)
	scatter(zone, 10, 30, 100, function(pos)
		rock(folder, pos, R(0.7, 1.3))
	end)
end

local function buildForest(folder, zone)
	local c = zone.center
	scatter(zone, 70, 15, 104, function(pos)
		if rng:NextNumber() &lt; 0.75 then
			pineTree(folder, pos, R(0.9, 1.6))
		else
			roundTree(folder, pos, R(0.9, 1.3))
		end
		avoidCircle(pos, 4)
	end)
	scatter(zone, 30, 12, 100, function(pos)
		mushroom(folder, pos, R(0.6, 1.4))
	end)
	scatter(zone, 18, 20, 100, function(pos)
		rock(folder, pos, R(0.8, 1.8), Color3.fromRGB(120, 125, 135))
	end)
	scatter(zone, 20, 12, 100, function(pos)
		bush(folder, pos, R(0.8, 1.3), Color3.fromRGB(150, 140, 255))
	end)
	-- Rondins et pont
	for k = 1, 5 do
		local pos = c + Vector3.new(R(-70, 70), 0, R(-70, 70))
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(R(6, 9), 2.2, 2.2), CFrame = CFrame.new(pos + Vector3.new(0, 1.1, 0)) * CFrame.Angles(0, R(0, 6.28), 0), Color = Color3.fromRGB(120, 80, 45), Material = Enum.Material.Wood }, folder)
	end
	-- Lucioles
	local zoneBox = part({ Size = Vector3.new(zone.size, 14, zone.size), CFrame = CFrame.new(c + Vector3.new(0, 8, 0)), Transparency = 1, CanCollide = false, CanQuery = false }, folder)
	local flies = Instance.new(&quot;ParticleEmitter&quot;)
	flies.Rate = 40
	flies.Lifetime = NumberRange.new(4, 7)
	flies.Speed = NumberRange.new(0.5, 1.5)
	flies.SpreadAngle = Vector2.new(180, 180)
	flies.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.4, 0.35), NumberSequenceKeypoint.new(1, 0) })
	flies.LightEmission = 1
	flies.Color = ColorSequence.new(Color3.fromRGB(230, 255, 130))
	flies.Shape = Enum.ParticleEmitterShape.Box
	flies.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	flies.Parent = zoneBox
end

local function buildDesert(folder, zone)
	local c = zone.center
	-- Pyramides a degres
	for k, def in ipairs({ { Vector3.new(70, 0, -60), 28 }, { Vector3.new(-80, 0, 70), 20 }, { Vector3.new(80, 0, 60), 16 } }) do
		local pos = c + def[1]
		local size = def[2]
		local steps = 6
		for s = 0, steps - 1 do
			local w = size * (1 - s / steps)
			part({ Size = Vector3.new(w, size / steps, w), CFrame = CFrame.new(pos + Vector3.new(0, (s + 0.5) * size / steps, 0)), Color = Color3.fromRGB(225, 185, 115):Lerp(Color3.fromRGB(245, 215, 150), s / steps), Material = Enum.Material.Sandstone }, folder)
		end
		ballPart(CFrame.new(pos + Vector3.new(0, size + 1, 0)), 2.4, Config.Colors.Gold, folder, Enum.Material.Neon)
		avoidCircle(pos, size * 0.75 + 4)
	end
	-- Oasis : palmiers autour de l'eau
	local oasis = c + Vector3.new(-50, 0, -40)
	for k = 1, 7 do
		local a = (k / 7) * math.pi * 2
		palmTree(folder, oasis + Vector3.new(math.cos(a) * 24, 0, math.sin(a) * 24), R(0.9, 1.3))
	end
	scatter(zone, 26, 18, 100, function(pos)
		local h = R(5, 9)
		local g = Color3.fromRGB(80, 175, 90)
		cylinder(CFrame.new(pos + Vector3.new(0, h / 2, 0)), h, 1, g, folder)
		ballPart(CFrame.new(pos + Vector3.new(0, h, 0)), 2, g, folder)
		for _, side in ipairs({ -1, 1 }) do
			local ah = R(2, 3.5)
			part({ Size = Vector3.new(2.2, 1.4, 1.4), CFrame = CFrame.new(pos + Vector3.new(side * 1.3, h * 0.45, 0)), Color = g }, folder)
			cylinder(CFrame.new(pos + Vector3.new(side * 2.2, h * 0.45 + ah / 2, 0)), ah, 0.7, g, folder)
			ballPart(CFrame.new(pos + Vector3.new(side * 2.2, h * 0.45 + ah, 0)), 1.4, g, folder)
		end
		ballPart(CFrame.new(pos + Vector3.new(0, h + 1, 0)), 0.9, Color3.fromRGB(255, 120, 170), folder)
		avoidCircle(pos, 4)
	end)
	scatter(zone, 16, 20, 100, function(pos)
		rock(folder, pos, R(0.8, 2), Color3.fromRGB(200, 150, 100))
	end)
	-- Ossements et sable volant
	local box = part({ Size = Vector3.new(zone.size, 6, zone.size), CFrame = CFrame.new(c + Vector3.new(0, 3, 0)), Transparency = 1, CanCollide = false, CanQuery = false }, folder)
	local dust = Instance.new(&quot;ParticleEmitter&quot;)
	dust.Rate = 25
	dust.Lifetime = NumberRange.new(3, 5)
	dust.Speed = NumberRange.new(3, 6)
	dust.EmissionDirection = Enum.NormalId.Right
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.4), NumberSequenceKeypoint.new(1, 0) })
	dust.Transparency = NumberSequence.new(0.4, 1)
	dust.Color = ColorSequence.new(Color3.fromRGB(250, 225, 170))
	dust.Shape = Enum.ParticleEmitterShape.Box
	dust.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	dust.Parent = box
end

local BUILDERS = { Village = buildVillage, Foret = buildForest, Desert = buildDesert }

local function buildZone(root, zone, index)
	local folder = Instance.new(&quot;Folder&quot;)
	folder.Name = &quot;Zone_&quot; .. zone.id
	folder:SetAttribute(&quot;ZoneId&quot;, zone.id)
	folder.Parent = root
	local c = zone.center
	local half = zone.size / 2
	walls(folder, zone, index)

	-- Stand a oeuf (avant le decor pour reserver la place)
	local egg = Config.Eggs[index]
	local eggPos = c + Vector3.new(-45, 0, 30)
	stand(folder, eggPos, c + Vector3.new(0, 0, 30), string.upper(egg.name), egg.color:Lerp(Color3.fromRGB(150, 80, 255), 0.45), &quot;EggStand&quot;, { EggId = egg.id }, &quot;Ouvrir un oeuf&quot;)
	eggDisplay(folder, eggPos + Vector3.new(-8, 0, -8), egg.color)
	eggDisplay(folder, eggPos + Vector3.new(8, 0, -8), egg.color:Lerp(Color3.fromRGB(255, 200, 255), 0.5))

	-- Panneau d'entree de zone
	sign(folder, CFrame.new(c + Vector3.new(20, 6, half - 8)) * CFrame.Angles(0, math.pi, 0), Vector3.new(18, 4, 0.6), string.upper(zone.name), Config.Colors.Gold, Color3.fromRGB(150, 100, 60))
	part({ Size = Vector3.new(0.8, 6, 0.8), CFrame = CFrame.new(c + Vector3.new(14, 3, half - 8)), Color = Color3.fromRGB(130, 85, 50), Material = Enum.Material.Wood }, folder)
	part({ Size = Vector3.new(0.8, 6, 0.8), CFrame = CFrame.new(c + Vector3.new(26, 3, half - 8)), Color = Color3.fromRGB(130, 85, 50), Material = Enum.Material.Wood }, folder)

	if index == 1 then
		MapBuilder._reserveVillage(folder, zone)
	end

	BUILDERS[zone.id](folder, zone)

	local nextZone = Config.Zones[index + 1]
	if nextZone then
		gateArch(folder, c + Vector3.new(0, 0, -half), nextZone)
	end

	-- Points de spawn des coins (sur le sol libre)
	coinSpots[zone.id] = {}
	local tries = 0
	while #coinSpots[zone.id] &lt; zone.coinCount and tries &lt; 2000 do
		tries += 1
		local a = rng:NextNumber(0, math.pi * 2)
		local r = R(10, half - 22)
		local pos = c + Vector3.new(math.cos(a) * r, 2.2, math.sin(a) * r)
		local ok = true
		for _, av in ipairs(avoid) do
			if (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(av.pos.X, 0, av.pos.Z)).Magnitude &lt; av.radius then
				ok = false
				break
			end
		end
		if ok then
			table.insert(coinSpots[zone.id], pos)
		end
	end
end

-- Piste de course, spawn, classement, cadeau (Village) -------------------------------------

local raceWaypoints = {}

local function buildRaceTrack(root, center)
	local rx, rz = 36, 22
	local n = 28
	for i = 0, n - 1 do
		local a = (i / n) * math.pi * 2
		table.insert(raceWaypoints, center + Vector3.new(math.cos(a) * rx, 1.2, math.sin(a) * rz))
	end
	for i = 1, n do
		local p1 = raceWaypoints[i] - Vector3.new(0, 1.2, 0)
		local p2 = raceWaypoints[(i % n) + 1] - Vector3.new(0, 1.2, 0)
		local len = (p2 - p1).Magnitude + 1.2
		local cf = CFrame.lookAt((p1 + p2) / 2 + Vector3.new(0, 0.15, 0), p2 + Vector3.new(0, 0.15, 0))
		part({ Name = &quot;Track&quot;, Size = Vector3.new(11, 0.3, len), CFrame = cf, Color = Color3.fromRGB(215, 110, 70), Material = Enum.Material.Sand, CanCollide = false }, root)
		for _, x in ipairs({ -5.8, 5.8 }) do
			part({ Name = &quot;TrackEdge&quot;, Size = Vector3.new(0.6, 0.6, len), CFrame = cf * CFrame.new(x, 0.15, 0), Color = (i % 2 == 0) and Color3.fromRGB(240, 60, 60) or Color3.new(1, 1, 1), CanCollide = false }, root)
		end
	end
	-- Ligne d'arrivee en damier
	local start = raceWaypoints[1] - Vector3.new(0, 1.2, 0)
	for row = 0, 1 do
		for col = 0, 5 do
			part({ Size = Vector3.new(1.8, 0.35, 1.8), CFrame = CFrame.new(start + Vector3.new(-1.8 + row * 1.8 + 0.9, 0.2, -5 + col * 1.8 + 0.9)), Color = ((row + col) % 2 == 0) and Color3.new(1, 1, 1) or Color3.fromRGB(25, 25, 30), CanCollide = false }, root)
		end
	end
	for _, z in ipairs({ -7, 7 }) do
		part({ Size = Vector3.new(1.2, 10, 1.2), CFrame = CFrame.new(start + Vector3.new(0, 5, z)), Color = Color3.new(1, 1, 1), Material = Enum.Material.Metal }, root)
	end
	sign(root, CFrame.new(start + Vector3.new(0, 10.5, 0)) * CFrame.Angles(0, math.pi / 2, 0), Vector3.new(15, 2.8, 0.5), &quot;ARRIVEE&quot;, Color3.new(1, 1, 1), Color3.fromRGB(230, 60, 60))
	-- Tribunes
	for k = 0, 2 do
		part({ Size = Vector3.new(34, 1.4 + k * 1.4, 3.2), CFrame = CFrame.new(center + Vector3.new(0, 0.7 + k * 0.7, rz + 12 + k * 3.2)), Color = (k % 2 == 0) and Color3.fromRGB(70, 150, 255) or Color3.new(1, 1, 1) }, root)
	end
	for _, x in ipairs({ -30, -10, 10, 30 }) do
		local flag = part({ Size = Vector3.new(0.3, 8, 0.3), CFrame = CFrame.new(center + Vector3.new(x, 4, rz + 22)), Color = Color3.new(1, 1, 1) }, root)
		part({ Size = Vector3.new(0.1, 2, 3), CFrame = CFrame.new(center + Vector3.new(x, 7, rz + 23.5)), Color = Color3.fromRGB(255, 200, 40), CanCollide = false }, root)
	end
	stand(root, center + Vector3.new(0, 0, -rz - 14), center + Vector3.new(0, 0, -rz - 40), &quot;COURSES&quot;, Color3.fromRGB(240, 60, 60), &quot;RaceStand&quot;, {}, &quot;Courses&quot;)
	avoidCircle(center, rx + 10)
end

function MapBuilder._reserveVillage(folder, zone)
	local c = zone.center
	local spawnPos = Config.Map.SpawnPosition
	avoidCircle(Vector3.new(spawnPos.X, 0, spawnPos.Z), 16)
	buildRaceTrack(folder, c + Vector3.new(55, 0, -45))

	-- Spawn
	local existing = workspace:FindFirstChildOfClass(&quot;SpawnLocation&quot;)
	if existing then
		existing:Destroy()
	end
	local spawn = Instance.new(&quot;SpawnLocation&quot;)
	spawn.Name = &quot;MainSpawn&quot;
	spawn.Shape = Enum.PartType.Cylinder
	spawn.Size = Vector3.new(0.6, 14, 14)
	spawn.CFrame = CFrame.new(spawnPos.X, 0.3, spawnPos.Z) * CFrame.Angles(0, 0, math.rad(90))
	spawn.Anchored = true
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Color = Color3.fromRGB(120, 210, 255)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = folder
	local ring = cylinder(CFrame.new(spawnPos.X, 0.4, spawnPos.Z), 0.4, 7.5, Color3.new(1, 1, 1), folder, Enum.Material.Neon)
	ring.CanCollide = false
	ring.Transparency = 0.4

	-- Grand panneau titre
	local title = sign(folder, CFrame.new(spawnPos.X, 13, spawnPos.Z + 20) * CFrame.Angles(0, math.pi, 0), Vector3.new(34, 8, 1), &quot;PET RUSH&quot;, Color3.fromRGB(255, 210, 60), Color3.fromRGB(120, 70, 200))
	for _, x in ipairs({ -15, 15 }) do
		part({ Size = Vector3.new(1.2, 13, 1.2), CFrame = CFrame.new(spawnPos.X + x, 6.5, spawnPos.Z + 20), Color = Color3.new(1, 1, 1), Material = Enum.Material.Wood }, folder)
	end

	-- Classement
	local boardPos = c + Vector3.new(-45, 0, 85)
	local board = part({ Name = &quot;Leaderboard&quot;, Size = Vector3.new(20, 16, 1), CFrame = CFrame.lookAt(boardPos + Vector3.new(0, 10, 0), Vector3.new(spawnPos.X, 10, spawnPos.Z)), Color = Color3.fromRGB(40, 45, 90) }, folder)
	part({ Size = Vector3.new(21.6, 17.6, 0.8), CFrame = board.CFrame * CFrame.new(0, 0, 0.3), Color = Config.Colors.Gold, Material = Enum.Material.Metal }, folder)
	for _, x in ipairs({ -8, 8 }) do
		part({ Size = Vector3.new(1, 3, 1), CFrame = board.CFrame * CFrame.new(x, -9.5, 0.3), Color = Config.Colors.Gold, Material = Enum.Material.Metal }, folder)
	end
	local gui = Instance.new(&quot;SurfaceGui&quot;)
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	local head = Instance.new(&quot;TextLabel&quot;)
	head.Size = UDim2.new(1, 0, 0.16, 0)
	head.BackgroundTransparency = 1
	head.Text = &quot;TOP COINS&quot;
	head.TextColor3 = Config.Colors.Gold
	head.Font = Enum.Font.FredokaOne
	head.TextScaled = true
	head.Parent = gui
	local st = Instance.new(&quot;UIStroke&quot;)
	st.Color = Color3.fromRGB(22, 24, 52)
	st.Thickness = 4
	st.Parent = head
	local list = Instance.new(&quot;TextLabel&quot;)
	list.Size = UDim2.new(1, -30, 0.8, 0)
	list.Position = UDim2.new(0, 15, 0.18, 0)
	list.BackgroundTransparency = 1
	list.Text = &quot;Chargement...&quot;
	list.TextColor3 = Color3.new(1, 1, 1)
	list.Font = Enum.Font.FredokaOne
	list.TextScaled = true
	list.TextXAlignment = Enum.TextXAlignment.Left
	list.TextYAlignment = Enum.TextYAlignment.Top
	list.Parent = gui
	gui.Parent = board
	MapBuilder.LeaderboardLabel = list
	avoidCircle(boardPos, 12)

	-- Stand cadeau du jour
	stand(folder, c + Vector3.new(45, 0, 88), Vector3.new(spawnPos.X, 0, spawnPos.Z), &quot;CADEAU&quot;, Color3.fromRGB(255, 170, 30), &quot;DailyStand&quot;, {}, &quot;Recuperer&quot;)
end

-- Construction ------------------------------------------------------------------------------

function MapBuilder.Build()
	for _, name in ipairs({ &quot;PetRush&quot;, &quot;Baseplate&quot; }) do
		local old = workspace:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local root = Instance.new(&quot;Folder&quot;)
	root.Name = &quot;PetRush&quot;
	root.Parent = workspace
	buildLighting()
	buildWorld(root)
	for i, zone in ipairs(Config.Zones) do
		buildZone(root, zone, i)
	end
	for _, name in ipairs({ &quot;Coins&quot;, &quot;Racers&quot; }) do
		if not workspace:FindFirstChild(name) then
			local f = Instance.new(&quot;Folder&quot;)
			f.Name = name
			f.Parent = workspace
		end
	end
	Players.RespawnTime = 2
	return root
end

function MapBuilder.GetCoinSpots(zoneId)
	return coinSpots[zoneId] or {}
end

function MapBuilder.GetRaceWaypoints()
	return raceWaypoints
end

function MapBuilder.ZoneAt(position)
	for _, zone in ipairs(Config.Zones) do
		local half = zone.size / 2 + 50
		if math.abs(position.X - zone.center.X) &lt;= half and math.abs(position.Z - zone.center.Z) &lt;= half then
			return zone
		end
	end
	return nil
end

return MapBuilder
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">PetService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Pets : eclosion, equipement, evolution, index, zones, cadeau du jour, classement.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local HttpService = game:GetService(&quot;HttpService&quot;)
local CollectionService = game:GetService(&quot;CollectionService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local PetModel = require(ReplicatedStorage.Shared.PetModel)
local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)

local PetService = {}

local function notify(player, text, kind)
	Remotes.Notify:FireClient(player, text, kind or &quot;info&quot;)
end

-- Synchronisation ------------------------------------------------------------------

function PetService.Sync(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	DataService.Sync(player)
	-- Attribut lu par tous les clients pour afficher les pets qui suivent
	local equipped = {}
	for _, uid in ipairs(data.Equipped) do
		for _, pet in ipairs(data.Pets) do
			if pet.uid == uid then
				table.insert(equipped, { id = pet.id, evo = pet.evo })
			end
		end
	end
	player:SetAttribute(&quot;EquippedPets&quot;, HttpService:JSONEncode(equipped))
	player:SetAttribute(&quot;Power&quot;, PetService.GetPower(player))
	Remotes.PetsSync:FireClient(player, {
		coins = math.floor(data.Coins),
		totalCoins = math.floor(data.TotalCoins),
		pets = data.Pets,
		equipped = data.Equipped,
		zones = data.Zones,
		index = data.Index,
		hatched = data.Hatched,
		raceWins = data.RaceWins,
		races = data.Races,
		dailyReady = os.time() - (data.LastDaily or 0) &gt;= Config.Daily.Cooldown,
		dailyIn = math.max(0, Config.Daily.Cooldown - (os.time() - (data.LastDaily or 0))),
		power = PetService.GetPower(player),
	})
end

function PetService.GetPower(player)
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	local total = 0
	for _, uid in ipairs(data.Equipped) do
		for _, pet in ipairs(data.Pets) do
			if pet.uid == uid then
				total += PetModel.Stats(pet.id, pet.evo).power
			end
		end
	end
	return total
end

function PetService.GetEquippedPets(player)
	local data = DataService.Get(player)
	local list = {}
	if not data then
		return list
	end
	for _, uid in ipairs(data.Equipped) do
		for _, pet in ipairs(data.Pets) do
			if pet.uid == uid then
				table.insert(list, pet)
			end
		end
	end
	return list
end

function PetService.AddCoins(player, amount)
	local data = DataService.Get(player)
	if not data then
		return
	end
	data.Coins += amount
	if amount &gt; 0 then
		data.TotalCoins += amount
	end
end

local function findPet(data, uid)
	for i, pet in ipairs(data.Pets) do
		if pet.uid == uid then
			return pet, i
		end
	end
	return nil
end

local function givePet(player, data, petId, evo)
	local pet = { uid = data.NextUid, id = petId, evo = evo or 1 }
	data.NextUid += 1
	table.insert(data.Pets, pet)
	if not data.Index[petId] then
		data.Index[petId] = true
		notify(player, &quot;📖 Nouveau pet dans ton index : &quot; .. Config.PetById[petId].icon .. &quot; &quot; .. petId, &quot;good&quot;)
	end
	return pet
end

-- Eclosion --------------------------------------------------------------------------

local function luckBonus(player)
	local luck = 0
	for _, pet in ipairs(PetService.GetEquippedPets(player)) do
		luck += PetModel.Stats(pet.id, pet.evo).luck
	end
	return 1 + math.min(luck, 300) / 150 -- jusqu'a x3 sur les raretes hautes
end

function PetService.EggChances(eggId, luck)
	luck = luck or 1
	local pool = {}
	local total = 0
	for _, pet in ipairs(Config.Pets) do
		if pet.egg == eggId then
			local rarity = Config.RarityById[pet.rarity]
			local weight = rarity.weight * (rarity.index &gt;= 3 and luck or 1)
			table.insert(pool, { pet = pet, weight = weight })
			total += weight
		end
	end
	return pool, total
end

local function hatch(player, eggId)
	local data = DataService.Get(player)
	local egg = Config.EggById[eggId]
	if not data or not egg then
		return
	end
	if not data.Zones[egg.zone] then
		notify(player, &quot;🔒 Debloque d'abord la zone &quot; .. Config.ZoneById[egg.zone].name, &quot;danger&quot;)
		return
	end
	if #data.Pets &gt;= Config.MaxPets then
		notify(player, &quot;🐾 Inventaire plein (&quot; .. Config.MaxPets .. &quot; pets). Fais evoluer ou supprime des pets.&quot;, &quot;danger&quot;)
		return
	end
	if data.Coins &lt; egg.price then
		notify(player, &quot;🪙 Il te faut &quot; .. egg.price .. &quot; coins pour cet oeuf.&quot;, &quot;danger&quot;)
		return
	end
	data.Coins -= egg.price
	data.Hatched += 1
	local pool, total = PetService.EggChances(eggId, luckBonus(player))
	local r = math.random() * total
	local chosen = pool[1].pet
	for _, entry in ipairs(pool) do
		r -= entry.weight
		if r &lt;= 0 then
			chosen = entry.pet
			break
		end
	end
	local pet = givePet(player, data, chosen.id, 1)
	local rarity = Config.RarityById[chosen.rarity]
	Remotes.FX:FireClient(player, &quot;Hatch&quot;, { petId = chosen.id, uid = pet.uid, rarity = chosen.rarity, egg = eggId })
	if rarity.index &gt;= 5 then
		Remotes.Notify:FireAllClients(&quot;🎉 &quot; .. player.DisplayName .. &quot; a obtenu un pet &quot; .. rarity.icon .. &quot; &quot; .. rarity.name .. &quot; : &quot; .. chosen.icon .. &quot; &quot; .. chosen.id .. &quot; !&quot;, &quot;gold&quot;)
	end
	PetService.Sync(player)
end

-- Equipement / evolution / suppression ----------------------------------------------------

local function equip(player, uid)
	local data = DataService.Get(player)
	if not data then
		return
	end
	uid = tonumber(uid)
	local pet = findPet(data, uid)
	if not pet then
		return
	end
	local idx = table.find(data.Equipped, uid)
	if idx then
		table.remove(data.Equipped, idx)
	else
		if #data.Equipped &gt;= Config.MaxEquipped then
			notify(player, &quot;Tu peux equiper &quot; .. Config.MaxEquipped .. &quot; pets maximum.&quot;, &quot;danger&quot;)
			return
		end
		table.insert(data.Equipped, uid)
	end
	PetService.Sync(player)
end

local function equipBest(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local sorted = table.clone(data.Pets)
	table.sort(sorted, function(a, b)
		return PetModel.Stats(a.id, a.evo).power &gt; PetModel.Stats(b.id, b.evo).power
	end)
	data.Equipped = {}
	for i = 1, math.min(Config.MaxEquipped, #sorted) do
		table.insert(data.Equipped, sorted[i].uid)
	end
	notify(player, &quot;Meilleurs pets equipes !&quot;, &quot;good&quot;)
	PetService.Sync(player)
end

local function evolve(player, uid)
	local data = DataService.Get(player)
	if not data then
		return
	end
	uid = tonumber(uid)
	local pet = findPet(data, uid)
	if not pet then
		return
	end
	if pet.evo &gt;= #Config.Evolutions then
		notify(player, &quot;Ce pet est deja au niveau maximum 🌌&quot;, &quot;info&quot;)
		return
	end
	local same = {}
	for _, other in ipairs(data.Pets) do
		if other.id == pet.id and other.evo == pet.evo then
			table.insert(same, other)
		end
	end
	if #same &lt; Config.EvolveCost then
		notify(player, &quot;Il faut &quot; .. Config.EvolveCost .. &quot; x &quot; .. PetModel.DisplayName(pet.id, pet.evo) .. &quot; (tu en as &quot; .. #same .. &quot;)&quot;, &quot;danger&quot;)
		return
	end
	-- Consomme 3 exemplaires (celui choisi en premier)
	local consumed = 0
	local toRemove = { pet }
	for _, other in ipairs(same) do
		if other ~= pet and #toRemove &lt; Config.EvolveCost then
			table.insert(toRemove, other)
		end
	end
	for _, rem in ipairs(toRemove) do
		local _, i = findPet(data, rem.uid)
		if i then
			table.remove(data.Pets, i)
			local eq = table.find(data.Equipped, rem.uid)
			if eq then
				table.remove(data.Equipped, eq)
			end
			consumed += 1
		end
	end
	local newPet = givePet(player, data, pet.id, pet.evo + 1)
	if #data.Equipped &lt; Config.MaxEquipped then
		table.insert(data.Equipped, newPet.uid)
	end
	local evo = Config.Evolutions[newPet.evo]
	Remotes.FX:FireClient(player, &quot;Evolve&quot;, { petId = newPet.id, uid = newPet.uid, evo = newPet.evo })
	Remotes.Notify:FireAllClients(&quot;🧬 &quot; .. player.DisplayName .. &quot; a fait evoluer un &quot; .. Config.PetById[pet.id].icon .. &quot; &quot; .. pet.id .. &quot; en &quot; .. evo.icon .. &quot; &quot; .. evo.name .. &quot; !&quot;, &quot;gold&quot;)
	PetService.Sync(player)
end

local function deletePet(player, uid)
	local data = DataService.Get(player)
	if not data then
		return
	end
	uid = tonumber(uid)
	local pet, i = findPet(data, uid)
	if not pet then
		return
	end
	table.remove(data.Pets, i)
	local eq = table.find(data.Equipped, uid)
	if eq then
		table.remove(data.Equipped, eq)
	end
	local rarity = Config.RarityById[Config.PetById[pet.id].rarity]
	local refund = math.floor(10 * rarity.power * Config.Evolutions[pet.evo].mult)
	PetService.AddCoins(player, refund)
	notify(player, &quot;🗑️ Pet supprime (+&quot; .. refund .. &quot; coins)&quot;, &quot;info&quot;)
	PetService.Sync(player)
end

-- Zones -----------------------------------------------------------------------------

local function unlockZone(player, zoneId)
	local data = DataService.Get(player)
	local zone = Config.ZoneById[zoneId]
	if not data or not zone or data.Zones[zoneId] then
		return
	end
	if data.Coins &lt; zone.price then
		notify(player, &quot;🔒 Il te faut &quot; .. zone.price .. &quot; coins pour &quot; .. zone.name .. &quot; (tu as &quot; .. math.floor(data.Coins) .. &quot;).&quot;, &quot;danger&quot;)
		return
	end
	data.Coins -= zone.price
	data.Zones[zoneId] = true
	Remotes.Notify:FireAllClients(&quot;🗺️ &quot; .. player.DisplayName .. &quot; a debloque &quot; .. zone.icon .. &quot; &quot; .. zone.name .. &quot; !&quot;, &quot;gold&quot;)
	Remotes.FX:FireClient(player, &quot;ZoneUnlock&quot;, { zoneId = zoneId })
	PetService.Sync(player)
end

local function teleport(player, zoneId)
	local data = DataService.Get(player)
	local zone = Config.ZoneById[zoneId]
	if not data or not zone then
		return
	end
	if not data.Zones[zoneId] then
		notify(player, &quot;🔒 Zone verrouillee : va a la porte pour la debloquer.&quot;, &quot;danger&quot;)
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if hrp then
		hrp.CFrame = CFrame.new(zone.center + Vector3.new(0, 4, zone.size / 2 - 20))
		Remotes.FX:FireClient(player, &quot;Teleport&quot;, { zoneId = zoneId })
	end
end

-- Cadeau du jour ---------------------------------------------------------------------

local function daily(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	if os.time() - (data.LastDaily or 0) &lt; Config.Daily.Cooldown then
		local left = Config.Daily.Cooldown - (os.time() - data.LastDaily)
		notify(player, string.format(&quot;🎁 Reviens dans %dh%02d pour ton cadeau.&quot;, math.floor(left / 3600), math.floor(left % 3600 / 60)), &quot;info&quot;)
		return
	end
	data.LastDaily = os.time()
	PetService.AddCoins(player, Config.Daily.Coins)
	-- Petit bonus : un oeuf du village gratuit (pet Common/Uncommon)
	local pool, total = PetService.EggChances(&quot;Village&quot;, 1)
	local r = math.random() * total
	local chosen = pool[1].pet
	for _, entry in ipairs(pool) do
		r -= entry.weight
		if r &lt;= 0 then
			chosen = entry.pet
			break
		end
	end
	local pet = givePet(player, data, chosen.id, 1)
	Remotes.FX:FireClient(player, &quot;Daily&quot;, { coins = Config.Daily.Coins, petId = chosen.id })
	Remotes.FX:FireClient(player, &quot;Hatch&quot;, { petId = chosen.id, uid = pet.uid, rarity = chosen.rarity, egg = &quot;Village&quot; })
	PetService.Sync(player)
end

-- Codes cadeaux -------------------------------------------------------------------------

local function redeem(player, code)
	local data = DataService.Get(player)
	if not data or type(code) ~= &quot;string&quot; then
		return
	end
	code = string.upper(string.gsub(code, &quot;%s&quot;, &quot;&quot;))
	local reward = Config.Codes[code]
	data.Codes = data.Codes or {}
	if not reward then
		notify(player, &quot;Code invalide.&quot;, &quot;danger&quot;)
		return
	end
	if data.Codes[code] then
		notify(player, &quot;Code deja utilise.&quot;, &quot;danger&quot;)
		return
	end
	data.Codes[code] = true
	PetService.AddCoins(player, reward)
	Remotes.FX:FireClient(player, &quot;Code&quot;, { coins = reward })
	notify(player, &quot;Code &quot; .. code .. &quot; : +&quot; .. reward .. &quot; coins !&quot;, &quot;gold&quot;)
	PetService.Sync(player)
end

-- Joueurs -------------------------------------------------------------------------------

local function onPlayerAdded(player)
	local data = DataService.Load(player)
	if #data.Pets == 0 then
		local pet = givePet(player, data, &quot;Chaton&quot;, 1)
		data.Equipped = { pet.uid }
	end
	player.CharacterAdded:Connect(function(character)
		task.spawn(function()
			local humanoid = character:WaitForChild(&quot;Humanoid&quot;, 5)
			while character.Parent and humanoid and humanoid.Health &gt; 0 do
				task.wait(0.5)
				local hrp = character:FindFirstChild(&quot;HumanoidRootPart&quot;)
				if hrp and hrp.Position.Y &lt; Config.Map.KillHeight then
					hrp.CFrame = CFrame.new(Config.Map.SpawnPosition)
				end
			end
		end)
	end)
	task.wait(1)
	if player.Parent ~= Players then
		return
	end
	PetService.Sync(player)
	if data.Hatched == 0 then
		notify(player, &quot;🐾 Bienvenue ! Ton Chaton ramasse les coins avec toi. Va au stand 🥚 pour ouvrir des oeufs.&quot;, &quot;good&quot;)
	else
		notify(player, &quot;🐾 Bon retour, &quot; .. player.DisplayName .. &quot; !&quot;, &quot;good&quot;)
	end
end

-- Classement ----------------------------------------------------------------------------

local function updateLeaderboard()
	local label = MapBuilder.LeaderboardLabel
	if not label then
		return
	end
	local entries, seen = {}, {}
	for _, p in ipairs(Players:GetPlayers()) do
		local data = DataService.Get(p)
		if data then
			table.insert(entries, { name = p.DisplayName, value = math.floor(data.TotalCoins) })
			seen[p.UserId] = true
		end
	end
	for _, entry in ipairs(DataService.GetTop(10)) do
		if not seen[entry.userId] then
			local ok, name = pcall(function()
				return Players:GetNameFromUserIdAsync(entry.userId)
			end)
			table.insert(entries, { name = ok and name or &quot;???&quot;, value = entry.value })
		end
	end
	table.sort(entries, function(a, b)
		return a.value &gt; b.value
	end)
	local lines = {}
	for i = 1, math.min(10, #entries) do
		table.insert(lines, string.format(&quot;%d.  %s  -  %d&quot;, i, entries[i].name, entries[i].value))
	end
	label.Text = #lines &gt; 0 and table.concat(lines, &quot;\n&quot;) or &quot;Aucun joueur classe&quot;
end

function PetService.Init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		DataService.Save(player)
		DataService.Release(player)
	end)

	Remotes.Pets.OnServerEvent:Connect(function(player, action, a)
		if action == &quot;hatch&quot; then
			hatch(player, tostring(a))
		elseif action == &quot;equip&quot; then
			equip(player, a)
		elseif action == &quot;equipBest&quot; then
			equipBest(player)
		elseif action == &quot;evolve&quot; then
			evolve(player, a)
		elseif action == &quot;delete&quot; then
			deletePet(player, a)
		elseif action == &quot;unlock&quot; then
			unlockZone(player, tostring(a))
		elseif action == &quot;teleport&quot; then
			teleport(player, tostring(a))
		elseif action == &quot;daily&quot; then
			daily(player)
		elseif action == &quot;code&quot; then
			redeem(player, a)
		elseif action == &quot;sync&quot; then
			PetService.Sync(player)
		end
	end)

	for _, gate in ipairs(CollectionService:GetTagged(&quot;Gate&quot;)) do
		local prompt = gate:FindFirstChildOfClass(&quot;ProximityPrompt&quot;)
		if prompt then
			prompt.Triggered:Connect(function(player)
				unlockZone(player, gate:GetAttribute(&quot;ZoneId&quot;))
			end)
		end
	end
	for _, standPart in ipairs(CollectionService:GetTagged(&quot;DailyStand&quot;)) do
		local prompt = standPart:FindFirstChildOfClass(&quot;ProximityPrompt&quot;)
		if prompt then
			prompt.Triggered:Connect(daily)
		end
	end

	task.spawn(function()
		while true do
			pcall(updateLeaderboard)
			task.wait(30)
		end
	end)
end

return PetService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">RaceService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Courses de pets : lobby, compte a rebours, simulation avec Speed / Stamina / Luck, recompenses.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local CollectionService = game:GetService(&quot;CollectionService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local PetModel = require(ReplicatedStorage.Shared.PetModel)
local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)
local PetService = require(script.Parent.PetService)

local RaceService = {}

local state = { phase = &quot;Idle&quot;, type = nil, racers = {}, endsAt = 0 }
local runnersFolder

local function broadcast(extra)
	local payload = { phase = state.phase, type = state.type and state.type.id or nil, endsAt = state.endsAt, serverTime = workspace:GetServerTimeNow(), racers = {} }
	for _, r in ipairs(state.racers) do
		table.insert(payload.racers, { name = r.name, petId = r.petId, evo = r.evo, progress = r.progress or 0, finished = r.finished, rank = r.rank, userId = r.player and r.player.UserId or 0 })
	end
	if extra then
		for k, v in pairs(extra) do
			payload[k] = v
		end
	end
	Remotes.RaceSync:FireAllClients(payload)
end

local function pathLength(points)
	local total = 0
	for i = 1, #points do
		total += (points[(i % #points) + 1] - points[i]).Magnitude
	end
	return total
end

local function pointAt(points, distance)
	local total = pathLength(points)
	distance = distance % total
	for i = 1, #points do
		local a = points[i]
		local b = points[(i % #points) + 1]
		local len = (b - a).Magnitude
		if distance &lt;= len then
			return a:Lerp(b, distance / len), b
		end
		distance -= len
	end
	return points[1], points[2]
end

local function join(player, typeId, uid)
	local data = DataService.Get(player)
	if not data then
		return
	end
	uid = tonumber(uid)
	local pet
	for _, p in ipairs(data.Pets) do
		if p.uid == uid then
			pet = p
		end
	end
	if not pet then
		Remotes.Notify:FireClient(player, &quot;Choisis un pet pour la course.&quot;, &quot;danger&quot;)
		return
	end
	if state.phase == &quot;Idle&quot; then
		local raceType
		for _, t in ipairs(Config.Race.Types) do
			if t.id == typeId then
				raceType = t
			end
		end
		if not raceType then
			return
		end
		state.phase = &quot;Lobby&quot;
		state.type = raceType
		state.racers = {}
		state.endsAt = workspace:GetServerTimeNow() + Config.Race.LobbyTime
		Remotes.Notify:FireAllClients(&quot;🏁 &quot; .. player.DisplayName .. &quot; lance une course &quot; .. raceType.icon .. &quot; &quot; .. raceType.name .. &quot; ! Rejoins au stand des courses.&quot;, &quot;good&quot;)
		task.delay(Config.Race.LobbyTime, RaceService.Start)
	elseif state.phase ~= &quot;Lobby&quot; then
		Remotes.Notify:FireClient(player, &quot;Une course est en cours, attends la prochaine.&quot;, &quot;info&quot;)
		return
	end
	for _, r in ipairs(state.racers) do
		if r.player == player then
			r.petId = pet.id
			r.evo = pet.evo
			broadcast()
			Remotes.Notify:FireClient(player, &quot;Pet de course change : &quot; .. PetModel.DisplayName(pet.id, pet.evo), &quot;good&quot;)
			return
		end
	end
	if #state.racers &gt;= Config.Race.MaxRacers then
		Remotes.Notify:FireClient(player, &quot;La course est pleine !&quot;, &quot;danger&quot;)
		return
	end
	table.insert(state.racers, { player = player, name = player.DisplayName, petId = pet.id, evo = pet.evo, progress = 0 })
	Remotes.Notify:FireClient(player, &quot;✅ Inscrit avec &quot; .. PetModel.DisplayName(pet.id, pet.evo), &quot;good&quot;)
	broadcast()
end

local function fillWithAI()
	local i = 0
	while #state.racers &lt; Config.Race.MaxRacers do
		i += 1
		local pet = Config.Pets[math.random(1, 9)]
		table.insert(state.racers, { player = nil, name = &quot;🤖 &quot; .. (Config.Race.AINames[i] or (&quot;Bot &quot; .. i)), petId = pet.id, evo = 1, progress = 0 })
	end
end

function RaceService.Start()
	if state.phase ~= &quot;Lobby&quot; then
		return
	end
	-- Retire les joueurs partis
	for i = #state.racers, 1, -1 do
		local r = state.racers[i]
		if r.player and r.player.Parent ~= Players then
			table.remove(state.racers, i)
		end
	end
	fillWithAI()
	local points = MapBuilder.GetRaceWaypoints()
	local total = pathLength(points) * state.type.laps
	state.phase = &quot;Countdown&quot;
	state.endsAt = workspace:GetServerTimeNow() + Config.Race.Countdown
	-- Modeles des coureurs
	for i, r in ipairs(state.racers) do
		local stats = PetModel.Stats(r.petId, r.evo)
		r.stats = stats
		r.progress = 0
		r.finished = false
		r.rank = nil
		r.lane = (i - 2.5) * 2.2
		local pos = pointAt(points, 0)
		r.model = PetModel.Build(r.petId, r.evo, CFrame.new(pos + Vector3.new(0, -0.9, r.lane)))
		r.model.Parent = runnersFolder
		local tag = Instance.new(&quot;BillboardGui&quot;)
		tag.Size = UDim2.fromOffset(140, 30)
		tag.StudsOffset = Vector3.new(0, 3, 0)
		tag.AlwaysOnTop = true
		local l = Instance.new(&quot;TextLabel&quot;)
		l.Size = UDim2.fromScale(1, 1)
		l.BackgroundTransparency = 1
		l.Text = r.name
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.TextColor3 = r.player and Config.Colors.Gold or Color3.new(1, 1, 1)
		l.TextStrokeTransparency = 0.3
		l.Parent = tag
		tag.StudsOffset = Vector3.new(0, 4.5, 0)
		tag.Parent = r.model.PrimaryPart or r.model:FindFirstChildWhichIsA(&quot;BasePart&quot;, true)
	end
	broadcast()
	task.wait(Config.Race.Countdown)
	state.phase = &quot;Racing&quot;
	state.endsAt = 0
	broadcast()
	Remotes.FX:FireAllClients(&quot;RaceStart&quot;, {})

	local finishedCount = 0
	local startTime = os.clock()
	local lastSync = 0
	while finishedCount &lt; #state.racers and os.clock() - startTime &lt; 180 do
		local dt = task.wait(0.1)
		for _, r in ipairs(state.racers) do
			if not r.finished then
				local s = r.stats
				local speed = 10 + math.min(s.speed, 60) * 0.9
				-- Endurance : la vitesse chute apres 45 % de la course selon la stamina
				if r.progress / total &gt; 0.45 then
					local stamina = math.min(s.stamina, 60)
					speed = speed * (0.45 + stamina / 100)
				end
				-- Chance : rafales aleatoires
				if math.random() &lt; math.min(s.luck, 60) / 400 then
					speed = speed * 1.8
				end
				speed = speed * (0.92 + math.random() * 0.16)
				r.progress += speed * dt
				if r.progress &gt;= total then
					r.progress = total
					r.finished = true
					finishedCount += 1
					r.rank = finishedCount
				end
				local pos, nextPoint = pointAt(points, r.progress)
				local look = CFrame.lookAt(pos, Vector3.new(nextPoint.X, pos.Y, nextPoint.Z))
				local bob = math.abs(math.sin(os.clock() * 12 + r.lane)) * 0.6
				r.model:PivotTo(look * CFrame.new(r.lane, -0.9 + bob * 0.3, 0))
			end
		end
		if os.clock() - lastSync &gt; 0.5 then
			lastSync = os.clock()
			broadcast({ total = total })
		end
	end
	-- Classement final
	table.sort(state.racers, function(a, b)
		return (a.rank or 99) &lt; (b.rank or 99)
	end)
	state.phase = &quot;Finished&quot;
	state.endsAt = workspace:GetServerTimeNow() + 8
	local results = {}
	for i, r in ipairs(state.racers) do
		r.rank = r.rank or i
		table.insert(results, { name = r.name, petId = r.petId, evo = r.evo, rank = r.rank, userId = r.player and r.player.UserId or 0 })
		if r.player and r.player.Parent == Players then
			local data = DataService.Get(r.player)
			if data then
				data.Races += 1
				local reward = (r.rank == 1) and state.type.reward or (r.rank == 2 and math.floor(state.type.reward * 0.4) or math.floor(state.type.reward * 0.15))
				if r.rank == 1 then
					data.RaceWins += 1
				end
				PetService.AddCoins(r.player, reward)
				PetService.Sync(r.player)
				Remotes.Notify:FireClient(r.player, (r.rank == 1 and &quot;🥇 VICTOIRE ! &quot; or (r.rank == 2 and &quot;🥈 &quot; or &quot;🏁 &quot;)) .. &quot;Course terminee : +&quot; .. reward .. &quot; coins&quot;, r.rank == 1 and &quot;gold&quot; or &quot;good&quot;)
			end
		end
	end
	local winner = state.racers[1]
	Remotes.Notify:FireAllClients(&quot;🏆 &quot; .. winner.name .. &quot; remporte la course &quot; .. state.type.icon .. &quot; &quot; .. state.type.name .. &quot; avec &quot; .. PetModel.DisplayName(winner.petId, winner.evo) .. &quot; !&quot;, &quot;gold&quot;)
	broadcast({ results = results })
	Remotes.FX:FireAllClients(&quot;RaceEnd&quot;, { winnerUserId = winner.player and winner.player.UserId or 0, position = winner.model and winner.model:GetPivot().Position or nil })
	task.wait(8)
	for _, r in ipairs(state.racers) do
		if r.model then
			r.model:Destroy()
		end
	end
	state.phase = &quot;Idle&quot;
	state.type = nil
	state.racers = {}
	state.endsAt = 0
	broadcast()
end

function RaceService.Init()
	runnersFolder = workspace:FindFirstChild(&quot;Racers&quot;) or Instance.new(&quot;Folder&quot;)
	runnersFolder.Name = &quot;Racers&quot;
	runnersFolder.Parent = workspace
	Remotes.Race.OnServerEvent:Connect(function(player, action, a, b)
		if action == &quot;join&quot; then
			join(player, tostring(a), b)
		elseif action == &quot;state&quot; then
			broadcast()
		end
	end)
	Players.PlayerAdded:Connect(function()
		task.wait(1)
		broadcast()
	end)
end

return RaceService
</ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000001D"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000001C"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX0000001B"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX00000013"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Point d'entree client de PET RUSH.
-- Chaque module demarre separement : une erreur dans l'un n'empeche plus les autres de fonctionner.

local Modules = script.Parent.Modules

local function start(name, ...)
	local args = table.pack(...)
	local ok, err = pcall(function()
		local module = require(Modules[name])
		module.Init(table.unpack(args, 1, args.n))
	end)
	if not ok then
		warn(&quot;[PetRush] Erreur au demarrage de &quot; .. name .. &quot; : &quot; .. tostring(err))
	end
end

local HUD = require(Modules.HUD)
start(&quot;HUD&quot;)
start(&quot;Effects&quot;, HUD)
start(&quot;PetFollow&quot;)
task.spawn(start, &quot;WorldIcons&quot;)
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000001A"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">Effects</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Effets : coins qui tournent, collecte, coffres, eclosion, evolution, courses, teleportation, sons.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local Debris = game:GetService(&quot;Debris&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)
local Icons = require(ReplicatedStorage.Shared.Icons)

local Effects = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local HUD

local SOUNDS = {
	coin = &quot;rbxasset://sounds/electronicpingshort.wav&quot;,
	chest = &quot;rbxasset://sounds/victory.wav&quot;,
	hatch = &quot;rbxasset://sounds/snap.wav&quot;,
	rare = &quot;rbxasset://sounds/victory.wav&quot;,
	evolve = &quot;rbxasset://sounds/HalloweenGhost.wav&quot;,
	race = &quot;rbxasset://sounds/swoosh.wav&quot;,
	win = &quot;rbxasset://sounds/victory.wav&quot;,
	teleport = &quot;rbxasset://sounds/flashbulb.wav&quot;,
	unlock = &quot;rbxasset://sounds/bass.wav&quot;,
	click = &quot;rbxasset://sounds/button.wav&quot;,
}

local function playSound(name, volume, pitch, position)
	local s = Instance.new(&quot;Sound&quot;)
	s.SoundId = SOUNDS[name] or SOUNDS.click
	s.Volume = volume or 0.5
	s.PlaybackSpeed = pitch or 1
	if position then
		local holder = Instance.new(&quot;Part&quot;)
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.Transparency = 1
		holder.Size = Vector3.new(1, 1, 1)
		holder.Position = position
		holder.Parent = workspace
		s.RollOffMaxDistance = 120
		s.Parent = holder
		Debris:AddItem(holder, 4)
	else
		s.Parent = workspace
		Debris:AddItem(s, 4)
	end
	s:Play()
end

local function burst(position, color, count, speed, size, gravity)
	local holder = Instance.new(&quot;Part&quot;)
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.new(1, 1, 1)
	holder.Position = position
	holder.Parent = workspace
	local att = Instance.new(&quot;Attachment&quot;)
	att.Parent = holder
	local e = Instance.new(&quot;ParticleEmitter&quot;)
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.5, 1)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new(0, 1)
	e.LightEmission = 1
	e.Acceleration = Vector3.new(0, gravity or -15, 0)
	e.Drag = 3
	e.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	e.Parent = att
	e:Emit(count)
	Debris:AddItem(holder, 2)
end

local function shockwave(position, color, size, duration)
	local ring = Instance.new(&quot;Part&quot;)
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.4, 1, 1)
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.2
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace
	TweenService:Create(ring, TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = Vector3.new(0.4, size, size), Transparency = 1 }):Play()
	Debris:AddItem(ring, duration + 0.1)
end

local function floatingText(position, text, color, size, iconName)
	local holder = Instance.new(&quot;Part&quot;)
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.new(1, 1, 1)
	holder.Position = position + Vector3.new(0, 2, 0)
	holder.Parent = workspace
	local gui = Instance.new(&quot;BillboardGui&quot;)
	gui.Size = UDim2.fromOffset(size or 140, 46)
	gui.AlwaysOnTop = true
	gui.Parent = holder
	local l = Instance.new(&quot;TextLabel&quot;)
	l.Size = UDim2.new(1, iconName and -46 or 0, 1, 0)
	l.Position = UDim2.fromOffset(iconName and 46 or 0, 0)
	l.BackgroundTransparency = 1
	l.Text = text
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = color
	l.TextXAlignment = iconName and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
	l.Parent = gui
	local st = Instance.new(&quot;UIStroke&quot;)
	st.Color = Color3.fromRGB(22, 24, 52)
	st.Thickness = 3
	st.Parent = l
	local icon
	if iconName then
		icon = Icons.Image(iconName, gui, { Size = UDim2.fromOffset(46, 46) })
	end
	local scale = Instance.new(&quot;UIScale&quot;)
	scale.Scale = 0.3
	scale.Parent = l
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	TweenService:Create(holder, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = holder.Position + Vector3.new(0, 4, 0) }):Play()
	task.delay(0.65, function()
		TweenService:Create(l, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
		TweenService:Create(st, TweenInfo.new(0.35), { Transparency = 1 }):Play()
		if icon then
			TweenService:Create(icon, TweenInfo.new(0.35), { ImageTransparency = 1 }):Play()
		end
	end)
	Debris:AddItem(holder, 1.1)
end

local function flashScreen(color, transparency, duration)
	local gui = player.PlayerGui:FindFirstChild(&quot;PetFlash&quot;)
	if not gui then
		gui = Instance.new(&quot;ScreenGui&quot;)
		gui.Name = &quot;PetFlash&quot;
		gui.IgnoreGuiInset = true
		gui.ResetOnSpawn = false
		gui.DisplayOrder = 50
		gui.Parent = player.PlayerGui
		local frame = Instance.new(&quot;Frame&quot;)
		frame.Name = &quot;Flash&quot;
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundTransparency = 1
		frame.BorderSizePixel = 0
		frame.Parent = gui
	end
	local frame = gui.Flash
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency
	TweenService:Create(frame, TweenInfo.new(duration), { BackgroundTransparency = 1 }):Play()
end

-- Rotation des coins et coffres (rendu local)
RunService.Heartbeat:Connect(function()
	local folder = workspace:FindFirstChild(&quot;Coins&quot;)
	if not folder then
		return
	end
	local t = os.clock()
	for _, coin in ipairs(folder:GetChildren()) do
		if coin:IsA(&quot;BasePart&quot;) then
			local base = coin:GetAttribute(&quot;BaseY&quot;)
			if not base then
				base = coin.Position.Y
				coin:SetAttribute(&quot;BaseY&quot;, base)
			end
			local p = coin.Position
			if coin.Name == &quot;Coin&quot; then
				coin.CFrame = CFrame.new(p.X, base + math.sin(t * 3 + p.X) * 0.4, p.Z) * CFrame.Angles(0, t * 2.5, math.rad(90))
			else
				coin.CFrame = CFrame.new(p.X, base + math.sin(t * 2) * 0.6, p.Z) * CFrame.Angles(0, t * 1.2, 0)
			end
		end
	end
end)

local handlers = {}

handlers.Collect = function(data)
	local mine = data.userId == player.UserId
	if data.chest then
		burst(data.position, Config.Colors.Accent2, 60, 25, 0.9, -10)
		shockwave(data.position, Config.Colors.Accent2, 30, 0.8)
		playSound(&quot;chest&quot;, mine and 1 or 0.5, 1.1, data.position)
	else
		burst(data.position, Config.Colors.Gold, 10, 8, 0.4, -10)
		if mine then
			playSound(&quot;coin&quot;, 0.4, 1.2 + math.random() * 0.4, data.position)
		end
	end
	if mine then
		floatingText(data.position, &quot;+&quot; .. data.amount, Config.Colors.Gold, data.chest and 220 or 140, &quot;coin&quot;)
		if data.chest then
			flashScreen(Config.Colors.Gold, 0.75, 0.6)
		end
	end
end

handlers.ChestSpawn = function(data)
	shockwave(data.position, Config.Colors.Accent2, 40, 1.2)
	playSound(&quot;unlock&quot;, 0.6, 1.2)
end

handlers.Hatch = function(data)
	local rarity = Config.RarityById[data.rarity]
	HUD.playHatch(data)
	playSound(&quot;hatch&quot;, 0.7, 0.9)
	task.delay(0.95, function()
		playSound(rarity.index &gt;= 4 and &quot;rare&quot; or &quot;coin&quot;, 0.8, rarity.index &gt;= 4 and 1 or 1.5)
		flashScreen(rarity.color, 0.6, 0.8)
		local char = player.Character
		local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
		if hrp then
			burst(hrp.Position, rarity.color, 40 + rarity.index * 10, 15, 0.7, 2)
			shockwave(hrp.Position - Vector3.new(0, 2, 0), rarity.color, 10 + rarity.index * 4, 0.8)
		end
	end)
end

handlers.Evolve = function(data)
	local evo = Config.Evolutions[data.evo]
	playSound(&quot;evolve&quot;, 0.8, 1.3)
	flashScreen(evo.color or Config.Colors.Gold, 0.5, 1.2)
	local char = player.Character
	local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if hrp then
		burst(hrp.Position, evo.color or Config.Colors.Gold, 80, 20, 0.9, 4)
		shockwave(hrp.Position - Vector3.new(0, 2, 0), evo.color or Config.Colors.Gold, 30, 1)
		floatingText(hrp.Position + Vector3.new(0, 3, 0), string.upper(evo.name) .. &quot; !&quot;, evo.color or Config.Colors.Gold, 260, &quot;sparkle&quot;)
	end
	HUD.playHatch({ petId = data.petId, rarity = Config.PetById[data.petId].rarity, egg = &quot;Village&quot; })
end

handlers.ZoneUnlock = function(data)
	local zone = Config.ZoneById[data.zoneId]
	playSound(&quot;unlock&quot;, 1, 1)
	flashScreen(Config.Colors.Gold, 0.5, 1)
	HUD.toast(zone.name .. &quot; debloque ! Ouvre MONDES pour t'y rendre.&quot;, &quot;gold&quot;)
end

handlers.Teleport = function(data)
	playSound(&quot;teleport&quot;, 0.6, 1)
	flashScreen(Config.Colors.Accent, 0.4, 0.8)
	local char = player.Character
	local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if hrp then
		shockwave(hrp.Position - Vector3.new(0, 2, 0), Config.Colors.Accent, 20, 0.8)
	end
end

handlers.Daily = function(data)
	playSound(&quot;win&quot;, 0.8, 1.2)
	flashScreen(Config.Colors.Gold, 0.6, 1)
	HUD.toast(&quot;Cadeau du jour : +&quot; .. data.coins .. &quot; coins et un oeuf gratuit !&quot;, &quot;gold&quot;)
end

handlers.Code = function(data)
	playSound(&quot;win&quot;, 0.8, 1.3)
	flashScreen(Config.Colors.Gold, 0.65, 0.8)
	local char = player.Character
	local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if hrp then
		floatingText(hrp.Position + Vector3.new(0, 3, 0), &quot;+&quot; .. data.coins, Config.Colors.Gold, 220, &quot;coin&quot;)
		burst(hrp.Position, Config.Colors.Gold, 50, 16, 0.6, -5)
	end
end

handlers.RaceStart = function()
	playSound(&quot;race&quot;, 1, 0.8)
	flashScreen(Color3.new(1, 1, 1), 0.7, 0.5)
end

handlers.RaceEnd = function(data)
	if data.position then
		burst(data.position, Config.Colors.Gold, 60, 20, 0.8, 2)
		shockwave(data.position, Config.Colors.Gold, 30, 1)
	end
	if data.winnerUserId == player.UserId then
		playSound(&quot;win&quot;, 1, 1)
		flashScreen(Config.Colors.Gold, 0.5, 1.5)
	else
		playSound(&quot;win&quot;, 0.4, 1.3)
	end
end

function Effects.Init(hudModule)
	HUD = hudModule
	Remotes.FX.OnClientEvent:Connect(function(kind, data)
		local handler = handlers[kind]
		if handler then
			local ok, err = pcall(handler, data or {})
			if not ok then
				warn(&quot;[PetRush] Effet &quot; .. kind .. &quot; : &quot; .. tostring(err))
			end
		end
	end)
	-- Compteur de coins anime
	local lastCoins = nil
	State.Changed.Event:Connect(function(what, data)
		if what == &quot;sync&quot; then
			if lastCoins and data.coins &gt; lastCoins then
				playSound(&quot;click&quot;, 0.15, 1.6)
			end
			lastCoins = data.coins
		end
	end)
end

return Effects
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">HUD</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Interface PET RUSH, style simulateur : vraies icones, portraits 3D, panneaux degrades, texte epais.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)
local ProximityPromptService = game:GetService(&quot;ProximityPromptService&quot;)
local CollectionService = game:GetService(&quot;CollectionService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local PetModel = require(ReplicatedStorage.Shared.PetModel)
local Icons = require(ReplicatedStorage.Shared.Icons)
local State = require(script.Parent.State)
local Portrait = require(script.Parent.Portrait)

local HUD = {}

local player = Players.LocalPlayer
local playerGui = player:WaitForChild(&quot;PlayerGui&quot;)
local FONT = Enum.Font.FredokaOne
local TOUCH = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local DARK = Color3.fromRGB(22, 24, 52)
local WHITE = Color3.new(1, 1, 1)
local GREEN = Color3.fromRGB(70, 210, 90)
local PURPLE = Color3.fromRGB(170, 90, 255)
local RED = Color3.fromRGB(240, 70, 80)
local GOLD = Color3.fromRGB(255, 195, 40)
local BLUE = Color3.fromRGB(60, 150, 255)
local GREY = Color3.fromRGB(120, 125, 150)

local ui = {}
local panels = {}
local rebuilders = {}
local selectedPet = nil

-- Helpers ------------------------------------------------------------------------------

local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end
local function corner(p, r)
	return new(&quot;UICorner&quot;, { CornerRadius = UDim.new(0, r or 14) }, p)
end
local function stroke(p, color, thickness)
	return new(&quot;UIStroke&quot;, { Color = color or DARK, Thickness = thickness or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, LineJoinMode = Enum.LineJoinMode.Round }, p)
end
local function gradient(p, c1, c2, rotation)
	return new(&quot;UIGradient&quot;, { Color = ColorSequence.new(c1, c2), Rotation = rotation or 90 }, p)
end
local function lighten(c, t)
	return c:Lerp(WHITE, t)
end
local function darken(c, t)
	return c:Lerp(Color3.new(0, 0, 0), t)
end

-- Texte epais blanc avec contour sombre (style cartoon)
local function text(props, parent, strokeColor, strokeSize)
	local base = { BackgroundTransparency = 1, Font = FONT, TextColor3 = WHITE, TextScaled = true, TextStrokeTransparency = 1, BorderSizePixel = 0 }
	for k, v in pairs(props) do
		base[k] = v
	end
	local l = new(&quot;TextLabel&quot;, base, parent)
	new(&quot;UIStroke&quot;, { Color = strokeColor or DARK, Thickness = strokeSize or 2.5, LineJoinMode = Enum.LineJoinMode.Round }, l)
	return l
end

local function fmt(n)
	n = math.floor(n or 0)
	if n &gt;= 1e9 then
		return string.format(&quot;%.1fB&quot;, n / 1e9)
	elseif n &gt;= 1e6 then
		return string.format(&quot;%.1fM&quot;, n / 1e6)
	elseif n &gt;= 1e4 then
		return string.format(&quot;%.1fK&quot;, n / 1e3)
	end
	return tostring(n)
end

-- Supprime les emojis des messages (garde les lettres accentuees)
local function stripEmoji(s)
	local out = {}
	for _, code in utf8.codes(s) do
		if code &lt; 0x2000 then
			table.insert(out, utf8.char(code))
		end
	end
	return (table.concat(out):gsub(&quot;^%s+&quot;, &quot;&quot;):gsub(&quot;%s%s+&quot;, &quot; &quot;))
end

-- Animation &quot;rebond&quot; sur un bouton
local function bouncy(button)
	local scale = button:FindFirstChildOfClass(&quot;UIScale&quot;) or new(&quot;UIScale&quot;, { Scale = 1 }, button)
	button.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.08 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.15), { Scale = 1 }):Play()
	end)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.9 }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.05 }):Play()
	end)
	return scale
end

local function pop(gui, amount)
	local scale = gui:FindFirstChildOfClass(&quot;UIScale&quot;) or new(&quot;UIScale&quot;, { Scale = 1 }, gui)
	scale.Scale = amount or 1.25
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

-- Bouton colore avec degrade, contour, texte et icone optionnelle
local function button(parent, props, color, label, iconName)
	local b = new(&quot;TextButton&quot;, { BackgroundColor3 = color, Text = &quot;&quot;, AutoButtonColor = false, BorderSizePixel = 0 }, parent)
	for k, v in pairs(props) do
		b[k] = v
	end
	corner(b, 12)
	gradient(b, lighten(color, 0.25), darken(color, 0.15), 90)
	stroke(b, DARK, 3)
	local shine = new(&quot;Frame&quot;, { Size = UDim2.new(1, -10, 0.35, 0), Position = UDim2.new(0, 5, 0, 4), BackgroundColor3 = WHITE, BackgroundTransparency = 0.75, BorderSizePixel = 0, ZIndex = b.ZIndex + 1 }, b)
	corner(shine, 8)
	if iconName then
		Icons.Image(iconName, b, { Size = UDim2.new(1.2, 0, 1.2, 0), SizeConstraint = Enum.SizeConstraint.RelativeYY, Position = UDim2.new(0, -6, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = b.ZIndex + 2 })
	end
	local t = text({ Name = &quot;Label&quot;, Size = UDim2.new(1, iconName and -64 or -16, 0.66, 0), Position = UDim2.new(0.5, iconName and 24 or 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), Text = label or &quot;&quot;, ZIndex = b.ZIndex + 2 }, b)
	bouncy(b)
	return b, t
end

-- Panneau style simulateur : degrade bleu, gros contour, icone qui deborde, bouton fermer rond
local function panel(name, size, title, iconName, color)
	color = color or BLUE
	local frame = new(&quot;Frame&quot;, { Name = name, Size = size, Position = UDim2.fromScale(0.5, 0.52), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = color, Visible = false, BorderSizePixel = 0, ZIndex = 10 }, ui.gui)
	corner(frame, 26)
	gradient(frame, lighten(color, 0.3), darken(color, 0.25), 90)
	stroke(frame, DARK, 5)
	new(&quot;UIScale&quot;, { Scale = 1 }, frame)
	-- motif de points discret
	local pattern = new(&quot;Frame&quot;, { Size = UDim2.new(1, -24, 1, -86), Position = UDim2.new(0, 12, 0, 74), BackgroundColor3 = darken(color, 0.45), BackgroundTransparency = 0.45, BorderSizePixel = 0, ZIndex = 10 }, frame)
	corner(pattern, 18)
	frame:SetAttribute(&quot;Inner&quot;, true)
	text({ Name = &quot;Title&quot;, Size = UDim2.new(1, -220, 0, 50), Position = UDim2.new(0, 110, 0, 14), Text = title, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12 }, frame, DARK, 4)
	Icons.Image(iconName, frame, { Size = UDim2.fromOffset(118, 118), Position = UDim2.new(0, -26, 0, -40), Rotation = -8, ZIndex = 13 })
	local close = Icons.Button(&quot;close&quot;, frame, { Size = UDim2.fromOffset(60, 60), Position = UDim2.new(1, 18, 0, -18), AnchorPoint = Vector2.new(1, 0), ZIndex = 14 })
	bouncy(close)
	close.Activated:Connect(function()
		HUD.hide(frame)
	end)
	panels[name] = frame
	frame:SetAttribute(&quot;FullSize&quot;, size)
	return frame, pattern
end

local function scrolling(parent, props, layout)
	local s = new(&quot;ScrollingFrame&quot;, { BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8, ScrollBarImageColor3 = WHITE, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 11 }, parent)
	for k, v in pairs(props) do
		if k ~= &quot;CellSize&quot; then
			s[k] = v
		end
	end
	new(&quot;UIPadding&quot;, { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }, s)
	if layout == &quot;grid&quot; then
		new(&quot;UIGridLayout&quot;, { CellSize = props.CellSize or UDim2.fromOffset(110, 130), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }, s)
	else
		new(&quot;UIListLayout&quot;, { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, s)
	end
	return s
end

local function clear(container)
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA(&quot;GuiObject&quot;) then
			child:Destroy()
		end
	end
end

function HUD.show(frame)
	for _, other in pairs(panels) do
		if other ~= frame and other.Visible then
			other.Visible = false
		end
	end
	frame.Visible = true
	local scale = frame:FindFirstChildOfClass(&quot;UIScale&quot;)
	scale.Scale = 0.6
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end
function HUD.hide(frame)
	local scale = frame:FindFirstChildOfClass(&quot;UIScale&quot;)
	local t = TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0.5 })
	t:Play()
	t.Completed:Connect(function()
		frame.Visible = false
		scale.Scale = 1
	end)
end
function HUD.toggle(name)
	local frame = panels[name]
	if not frame then
		return
	end
	if frame.Visible then
		HUD.hide(frame)
	else
		if rebuilders[name] then
			rebuilders[name]()
		end
		HUD.show(frame)
	end
end

local function rarityOf(petId)
	return Config.RarityById[Config.PetById[petId].rarity]
end

-- Tuile de pet (portrait 3D sur fond de rarete)
local function petTile(parent, pet, order, opts)
	opts = opts or {}
	local rarity = rarityOf(pet.id)
	local evo = Config.Evolutions[pet.evo or 1]
	local tile = new(&quot;TextButton&quot;, { Text = &quot;&quot;, AutoButtonColor = false, BackgroundColor3 = rarity.color, LayoutOrder = order, BorderSizePixel = 0, ZIndex = 12 }, parent)
	corner(tile, 16)
	gradient(tile, lighten(rarity.color, 0.35), darken(rarity.color, 0.3), 90)
	stroke(tile, opts.selected and WHITE or DARK, opts.selected and 4 or 3)
	if evo.id ~= &quot;Normal&quot; then
		local g = new(&quot;Frame&quot;, { Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4), BackgroundTransparency = 1, ZIndex = 12 }, tile)
		corner(g, 14)
		new(&quot;UIStroke&quot;, { Color = evo.color, Thickness = 3, Transparency = 0.1 }, g)
	end
	Portrait.new(tile, pet.id, pet.evo, { Size = UDim2.new(1, -10, 0.72, 0), Position = UDim2.new(0.5, 0, 0, 4), AnchorPoint = Vector2.new(0.5, 0), ZIndex = 13 }, { silhouette = opts.silhouette })
	text({ Size = UDim2.new(1, -8, 0.2, 0), Position = UDim2.new(0.5, 0, 1, -4), AnchorPoint = Vector2.new(0.5, 1), Text = opts.label or pet.id, ZIndex = 14 }, tile)
	if evo.id ~= &quot;Normal&quot; then
		local badge = text({ Size = UDim2.fromOffset(60, 18), Position = UDim2.new(0, 4, 0, 4), Text = evo.name, TextColor3 = evo.color, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 15 }, tile)
		badge.Rotation = -6
	end
	if opts.equipped then
		local check = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(26, 26), Position = UDim2.new(1, -4, 0, 4), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = GREEN, ZIndex = 15 }, tile)
		corner(check, 13)
		stroke(check, DARK, 2.5)
		text({ Size = UDim2.fromScale(1, 1), Text = &quot;E&quot;, ZIndex = 16 }, check)
	end
	if opts.silhouette then
		Icons.Image(&quot;lock&quot;, tile, { Size = UDim2.fromOffset(34, 34), Position = UDim2.new(1, -4, 0, 4), AnchorPoint = Vector2.new(1, 0), ZIndex = 15 })
	end
	bouncy(tile)
	return tile
end

local function statRow(parent, y, iconName, label, value, max, color)
	Icons.Image(iconName, parent, { Size = UDim2.fromOffset(30, 30), Position = UDim2.new(0, 8, 0, y), ZIndex = 13 })
	local bg = new(&quot;Frame&quot;, { Size = UDim2.new(1, -96, 0, 16), Position = UDim2.new(0, 44, 0, y + 7), BackgroundColor3 = DARK, BackgroundTransparency = 0.3, BorderSizePixel = 0, ZIndex = 13 }, parent)
	corner(bg, 8)
	local fill = new(&quot;Frame&quot;, { Size = UDim2.fromScale(math.clamp(value / max, 0.04, 1), 1), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 14 }, bg)
	corner(fill, 8)
	gradient(fill, lighten(color, 0.3), darken(color, 0.1), 90)
	text({ Size = UDim2.fromOffset(44, 22), Position = UDim2.new(1, -48, 0, y + 4), Text = fmt(value), ZIndex = 14, TextXAlignment = Enum.TextXAlignment.Right }, parent)
end

-- Construction du HUD --------------------------------------------------------------------

local function statPill(parent, order, iconName, color)
	local f = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(230, 58), BackgroundColor3 = color, LayoutOrder = order, BorderSizePixel = 0 }, parent)
	corner(f, 29)
	gradient(f, lighten(color, 0.2), darken(color, 0.35), 90)
	stroke(f, DARK, 3)
	local icon = Icons.Image(iconName, f, { Size = UDim2.fromOffset(70, 70), Position = UDim2.new(0, -14, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 3 })
	local t = text({ Size = UDim2.new(1, -72, 0.72, 0), Position = UDim2.new(0, 62, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Text = &quot;0&quot;, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 3 }, f, DARK, 3)
	return f, t, icon
end

local function menuButton(parent, order, iconName, size, onClick)
	local holder = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, LayoutOrder = order }, parent)
	local b = Icons.Button(iconName, holder, { Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5) })
	bouncy(b)
	b.Activated:Connect(function()
		pop(b, 0.85)
		onClick()
	end)
	local badge = new(&quot;Frame&quot;, { Name = &quot;Badge&quot;, Size = UDim2.fromOffset(30, 30), Position = UDim2.new(1, -6, 0, 6), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = RED, Visible = false, ZIndex = 5 }, holder)
	corner(badge, 15)
	stroke(badge, WHITE, 3)
	text({ Size = UDim2.fromScale(1, 1), Text = &quot;!&quot;, ZIndex = 6 }, badge, DARK, 2)
	table.insert(ui.floaters, b)
	return b, badge
end

local function build()
	local gui = new(&quot;ScreenGui&quot;, { Name = &quot;PetHUD&quot;, ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, playerGui)
	ui.gui = gui
	ui.floaters = {}

	-- Stats (gauche)
	local stats = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(240, 210), Position = UDim2.new(0, 24, 0.5, -150), AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1 }, gui)
	new(&quot;UIListLayout&quot;, { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder }, stats)
	ui.coinPill, ui.coinText, ui.coinIcon = statPill(stats, 1, &quot;coin&quot;, Color3.fromRGB(255, 170, 30))
	ui.powerPill, ui.powerText = statPill(stats, 2, &quot;power&quot;, Color3.fromRGB(255, 90, 60))
	ui.petPill, ui.petText = statPill(stats, 3, &quot;paw&quot;, Color3.fromRGB(170, 100, 255))

	-- Boutons secondaires (gauche, sous les stats)
	local left = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(200, 200), Position = UDim2.new(0, 18, 0.5, 30), BackgroundTransparency = 1 }, gui)
	new(&quot;UIGridLayout&quot;, { CellSize = UDim2.fromOffset(96, 96), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }, left)
	menuButton(left, 1, &quot;race&quot;, 96, function()
		HUD.toggle(&quot;Race&quot;)
	end)
	ui.dailyButton, ui.dailyBadge = menuButton(left, 2, &quot;daily&quot;, 96, function()
		Remotes.Pets:FireServer(&quot;daily&quot;)
	end)
	menuButton(left, 3, &quot;leaderboard&quot;, 96, function()
		HUD.toggle(&quot;Leaderboard&quot;)
	end)
	menuButton(left, 4, &quot;codes&quot;, 96, function()
		HUD.toggle(&quot;Codes&quot;)
	end)
	ui.dailyTimer = text({ Size = UDim2.fromOffset(96, 20), Position = UDim2.new(0, 120, 0.5, 132), Text = &quot;&quot;, ZIndex = 5 }, gui)

	-- Menu principal (droite)
	local right = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(120, 500), Position = UDim2.new(1, -18, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1 }, gui)
	new(&quot;UIListLayout&quot;, { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center }, right)
	menuButton(right, 1, &quot;pets&quot;, 116, function()
		HUD.toggle(&quot;Pets&quot;)
	end)
	menuButton(right, 2, &quot;eggs&quot;, 116, function()
		HUD.openEgg(HUD.currentZoneEgg())
	end)
	menuButton(right, 3, &quot;index&quot;, 116, function()
		HUD.toggle(&quot;Index&quot;)
	end)
	menuButton(right, 4, &quot;worlds&quot;, 116, function()
		HUD.toggle(&quot;Worlds&quot;)
	end)

	-- Pets equipes (bas centre)
	ui.equipBar = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(360, 96), Position = UDim2.new(0.5, 0, 1, -14), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1 }, gui)
	new(&quot;UIListLayout&quot;, { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, ui.equipBar)

	-- Nom de zone (haut centre)
	ui.zoneBanner = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(320, 50), Position = UDim2.new(0.5, 0, 0, 10), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = GREEN, BorderSizePixel = 0 }, gui)
	corner(ui.zoneBanner, 25)
	ui.zoneGradient = gradient(ui.zoneBanner, lighten(GREEN, 0.3), darken(GREEN, 0.3), 90)
	stroke(ui.zoneBanner, DARK, 4)
	ui.zoneText = text({ Size = UDim2.new(1, -24, 0.8, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Text = &quot;Starter Village&quot; }, ui.zoneBanner, DARK, 3)

	-- Notifications
	ui.toasts = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(640, 260), Position = UDim2.new(0.5, 0, 0, 70), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1 }, gui)
	new(&quot;UIListLayout&quot;, { HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, ui.toasts)

	-- Course en direct
	ui.raceLive = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(300, 190), Position = UDim2.new(1, -150, 0, 14), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = GOLD, Visible = false, BorderSizePixel = 0 }, gui)
	corner(ui.raceLive, 20)
