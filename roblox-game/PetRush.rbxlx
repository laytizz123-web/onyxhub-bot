end

draw.timer = function(p)
	local c = circle(p, 0.5, 0.56, 0.74, Color3.fromRGB(240, 240, 250))
	outline(c, 3)
	shape(p, 0.5, 0.14, 0.2, 0.12, Color3.fromRGB(200, 200, 215), UDim.new(0.3, 0), 3)
	local hand = shape(p, 0.54, 0.5, 0.07, 0.28, BLACK, UDim.new(0.5, 0), 4, -40)
	hand.AnchorPoint = Vector2.new(0.5, 1)
	shape(p, 0.5, 0.56, 0.08, 0.08, BLACK, CIRCLE, 5)
end


-- Equivalent vectoriel (repli) pour les icones de la planche
local FALLBACK = {
	index = &quot;paw&quot;, eggs = &quot;egg&quot;, pets = &quot;paw&quot;, shop = &quot;chest&quot;, rewards = &quot;gift&quot;, worlds = &quot;map&quot;, race = &quot;flag&quot;,
	leaderboard = &quot;trophy&quot;, trading = &quot;star&quot;, quests = &quot;book&quot;, settings = &quot;star&quot;, inventory = &quot;chest&quot;,
	teleport = &quot;gem&quot;, daily = &quot;gift&quot;, codes = &quot;star&quot;, ranks = &quot;crown&quot;, achievements = &quot;trophy&quot;, freegift = &quot;gift&quot;,
	events = &quot;star&quot;, exit = &quot;close&quot;, coin = &quot;coin&quot;, speed = &quot;bolt&quot;, power = &quot;power&quot;, stamina = &quot;shield&quot;,
	luck = &quot;clover&quot;, lock = &quot;lock&quot;, gem = &quot;gem&quot;, star = &quot;star&quot;, close = &quot;close&quot;, paw = &quot;paw&quot;, egg = &quot;egg&quot;,
}

-- Decodage des icones integrees (IconData) vers EditableImage ---------------------------

local AssetService = game:GetService(&quot;AssetService&quot;)
local RunService = game:GetService(&quot;RunService&quot;)

local IconData = nil
local PetImageData = nil
local editableCache = {} -- [name] = Content | false
local editableSupported = RunService:IsClient()

local B64 = {}
do
	local chars = &quot;ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/&quot;
	for i = 1, #chars do
		B64[string.byte(chars, i)] = i - 1
	end
end

local function b64decode(s)
	local len = #s
	local pad = 0
	if string.sub(s, -2) == &quot;==&quot; then
		pad = 2
	elseif string.sub(s, -1) == &quot;=&quot; then
		pad = 1
	end
	local outLen = (len // 4) * 3 - pad
	local out = buffer.create(outLen)
	local o = 0
	for i = 1, len, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local n = bit32.lshift(B64[a], 18) + bit32.lshift(B64[b], 12) + bit32.lshift(B64[c] or 0, 6) + (B64[d] or 0)
		if o &lt; outLen then
			buffer.writeu8(out, o, bit32.extract(n, 16, 8))
		end
		if o + 1 &lt; outLen then
			buffer.writeu8(out, o + 1, bit32.extract(n, 8, 8))
		end
		if o + 2 &lt; outLen then
			buffer.writeu8(out, o + 2, bit32.extract(n, 0, 8))
		end
		o += 3
	end
	return out
end

local function buildEditable(name)
	if editableCache[name] ~= nil then
		return editableCache[name]
	end
	editableCache[name] = false
	if not editableSupported then
		return false
	end
	local entry
	if string.sub(name, 1, 4) == &quot;pet_&quot; then
		if not PetImageData then
			local ok, data = pcall(require, script.Parent:WaitForChild(&quot;PetImageData&quot;, 5))
			PetImageData = ok and data or {}
		end
		entry = PetImageData[string.sub(name, 5)]
	else
		if not IconData then
			local ok, data = pcall(require, script.Parent:WaitForChild(&quot;IconData&quot;, 5))
			IconData = ok and data or {}
		end
		entry = IconData[name]
	end
	if not entry then
		return false
	end
	local ok, content = pcall(function()
		local size = entry.size
		local palette = b64decode(entry.palette)
		local rle = b64decode(entry.data)
		local pixels = buffer.create(size * size * 4)
		local o = 0
		for i = 0, buffer.len(rle) - 2, 2 do
			local run = buffer.readu8(rle, i)
			local color = buffer.readu32(palette, buffer.readu8(rle, i + 1) * 4)
			for _ = 1, run do
				buffer.writeu32(pixels, o, color)
				o += 4
			end
		end
		local image = AssetService:CreateEditableImage({ Size = Vector2.new(size, size) })
		image:WritePixelsBuffer(Vector2.zero, Vector2.new(size, size), pixels)
		return Content.fromObject(image)
	end)
	if ok and content then
		editableCache[name] = content
		return content
	end
	warn(&quot;[PetRush] Icone integree indisponible (&quot; .. name .. &quot;) : &quot; .. tostring(content) .. &quot;. Repli sur l'icone vectorielle.&quot;)
	editableSupported = false
	return false
end

-- Applique une icone sur une ImageLabel / ImageButton existante.
function Icons.Apply(target, name, color)
	for _, child in ipairs(target:GetChildren()) do
		if child.Name == &quot;VectorIcon&quot; then
			child:Destroy()
		end
	end
	local asset = Config.IconImages and Config.IconImages[name]
	if string.sub(name, 1, 4) == &quot;pet_&quot; then
		asset = Config.PetImages and Config.PetImages[string.sub(name, 5)]
	end
	if asset and asset ~= &quot;&quot; then
		target.Image = asset
		return target
	end
	local content = buildEditable(name)
	if content then
		local ok = pcall(function()
			target.Image = &quot;&quot;
			target.ImageContent = content
		end)
		if ok then
			return target
		end
		editableSupported = false
	end
	target.Image = &quot;&quot;
	local holder = el(&quot;Frame&quot;, { Name = &quot;VectorIcon&quot;, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = target.ZIndex }, target)
	el(&quot;UIAspectRatioConstraint&quot;, { AspectRatio = 1 }, holder)
	local painter = draw[FALLBACK[name] or name] or draw.star
	painter(holder, color)
	return target
end

-- Cree une ImageLabel avec l'icone. props : proprietes de l'ImageLabel (Size, Position...).
function Icons.Image(name, parent, props, color)
	local label = Instance.new(&quot;ImageLabel&quot;)
	label.Name = &quot;Icon_&quot; .. name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.ScaleType = Enum.ScaleType.Fit
	for k, v in pairs(props or {}) do
		label[k] = v
	end
	Icons.Apply(label, name, color)
	label.Parent = parent
	return label
end

-- Cree un ImageButton avec l'icone.
function Icons.Button(name, parent, props, color)
	local b = Instance.new(&quot;ImageButton&quot;)
	b.Name = &quot;IconButton_&quot; .. name
	b.BackgroundTransparency = 1
	b.BorderSizePixel = 0
	b.ScaleType = Enum.ScaleType.Fit
	b.AutoButtonColor = false
	for k, v in pairs(props or {}) do
		b[k] = v
	end
	Icons.Apply(b, name, color)
	b.Parent = parent
	return b
end

-- Vrai si l'image `name` peut etre affichee (ID uploade ou image integree)
function Icons.HasImage(name)
	local asset = Config.IconImages and Config.IconImages[name]
	if string.sub(name, 1, 4) == &quot;pet_&quot; then
		asset = Config.PetImages and Config.PetImages[string.sub(name, 5)]
	end
	if asset and asset ~= &quot;&quot; then
		return true
	end
	return buildEditable(name) ~= false
end

-- Image d'un pet. Retourne nil si l'image n'est pas disponible (l'appelant utilise alors le modele 3D).
function Icons.PetImage(petId, parent, props)
	local name = &quot;pet_&quot; .. petId
	if not Icons.HasImage(name) then
		return nil
	end
	local label = Icons.Image(name, parent, props)
	if label:FindFirstChild(&quot;VectorIcon&quot;) then
		label:Destroy()
		return nil
	end
	return label
end

-- Gemme teintee a la couleur de la rarete
function Icons.Rarity(rarityId, parent, props)
	local rarity = Config.RarityById[rarityId]
	local label = Icons.Image(&quot;gem&quot;, parent, props, rarity and rarity.color)
	label.ImageColor3 = rarity and rarity.color or Color3.new(1, 1, 1)
	return label
end

-- Le dessin vectoriel en anneau doit garder son contour : expose pour d'autres modules
Icons.Draw = draw

return Icons
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">PetAnimator</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Animations procedurales des pets 3D : idle, marche, course, saut, vol et petits mouvements.
-- Chaque Part est rattachee a un groupe (prefixe de son nom). Les groupes tournent autour des pivots
-- definis dans PetRigs. Tout est calcule en une passe et applique avec workspace:BulkMoveTo.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local PetRigs = require(ReplicatedStorage.Shared.PetRigs)

local PetAnimator = {}
PetAnimator.__index = PetAnimator

local rad = math.rad
local sin = math.sin
local cos = math.cos

local DEFAULT_PARENT = {
	Head = &quot;Body&quot;,
	Tail = &quot;Body&quot;,
	WingL = &quot;Body&quot;,
	WingR = &quot;Body&quot;,
	EarL = &quot;Head&quot;,
	EarR = &quot;Head&quot;,
	Fx = &quot;Body&quot;,
}
local ORDER = { &quot;Body&quot;, &quot;Head&quot;, &quot;EarL&quot;, &quot;EarR&quot;, &quot;Tail&quot;, &quot;WingL&quot;, &quot;WingR&quot;, &quot;LegFL&quot;, &quot;LegFR&quot;, &quot;LegBL&quot;, &quot;LegBR&quot;, &quot;Fx&quot; }

function PetAnimator.new(model, petId)
	local self = setmetatable({}, PetAnimator)
	local rig = PetRigs[petId] or { kind = &quot;quad&quot;, hover = 0, pivots = {}, parents = {} }
	local scale = model:GetAttribute(&quot;PetScale&quot;) or 1
	self.model = model
	self.kind = rig.kind
	self.hover = (rig.hover or 0) * scale
	self.scale = scale
	self.phase = math.random() * 10
	self.pivots = {}
	for name, p in pairs(rig.pivots or {}) do
		self.pivots[name] = p * scale
	end
	self.parents = {}
	for _, g in ipairs(ORDER) do
		self.parents[g] = (rig.parents and rig.parents[g]) or DEFAULT_PARENT[g]
	end
	local pivot = model:GetPivot()
	self.parts = {}
	self.offsets = {}
	self.groups = {}
	self.rainbow = {}
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA(&quot;BasePart&quot;) then
			table.insert(self.parts, part)
			table.insert(self.offsets, pivot:ToObjectSpace(part.CFrame))
			local group = string.match(part.Name, &quot;^(%w+)&quot;) or &quot;Body&quot;
			if not self.parents[group] and not string.match(group, &quot;^Leg&quot;) and group ~= &quot;Body&quot; then
				group = &quot;Body&quot;
			end
			table.insert(self.groups, group)
			if part:GetAttribute(&quot;Rainbow&quot;) then
				table.insert(self.rainbow, part)
			end
		end
	end
	self.cframes = table.create(#self.parts)
	-- modele d'une seule piece (importe) : animation par sauts et ecrasement
	self.simple = model:GetAttribute(&quot;SimplePet&quot;) == true
	if self.simple then
		self.sizes = {}
		for i, part in ipairs(self.parts) do
			self.sizes[i] = part.Size
		end
		self.glow = model:FindFirstChild(&quot;EvolutionGlow&quot;)
	end
	self.hopPhase = 0
	self.blink = 0
	self.nextBlink = os.clock() + math.random(2, 5)
	return self
end

local function around(pivot, rotation)
	if not pivot then
		return rotation
	end
	return CFrame.new(pivot) * rotation * CFrame.new(-pivot)
end

-- Animation &quot;sautillante&quot; pour les modeles d'une seule piece
function PetAnimator:updateSimple(rootCF, state, now, dt)
	local t = now + self.phase
	local s = self.scale
	local airborne = self.kind == &quot;fly&quot; or self.kind == &quot;float&quot;
	local moving = state == &quot;walk&quot; or state == &quot;run&quot;
	local y, pitch, roll, yawWobble = 0, 0, 0, 0
	local sx, sy = 1, 1
	if airborne then
		y = sin(t * 2.2) * 0.35 * s
		pitch = moving and -12 or sin(t * 1.3) * 4
		roll = sin(t * 1.6) * 6
		sy = 1 + sin(t * 4.4) * 0.03
	elseif moving or state == &quot;jump&quot; then
		-- bonds successifs : arc de saut + ecrasement a l'atterrissage
		local rate = state == &quot;run&quot; and 9 or 6.5
		self.hopPhase = (self.hopPhase + dt * rate) % (math.pi)
		local h = sin(self.hopPhase)
		local height = (state == &quot;run&quot; and 1.3 or 0.9) * s
		if state == &quot;jump&quot; then
			height = 1.8 * s
		end
		y = h * height
		local landing = math.max(0, 1 - self.hopPhase / 0.6) + math.max(0, (self.hopPhase - (math.pi - 0.45)) / 0.45)
		sy = 1 - 0.18 * landing + 0.08 * h
		sx = 1 + 0.12 * landing - 0.04 * h
		pitch = -h * 10
		roll = sin(t * rate * 0.5) * 6
	else
		-- repos : respiration, petit balancement, regarde autour
		sy = 1 + sin(t * 2.6) * 0.035
		sx = 1 - sin(t * 2.6) * 0.02
		roll = sin(t * 0.9) * 4
		yawWobble = sin(t * 0.55) * 14
		self.hopPhase = 0
	end
	local base = rootCF * CFrame.new(0, y, 0) * CFrame.Angles(0, rad(yawWobble), 0) * CFrame.Angles(rad(pitch), 0, rad(roll))
	local cframes = self.cframes
	for i, part in ipairs(self.parts) do
		local off = self.offsets[i]
		local p = off.Position
		cframes[i] = base * CFrame.new(p.X * sx, p.Y * sy, p.Z * sx) * off.Rotation
		local size = self.sizes[i]
		part.Size = Vector3.new(size.X * sx, size.Y * sy, size.Z * sx)
	end
	workspace:BulkMoveTo(self.parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	if self.glow and self.glow:GetAttribute(&quot;Rainbow&quot;) then
		local c = Color3.fromHSV((now * 0.3) % 1, 0.7, 1)
		self.glow.OutlineColor = c
		self.glow.FillColor = c
	end
end

-- state : &quot;idle&quot; | &quot;walk&quot; | &quot;run&quot; | &quot;jump&quot; ; speed : vitesse du proprietaire (studs/s)
function PetAnimator:update(rootCF, state, now)
	local dt = now - (self.lastUpdate or now)
	self.lastUpdate = now
	if self.simple then
		return self:updateSimple(rootCF, state, now, math.clamp(dt, 0, 0.1))
	end
	local t = now + self.phase
	local s = self.scale
	local kind = self.kind
	local moving = state == &quot;walk&quot; or state == &quot;run&quot;
	local stride = state == &quot;run&quot; and 15 or 10
	local legAmp = (state == &quot;run&quot; and 50) or (state == &quot;walk&quot; and 32) or 0

	local local_ = {}
	-- Corps : respiration, rebond de marche, inclinaison en course
	local bob, lean, roll = 0, 0, 0
	if kind == &quot;fly&quot; or kind == &quot;float&quot; then
		bob = sin(t * 2.2) * 0.25 * s
		lean = moving and -12 or sin(t * 1.3) * 3
		roll = sin(t * 1.1) * 4
	elseif kind == &quot;slither&quot; then
		bob = sin(t * 2) * 0.05 * s
		roll = moving and sin(t * 6) * 10 or sin(t * 1.5) * 4
	else
		if moving then
			bob = math.abs(sin(t * stride)) * (state == &quot;run&quot; and 0.32 or 0.18) * s
			lean = state == &quot;run&quot; and -8 or -3
			roll = sin(t * stride) * 3
		else
			bob = (sin(t * 2.4) * 0.5 + 0.5) * 0.06 * s
		end
	end
	if state == &quot;jump&quot; then
		lean = 10
	end
	local bodyPivot = self.pivots.Body
	local yaw = 0
	if kind == &quot;slither&quot; then
		yaw = moving and sin(t * 6) * 12 or 0
	end
	local_.Body = CFrame.new(0, bob, 0) * around(bodyPivot, CFrame.Angles(rad(lean), rad(yaw), rad(roll)))

	-- Tete : regarde autour en idle, hoche la tete en marchant
	local headYaw, headPitch, headRoll
	if moving then
		headYaw = sin(t * 1.5) * 6
		headPitch = sin(t * stride * 2) * (state == &quot;run&quot; and 6 or 4)
		headRoll = 0
	else
		headYaw = sin(t * 0.6) * 22 + sin(t * 1.7) * 6
		headPitch = sin(t * 0.9) * 6
		headRoll = sin(t * 0.75) * 8
	end
	if kind == &quot;slither&quot; then
		headYaw = headYaw * 0.6 - yaw * 1.2
	end
	if state == &quot;jump&quot; then
		headPitch = -10
	end
	local_.Head = around(self.pivots.Head, CFrame.Angles(rad(headPitch), rad(headYaw), rad(headRoll)))

	-- Oreilles : petits frissons de temps en temps
	local twitch = math.max(0, sin(t * 0.9) - 0.92) * 220
	local_.EarL = around(self.pivots.EarL, CFrame.Angles(0, 0, rad(-twitch - (moving and sin(t * stride) * 6 or 0))))
	local_.EarR = around(self.pivots.EarR, CFrame.Angles(0, 0, rad(twitch + (moving and sin(t * stride) * 6 or 0))))

	-- Queue : remue
	local wagSpeed = moving and 12 or 5
	local wagAmp = (kind == &quot;crawl&quot;) and 6 or (moving and 26 or 16)
	if kind == &quot;crawl&quot; then
		local_.Tail = around(self.pivots.Tail, CFrame.Angles(rad(sin(t * 3) * 8), rad(sin(t * 2) * wagAmp), 0))
	elseif kind == &quot;float&quot; then
		local_.Tail = around(self.pivots.Tail, CFrame.Angles(rad(sin(t * 2) * 10), rad(sin(t * 1.6) * 20), 0))
	else
		local_.Tail = around(self.pivots.Tail, CFrame.Angles(rad(state == &quot;jump&quot; and -20 or 0), rad(sin(t * wagSpeed) * wagAmp), 0))
	end

	-- Ailes : battent (plus vite en mouvement)
	local flapRate = (kind == &quot;fly&quot;) and (moving and 16 or 9) or 5
	local flapAmp = (kind == &quot;fly&quot;) and (moving and 40 or 28) or 10
	if state == &quot;jump&quot; then
		flapRate, flapAmp = 18, 45
	end
	local flap = sin(t * flapRate) * flapAmp
	local_.WingL = around(self.pivots.WingL, CFrame.Angles(0, 0, rad(-flap)))
	local_.WingR = around(self.pivots.WingR, CFrame.Angles(0, 0, rad(flap)))

	-- Pattes
	local swing = sin(t * stride) * legAmp
	if kind == &quot;crawl&quot; then
		swing = sin(t * (moving and 22 or 3)) * (moving and 22 or 4)
	end
	local tuck = state == &quot;jump&quot; and 35 or 0
	if kind == &quot;fly&quot; or kind == &quot;float&quot; then
		swing = sin(t * 2) * 8
		tuck = 15
	end
	local_.LegFL = around(self.pivots.LegFL, CFrame.Angles(rad(swing - tuck), 0, 0))
	local_.LegBR = around(self.pivots.LegBR, CFrame.Angles(rad(swing + tuck), 0, 0))
	local_.LegFR = around(self.pivots.LegFR, CFrame.Angles(rad(-swing - tuck), 0, 0))
	local_.LegBL = around(self.pivots.LegBL, CFrame.Angles(rad(-swing + tuck), 0, 0))
	local_.Fx = CFrame.new()

	-- Compose la hierarchie
	local world = {}
	for _, g in ipairs(ORDER) do
		local parent = self.parents[g]
		local l = local_[g] or CFrame.new()
		if parent and world[parent] then
			world[g] = world[parent] * l
		else
			world[g] = l
		end
	end

	local cframes = self.cframes
	for i, part in ipairs(self.parts) do
		cframes[i] = rootCF * (world[self.groups[i]] or world.Body) * self.offsets[i]
	end
	workspace:BulkMoveTo(self.parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)

	if #self.rainbow &gt; 0 then
		local color = Color3.fromHSV((now * 0.25 + self.phase) % 1, 0.55, 1)
		for _, part in ipairs(self.rainbow) do
			part.Color = color
		end
	end
end

function PetAnimator:destroy()
	self.model:Destroy()
end

return PetAnimator
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">PetModel</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Modeles 3D des pets.
-- Source : ReplicatedStorage.Pets.&lt;Nom&gt; (19 modeles generes par tools/build_pets3d.py, modifiables dans Studio).
-- Chaque Part s'appelle &quot;&lt;Groupe&gt;.&lt;role&gt;&quot; : le groupe sert aux animations (voir PetAnimator),
-- le role aux evolutions (base et accent sont recolores, eye / detail / glow sont conserves).
-- Si un modele manque, un modele simplifie est construit par code (secours).

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Config = require(ReplicatedStorage.Shared.Config)

local PetModel = {}

local function part(model, props)
	local p = Instance.new(&quot;Part&quot;)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = model
	return p
end

local function ball(model, cf, size, color, material, name)
	return part(model, { Name = name or &quot;Body&quot;, Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), CFrame = cf, Color = color, Material = material })
end

local function eyes(model, cf, spread, height, forward, size)
	for _, x in ipairs({ -spread, spread }) do
		part(model, { Name = &quot;Eye&quot;, Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), CFrame = cf * CFrame.new(x, height, -forward), Color = Color3.new(0, 0, 0), Material = Enum.Material.SmoothPlastic })
	end
end

local shapes = {}

shapes.cat = function(m, cf, color, mat)
	ball(m, cf, 1.6, color, mat)
	ball(m, cf * CFrame.new(0, 0.9, -0.6), 1.2, color, mat, &quot;Head&quot;)
	for _, x in ipairs({ -0.4, 0.4 }) do
		part(m, { Name = &quot;Ear&quot;, Size = Vector3.new(0.35, 0.5, 0.2), CFrame = cf * CFrame.new(x, 1.6, -0.6) * CFrame.Angles(0, 0, x &gt; 0 and -0.3 or 0.3), Color = color, Material = mat })
	end
	part(m, { Name = &quot;Tail&quot;, Size = Vector3.new(0.25, 1.2, 0.25), CFrame = cf * CFrame.new(0, 0.6, 0.9) * CFrame.Angles(0.5, 0, 0), Color = color, Material = mat })
	eyes(m, cf, 0.28, 1, 1.1, 0.22)
end

shapes.dog = function(m, cf, color, mat)
	part(m, { Size = Vector3.new(1.3, 1.1, 1.9), CFrame = cf, Color = color, Material = mat })
	ball(m, cf * CFrame.new(0, 0.8, -1), 1.2, color, mat, &quot;Head&quot;)
	for _, x in ipairs({ -0.55, 0.55 }) do
		part(m, { Name = &quot;Ear&quot;, Size = Vector3.new(0.25, 0.7, 0.4), CFrame = cf * CFrame.new(x, 0.9, -1), Color = color:Lerp(Color3.new(0, 0, 0), 0.25), Material = mat })
	end
	for _, pos in ipairs({ Vector3.new(-0.45, -0.7, -0.6), Vector3.new(0.45, -0.7, -0.6), Vector3.new(-0.45, -0.7, 0.6), Vector3.new(0.45, -0.7, 0.6) }) do
		part(m, { Name = &quot;Leg&quot;, Size = Vector3.new(0.35, 0.6, 0.35), CFrame = cf * CFrame.new(pos), Color = color, Material = mat })
	end
	eyes(m, cf, 0.28, 0.9, 1.5, 0.22)
end

shapes.bunny = function(m, cf, color, mat)
	ball(m, cf, 1.4, color, mat)
	ball(m, cf * CFrame.new(0, 0.9, -0.4), 1.1, color, mat, &quot;Head&quot;)
	for _, x in ipairs({ -0.3, 0.3 }) do
		part(m, { Name = &quot;Ear&quot;, Size = Vector3.new(0.3, 1.2, 0.2), CFrame = cf * CFrame.new(x, 1.9, -0.4) * CFrame.Angles(0, 0, x &gt; 0 and -0.15 or 0.15), Color = color, Material = mat })
	end
	ball(m, cf * CFrame.new(0, 0, 0.8), 0.5, Color3.new(1, 1, 1), mat, &quot;Tail&quot;)
	eyes(m, cf, 0.26, 1, 0.9, 0.2)
end

shapes.bird = function(m, cf, color, mat)
	ball(m, cf, 1.4, color, mat)
	ball(m, cf * CFrame.new(0, 0.9, -0.3), 1, color, mat, &quot;Head&quot;)
	for _, x in ipairs({ -0.9, 0.9 }) do
		part(m, { Name = &quot;Wing&quot;, Size = Vector3.new(0.8, 0.2, 1), CFrame = cf * CFrame.new(x, 0.2, 0) * CFrame.Angles(0, 0, x &gt; 0 and -0.4 or 0.4), Color = color:Lerp(Color3.new(1, 1, 1), 0.2), Material = mat })
	end
	part(m, { Name = &quot;Beak&quot;, Size = Vector3.new(0.3, 0.25, 0.5), CFrame = cf * CFrame.new(0, 0.8, -0.9), Color = Color3.fromRGB(255, 180, 40), Material = Enum.Material.SmoothPlastic })
	eyes(m, cf, 0.25, 1, 0.75, 0.2)
end

shapes.dragon = function(m, cf, color, mat)
	part(m, { Size = Vector3.new(1.4, 1.2, 2.2), CFrame = cf, Color = color, Material = mat })
	ball(m, cf * CFrame.new(0, 0.9, -1.2), 1.2, color, mat, &quot;Head&quot;)
	for _, x in ipairs({ -1.1, 1.1 }) do
		part(m, { Name = &quot;Wing&quot;, Size = Vector3.new(1.4, 0.15, 1.2), CFrame = cf * CFrame.new(x, 0.9, 0.2) * CFrame.Angles(0, 0, x &gt; 0 and -0.6 or 0.6), Color = color:Lerp(Color3.new(0, 0, 0), 0.3), Material = mat })
	end
	for _, x in ipairs({ -0.35, 0.35 }) do
		part(m, { Name = &quot;Horn&quot;, Size = Vector3.new(0.2, 0.6, 0.2), CFrame = cf * CFrame.new(x, 1.7, -1.1) * CFrame.Angles(0, 0, x &gt; 0 and -0.3 or 0.3), Color = Color3.fromRGB(240, 240, 220), Material = Enum.Material.SmoothPlastic })
	end
	part(m, { Name = &quot;Tail&quot;, Size = Vector3.new(0.4, 0.4, 1.6), CFrame = cf * CFrame.new(0, 0, 1.8) * CFrame.Angles(0.3, 0, 0), Color = color, Material = mat })
	eyes(m, cf, 0.3, 1, 1.7, 0.24)
end

shapes.snake = function(m, cf, color, mat)
	for i = 0, 4 do
		ball(m, cf * CFrame.new(math.sin(i * 1.2) * 0.4, -0.3 + i * 0.1, i * 0.6 - 0.8), 0.9 - i * 0.08, color, mat, i == 0 and &quot;Head&quot; or &quot;Body&quot;)
	end
	eyes(m, cf * CFrame.new(0, -0.3, -0.8), 0.22, 0.15, 0.4, 0.18)
end

shapes.bear = function(m, cf, color, mat)
	part(m, { Size = Vector3.new(1.8, 1.6, 1.5), CFrame = cf, Color = color, Material = mat })
	ball(m, cf * CFrame.new(0, 1.2, -0.5), 1.4, color, mat, &quot;Head&quot;)
	for _, x in ipairs({ -0.55, 0.55 }) do
		ball(m, cf * CFrame.new(x, 1.9, -0.5), 0.5, color, mat, &quot;Ear&quot;)
	end
	ball(m, cf * CFrame.new(0, 1, -1.1), 0.5, color:Lerp(Color3.new(1, 1, 1), 0.4), mat, &quot;Muzzle&quot;)
	eyes(m, cf, 0.3, 1.35, 1.1, 0.22)
end

shapes.blob = function(m, cf, color, mat)
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(1.8, 1.4, 1.8), CFrame = cf, Color = color, Material = mat })
	ball(m, cf * CFrame.new(0, 1, 0), 0.9, color, mat, &quot;Head&quot;)
	eyes(m, cf, 0.3, 0.3, 0.8, 0.24)
end

-- Retourne un Model anchore centre sur cf. evoIndex : 1 Normal, 2 Golden, 3 Rainbow, 4 Cosmic
local function buildProcedural(petId, evoIndex, cf)
	local def = Config.PetById[petId] or Config.Pets[1]
	local evo = Config.Evolutions[evoIndex or 1] or Config.Evolutions[1]
	local model = Instance.new(&quot;Model&quot;)
	model.Name = def.id
	local color = def.color
	local material = Enum.Material.SmoothPlastic
	if evo.id == &quot;Golden&quot; then
		color = Color3.fromRGB(255, 215, 0)
		material = Enum.Material.Neon
	elseif evo.id == &quot;Rainbow&quot; then
		color = Color3.fromRGB(255, 120, 255)
		material = Enum.Material.Neon
	elseif evo.id == &quot;Cosmic&quot; then
		color = Color3.fromRGB(110, 60, 220)
		material = Enum.Material.Neon
	end
	local builder = shapes[def.shape] or shapes.blob
	builder(model, cf, color, material)
	local rarity = Config.RarityById[def.rarity]
	local scale = 0.9 + (rarity.index - 1) * 0.08
	if scale ~= 1 then
		model:ScaleTo(scale)
	end
	model:SetAttribute(&quot;PetId&quot;, def.id)
	model:SetAttribute(&quot;Evo&quot;, evo.id)
	-- Effets d'evolution
	if evo.id ~= &quot;Normal&quot; then
		local head = model:FindFirstChild(&quot;Head&quot;) or model:FindFirstChildWhichIsA(&quot;BasePart&quot;)
		local att = Instance.new(&quot;Attachment&quot;)
		att.Parent = head
		local e = Instance.new(&quot;ParticleEmitter&quot;)
		e.Rate = evo.id == &quot;Cosmic&quot; and 18 or 8
		e.Lifetime = NumberRange.new(0.6, 1.2)
		e.Speed = NumberRange.new(1, 2)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
		e.Transparency = NumberSequence.new(0.2, 1)
		e.LightEmission = 1
		if evo.id == &quot;Rainbow&quot; then
			e.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 255, 120)), ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 120, 255)) })
		else
			e.Color = ColorSequence.new(evo.color)
		end
		e.Parent = att
	end
	model.PrimaryPart = model:FindFirstChild(&quot;Body&quot;) or model:FindFirstChildWhichIsA(&quot;BasePart&quot;)
	return model
end

-- Modeles 3D de ReplicatedStorage.Pets -----------------------------------------------------

local RARITY_FX = {
	Legendary = { light = 1.2, rate = 6, size = 0.35, speed = 1.5 },
	Mythical = { light = 2, rate = 16, size = 0.45, speed = 3, swirl = true },
	Secret = { light = 3, rate = 24, size = 0.55, speed = 2, aura = true },
}

local function roleOf(part)
	return string.match(part.Name, &quot;%.(%w+)$&quot;) or &quot;base&quot;
end

local function addRarityFx(model, rarity, root, height)
	local fx = RARITY_FX[rarity.id]
	if not fx or not root then
		return
	end
	local att = Instance.new(&quot;Attachment&quot;)
	att.Name = &quot;RarityFx&quot;
	att.Position = Vector3.new(0, 0, 0)
	att.Parent = root
	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = rarity.color
	light.Range = 10
	light.Brightness = fx.light
	light.Shadows = false
	light.Parent = att
	local sparkles = Instance.new(&quot;ParticleEmitter&quot;)
	sparkles.Name = &quot;RaritySparkles&quot;
	sparkles.Rate = fx.rate
	sparkles.Lifetime = NumberRange.new(0.8, 1.4)
	sparkles.Speed = NumberRange.new(fx.speed * 0.5, fx.speed)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, fx.size), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Transparency = NumberSequence.new(0.1, 1)
	sparkles.LightEmission = 1
	sparkles.Color = ColorSequence.new(Color3.new(1, 1, 1), rarity.color)
	if fx.swirl then
		sparkles.RotSpeed = NumberRange.new(-180, 180)
		sparkles.Acceleration = Vector3.new(0, 2, 0)
		sparkles.Shape = Enum.ParticleEmitterShape.Sphere
		sparkles.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		sparkles.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 220, 255)),
			ColorSequenceKeypoint.new(0.5, rarity.color),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 120, 255)),
		})
	end
	sparkles.Parent = att
	if fx.aura then
		-- aura doree : anneau de lumiere au sol + rayons
		local aura = Instance.new(&quot;ParticleEmitter&quot;)
		aura.Name = &quot;SecretAura&quot;
		aura.Rate = 10
		aura.Lifetime = NumberRange.new(1.2, 1.8)
		aura.Speed = NumberRange.new(0.5, 1)
		aura.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(0.5, 2.2), NumberSequenceKeypoint.new(1, 0) })
		aura.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.6), NumberSequenceKeypoint.new(1, 1) })
		aura.LightEmission = 1
		aura.Color = ColorSequence.new(Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 160, 40))
		aura.EmissionDirection = Enum.NormalId.Top
		aura.Acceleration = Vector3.new(0, 3, 0)
		aura.Parent = att
	end
end

local EVO_COLORS = {
	Golden = { base = Color3.fromRGB(255, 200, 55), accent = Color3.fromRGB(255, 232, 140), reflect = 0.2 },
	Rainbow = { base = Color3.fromRGB(255, 120, 220), accent = Color3.fromRGB(255, 220, 245), reflect = 0.05 },
	Cosmic = { base = Color3.fromRGB(70, 40, 170), accent = Color3.fromRGB(150, 110, 255), reflect = 0.1 },
}

local function applyEvolution(model, evo, root)
	local colors = EVO_COLORS[evo.id]
	if not colors then
		return
	end
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA(&quot;BasePart&quot;) then
			local role = roleOf(part)
			if role == &quot;base&quot; then
				part.Color = colors.base
				part.Reflectance = colors.reflect
				part:SetAttribute(&quot;Rainbow&quot;, evo.id == &quot;Rainbow&quot;)
			elseif role == &quot;accent&quot; then
				part.Color = colors.accent
				part.Reflectance = colors.reflect
			end
		end
	end
	if root then
		local att = Instance.new(&quot;Attachment&quot;)
		att.Name = &quot;EvolutionFx&quot;
		att.Parent = root
		local e = Instance.new(&quot;ParticleEmitter&quot;)
		e.Rate = evo.id == &quot;Cosmic&quot; and 14 or 6
		e.Lifetime = NumberRange.new(0.7, 1.2)
		e.Speed = NumberRange.new(1, 2.5)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
		e.LightEmission = 1
		e.Color = ColorSequence.new(evo.color or Color3.new(1, 1, 1))
		e.Parent = att
	end
end

function PetModel.Build(petId, evoIndex, cf)
	cf = cf or CFrame.new()
	local folder = ReplicatedStorage:FindFirstChild(&quot;Pets&quot;)
	-- cherche d'abord directement dans Pets, puis dans un modele importe d'un bloc (ex. TousLesPets)
	local template = folder and (folder:FindFirstChild(petId) or folder:FindFirstChild(petId, true))
	if not template then
		return buildProcedural(petId, evoIndex, cf)
	end
	local def = Config.PetById[petId] or Config.Pets[1]
	local evo = Config.Evolutions[evoIndex or 1] or Config.Evolutions[1]
	local rarity = Config.RarityById[def.rarity]
	local model = template:Clone()
	if model:IsA(&quot;BasePart&quot;) then
		-- piece importee posee seule dans le dossier : on l'emballe dans un Model
		local wrapper = Instance.new(&quot;Model&quot;)
		wrapper.Name = petId
		model.Parent = wrapper
		model = wrapper
	elseif not model:IsA(&quot;Model&quot;) then
		model:Destroy()
		return buildProcedural(petId, evoIndex, cf)
	end
	local root
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA(&quot;BasePart&quot;) then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Massless = true
			if not root and part.Name == &quot;Body.base&quot; then
				root = part
			end
		end
	end
	root = root or model:FindFirstChildWhichIsA(&quot;BasePart&quot;, true)
	model.PrimaryPart = root
	local simple = true
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA(&quot;BasePart&quot;) and string.find(part.Name, &quot;.&quot;, 1, true) then
			simple = false
			break
		end
	end
	if simple then
		-- modele importe : remis debout, pivot au centre du dessous, taille d'environ 4,2 studs
		model.PrimaryPart = nil
		model.WorldPivot = CFrame.new(model:GetBoundingBox().Position)
		local _, rawSize = model:GetBoundingBox() -- boite alignee sur le monde
		local fix = Config.ImportedPetRotation or {}
		local rotation = CFrame.new()
		if rawSize.Y &lt; rawSize.X and rawSize.Y &lt; rawSize.Z then
			-- couche : l'epaisseur (la plus petite dimension) doit etre en profondeur, pas en hauteur
			rotation = CFrame.Angles(math.rad(fix.LyingFix or -90), 0, 0)
		elseif rawSize.X &lt; rawSize.Y and rawSize.X &lt; rawSize.Z then
			-- de profil : on le tourne face a l'avant
			rotation = CFrame.Angles(0, math.rad(90), 0)
		end
		local extra = fix.Extra or Vector3.zero
		rotation = rotation * CFrame.Angles(math.rad(extra.X), math.rad(extra.Y), math.rad(extra.Z))
		model:PivotTo(CFrame.new(model.WorldPivot.Position) * rotation)
		model.WorldPivot = CFrame.new(model:GetBoundingBox().Position)
		model.PrimaryPart = root
		model.PrimaryPart = nil
		local boxCF, boxSize = model:GetBoundingBox()
		model.WorldPivot = CFrame.new(boxCF.Position - Vector3.new(0, boxSize.Y / 2, 0))
		model.PrimaryPart = root
		if boxSize.Y &gt; 7 or boxSize.Y &lt; 2 then
			model:ScaleTo(model:GetScale() * (4.2 / boxSize.Y))
		end
	else
		model.WorldPivot = CFrame.new() -- modeles generes : sol a Y = 0 sous le pet
	end
	local scale = 0.92 + (rarity.index - 1) * 0.05
	if math.abs(scale - 1) &gt; 0.01 then
		model:ScaleTo(model:GetScale() * scale)
	end
	if simple then
		-- modele texture d'une seule piece : l'evolution se voit par un contour lumineux
		local colors = { Golden = Color3.fromRGB(255, 205, 50), Rainbow = Color3.fromRGB(255, 120, 230), Cosmic = Color3.fromRGB(140, 90, 255) }
		if colors[evo.id] then
			local h = Instance.new(&quot;Highlight&quot;)
			h.Name = &quot;EvolutionGlow&quot;
			h.FillColor = colors[evo.id]
			h.FillTransparency = 0.75
			h.OutlineColor = colors[evo.id]
			h.OutlineTransparency = 0
			h.DepthMode = Enum.HighlightDepthMode.Occluded
			h:SetAttribute(&quot;Rainbow&quot;, evo.id == &quot;Rainbow&quot;)
			h.Parent = model
		end
		model:SetAttribute(&quot;SimplePet&quot;, true)
	end
	applyEvolution(model, evo, root)
	addRarityFx(model, rarity, root)
	model:SetAttribute(&quot;PetId&quot;, def.id)
	model:SetAttribute(&quot;Evo&quot;, evo.id)
	model:SetAttribute(&quot;PetScale&quot;, scale)
	model:PivotTo(cf)
	return model
end

-- Stats effectives d'un pet { speed, power, stamina, luck, total }
function PetModel.Stats(petId, evoIndex)
	local def = Config.PetById[petId]
	if not def then
		return { speed = 0, power = 0, stamina = 0, luck = 0 }
	end
	local rarity = Config.RarityById[def.rarity]
	local mult = (Config.Evolutions[evoIndex or 1] or Config.Evolutions[1]).mult
	return {
		speed = def.speed * mult,
		power = rarity.power * mult,
		stamina = def.stamina * mult,
		luck = def.luck * mult,
	}
end

function PetModel.DisplayName(petId, evoIndex)
	local def = Config.PetById[petId]
	local evo = Config.Evolutions[evoIndex or 1]
	if not def then
		return petId
	end
	local name = def.id
	if evo and evo.id ~= &quot;Normal&quot; then
		name = evo.icon .. &quot; &quot; .. evo.name .. &quot; &quot; .. name
	end
	return def.icon .. &quot; &quot; .. name
end

return PetModel
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">PetRigs</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- GENERE AUTOMATIQUEMENT par tools/build_pets3d.py : articulations des modeles 3D des pets.
