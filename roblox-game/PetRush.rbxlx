<Item class="ReplicatedStorage" referent="RBX00000004"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000003"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000000"><Properties><string name="Name">Config</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Configuration centrale de PET RUSH : raretes, pets, oeufs, zones, evolutions, courses.

local Config = {}

Config.GameName = &quot;PET RUSH&quot;
Config.StartCoins = 100
Config.MaxEquipped = 3
Config.MaxPets = 60

Config.Colors = {
	Accent = Color3.fromRGB(80, 200, 255),
	Accent2 = Color3.fromRGB(255, 120, 200),
	Gold = Color3.fromRGB(255, 200, 40),
	Danger = Color3.fromRGB(255, 80, 80),
	Panel = Color3.fromRGB(28, 26, 46),
	Panel2 = Color3.fromRGB(14, 12, 26),
	Grass = Color3.fromRGB(110, 200, 90),
}

Config.Icons = {
	coins = &quot;🪙&quot;, pets = &quot;🐾&quot;, egg = &quot;🥚&quot;, index = &quot;📖&quot;, race = &quot;🏁&quot;, zone = &quot;🗺️&quot;, daily = &quot;🎁&quot;, chest = &quot;🎁&quot;,
	speed = &quot;⚡&quot;, power = &quot;💪&quot;, stamina = &quot;🛡️&quot;, luck = &quot;🍀&quot;, evolve = &quot;🧬&quot;, equip = &quot;✅&quot;, trophy = &quot;🏆&quot;,
	lock = &quot;🔒&quot;, star = &quot;⭐&quot;, info = &quot;ℹ️&quot;, warning = &quot;⚠️&quot;, delete = &quot;🗑️&quot;, leader = &quot;📈&quot;,
}

-- Raretes (ordre croissant)
Config.Rarities = {
	{ id = &quot;Common&quot;, name = &quot;Common&quot;, icon = &quot;⚪&quot;, color = Color3.fromRGB(210, 210, 210), weight = 50, power = 1 },
	{ id = &quot;Uncommon&quot;, name = &quot;Uncommon&quot;, icon = &quot;🟢&quot;, color = Color3.fromRGB(90, 220, 90), weight = 28, power = 2 },
	{ id = &quot;Rare&quot;, name = &quot;Rare&quot;, icon = &quot;🔵&quot;, color = Color3.fromRGB(70, 140, 255), weight = 14, power = 4 },
	{ id = &quot;Epic&quot;, name = &quot;Epic&quot;, icon = &quot;🟣&quot;, color = Color3.fromRGB(190, 90, 255), weight = 6, power = 8 },
	{ id = &quot;Legendary&quot;, name = &quot;Legendary&quot;, icon = &quot;🟡&quot;, color = Color3.fromRGB(255, 210, 50), weight = 1.6, power = 18 },
	{ id = &quot;Mythical&quot;, name = &quot;Mythical&quot;, icon = &quot;🔴&quot;, color = Color3.fromRGB(255, 70, 70), weight = 0.35, power = 45 },
	{ id = &quot;Secret&quot;, name = &quot;Secret&quot;, icon = &quot;🌈&quot;, color = Color3.fromRGB(255, 150, 255), weight = 0.05, power = 120 },
}
Config.RarityById = {}
for i, r in ipairs(Config.Rarities) do
	r.index = i
	Config.RarityById[r.id] = r
end

-- Evolutions : Normal -&gt; Golden -&gt; Rainbow -&gt; Cosmic (3 exemplaires identiques pour evoluer)
Config.Evolutions = {
	{ id = &quot;Normal&quot;, name = &quot;&quot;, icon = &quot;&quot;, mult = 1 },
	{ id = &quot;Golden&quot;, name = &quot;Golden&quot;, icon = &quot;✨&quot;, mult = 2.5, color = Color3.fromRGB(255, 215, 0) },
	{ id = &quot;Rainbow&quot;, name = &quot;Rainbow&quot;, icon = &quot;🌈&quot;, mult = 6, color = Color3.fromRGB(255, 120, 255) },
	{ id = &quot;Cosmic&quot;, name = &quot;Cosmic&quot;, icon = &quot;🌌&quot;, mult = 15, color = Color3.fromRGB(140, 80, 255) },
}
Config.EvolveCost = 3

-- Pets : shape = cat | dog | bunny | bird | dragon | snake | bear | blob
-- speed / stamina / luck : 1 a 10. power vient de la rarete.
Config.Pets = {
	-- Village
	{ id = &quot;Chaton&quot;, icon = &quot;🐱&quot;, rarity = &quot;Common&quot;, egg = &quot;Village&quot;, shape = &quot;cat&quot;, color = Color3.fromRGB(255, 180, 90), speed = 5, stamina = 3, luck = 3 },
	{ id = &quot;Chiot&quot;, icon = &quot;🐶&quot;, rarity = &quot;Common&quot;, egg = &quot;Village&quot;, shape = &quot;dog&quot;, color = Color3.fromRGB(190, 140, 90), speed = 4, stamina = 5, luck = 2 },
	{ id = &quot;Lapin&quot;, icon = &quot;🐰&quot;, rarity = &quot;Uncommon&quot;, egg = &quot;Village&quot;, shape = &quot;bunny&quot;, color = Color3.fromRGB(240, 240, 250), speed = 7, stamina = 3, luck = 5 },
	{ id = &quot;Renard&quot;, icon = &quot;🦊&quot;, rarity = &quot;Rare&quot;, egg = &quot;Village&quot;, shape = &quot;cat&quot;, color = Color3.fromRGB(255, 120, 40), speed = 7, stamina = 5, luck = 4 },
	{ id = &quot;Hibou&quot;, icon = &quot;🦉&quot;, rarity = &quot;Epic&quot;, egg = &quot;Village&quot;, shape = &quot;bird&quot;, color = Color3.fromRGB(150, 110, 80), speed = 6, stamina = 7, luck = 7 },
	{ id = &quot;Licorne&quot;, icon = &quot;🦄&quot;, rarity = &quot;Legendary&quot;, egg = &quot;Village&quot;, shape = &quot;dog&quot;, color = Color3.fromRGB(255, 200, 255), speed = 9, stamina = 6, luck = 8 },
	-- Foret
	{ id = &quot;Cerf&quot;, icon = &quot;🦌&quot;, rarity = &quot;Common&quot;, egg = &quot;Foret&quot;, shape = &quot;dog&quot;, color = Color3.fromRGB(170, 120, 70), speed = 6, stamina = 6, luck = 2 },
	{ id = &quot;Loup&quot;, icon = &quot;🐺&quot;, rarity = &quot;Uncommon&quot;, egg = &quot;Foret&quot;, shape = &quot;dog&quot;, color = Color3.fromRGB(120, 120, 130), speed = 6, stamina = 9, luck = 3 },
	{ id = &quot;Ours&quot;, icon = &quot;🐻&quot;, rarity = &quot;Rare&quot;, egg = &quot;Foret&quot;, shape = &quot;bear&quot;, color = Color3.fromRGB(120, 80, 50), speed = 3, stamina = 10, luck = 4 },
	{ id = &quot;Panda&quot;, icon = &quot;🐼&quot;, rarity = &quot;Epic&quot;, egg = &quot;Foret&quot;, shape = &quot;bear&quot;, color = Color3.fromRGB(245, 245, 245), speed = 4, stamina = 8, luck = 8 },
	{ id = &quot;Phenix&quot;, icon = &quot;🐦‍🔥&quot;, rarity = &quot;Legendary&quot;, egg = &quot;Foret&quot;, shape = &quot;bird&quot;, color = Color3.fromRGB(255, 90, 30), speed = 10, stamina = 7, luck = 6 },
	{ id = &quot;Dragon&quot;, icon = &quot;🐉&quot;, rarity = &quot;Mythical&quot;, egg = &quot;Foret&quot;, shape = &quot;dragon&quot;, color = Color3.fromRGB(60, 200, 90), speed = 9, stamina = 10, luck = 7 },
	-- Desert
	{ id = &quot;Scorpion&quot;, icon = &quot;🦂&quot;, rarity = &quot;Common&quot;, egg = &quot;Desert&quot;, shape = &quot;blob&quot;, color = Color3.fromRGB(150, 90, 40), speed = 4, stamina = 7, luck = 3 },
	{ id = &quot;Chameau&quot;, icon = &quot;🐫&quot;, rarity = &quot;Uncommon&quot;, egg = &quot;Desert&quot;, shape = &quot;dog&quot;, color = Color3.fromRGB(220, 180, 110), speed = 4, stamina = 10, luck = 3 },
	{ id = &quot;Cobra&quot;, icon = &quot;🐍&quot;, rarity = &quot;Rare&quot;, egg = &quot;Desert&quot;, shape = &quot;snake&quot;, color = Color3.fromRGB(90, 160, 60), speed = 8, stamina = 4, luck = 6 },
	{ id = &quot;Lezard&quot;, icon = &quot;🦎&quot;, rarity = &quot;Epic&quot;, egg = &quot;Desert&quot;, shape = &quot;snake&quot;, color = Color3.fromRGB(120, 220, 120), speed = 9, stamina = 5, luck = 7 },
	{ id = &quot;Sphinx&quot;, icon = &quot;🦁&quot;, rarity = &quot;Legendary&quot;, egg = &quot;Desert&quot;, shape = &quot;cat&quot;, color = Color3.fromRGB(230, 190, 90), speed = 8, stamina = 9, luck = 8 },
	{ id = &quot;Genie&quot;, icon = &quot;🧞&quot;, rarity = &quot;Mythical&quot;, egg = &quot;Desert&quot;, shape = &quot;blob&quot;, color = Color3.fromRGB(90, 120, 255), speed = 10, stamina = 8, luck = 10 },
	{ id = &quot;Pharaon&quot;, icon = &quot;👑&quot;, rarity = &quot;Secret&quot;, egg = &quot;Desert&quot;, shape = &quot;cat&quot;, color = Color3.fromRGB(255, 220, 90), speed = 10, stamina = 10, luck = 10 },
}
Config.PetById = {}
for _, pet in ipairs(Config.Pets) do
	Config.PetById[pet.id] = pet
end

-- Oeufs (un par zone)
Config.Eggs = {
	{ id = &quot;Village&quot;, name = &quot;Oeuf du Village&quot;, icon = &quot;🥚&quot;, price = 50, zone = &quot;Village&quot;, color = Color3.fromRGB(240, 240, 255) },
	{ id = &quot;Foret&quot;, name = &quot;Oeuf de la Foret&quot;, icon = &quot;🌳&quot;, price = 600, zone = &quot;Foret&quot;, color = Color3.fromRGB(120, 220, 110) },
	{ id = &quot;Desert&quot;, name = &quot;Oeuf du Desert&quot;, icon = &quot;🏜️&quot;, price = 6000, zone = &quot;Desert&quot;, color = Color3.fromRGB(255, 200, 100) },
}
Config.EggById = {}
for _, egg in ipairs(Config.Eggs) do
	Config.EggById[egg.id] = egg
end

-- Zones
Config.Zones = {
	{ id = &quot;Village&quot;, name = &quot;Starter Village&quot;, icon = &quot;🏡&quot;, price = 0, center = Vector3.new(0, 0, 0), size = 220, coinValue = 5, coinCount = 40, ground = Color3.fromRGB(110, 200, 90), chestValue = 400 },
	{ id = &quot;Foret&quot;, name = &quot;Forest&quot;, icon = &quot;🌲&quot;, price = 2500, center = Vector3.new(0, 0, -300), size = 220, coinValue = 30, coinCount = 40, ground = Color3.fromRGB(60, 150, 70), chestValue = 3000 },
	{ id = &quot;Desert&quot;, name = &quot;Desert&quot;, icon = &quot;🏜️&quot;, price = 25000, center = Vector3.new(0, 0, -600), size = 220, coinValue = 150, coinCount = 40, ground = Color3.fromRGB(230, 200, 130), chestValue = 20000 },
}
Config.ZoneById = {}
for _, zone in ipairs(Config.Zones) do
	Config.ZoneById[zone.id] = zone
end

Config.Collect = {
	BaseRadius = 7, -- rayon de collecte sans pet
	RadiusPerPet = 2.5,
	Tick = 0.4,
	CoinRespawn = 6,
	ChestInterval = { 120, 200 },
	ChestLifetime = 60,
}

Config.Daily = {
	Cooldown = 20 * 3600,
	Coins = 500,
}

-- Courses
Config.Race = {
	LobbyTime = 25,
	Countdown = 3,
	MaxRacers = 4,
	Types = {
		{ id = &quot;Sprint&quot;, name = &quot;Sprint&quot;, icon = &quot;⚡&quot;, laps = 1, reward = 250, description = &quot;1 tour : la vitesse compte le plus&quot; },
		{ id = &quot;Marathon&quot;, name = &quot;Marathon&quot;, icon = &quot;🛡️&quot;, laps = 3, reward = 900, description = &quot;3 tours : l'endurance fait la difference&quot; },
	},
	AINames = { &quot;Robo-Chat&quot;, &quot;Turbo-Chien&quot;, &quot;Lapinou&quot;, &quot;Mister Renard&quot; },
}

Config.Map = {
	SpawnPosition = Vector3.new(0, 3, 70),
	KillHeight = -40,
}

return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">PetModel</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Construit le modele 3D d'un pet (parts uniquement) selon sa forme, sa couleur et son evolution.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Config = require(ReplicatedStorage.Shared.Config)

local PetModel = {}

local function part(model, props)
	local p = Instance.new(&quot;Part&quot;)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = model
	return p
end

local function ball(model, cf, size, color, material, name)
	return part(model, { Name = name or &quot;Body&quot;, Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), CFrame = cf, Color = color, Material = material })
end

local function eyes(model, cf, spread, height, forward, size)
	for _, x in ipairs({ -spread, spread }) do
		part(model, { Name = &quot;Eye&quot;, Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), CFrame = cf * CFrame.new(x, height, -forward), Color = Color3.new(0, 0, 0), Material = Enum.Material.SmoothPlastic })
	end
end

local shapes = {}

shapes.cat = function(m, cf, color, mat)
	ball(m, cf, 1.6, color, mat)
	ball(m, cf * CFrame.new(0, 0.9, -0.6), 1.2, color, mat, &quot;Head&quot;)
	for _, x in ipairs({ -0.4, 0.4 }) do
		part(m, { Name = &quot;Ear&quot;, Size = Vector3.new(0.35, 0.5, 0.2), CFrame = cf * CFrame.new(x, 1.6, -0.6) * CFrame.Angles(0, 0, x &gt; 0 and -0.3 or 0.3), Color = color, Material = mat })
	end
	part(m, { Name = &quot;Tail&quot;, Size = Vector3.new(0.25, 1.2, 0.25), CFrame = cf * CFrame.new(0, 0.6, 0.9) * CFrame.Angles(0.5, 0, 0), Color = color, Material = mat })
	eyes(m, cf, 0.28, 1, 1.1, 0.22)
end

shapes.dog = function(m, cf, color, mat)
	part(m, { Size = Vector3.new(1.3, 1.1, 1.9), CFrame = cf, Color = color, Material = mat })
	ball(m, cf * CFrame.new(0, 0.8, -1), 1.2, color, mat, &quot;Head&quot;)
	for _, x in ipairs({ -0.55, 0.55 }) do
		part(m, { Name = &quot;Ear&quot;, Size = Vector3.new(0.25, 0.7, 0.4), CFrame = cf * CFrame.new(x, 0.9, -1), Color = color:Lerp(Color3.new(0, 0, 0), 0.25), Material = mat })
	end
	for _, pos in ipairs({ Vector3.new(-0.45, -0.7, -0.6), Vector3.new(0.45, -0.7, -0.6), Vector3.new(-0.45, -0.7, 0.6), Vector3.new(0.45, -0.7, 0.6) }) do
		part(m, { Name = &quot;Leg&quot;, Size = Vector3.new(0.35, 0.6, 0.35), CFrame = cf * CFrame.new(pos), Color = color, Material = mat })
	end
	eyes(m, cf, 0.28, 0.9, 1.5, 0.22)
end

shapes.bunny = function(m, cf, color, mat)
	ball(m, cf, 1.4, color, mat)
	ball(m, cf * CFrame.new(0, 0.9, -0.4), 1.1, color, mat, &quot;Head&quot;)
	for _, x in ipairs({ -0.3, 0.3 }) do
		part(m, { Name = &quot;Ear&quot;, Size = Vector3.new(0.3, 1.2, 0.2), CFrame = cf * CFrame.new(x, 1.9, -0.4) * CFrame.Angles(0, 0, x &gt; 0 and -0.15 or 0.15), Color = color, Material = mat })
	end
	ball(m, cf * CFrame.new(0, 0, 0.8), 0.5, Color3.new(1, 1, 1), mat, &quot;Tail&quot;)
	eyes(m, cf, 0.26, 1, 0.9, 0.2)
end

shapes.bird = function(m, cf, color, mat)
	ball(m, cf, 1.4, color, mat)
	ball(m, cf * CFrame.new(0, 0.9, -0.3), 1, color, mat, &quot;Head&quot;)
	for _, x in ipairs({ -0.9, 0.9 }) do
		part(m, { Name = &quot;Wing&quot;, Size = Vector3.new(0.8, 0.2, 1), CFrame = cf * CFrame.new(x, 0.2, 0) * CFrame.Angles(0, 0, x &gt; 0 and -0.4 or 0.4), Color = color:Lerp(Color3.new(1, 1, 1), 0.2), Material = mat })
	end
	part(m, { Name = &quot;Beak&quot;, Size = Vector3.new(0.3, 0.25, 0.5), CFrame = cf * CFrame.new(0, 0.8, -0.9), Color = Color3.fromRGB(255, 180, 40), Material = Enum.Material.SmoothPlastic })
	eyes(m, cf, 0.25, 1, 0.75, 0.2)
end

shapes.dragon = function(m, cf, color, mat)
	part(m, { Size = Vector3.new(1.4, 1.2, 2.2), CFrame = cf, Color = color, Material = mat })
	ball(m, cf * CFrame.new(0, 0.9, -1.2), 1.2, color, mat, &quot;Head&quot;)
	for _, x in ipairs({ -1.1, 1.1 }) do
		part(m, { Name = &quot;Wing&quot;, Size = Vector3.new(1.4, 0.15, 1.2), CFrame = cf * CFrame.new(x, 0.9, 0.2) * CFrame.Angles(0, 0, x &gt; 0 and -0.6 or 0.6), Color = color:Lerp(Color3.new(0, 0, 0), 0.3), Material = mat })
	end
	for _, x in ipairs({ -0.35, 0.35 }) do
		part(m, { Name = &quot;Horn&quot;, Size = Vector3.new(0.2, 0.6, 0.2), CFrame = cf * CFrame.new(x, 1.7, -1.1) * CFrame.Angles(0, 0, x &gt; 0 and -0.3 or 0.3), Color = Color3.fromRGB(240, 240, 220), Material = Enum.Material.SmoothPlastic })
	end
	part(m, { Name = &quot;Tail&quot;, Size = Vector3.new(0.4, 0.4, 1.6), CFrame = cf * CFrame.new(0, 0, 1.8) * CFrame.Angles(0.3, 0, 0), Color = color, Material = mat })
	eyes(m, cf, 0.3, 1, 1.7, 0.24)
end

shapes.snake = function(m, cf, color, mat)
	for i = 0, 4 do
		ball(m, cf * CFrame.new(math.sin(i * 1.2) * 0.4, -0.3 + i * 0.1, i * 0.6 - 0.8), 0.9 - i * 0.08, color, mat, i == 0 and &quot;Head&quot; or &quot;Body&quot;)
	end
	eyes(m, cf * CFrame.new(0, -0.3, -0.8), 0.22, 0.15, 0.4, 0.18)
end

shapes.bear = function(m, cf, color, mat)
	part(m, { Size = Vector3.new(1.8, 1.6, 1.5), CFrame = cf, Color = color, Material = mat })
	ball(m, cf * CFrame.new(0, 1.2, -0.5), 1.4, color, mat, &quot;Head&quot;)
	for _, x in ipairs({ -0.55, 0.55 }) do
		ball(m, cf * CFrame.new(x, 1.9, -0.5), 0.5, color, mat, &quot;Ear&quot;)
	end
	ball(m, cf * CFrame.new(0, 1, -1.1), 0.5, color:Lerp(Color3.new(1, 1, 1), 0.4), mat, &quot;Muzzle&quot;)
	eyes(m, cf, 0.3, 1.35, 1.1, 0.22)
end

shapes.blob = function(m, cf, color, mat)
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(1.8, 1.4, 1.8), CFrame = cf, Color = color, Material = mat })
	ball(m, cf * CFrame.new(0, 1, 0), 0.9, color, mat, &quot;Head&quot;)
	eyes(m, cf, 0.3, 0.3, 0.8, 0.24)
end

-- Retourne un Model anchore centre sur cf. evoIndex : 1 Normal, 2 Golden, 3 Rainbow, 4 Cosmic
function PetModel.Build(petId, evoIndex, cf)
	local def = Config.PetById[petId] or Config.Pets[1]
	local evo = Config.Evolutions[evoIndex or 1] or Config.Evolutions[1]
	local model = Instance.new(&quot;Model&quot;)
	model.Name = def.id
	local color = def.color
	local material = Enum.Material.SmoothPlastic
	if evo.id == &quot;Golden&quot; then
		color = Color3.fromRGB(255, 215, 0)
		material = Enum.Material.Neon
	elseif evo.id == &quot;Rainbow&quot; then
		color = Color3.fromRGB(255, 120, 255)
		material = Enum.Material.Neon
	elseif evo.id == &quot;Cosmic&quot; then
		color = Color3.fromRGB(110, 60, 220)
		material = Enum.Material.Neon
	end
	local builder = shapes[def.shape] or shapes.blob
	builder(model, cf, color, material)
	local rarity = Config.RarityById[def.rarity]
	local scale = 0.9 + (rarity.index - 1) * 0.08
	if scale ~= 1 then
		model:ScaleTo(scale)
	end
	model:SetAttribute(&quot;PetId&quot;, def.id)
	model:SetAttribute(&quot;Evo&quot;, evo.id)
	-- Effets d'evolution
	if evo.id ~= &quot;Normal&quot; then
		local head = model:FindFirstChild(&quot;Head&quot;) or model:FindFirstChildWhichIsA(&quot;BasePart&quot;)
		local att = Instance.new(&quot;Attachment&quot;)
		att.Parent = head
		local e = Instance.new(&quot;ParticleEmitter&quot;)
		e.Rate = evo.id == &quot;Cosmic&quot; and 18 or 8
		e.Lifetime = NumberRange.new(0.6, 1.2)
		e.Speed = NumberRange.new(1, 2)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
		e.Transparency = NumberSequence.new(0.2, 1)
		e.LightEmission = 1
		if evo.id == &quot;Rainbow&quot; then
			e.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 255, 120)), ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 120, 255)) })
		else
			e.Color = ColorSequence.new(evo.color)
		end
		e.Parent = att
	end
	model.PrimaryPart = model:FindFirstChild(&quot;Body&quot;) or model:FindFirstChildWhichIsA(&quot;BasePart&quot;)
	return model
end

-- Stats effectives d'un pet { speed, power, stamina, luck, total }
function PetModel.Stats(petId, evoIndex)
	local def = Config.PetById[petId]
	if not def then
		return { speed = 0, power = 0, stamina = 0, luck = 0 }
	end
	local rarity = Config.RarityById[def.rarity]
	local mult = (Config.Evolutions[evoIndex or 1] or Config.Evolutions[1]).mult
	return {
		speed = def.speed * mult,
		power = rarity.power * mult,
		stamina = def.stamina * mult,
		luck = def.luck * mult,
	}
end

function PetModel.DisplayName(petId, evoIndex)
	local def = Config.PetById[petId]
	local evo = Config.Evolutions[evoIndex or 1]
	if not def then
		return petId
	end
	local name = def.id
	if evo and evo.id ~= &quot;Normal&quot; then
		name = evo.icon .. &quot; &quot; .. evo.name .. &quot; &quot; .. name
	end
	return def.icon .. &quot; &quot; .. name
end

return PetModel
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Remotes</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Cree (serveur) ou recupere (client) les RemoteEvents du jeu.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)

local NAMES = { &quot;Pets&quot;, &quot;PetsSync&quot;, &quot;Race&quot;, &quot;RaceSync&quot;, &quot;Notify&quot;, &quot;FX&quot; }

local Remotes = {}

local folder: Folder
if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild(&quot;Remotes&quot;)
	if existing and existing:IsA(&quot;Folder&quot;) then
		folder = existing
	else
		folder = Instance.new(&quot;Folder&quot;)
		folder.Name = &quot;Remotes&quot;
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(NAMES) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new(&quot;RemoteEvent&quot;)
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild(&quot;Remotes&quot;) :: Folder
end

for _, name in ipairs(NAMES) do
	Remotes[name] = folder:WaitForChild(name) :: RemoteEvent
end

return Remotes
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000000D"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX0000000C"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX00000005"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Point d'entree serveur de PET RUSH.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

require(ReplicatedStorage.Shared.Remotes) -- cree les RemoteEvents avant tout

local Modules = script.Parent.Modules
local MapBuilder = require(Modules.MapBuilder)
local DataService = require(Modules.DataService)
local PetService = require(Modules.PetService)
local CoinService = require(Modules.CoinService)
local RaceService = require(Modules.RaceService)

MapBuilder.Build()
DataService.Init()
PetService.Init()
CoinService.Init()
RaceService.Init()

print(&quot;[PetRush] Serveur pret.&quot;)
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000000B"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">CoinService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Coins dans les zones, collecte automatique par les pets, coffres rares.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)
local PetService = require(script.Parent.PetService)

local CoinService = {}

local coinsFolder
local coins = {} -- [part] = { zone = zone, value = n, chest = bool }

local function spawnCoin(zone, position)
	local coin = Instance.new(&quot;Part&quot;)
	coin.Name = &quot;Coin&quot;
	coin.Shape = Enum.PartType.Cylinder
	coin.Size = Vector3.new(0.4, 2.2, 2.2)
	coin.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	coin.Material = Enum.Material.Neon
	coin.Color = Config.Colors.Gold
	coin.Anchored = true
	coin.CanCollide = false
	coin.CanQuery = false
	coin:SetAttribute(&quot;Value&quot;, zone.coinValue)
	coin.Parent = coinsFolder
	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = Config.Colors.Gold
	light.Range = 8
	light.Brightness = 1
	light.Parent = coin
	coins[coin] = { zone = zone, value = zone.coinValue }
	return coin
end

local function spawnChest(zone)
	local half = zone.size / 2
	local a = math.random() * math.pi * 2
	local r = 20 + math.random() * (half - 40)
	local pos = zone.center + Vector3.new(math.cos(a) * r, 2.5, math.sin(a) * r)
	local chest = Instance.new(&quot;Part&quot;)
	chest.Name = &quot;Chest&quot;
	chest.Size = Vector3.new(4, 3, 3)
	chest.CFrame = CFrame.new(pos)
	chest.Material = Enum.Material.Neon
	chest.Color = Config.Colors.Accent2
	chest.Anchored = true
	chest.CanCollide = false
	chest.CanQuery = false
	chest:SetAttribute(&quot;Value&quot;, zone.chestValue)
	chest:SetAttribute(&quot;Chest&quot;, true)
	chest.Parent = coinsFolder
	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = Config.Colors.Accent2
	light.Range = 30
	light.Brightness = 3
	light.Parent = chest
	local beam = Instance.new(&quot;Part&quot;)
	beam.Name = &quot;ChestBeam&quot;
	beam.Size = Vector3.new(1.5, 200, 1.5)
	beam.CFrame = CFrame.new(pos + Vector3.new(0, 100, 0))
	beam.Material = Enum.Material.Neon
	beam.Color = Config.Colors.Accent2
	beam.Transparency = 0.6
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.Parent = chest
	coins[chest] = { zone = zone, value = zone.chestValue, chest = true }
	Remotes.Notify:FireAllClients(&quot;🎁 Un coffre rare est apparu dans &quot; .. zone.icon .. &quot; &quot; .. zone.name .. &quot; ! (&quot; .. zone.chestValue .. &quot; coins)&quot;, &quot;gold&quot;)
	Remotes.FX:FireAllClients(&quot;ChestSpawn&quot;, { position = pos, zoneId = zone.id })
	task.delay(Config.Collect.ChestLifetime, function()
		if coins[chest] then
			coins[chest] = nil
			chest:Destroy()
		end
	end)
end

local function collect(player, coin, info)
	coins[coin] = nil
	local data = DataService.Get(player)
	if not data then
		coin:Destroy()
		return
	end
	local power = PetService.GetPower(player)
	local amount = math.floor(info.value * (1 + power * 0.08) + 0.5)
	PetService.AddCoins(player, amount)
	Remotes.FX:FireAllClients(&quot;Collect&quot;, { position = coin.Position, userId = player.UserId, amount = amount, chest = info.chest or false })
	if info.chest then
		Remotes.Notify:FireAllClients(&quot;🎁 &quot; .. player.DisplayName .. &quot; a ouvert le coffre et gagne &quot; .. amount .. &quot; coins !&quot;, &quot;gold&quot;)
	end
	coin:Destroy()
	PetService.Sync(player)
	if not info.chest then
		task.delay(Config.Collect.CoinRespawn + math.random() * 4, function()
			local spots = MapBuilder.GetCoinSpots(info.zone.id)
			spawnCoin(info.zone, spots[math.random(#spots)])
		end)
	end
end

local function collectLoop()
	while true do
		task.wait(Config.Collect.Tick)
		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
			local data = DataService.Get(player)
			if hrp and data then
				local equipped = PetService.GetEquippedPets(player)
				local radius = Config.Collect.BaseRadius + #equipped * Config.Collect.RadiusPerPet
				for coin, info in pairs(coins) do
					if coin.Parent then
						local dist = (coin.Position - hrp.Position).Magnitude
						local reach = info.chest and 8 or radius
						if dist &lt;= reach and (info.chest or data.Zones[info.zone.id]) then
							collect(player, coin, info)
						end
					else
						coins[coin] = nil
					end
				end
			end
		end
	end
end

function CoinService.Init()
	coinsFolder = workspace:FindFirstChild(&quot;Coins&quot;) or Instance.new(&quot;Folder&quot;)
	coinsFolder.Name = &quot;Coins&quot;
	coinsFolder.Parent = workspace
	for _, zone in ipairs(Config.Zones) do
		for _, spot in ipairs(MapBuilder.GetCoinSpots(zone.id)) do
			spawnCoin(zone, spot)
		end
	end
	task.spawn(collectLoop)
	task.spawn(function()
		task.wait(60)
		while true do
			local zone = Config.Zones[math.random(#Config.Zones)]
			spawnChest(zone)
			task.wait(math.random(Config.Collect.ChestInterval[1], Config.Collect.ChestInterval[2]))
		end
	end)
end

return CoinService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">DataService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Sauvegarde DataStore + leaderstats + classement global coins.

local DataStoreService = game:GetService(&quot;DataStoreService&quot;)
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local store, topStore
pcall(function()
	store = DataStoreService:GetDataStore(&quot;PetRush_v1&quot;)
	topStore = DataStoreService:GetOrderedDataStore(&quot;PetRush_Coins_v1&quot;)
end)

local cache = {}
local stats = {}

local function defaultData()
	return {
		Coins = Config.StartCoins,
		TotalCoins = 0,
		Pets = {}, -- { uid = n, id = &quot;Chaton&quot;, evo = 1 }
		NextUid = 1,
		Equipped = {}, -- liste d'uids
		Zones = { Village = true },
		Index = {}, -- [petId] = true (decouverts)
		Hatched = 0,
		RaceWins = 0,
		Races = 0,
		LastDaily = 0,
	}
end

local function key(player)
	return &quot;p_&quot; .. player.UserId
end

function DataService.Load(player)
	local data = defaultData()
	if store then
		local ok, result = pcall(function()
			return store:GetAsync(key(player))
		end)
		if ok and type(result) == &quot;table&quot; then
			for k, v in pairs(result) do
				data[k] = v
			end
		elseif not ok then
			warn(&quot;[PetRush] Chargement impossible pour &quot; .. player.Name .. &quot; : &quot; .. tostring(result))
		end
	end
	data.Zones = data.Zones or { Village = true }
	data.Zones.Village = true
	data.Pets = data.Pets or {}
	data.Equipped = data.Equipped or {}
	data.Index = data.Index or {}
	cache[player] = data

	local leaderstats = Instance.new(&quot;Folder&quot;)
	leaderstats.Name = &quot;leaderstats&quot;
	local values = {}
	for _, name in ipairs({ &quot;Coins&quot;, &quot;Pets&quot;, &quot;RaceWins&quot; }) do
		local v = Instance.new(&quot;IntValue&quot;)
		v.Name = name
		v.Parent = leaderstats
		values[name] = v
	end
	leaderstats.Parent = player
	stats[player] = values
	DataService.Sync(player)
	return data
end

function DataService.Get(player)
	return cache[player]
end

function DataService.Sync(player)
	local data = cache[player]
	local values = stats[player]
	if data and values then
		values.Coins.Value = math.floor(data.Coins)
		values.Pets.Value = #data.Pets
		values.RaceWins.Value = data.RaceWins
	end
end

function DataService.Save(player)
	local data = cache[player]
	if not data or not store then
		return
	end
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function()
			return data
		end)
	end)
	if not ok then
		warn(&quot;[PetRush] Sauvegarde impossible pour &quot; .. player.Name .. &quot; : &quot; .. tostring(err))
	end
	if topStore then
		pcall(function()
			topStore:SetAsync(tostring(player.UserId), math.floor(data.TotalCoins))
		end)
	end
end

function DataService.Release(player)
	cache[player] = nil
	stats[player] = nil
end

function DataService.GetTop(count)
	if not topStore then
		return {}
	end
	local ok, pages = pcall(function()
		return topStore:GetSortedAsync(false, count)
	end)
	if not ok then
		return {}
	end
	local result = {}
	for _, entry in ipairs(pages:GetCurrentPage()) do
		table.insert(result, { userId = tonumber(entry.key), value = entry.value })
	end
	return result
end

function DataService.Init()
	game:BindToClose(function()
		for _, p in ipairs(Players:GetPlayers()) do
			DataService.Save(p)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(120)
			for _, p in ipairs(Players:GetPlayers()) do
				DataService.Save(p)
			end
		end
	end)
end

return DataService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">MapBuilder</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Map de PET RUSH : 3 zones (Village, Foret, Desert), portes, stands a oeufs, piste de course, classement.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local CollectionService = game:GetService(&quot;CollectionService&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local Lighting = game:GetService(&quot;Lighting&quot;)
local Players = game:GetService(&quot;Players&quot;)

local Config = require(ReplicatedStorage.Shared.Config)

local MapBuilder = {}

local function makePart(props)
	local p = Instance.new(&quot;Part&quot;)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		p[key] = value
	end
	return p
end

local function addLabel(parent, text, face, color)
	local gui = Instance.new(&quot;SurfaceGui&quot;)
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0
	local label = Instance.new(&quot;TextLabel&quot;)
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextStrokeTransparency = 0.5
	label.Parent = gui
	gui.Parent = parent
	return label
end

local function buildLighting()
	Lighting.ClockTime = 13
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(120, 125, 140)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 155, 170)
	Lighting.FogColor = Color3.fromRGB(205, 225, 255)
	Lighting.FogStart = 350
	Lighting.FogEnd = 1400
	Lighting.GlobalShadows = true
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA(&quot;PostEffect&quot;) or child:IsA(&quot;Atmosphere&quot;) or child:IsA(&quot;Sky&quot;) then
			child:Destroy()
		end
	end
	local bloom = Instance.new(&quot;BloomEffect&quot;)
	bloom.Intensity = 0.5
	bloom.Size = 24
	bloom.Threshold = 1.4
	bloom.Parent = Lighting
	local cc = Instance.new(&quot;ColorCorrectionEffect&quot;)
	cc.Name = &quot;PetColor&quot;
	cc.Saturation = 0.35
	cc.Contrast = 0.08
	cc.Parent = Lighting
	local atmosphere = Instance.new(&quot;Atmosphere&quot;)
	atmosphere.Density = 0.22
	atmosphere.Color = Color3.fromRGB(205, 225, 255)
	atmosphere.Decay = Color3.fromRGB(150, 180, 230)
	atmosphere.Glare = 0.4
	atmosphere.Haze = 1
	atmosphere.Parent = Lighting
	local sky = Instance.new(&quot;Sky&quot;)
	sky.SunAngularSize = 16
	sky.Parent = Lighting
end

local function tree(root, position, scale, leafColor)
	scale = scale or 1
	makePart({ Name = &quot;Tree&quot;, Size = Vector3.new(1.4 * scale, 6 * scale, 1.4 * scale), CFrame = CFrame.new(position + Vector3.new(0, 3 * scale, 0)), Material = Enum.Material.Wood, Color = Color3.fromRGB(110, 75, 45) }).Parent = root
	for i = 1, 3 do
		local r = (4.5 - i * 0.8) * scale
		makePart({ Name = &quot;Leaves&quot;, Shape = Enum.PartType.Ball, Size = Vector3.new(r * 2, r * 2, r * 2), CFrame = CFrame.new(position + Vector3.new(0, (5 + i * 2) * scale, 0)), Material = Enum.Material.Grass, Color = (leafColor or Color3.fromRGB(70, 170, 80)):Lerp(Color3.new(1, 1, 1), i * 0.08), CanCollide = false }).Parent = root
	end
end

local function cactus(root, position)
	makePart({ Name = &quot;Cactus&quot;, Size = Vector3.new(1.4, 6, 1.4), CFrame = CFrame.new(position + Vector3.new(0, 3, 0)), Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(70, 160, 80) }).Parent = root
	for _, x in ipairs({ -1.4, 1.4 }) do
		makePart({ Name = &quot;CactusArm&quot;, Size = Vector3.new(1, 3, 1), CFrame = CFrame.new(position + Vector3.new(x, 4, 0)), Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(70, 160, 80) }).Parent = root
	end
end

local function stand(root, position, lookAt, title, icon, color, tag, attrs)
	local base = makePart({ Name = tag, Size = Vector3.new(10, 3, 5), CFrame = CFrame.lookAt(position + Vector3.new(0, 1.5, 0), Vector3.new(lookAt.X, position.Y + 1.5, lookAt.Z)), Material = Enum.Material.WoodPlanks, Color = Color3.fromRGB(150, 105, 60) })
	base.Parent = root
	local roof = makePart({ Name = &quot;Roof&quot;, Size = Vector3.new(12, 0.6, 8), CFrame = base.CFrame * CFrame.new(0, 6, 0), Material = Enum.Material.Fabric, Color = color })
	roof.Parent = root
	for _, x in ipairs({ -5, 5 }) do
		makePart({ Name = &quot;Pole&quot;, Size = Vector3.new(0.5, 8, 0.5), CFrame = base.CFrame * CFrame.new(x, 2.5, 2.5), Material = Enum.Material.Wood, Color = Color3.fromRGB(150, 105, 60) }).Parent = root
	end
	local sign = makePart({ Name = &quot;Sign&quot;, Size = Vector3.new(11, 2.4, 0.4), CFrame = base.CFrame * CFrame.new(0, 4.5, -3), Material = Enum.Material.SmoothPlastic, Color = Config.Colors.Panel })
	sign.Parent = root
	addLabel(sign, icon .. &quot; &quot; .. title, Enum.NormalId.Front, color)
	local prompt = Instance.new(&quot;ProximityPrompt&quot;)
	prompt.ActionText = &quot;Ouvrir&quot;
	prompt.ObjectText = title
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = base
	for k, v in pairs(attrs or {}) do
		base:SetAttribute(k, v)
	end
	CollectionService:AddTag(base, tag)
	return base
end

local function eggDisplay(root, position, color)
	local egg = makePart({ Name = &quot;EggDisplay&quot;, Shape = Enum.PartType.Ball, Size = Vector3.new(3, 3.8, 3), CFrame = CFrame.new(position + Vector3.new(0, 8.5, 0)), Material = Enum.Material.Neon, Color = color, CanCollide = false })
	egg.Parent = root
	TweenService:Create(egg, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { CFrame = egg.CFrame * CFrame.new(0, 1.2, 0) * CFrame.Angles(0, math.pi, 0) }):Play()
	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = color
	light.Range = 14
	light.Brightness = 2
	light.Parent = egg
end

local zoneRoots = {}
local coinSpots = {}

local function buildZone(root, zone, index)
	local folder = Instance.new(&quot;Folder&quot;)
	folder.Name = &quot;Zone_&quot; .. zone.id
	folder:SetAttribute(&quot;ZoneId&quot;, zone.id)
	folder.Parent = root
	zoneRoots[zone.id] = folder
	local c = zone.center
	local half = zone.size / 2

	local ground = makePart({ Name = &quot;Ground&quot;, Size = Vector3.new(zone.size, 4, zone.size), CFrame = CFrame.new(c - Vector3.new(0, 2, 0)), Material = zone.id == &quot;Desert&quot; and Enum.Material.Sand or Enum.Material.Grass, Color = zone.ground })
	ground.Parent = folder
	-- Bordure
	local border = makePart({ Name = &quot;Border&quot;, Size = Vector3.new(zone.size + 2, 1, zone.size + 2), CFrame = CFrame.new(c - Vector3.new(0, 4.4, 0)), Material = Enum.Material.Neon, Color = Config.Colors.Accent })
	border.Parent = folder
	-- Murs invisibles
	for _, def in ipairs({ { Vector3.new(zone.size, 40, 2), Vector3.new(0, 20, half) }, { Vector3.new(zone.size, 40, 2), Vector3.new(0, 20, -half) }, { Vector3.new(2, 40, zone.size), Vector3.new(half, 20, 0) }, { Vector3.new(2, 40, zone.size), Vector3.new(-half, 20, 0) } }) do
		local wall = makePart({ Name = &quot;Wall&quot;, Size = def[1], CFrame = CFrame.new(c + def[2]), Transparency = 1 })
		wall.Parent = folder
	end

	-- Panneau de zone
	local sign = makePart({ Name = &quot;ZoneSign&quot;, Size = Vector3.new(30, 6, 1), CFrame = CFrame.new(c + Vector3.new(0, 12, half - 6)), Material = Enum.Material.SmoothPlastic, Color = Config.Colors.Panel })
	sign.Parent = folder
	addLabel(sign, zone.icon .. &quot; &quot; .. zone.name, Enum.NormalId.Front, Config.Colors.Gold)
	addLabel(sign, zone.icon .. &quot; &quot; .. zone.name, Enum.NormalId.Back, Config.Colors.Gold)

	-- Decor
	for i = 1, 22 do
		local a = (i / 22) * math.pi * 2
		local r = half - 12 - (i % 3) * 8
		local pos = c + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		if math.abs(pos.Z - c.Z) &lt; half - 30 or math.abs(pos.X - c.X) &gt; 30 then
			if zone.id == &quot;Desert&quot; then
				cactus(folder, pos)
			else
				tree(folder, pos, 0.8 + (i % 4) * 0.25, zone.id == &quot;Foret&quot; and Color3.fromRGB(40, 130, 60) or nil)
			end
		end
	end
	if zone.id == &quot;Foret&quot; then
		for i = 1, 30 do
			makePart({ Name = &quot;Mushroom&quot;, Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 0.8, 1.2), CFrame = CFrame.new(c + Vector3.new(math.random(-half + 10, half - 10), 0.4, math.random(-half + 10, half - 10))), Material = Enum.Material.Neon, Color = (i % 2 == 0) and Color3.fromRGB(255, 90, 90) or Color3.fromRGB(120, 200, 255), CanCollide = false }).Parent = folder
		end
	elseif zone.id == &quot;Desert&quot; then
		for i = 1, 4 do
			local a = i * 1.7
			local pyr = makePart({ Name = &quot;Pyramid&quot;, Size = Vector3.new(14, 14, 14), CFrame = CFrame.new(c + Vector3.new(math.cos(a) * 70, 2, math.sin(a) * 70)) * CFrame.Angles(math.rad(45), 0, math.rad(45)), Material = Enum.Material.Sandstone, Color = Color3.fromRGB(220, 190, 120) })
			pyr.Parent = folder
		end
	else
		-- Maisons du village
		for i = 1, 6 do
			local a = i * 1.05 + 0.5
			local pos = c + Vector3.new(math.cos(a) * 75, 0, math.sin(a) * 75)
			local colors = { Color3.fromRGB(255, 200, 150), Color3.fromRGB(180, 220, 255), Color3.fromRGB(255, 180, 200) }
			makePart({ Name = &quot;House&quot;, Size = Vector3.new(12, 9, 12), CFrame = CFrame.new(pos + Vector3.new(0, 4.5, 0)), Material = Enum.Material.SmoothPlastic, Color = colors[(i % 3) + 1] }).Parent = folder
			makePart({ Name = &quot;RoofHouse&quot;, Size = Vector3.new(13, 5, 13), CFrame = CFrame.new(pos + Vector3.new(0, 11, 0)) * CFrame.Angles(0, math.rad(45), 0) * CFrame.Angles(math.rad(45), 0, 0) * CFrame.Angles(0, 0, math.rad(45)), Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(200, 70, 60), CanCollide = false }).Parent = folder
		end
	end

	-- Stand a oeuf
	local egg = Config.Eggs[index]
	local eggPos = c + Vector3.new(-50, 0, 20)
	stand(folder, eggPos, c, egg.name, egg.icon, egg.color, &quot;EggStand&quot;, { EggId = egg.id })
	eggDisplay(folder, eggPos, egg.color)

	-- Points de spawn des coins
	coinSpots[zone.id] = {}
	for i = 1, zone.coinCount do
		local a = math.random() * math.pi * 2
		local r = 15 + math.random() * (half - 30)
		table.insert(coinSpots[zone.id], c + Vector3.new(math.cos(a) * r, 2.2, math.sin(a) * r))
	end

	-- Porte vers la zone suivante (au nord : -Z)
	local nextZone = Config.Zones[index + 1]
	if nextZone then
		local gate = makePart({ Name = &quot;Gate&quot;, Size = Vector3.new(24, 16, 3), CFrame = CFrame.new(c + Vector3.new(0, 8, -half)), Material = Enum.Material.Neon, Color = Config.Colors.Gold, Transparency = 0.35 })
		gate:SetAttribute(&quot;ZoneId&quot;, nextZone.id)
		CollectionService:AddTag(gate, &quot;Gate&quot;)
		gate.Parent = folder
		local gateSign = makePart({ Name = &quot;GateSign&quot;, Size = Vector3.new(24, 4, 0.5), CFrame = CFrame.new(c + Vector3.new(0, 18.5, -half)), Material = Enum.Material.SmoothPlastic, Color = Config.Colors.Panel })
		gateSign.Parent = folder
		addLabel(gateSign, nextZone.icon .. &quot; &quot; .. nextZone.name .. &quot;  🔒 &quot; .. nextZone.price .. &quot; coins&quot;, Enum.NormalId.Front, Config.Colors.Gold)
		addLabel(gateSign, nextZone.icon .. &quot; &quot; .. nextZone.name .. &quot;  🔒 &quot; .. nextZone.price .. &quot; coins&quot;, Enum.NormalId.Back, Config.Colors.Gold)
		for _, x in ipairs({ -13, 13 }) do
			makePart({ Name = &quot;GatePillar&quot;, Size = Vector3.new(3, 20, 3), CFrame = CFrame.new(c + Vector3.new(x, 10, -half)), Material = Enum.Material.Marble, Color = Color3.fromRGB(235, 235, 240) }).Parent = folder
		end
		-- Chemin entre les zones
		makePart({ Name = &quot;Path&quot;, Size = Vector3.new(20, 0.4, 90), CFrame = CFrame.new(c + Vector3.new(0, 0.2, -half - 40)), Material = Enum.Material.Cobblestone, Color = Color3.fromRGB(200, 190, 170) }).Parent = folder
		local prompt = Instance.new(&quot;ProximityPrompt&quot;)
		prompt.ActionText = &quot;Debloquer&quot;
		prompt.ObjectText = nextZone.name
		prompt.HoldDuration = 0.5
		prompt.MaxActivationDistance = 16
		prompt.RequiresLineOfSight = false
		prompt.Parent = gate
	end
end

-- Piste de course (boucle dans le village)
local raceWaypoints = {}

local function buildRaceTrack(root)
	local c = Config.Zones[1].center + Vector3.new(60, 0, 40)
	local rx, rz = 38, 24
	local n = 24
	for i = 0, n - 1 do
		local a = (i / n) * math.pi * 2
		table.insert(raceWaypoints, c + Vector3.new(math.cos(a) * rx, 1.2, math.sin(a) * rz))
	end
	for i = 1, n do
		local p1 = raceWaypoints[i]
		local p2 = raceWaypoints[(i % n) + 1]
		local seg = makePart({ Name = &quot;Track&quot;, Size = Vector3.new(8, 0.4, (p2 - p1).Magnitude + 1), CFrame = CFrame.lookAt((p1 + p2) / 2 - Vector3.new(0, 1, 0), p2 - Vector3.new(0, 1, 0)), Material = Enum.Material.Asphalt, Color = Color3.fromRGB(60, 60, 70), CanCollide = false })
		seg.Parent = root
		local line = makePart({ Name = &quot;TrackLine&quot;, Size = Vector3.new(0.4, 0.45, (p2 - p1).Magnitude + 1), CFrame = seg.CFrame, Material = Enum.Material.Neon, Color = Config.Colors.Accent, CanCollide = false })
		line.Parent = root
	end
	local start = raceWaypoints[1]
	local finish = makePart({ Name = &quot;FinishLine&quot;, Size = Vector3.new(10, 0.5, 2), CFrame = CFrame.new(start + Vector3.new(0, 0.1, 0)), Material = Enum.Material.Neon, Color = Color3.new(1, 1, 1), CanCollide = false })
	finish.Parent = root
	local arch = makePart({ Name = &quot;FinishArch&quot;, Size = Vector3.new(12, 1.5, 1.5), CFrame = CFrame.new(start + Vector3.new(0, 8, 0)), Material = Enum.Material.Neon, Color = Config.Colors.Accent2 })
	arch.Parent = root
	addLabel(arch, &quot;🏁 ARRIVEE&quot;, Enum.NormalId.Front, Color3.new(1, 1, 1))
	for _, z in ipairs({ -5.5, 5.5 }) do
		makePart({ Name = &quot;ArchPole&quot;, Size = Vector3.new(1, 8, 1), CFrame = CFrame.new(start + Vector3.new(0, 4, z)), Material = Enum.Material.Marble, Color = Color3.new(1, 1, 1) }).Parent = root
	end
	-- Stand d'inscription
	stand(root, c + Vector3.new(0, 0, 0), c + Vector3.new(0, 0, -10), &quot;COURSES DE PETS&quot;, &quot;🏁&quot;, Config.Colors.Accent2, &quot;RaceStand&quot;, {})
	-- Tribunes
	for i = 1, 3 do
		makePart({ Name = &quot;Stand&quot;, Size = Vector3.new(30, 1.5 * i, 3), CFrame = CFrame.new(c + Vector3.new(0, 0.75 * i, rz + 12 + i * 3)), Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(230, 230, 240) }).Parent = root
	end
end

local function buildHub(root)
	local pos = Config.Map.SpawnPosition
	local existingSpawn = workspace:FindFirstChildOfClass(&quot;SpawnLocation&quot;)
	if existingSpawn then
		existingSpawn:Destroy()
	end
	local spawn = Instance.new(&quot;SpawnLocation&quot;)
	spawn.Name = &quot;MainSpawn&quot;
	spawn.Size = Vector3.new(12, 0.5, 12)
	spawn.CFrame = CFrame.new(pos.X, 0.25, pos.Z)
	spawn.Anchored = true
	spawn.Material = Enum.Material.Neon
	spawn.Color = Config.Colors.Accent
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = root

	local sign = makePart({ Name = &quot;WelcomeSign&quot;, Size = Vector3.new(36, 8, 1), CFrame = CFrame.new(pos.X, 8, pos.Z + 22), Material = Enum.Material.SmoothPlastic, Color = Config.Colors.Panel })
	sign.Parent = root
	addLabel(sign, &quot;🐾 &quot; .. Config.GameName .. &quot; 🐾&quot;, Enum.NormalId.Back, Config.Colors.Accent2)
	local hint = makePart({ Name = &quot;HintSign&quot;, Size = Vector3.new(36, 3, 1), CFrame = CFrame.new(pos.X, 3, pos.Z + 22), Material = Enum.Material.SmoothPlastic, Color = Config.Colors.Panel })
	hint.Parent = root
	addLabel(hint, &quot;Ramasse les 🪙 avec tes pets  •  Ouvre des 🥚  •  Fais evoluer 🧬  •  Gagne des courses 🏁&quot;, Enum.NormalId.Back, Color3.new(1, 1, 1))

	-- Fontaine
	makePart({ Name = &quot;Fountain&quot;, Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 14, 14), CFrame = CFrame.new(pos.X - 40, 1, pos.Z - 10) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.Marble, Color = Color3.fromRGB(235, 235, 240) }).Parent = root
	local water = makePart({ Name = &quot;Water&quot;, Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 12, 12), CFrame = CFrame.new(pos.X - 40, 2, pos.Z - 10) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.Glass, Color = Color3.fromRGB(80, 170, 255), Transparency = 0.3, CanCollide = false })
	water.Parent = root
	local jet = makePart({ Name = &quot;Jet&quot;, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(pos.X - 40, 3, pos.Z - 10), Transparency = 1, CanCollide = false })
	jet.Parent = root
	local emitter = Instance.new(&quot;ParticleEmitter&quot;)
	emitter.Rate = 40
	emitter.Lifetime = NumberRange.new(1, 1.4)
	emitter.Speed = NumberRange.new(16, 22)
	emitter.SpreadAngle = Vector2.new(8, 8)
	emitter.Acceleration = Vector3.new(0, -40, 0)
	emitter.Size = NumberSequence.new(0.6)
	emitter.Transparency = NumberSequence.new(0.3, 1)
	emitter.Color = ColorSequence.new(Color3.fromRGB(170, 220, 255))
	emitter.Parent = jet

	-- Classement
	local board = makePart({ Name = &quot;Leaderboard&quot;, Size = Vector3.new(22, 16, 1), CFrame = CFrame.new(pos.X + 45, 9, pos.Z), Material = Enum.Material.SmoothPlastic, Color = Config.Colors.Panel })
	board.Parent = root
	local gui = Instance.new(&quot;SurfaceGui&quot;)
	gui.Face = Enum.NormalId.Left
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	local title = Instance.new(&quot;TextLabel&quot;)
	title.Size = UDim2.new(1, 0, 0.14, 0)
	title.BackgroundTransparency = 1
	title.Text = &quot;📈 TOP COINS&quot;
	title.TextColor3 = Config.Colors.Gold
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.Parent = gui
	local list = Instance.new(&quot;TextLabel&quot;)
	list.Size = UDim2.new(1, -20, 0.84, 0)
	list.Position = UDim2.new(0, 10, 0.15, 0)
	list.BackgroundTransparency = 1
	list.Text = &quot;Chargement...&quot;
	list.TextColor3 = Color3.new(1, 1, 1)
	list.Font = Enum.Font.GothamBold
	list.TextScaled = true
	list.TextXAlignment = Enum.TextXAlignment.Left
	list.TextYAlignment = Enum.TextYAlignment.Top
	list.Parent = gui
	gui.Parent = board
	makePart({ Name = &quot;BoardFrame&quot;, Size = Vector3.new(23, 17, 0.6), CFrame = board.CFrame * CFrame.new(0, 0, 0.1), Material = Enum.Material.Neon, Color = Config.Colors.Gold }).Parent = root
	MapBuilder.LeaderboardLabel = list

	-- Stand recompense quotidienne
	stand(root, Vector3.new(pos.X + 40, 0, pos.Z + 30), Vector3.new(pos.X, 0, pos.Z), &quot;CADEAU DU JOUR&quot;, &quot;🎁&quot;, Config.Colors.Gold, &quot;DailyStand&quot;, {})
end

-- Ambiance : nuages, particules
local function buildLife(root)
	for i = 1, 14 do
		local cloud = makePart({ Name = &quot;Cloud&quot;, Size = Vector3.new(30 + (i % 3) * 12, 7, 18 + (i % 2) * 8), CFrame = CFrame.new(-250 + i * 40, 120 + (i % 4) * 12, -700 + (i * 97) % 900), Material = Enum.Material.SmoothPlastic, Color = Color3.new(1, 1, 1), Transparency = 0.3, CanCollide = false, CanQuery = false })
		cloud.Parent = root
		TweenService:Create(cloud, TweenInfo.new(40 + i * 4, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, true), { CFrame = cloud.CFrame * CFrame.new(100, 0, 0) }):Play()
	end
	for _, zone in ipairs(Config.Zones) do
		local z = makePart({ Name = &quot;Ambient&quot;, Size = Vector3.new(zone.size, 20, zone.size), CFrame = CFrame.new(zone.center + Vector3.new(0, 10, 0)), Transparency = 1, CanCollide = false, CanQuery = false })
		z.Parent = root
		local e = Instance.new(&quot;ParticleEmitter&quot;)
		e.Rate = 30
		e.Lifetime = NumberRange.new(4, 7)
		e.Speed = NumberRange.new(0.5, 1.5)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.35), NumberSequenceKeypoint.new(1, 0) })
		e.Transparency = NumberSequence.new(0.3)
		e.LightEmission = 1
		e.Color = ColorSequence.new(zone.id == &quot;Desert&quot; and Color3.fromRGB(255, 220, 150) or (zone.id == &quot;Foret&quot; and Color3.fromRGB(170, 255, 140) or Color3.fromRGB(255, 240, 200)))
		e.Shape = Enum.ParticleEmitterShape.Box
		e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
		e.Parent = z
	end
end

function MapBuilder.Build()
	local old = workspace:FindFirstChild(&quot;PetRush&quot;)
	if old then
		old:Destroy()
	end
	local baseplate = workspace:FindFirstChild(&quot;Baseplate&quot;)
	if baseplate then
		baseplate:Destroy()
	end
	local root = Instance.new(&quot;Folder&quot;)
	root.Name = &quot;PetRush&quot;
	root.Parent = workspace
	buildLighting()
	for i, zone in ipairs(Config.Zones) do
		buildZone(root, zone, i)
	end
	buildHub(root)
	buildRaceTrack(root)
	buildLife(root)
	local coins = Instance.new(&quot;Folder&quot;)
	coins.Name = &quot;Coins&quot;
	coins.Parent = workspace
	local runners = Instance.new(&quot;Folder&quot;)
	runners.Name = &quot;Racers&quot;
	runners.Parent = workspace
	Players.RespawnTime = 2
	return root
end

function MapBuilder.GetCoinSpots(zoneId)
	return coinSpots[zoneId] or {}
end

function MapBuilder.GetRaceWaypoints()
	return raceWaypoints
end

function MapBuilder.ZoneAt(position)
	for _, zone in ipairs(Config.Zones) do
		local half = zone.size / 2 + 50
		if math.abs(position.X - zone.center.X) &lt;= half and math.abs(position.Z - zone.center.Z) &lt;= half then
			return zone
		end
	end
	return nil
end

return MapBuilder
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">PetService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Pets : eclosion, equipement, evolution, index, zones, cadeau du jour, classement.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local HttpService = game:GetService(&quot;HttpService&quot;)
local CollectionService = game:GetService(&quot;CollectionService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local PetModel = require(ReplicatedStorage.Shared.PetModel)
local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)

local PetService = {}

local function notify(player, text, kind)
	Remotes.Notify:FireClient(player, text, kind or &quot;info&quot;)
end

-- Synchronisation ------------------------------------------------------------------

function PetService.Sync(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	DataService.Sync(player)
	-- Attribut lu par tous les clients pour afficher les pets qui suivent
	local equipped = {}
	for _, uid in ipairs(data.Equipped) do
		for _, pet in ipairs(data.Pets) do
			if pet.uid == uid then
				table.insert(equipped, { id = pet.id, evo = pet.evo })
			end
		end
	end
	player:SetAttribute(&quot;EquippedPets&quot;, HttpService:JSONEncode(equipped))
	player:SetAttribute(&quot;Power&quot;, PetService.GetPower(player))
	Remotes.PetsSync:FireClient(player, {
		coins = math.floor(data.Coins),
		totalCoins = math.floor(data.TotalCoins),
		pets = data.Pets,
		equipped = data.Equipped,
		zones = data.Zones,
		index = data.Index,
		hatched = data.Hatched,
		raceWins = data.RaceWins,
		races = data.Races,
		dailyReady = os.time() - (data.LastDaily or 0) &gt;= Config.Daily.Cooldown,
		dailyIn = math.max(0, Config.Daily.Cooldown - (os.time() - (data.LastDaily or 0))),
		power = PetService.GetPower(player),
	})
end

function PetService.GetPower(player)
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	local total = 0
	for _, uid in ipairs(data.Equipped) do
		for _, pet in ipairs(data.Pets) do
			if pet.uid == uid then
				total += PetModel.Stats(pet.id, pet.evo).power
			end
		end
	end
	return total
end

function PetService.GetEquippedPets(player)
	local data = DataService.Get(player)
	local list = {}
	if not data then
		return list
	end
	for _, uid in ipairs(data.Equipped) do
		for _, pet in ipairs(data.Pets) do
			if pet.uid == uid then
				table.insert(list, pet)
			end
		end
	end
	return list
end

function PetService.AddCoins(player, amount)
	local data = DataService.Get(player)
	if not data then
		return
	end
	data.Coins += amount
	if amount &gt; 0 then
		data.TotalCoins += amount
	end
end

local function findPet(data, uid)
	for i, pet in ipairs(data.Pets) do
		if pet.uid == uid then
			return pet, i
		end
	end
	return nil
end

local function givePet(player, data, petId, evo)
	local pet = { uid = data.NextUid, id = petId, evo = evo or 1 }
	data.NextUid += 1
	table.insert(data.Pets, pet)
	if not data.Index[petId] then
		data.Index[petId] = true
		notify(player, &quot;📖 Nouveau pet dans ton index : &quot; .. Config.PetById[petId].icon .. &quot; &quot; .. petId, &quot;good&quot;)
	end
	return pet
end

-- Eclosion --------------------------------------------------------------------------

local function luckBonus(player)
	local luck = 0
	for _, pet in ipairs(PetService.GetEquippedPets(player)) do
		luck += PetModel.Stats(pet.id, pet.evo).luck
	end
	return 1 + math.min(luck, 300) / 150 -- jusqu'a x3 sur les raretes hautes
end

function PetService.EggChances(eggId, luck)
	luck = luck or 1
	local pool = {}
	local total = 0
	for _, pet in ipairs(Config.Pets) do
		if pet.egg == eggId then
			local rarity = Config.RarityById[pet.rarity]
			local weight = rarity.weight * (rarity.index &gt;= 3 and luck or 1)
			table.insert(pool, { pet = pet, weight = weight })
			total += weight
		end
	end
	return pool, total
end

local function hatch(player, eggId)
	local data = DataService.Get(player)
	local egg = Config.EggById[eggId]
	if not data or not egg then
		return
	end
	if not data.Zones[egg.zone] then
		notify(player, &quot;🔒 Debloque d'abord la zone &quot; .. Config.ZoneById[egg.zone].name, &quot;danger&quot;)
		return
	end
	if #data.Pets &gt;= Config.MaxPets then
		notify(player, &quot;🐾 Inventaire plein (&quot; .. Config.MaxPets .. &quot; pets). Fais evoluer ou supprime des pets.&quot;, &quot;danger&quot;)
		return
	end
	if data.Coins &lt; egg.price then
		notify(player, &quot;🪙 Il te faut &quot; .. egg.price .. &quot; coins pour cet oeuf.&quot;, &quot;danger&quot;)
		return
	end
	data.Coins -= egg.price
	data.Hatched += 1
	local pool, total = PetService.EggChances(eggId, luckBonus(player))
	local r = math.random() * total
	local chosen = pool[1].pet
	for _, entry in ipairs(pool) do
		r -= entry.weight
		if r &lt;= 0 then
			chosen = entry.pet
			break
		end
	end
	local pet = givePet(player, data, chosen.id, 1)
	local rarity = Config.RarityById[chosen.rarity]
	Remotes.FX:FireClient(player, &quot;Hatch&quot;, { petId = chosen.id, uid = pet.uid, rarity = chosen.rarity, egg = eggId })
	if rarity.index &gt;= 5 then
		Remotes.Notify:FireAllClients(&quot;🎉 &quot; .. player.DisplayName .. &quot; a obtenu un pet &quot; .. rarity.icon .. &quot; &quot; .. rarity.name .. &quot; : &quot; .. chosen.icon .. &quot; &quot; .. chosen.id .. &quot; !&quot;, &quot;gold&quot;)
	end
	PetService.Sync(player)
end

-- Equipement / evolution / suppression ----------------------------------------------------

local function equip(player, uid)
	local data = DataService.Get(player)
	if not data then
		return
	end
	uid = tonumber(uid)
	local pet = findPet(data, uid)
	if not pet then
		return
	end
	local idx = table.find(data.Equipped, uid)
	if idx then
		table.remove(data.Equipped, idx)
	else
		if #data.Equipped &gt;= Config.MaxEquipped then
			notify(player, &quot;Tu peux equiper &quot; .. Config.MaxEquipped .. &quot; pets maximum.&quot;, &quot;danger&quot;)
			return
		end
		table.insert(data.Equipped, uid)
	end
	PetService.Sync(player)
end

local function evolve(player, uid)
	local data = DataService.Get(player)
	if not data then
		return
	end
	uid = tonumber(uid)
	local pet = findPet(data, uid)
	if not pet then
		return
	end
	if pet.evo &gt;= #Config.Evolutions then
		notify(player, &quot;Ce pet est deja au niveau maximum 🌌&quot;, &quot;info&quot;)
		return
	end
	local same = {}
	for _, other in ipairs(data.Pets) do
		if other.id == pet.id and other.evo == pet.evo then
			table.insert(same, other)
		end
	end
	if #same &lt; Config.EvolveCost then
		notify(player, &quot;Il faut &quot; .. Config.EvolveCost .. &quot; x &quot; .. PetModel.DisplayName(pet.id, pet.evo) .. &quot; (tu en as &quot; .. #same .. &quot;)&quot;, &quot;danger&quot;)
		return
	end
	-- Consomme 3 exemplaires (celui choisi en premier)
	local consumed = 0
	local toRemove = { pet }
	for _, other in ipairs(same) do
		if other ~= pet and #toRemove &lt; Config.EvolveCost then
			table.insert(toRemove, other)
		end
	end
	for _, rem in ipairs(toRemove) do
		local _, i = findPet(data, rem.uid)
		if i then
			table.remove(data.Pets, i)
			local eq = table.find(data.Equipped, rem.uid)
			if eq then
				table.remove(data.Equipped, eq)
			end
			consumed += 1
		end
	end
	local newPet = givePet(player, data, pet.id, pet.evo + 1)
	if #data.Equipped &lt; Config.MaxEquipped then
		table.insert(data.Equipped, newPet.uid)
	end
	local evo = Config.Evolutions[newPet.evo]
	Remotes.FX:FireClient(player, &quot;Evolve&quot;, { petId = newPet.id, uid = newPet.uid, evo = newPet.evo })
	Remotes.Notify:FireAllClients(&quot;🧬 &quot; .. player.DisplayName .. &quot; a fait evoluer un &quot; .. Config.PetById[pet.id].icon .. &quot; &quot; .. pet.id .. &quot; en &quot; .. evo.icon .. &quot; &quot; .. evo.name .. &quot; !&quot;, &quot;gold&quot;)
	PetService.Sync(player)
end

local function deletePet(player, uid)
	local data = DataService.Get(player)
	if not data then
		return
	end
	uid = tonumber(uid)
	local pet, i = findPet(data, uid)
	if not pet then
		return
	end
	table.remove(data.Pets, i)
	local eq = table.find(data.Equipped, uid)
	if eq then
		table.remove(data.Equipped, eq)
	end
	local rarity = Config.RarityById[Config.PetById[pet.id].rarity]
	local refund = math.floor(10 * rarity.power * Config.Evolutions[pet.evo].mult)
	PetService.AddCoins(player, refund)
	notify(player, &quot;🗑️ Pet supprime (+&quot; .. refund .. &quot; coins)&quot;, &quot;info&quot;)
	PetService.Sync(player)
end

-- Zones -----------------------------------------------------------------------------

local function unlockZone(player, zoneId)
	local data = DataService.Get(player)
	local zone = Config.ZoneById[zoneId]
	if not data or not zone or data.Zones[zoneId] then
		return
	end
	if data.Coins &lt; zone.price then
		notify(player, &quot;🔒 Il te faut &quot; .. zone.price .. &quot; coins pour &quot; .. zone.name .. &quot; (tu as &quot; .. math.floor(data.Coins) .. &quot;).&quot;, &quot;danger&quot;)
		return
	end
	data.Coins -= zone.price
	data.Zones[zoneId] = true
	Remotes.Notify:FireAllClients(&quot;🗺️ &quot; .. player.DisplayName .. &quot; a debloque &quot; .. zone.icon .. &quot; &quot; .. zone.name .. &quot; !&quot;, &quot;gold&quot;)
	Remotes.FX:FireClient(player, &quot;ZoneUnlock&quot;, { zoneId = zoneId })
	PetService.Sync(player)
end

local function teleport(player, zoneId)
	local data = DataService.Get(player)
	local zone = Config.ZoneById[zoneId]
	if not data or not zone then
		return
	end
	if not data.Zones[zoneId] then
		notify(player, &quot;🔒 Zone verrouillee : va a la porte pour la debloquer.&quot;, &quot;danger&quot;)
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if hrp then
		hrp.CFrame = CFrame.new(zone.center + Vector3.new(0, 4, zone.size / 2 - 20))
		Remotes.FX:FireClient(player, &quot;Teleport&quot;, { zoneId = zoneId })
	end
end

-- Cadeau du jour ---------------------------------------------------------------------

local function daily(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	if os.time() - (data.LastDaily or 0) &lt; Config.Daily.Cooldown then
		local left = Config.Daily.Cooldown - (os.time() - data.LastDaily)
		notify(player, string.format(&quot;🎁 Reviens dans %dh%02d pour ton cadeau.&quot;, math.floor(left / 3600), math.floor(left % 3600 / 60)), &quot;info&quot;)
		return
	end
	data.LastDaily = os.time()
	PetService.AddCoins(player, Config.Daily.Coins)
	-- Petit bonus : un oeuf du village gratuit (pet Common/Uncommon)
	local pool, total = PetService.EggChances(&quot;Village&quot;, 1)
	local r = math.random() * total
	local chosen = pool[1].pet
	for _, entry in ipairs(pool) do
		r -= entry.weight
		if r &lt;= 0 then
			chosen = entry.pet
			break
		end
	end
	local pet = givePet(player, data, chosen.id, 1)
	Remotes.FX:FireClient(player, &quot;Daily&quot;, { coins = Config.Daily.Coins, petId = chosen.id })
	Remotes.FX:FireClient(player, &quot;Hatch&quot;, { petId = chosen.id, uid = pet.uid, rarity = chosen.rarity, egg = &quot;Village&quot; })
	PetService.Sync(player)
end

-- Joueurs -------------------------------------------------------------------------------

local function onPlayerAdded(player)
	local data = DataService.Load(player)
	if #data.Pets == 0 then
		local pet = givePet(player, data, &quot;Chaton&quot;, 1)
		data.Equipped = { pet.uid }
	end
	player.CharacterAdded:Connect(function(character)
		task.spawn(function()
			local humanoid = character:WaitForChild(&quot;Humanoid&quot;, 5)
			while character.Parent and humanoid and humanoid.Health &gt; 0 do
				task.wait(0.5)
				local hrp = character:FindFirstChild(&quot;HumanoidRootPart&quot;)
				if hrp and hrp.Position.Y &lt; Config.Map.KillHeight then
					hrp.CFrame = CFrame.new(Config.Map.SpawnPosition)
				end
			end
		end)
	end)
	task.wait(1)
	if player.Parent ~= Players then
		return
	end
	PetService.Sync(player)
	if data.Hatched == 0 then
		notify(player, &quot;🐾 Bienvenue ! Ton Chaton ramasse les coins avec toi. Va au stand 🥚 pour ouvrir des oeufs.&quot;, &quot;good&quot;)
	else
		notify(player, &quot;🐾 Bon retour, &quot; .. player.DisplayName .. &quot; !&quot;, &quot;good&quot;)
	end
end

-- Classement ----------------------------------------------------------------------------

local function updateLeaderboard()
	local label = MapBuilder.LeaderboardLabel
	if not label then
		return
	end
	local entries, seen = {}, {}
	for _, p in ipairs(Players:GetPlayers()) do
		local data = DataService.Get(p)
		if data then
			table.insert(entries, { name = p.DisplayName, value = math.floor(data.TotalCoins) })
			seen[p.UserId] = true
		end
	end
	for _, entry in ipairs(DataService.GetTop(10)) do
		if not seen[entry.userId] then
			local ok, name = pcall(function()
				return Players:GetNameFromUserIdAsync(entry.userId)
			end)
			table.insert(entries, { name = ok and name or &quot;???&quot;, value = entry.value })
		end
	end
	table.sort(entries, function(a, b)
		return a.value &gt; b.value
	end)
	local lines = {}
	local medals = { &quot;🥇&quot;, &quot;🥈&quot;, &quot;🥉&quot; }
	for i = 1, math.min(10, #entries) do
		table.insert(lines, string.format(&quot;%s %s  -  %d 🪙&quot;, medals[i] or (i .. &quot;.&quot;), entries[i].name, entries[i].value))
	end
	label.Text = #lines &gt; 0 and table.concat(lines, &quot;\n&quot;) or &quot;Aucun joueur classe&quot;
end

function PetService.Init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		DataService.Save(player)
		DataService.Release(player)
	end)

	Remotes.Pets.OnServerEvent:Connect(function(player, action, a)
		if action == &quot;hatch&quot; then
			hatch(player, tostring(a))
		elseif action == &quot;equip&quot; then
			equip(player, a)
		elseif action == &quot;evolve&quot; then
			evolve(player, a)
		elseif action == &quot;delete&quot; then
			deletePet(player, a)
		elseif action == &quot;unlock&quot; then
			unlockZone(player, tostring(a))
		elseif action == &quot;teleport&quot; then
			teleport(player, tostring(a))
		elseif action == &quot;daily&quot; then
			daily(player)
		elseif action == &quot;sync&quot; then
			PetService.Sync(player)
		end
	end)

	for _, gate in ipairs(CollectionService:GetTagged(&quot;Gate&quot;)) do
		local prompt = gate:FindFirstChildOfClass(&quot;ProximityPrompt&quot;)
		if prompt then
			prompt.Triggered:Connect(function(player)
				unlockZone(player, gate:GetAttribute(&quot;ZoneId&quot;))
			end)
		end
	end
	for _, standPart in ipairs(CollectionService:GetTagged(&quot;DailyStand&quot;)) do
		local prompt = standPart:FindFirstChildOfClass(&quot;ProximityPrompt&quot;)
		if prompt then
			prompt.Triggered:Connect(daily)
		end
	end

	task.spawn(function()
		while true do
			pcall(updateLeaderboard)
			task.wait(30)
		end
	end)
end

return PetService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">RaceService</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Courses de pets : lobby, compte a rebours, simulation avec Speed / Stamina / Luck, recompenses.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local CollectionService = game:GetService(&quot;CollectionService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local PetModel = require(ReplicatedStorage.Shared.PetModel)
local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)
local PetService = require(script.Parent.PetService)

local RaceService = {}

local state = { phase = &quot;Idle&quot;, type = nil, racers = {}, endsAt = 0 }
local runnersFolder

local function broadcast(extra)
	local payload = { phase = state.phase, type = state.type and state.type.id or nil, endsAt = state.endsAt, serverTime = workspace:GetServerTimeNow(), racers = {} }
	for _, r in ipairs(state.racers) do
		table.insert(payload.racers, { name = r.name, petId = r.petId, evo = r.evo, progress = r.progress or 0, finished = r.finished, rank = r.rank, userId = r.player and r.player.UserId or 0 })
	end
	if extra then
		for k, v in pairs(extra) do
			payload[k] = v
		end
	end
	Remotes.RaceSync:FireAllClients(payload)
end

local function pathLength(points)
	local total = 0
	for i = 1, #points do
		total += (points[(i % #points) + 1] - points[i]).Magnitude
	end
	return total
end

local function pointAt(points, distance)
	local total = pathLength(points)
	distance = distance % total
	for i = 1, #points do
		local a = points[i]
		local b = points[(i % #points) + 1]
		local len = (b - a).Magnitude
		if distance &lt;= len then
			return a:Lerp(b, distance / len), b
		end
		distance -= len
	end
	return points[1], points[2]
end

local function join(player, typeId, uid)
	local data = DataService.Get(player)
	if not data then
		return
	end
	uid = tonumber(uid)
	local pet
	for _, p in ipairs(data.Pets) do
		if p.uid == uid then
			pet = p
		end
	end
	if not pet then
		Remotes.Notify:FireClient(player, &quot;Choisis un pet pour la course.&quot;, &quot;danger&quot;)
		return
	end
	if state.phase == &quot;Idle&quot; then
		local raceType
		for _, t in ipairs(Config.Race.Types) do
			if t.id == typeId then
				raceType = t
			end
		end
		if not raceType then
			return
		end
		state.phase = &quot;Lobby&quot;
		state.type = raceType
		state.racers = {}
		state.endsAt = workspace:GetServerTimeNow() + Config.Race.LobbyTime
		Remotes.Notify:FireAllClients(&quot;🏁 &quot; .. player.DisplayName .. &quot; lance une course &quot; .. raceType.icon .. &quot; &quot; .. raceType.name .. &quot; ! Rejoins au stand des courses.&quot;, &quot;good&quot;)
		task.delay(Config.Race.LobbyTime, RaceService.Start)
	elseif state.phase ~= &quot;Lobby&quot; then
		Remotes.Notify:FireClient(player, &quot;Une course est en cours, attends la prochaine.&quot;, &quot;info&quot;)
		return
	end
	for _, r in ipairs(state.racers) do
		if r.player == player then
			r.petId = pet.id
			r.evo = pet.evo
			broadcast()
			Remotes.Notify:FireClient(player, &quot;Pet de course change : &quot; .. PetModel.DisplayName(pet.id, pet.evo), &quot;good&quot;)
			return
		end
	end
	if #state.racers &gt;= Config.Race.MaxRacers then
		Remotes.Notify:FireClient(player, &quot;La course est pleine !&quot;, &quot;danger&quot;)
		return
	end
	table.insert(state.racers, { player = player, name = player.DisplayName, petId = pet.id, evo = pet.evo, progress = 0 })
	Remotes.Notify:FireClient(player, &quot;✅ Inscrit avec &quot; .. PetModel.DisplayName(pet.id, pet.evo), &quot;good&quot;)
	broadcast()
end

local function fillWithAI()
	local i = 0
	while #state.racers &lt; Config.Race.MaxRacers do
		i += 1
		local pet = Config.Pets[math.random(1, 9)]
		table.insert(state.racers, { player = nil, name = &quot;🤖 &quot; .. (Config.Race.AINames[i] or (&quot;Bot &quot; .. i)), petId = pet.id, evo = 1, progress = 0 })
	end
end

function RaceService.Start()
	if state.phase ~= &quot;Lobby&quot; then
		return
	end
	-- Retire les joueurs partis
	for i = #state.racers, 1, -1 do
		local r = state.racers[i]
		if r.player and r.player.Parent ~= Players then
			table.remove(state.racers, i)
		end
	end
	fillWithAI()
	local points = MapBuilder.GetRaceWaypoints()
	local total = pathLength(points) * state.type.laps
	state.phase = &quot;Countdown&quot;
	state.endsAt = workspace:GetServerTimeNow() + Config.Race.Countdown
	-- Modeles des coureurs
	for i, r in ipairs(state.racers) do
		local stats = PetModel.Stats(r.petId, r.evo)
		r.stats = stats
		r.progress = 0
		r.finished = false
		r.rank = nil
		r.lane = (i - 2.5) * 2.2
		local pos = pointAt(points, 0)
		r.model = PetModel.Build(r.petId, r.evo, CFrame.new(pos + Vector3.new(0, 1.5, r.lane)))
		r.model.Parent = runnersFolder
		local tag = Instance.new(&quot;BillboardGui&quot;)
		tag.Size = UDim2.fromOffset(140, 30)
		tag.StudsOffset = Vector3.new(0, 3, 0)
		tag.AlwaysOnTop = true
		local l = Instance.new(&quot;TextLabel&quot;)
		l.Size = UDim2.fromScale(1, 1)
		l.BackgroundTransparency = 1
		l.Text = r.name
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.TextColor3 = r.player and Config.Colors.Gold or Color3.new(1, 1, 1)
		l.TextStrokeTransparency = 0.3
		l.Parent = tag
		tag.Parent = r.model.PrimaryPart
	end
	broadcast()
	task.wait(Config.Race.Countdown)
	state.phase = &quot;Racing&quot;
	state.endsAt = 0
	broadcast()
	Remotes.FX:FireAllClients(&quot;RaceStart&quot;, {})

	local finishedCount = 0
	local startTime = os.clock()
	local lastSync = 0
	while finishedCount &lt; #state.racers and os.clock() - startTime &lt; 180 do
		local dt = task.wait(0.1)
		for _, r in ipairs(state.racers) do
			if not r.finished then
				local s = r.stats
				local speed = 10 + math.min(s.speed, 60) * 0.9
				-- Endurance : la vitesse chute apres 45 % de la course selon la stamina
				if r.progress / total &gt; 0.45 then
					local stamina = math.min(s.stamina, 60)
					speed = speed * (0.45 + stamina / 100)
				end
				-- Chance : rafales aleatoires
				if math.random() &lt; math.min(s.luck, 60) / 400 then
					speed = speed * 1.8
				end
				speed = speed * (0.92 + math.random() * 0.16)
				r.progress += speed * dt
				if r.progress &gt;= total then
					r.progress = total
					r.finished = true
					finishedCount += 1
					r.rank = finishedCount
				end
				local pos, nextPoint = pointAt(points, r.progress)
				local look = CFrame.lookAt(pos, Vector3.new(nextPoint.X, pos.Y, nextPoint.Z))
				local bob = math.abs(math.sin(os.clock() * 12 + r.lane)) * 0.6
				r.model:PivotTo(look * CFrame.new(r.lane, 1.2 + bob, 0))
			end
		end
		if os.clock() - lastSync &gt; 0.5 then
			lastSync = os.clock()
			broadcast({ total = total })
		end
	end
	-- Classement final
	table.sort(state.racers, function(a, b)
		return (a.rank or 99) &lt; (b.rank or 99)
	end)
	state.phase = &quot;Finished&quot;
	state.endsAt = workspace:GetServerTimeNow() + 8
	local results = {}
	for i, r in ipairs(state.racers) do
		r.rank = r.rank or i
		table.insert(results, { name = r.name, petId = r.petId, evo = r.evo, rank = r.rank, userId = r.player and r.player.UserId or 0 })
		if r.player and r.player.Parent == Players then
			local data = DataService.Get(r.player)
			if data then
				data.Races += 1
				local reward = (r.rank == 1) and state.type.reward or (r.rank == 2 and math.floor(state.type.reward * 0.4) or math.floor(state.type.reward * 0.15))
				if r.rank == 1 then
					data.RaceWins += 1
				end
				PetService.AddCoins(r.player, reward)
				PetService.Sync(r.player)
				Remotes.Notify:FireClient(r.player, (r.rank == 1 and &quot;🥇 VICTOIRE ! &quot; or (r.rank == 2 and &quot;🥈 &quot; or &quot;🏁 &quot;)) .. &quot;Course terminee : +&quot; .. reward .. &quot; coins&quot;, r.rank == 1 and &quot;gold&quot; or &quot;good&quot;)
			end
		end
	end
	local winner = state.racers[1]
	Remotes.Notify:FireAllClients(&quot;🏆 &quot; .. winner.name .. &quot; remporte la course &quot; .. state.type.icon .. &quot; &quot; .. state.type.name .. &quot; avec &quot; .. PetModel.DisplayName(winner.petId, winner.evo) .. &quot; !&quot;, &quot;gold&quot;)
	broadcast({ results = results })
	Remotes.FX:FireAllClients(&quot;RaceEnd&quot;, { winnerUserId = winner.player and winner.player.UserId or 0, position = winner.model and winner.model:GetPivot().Position or nil })
	task.wait(8)
	for _, r in ipairs(state.racers) do
		if r.model then
			r.model:Destroy()
		end
	end
	state.phase = &quot;Idle&quot;
	state.type = nil
	state.racers = {}
	state.endsAt = 0
	broadcast()
end

function RaceService.Init()
	runnersFolder = workspace:FindFirstChild(&quot;Racers&quot;) or Instance.new(&quot;Folder&quot;)
	runnersFolder.Name = &quot;Racers&quot;
	runnersFolder.Parent = workspace
	Remotes.Race.OnServerEvent:Connect(function(player, action, a, b)
		if action == &quot;join&quot; then
			join(player, tostring(a), b)
		elseif action == &quot;state&quot; then
			broadcast()
		end
	end)
	Players.PlayerAdded:Connect(function()
		task.wait(1)
		broadcast()
	end)
end

return RaceService
</ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000016"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000015"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000014"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX0000000E"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Point d'entree client de PET RUSH.

local Modules = script.Parent.Modules
local HUD = require(Modules.HUD)
local Effects = require(Modules.Effects)
local PetFollow = require(Modules.PetFollow)

HUD.Init()
Effects.Init(HUD)
PetFollow.Init()
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000013"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Effects</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Effets : coins qui tournent, collecte, coffres, eclosion, evolution, courses, teleportation, sons.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local Debris = game:GetService(&quot;Debris&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)

local Effects = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local HUD

local SOUNDS = {
	coin = &quot;rbxasset://sounds/electronicpingshort.wav&quot;,
	chest = &quot;rbxasset://sounds/victory.wav&quot;,
	hatch = &quot;rbxasset://sounds/snap.wav&quot;,
	rare = &quot;rbxasset://sounds/victory.wav&quot;,
	evolve = &quot;rbxasset://sounds/HalloweenGhost.wav&quot;,
	race = &quot;rbxasset://sounds/swoosh.wav&quot;,
	win = &quot;rbxasset://sounds/victory.wav&quot;,
	teleport = &quot;rbxasset://sounds/flashbulb.wav&quot;,
	unlock = &quot;rbxasset://sounds/bass.wav&quot;,
	click = &quot;rbxasset://sounds/button.wav&quot;,
}

local function playSound(name, volume, pitch, position)
	local s = Instance.new(&quot;Sound&quot;)
	s.SoundId = SOUNDS[name] or SOUNDS.click
	s.Volume = volume or 0.5
	s.PlaybackSpeed = pitch or 1
	if position then
		local holder = Instance.new(&quot;Part&quot;)
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.Transparency = 1
		holder.Size = Vector3.new(1, 1, 1)
		holder.Position = position
		holder.Parent = workspace
		s.RollOffMaxDistance = 120
		s.Parent = holder
		Debris:AddItem(holder, 4)
	else
		s.Parent = workspace
		Debris:AddItem(s, 4)
	end
	s:Play()
end

local function burst(position, color, count, speed, size, gravity)
	local holder = Instance.new(&quot;Part&quot;)
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.new(1, 1, 1)
	holder.Position = position
	holder.Parent = workspace
	local att = Instance.new(&quot;Attachment&quot;)
	att.Parent = holder
	local e = Instance.new(&quot;ParticleEmitter&quot;)
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.5, 1)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new(0, 1)
	e.LightEmission = 1
	e.Acceleration = Vector3.new(0, gravity or -15, 0)
	e.Drag = 3
	e.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	e.Parent = att
	e:Emit(count)
	Debris:AddItem(holder, 2)
end

local function shockwave(position, color, size, duration)
	local ring = Instance.new(&quot;Part&quot;)
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.4, 1, 1)
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.2
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace
	TweenService:Create(ring, TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = Vector3.new(0.4, size, size), Transparency = 1 }):Play()
	Debris:AddItem(ring, duration + 0.1)
end

local function floatingText(position, text, color, size)
	local holder = Instance.new(&quot;Part&quot;)
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.new(1, 1, 1)
	holder.Position = position + Vector3.new(0, 2, 0)
	holder.Parent = workspace
	local gui = Instance.new(&quot;BillboardGui&quot;)
	gui.Size = UDim2.fromOffset(size or 140, 40)
	gui.AlwaysOnTop = true
	gui.Parent = holder
	local l = Instance.new(&quot;TextLabel&quot;)
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Text = text
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.2
	l.Parent = gui
	TweenService:Create(holder, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = holder.Position + Vector3.new(0, 4, 0) }):Play()
	task.delay(0.6, function()
		TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
	Debris:AddItem(holder, 1.1)
end

local function flashScreen(color, transparency, duration)
	local gui = player.PlayerGui:FindFirstChild(&quot;PetFlash&quot;)
	if not gui then
		gui = Instance.new(&quot;ScreenGui&quot;)
		gui.Name = &quot;PetFlash&quot;
		gui.IgnoreGuiInset = true
		gui.ResetOnSpawn = false
		gui.DisplayOrder = 50
		gui.Parent = player.PlayerGui
		local frame = Instance.new(&quot;Frame&quot;)
		frame.Name = &quot;Flash&quot;
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundTransparency = 1
		frame.BorderSizePixel = 0
		frame.Parent = gui
	end
	local frame = gui.Flash
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency
	TweenService:Create(frame, TweenInfo.new(duration), { BackgroundTransparency = 1 }):Play()
end

-- Rotation des coins et coffres (rendu local)
RunService.Heartbeat:Connect(function()
	local folder = workspace:FindFirstChild(&quot;Coins&quot;)
	if not folder then
		return
	end
	local t = os.clock()
	for _, coin in ipairs(folder:GetChildren()) do
		if coin:IsA(&quot;BasePart&quot;) then
			local base = coin:GetAttribute(&quot;BaseY&quot;)
			if not base then
				base = coin.Position.Y
				coin:SetAttribute(&quot;BaseY&quot;, base)
			end
			local p = coin.Position
			if coin.Name == &quot;Coin&quot; then
				coin.CFrame = CFrame.new(p.X, base + math.sin(t * 3 + p.X) * 0.4, p.Z) * CFrame.Angles(0, t * 2.5, math.rad(90))
			else
				coin.CFrame = CFrame.new(p.X, base + math.sin(t * 2) * 0.6, p.Z) * CFrame.Angles(0, t * 1.2, 0)
			end
		end
	end
end)

local handlers = {}

handlers.Collect = function(data)
	local mine = data.userId == player.UserId
	if data.chest then
		burst(data.position, Config.Colors.Accent2, 60, 25, 0.9, -10)
		shockwave(data.position, Config.Colors.Accent2, 30, 0.8)
		playSound(&quot;chest&quot;, mine and 1 or 0.5, 1.1, data.position)
	else
		burst(data.position, Config.Colors.Gold, 10, 8, 0.4, -10)
		if mine then
			playSound(&quot;coin&quot;, 0.4, 1.2 + math.random() * 0.4, data.position)
		end
	end
	if mine then
		floatingText(data.position, &quot;+&quot; .. data.amount .. &quot; 🪙&quot;, Config.Colors.Gold, data.chest and 220 or 130)
		if data.chest then
			flashScreen(Config.Colors.Gold, 0.75, 0.6)
		end
	end
end

handlers.ChestSpawn = function(data)
	shockwave(data.position, Config.Colors.Accent2, 40, 1.2)
	playSound(&quot;unlock&quot;, 0.6, 1.2)
end

handlers.Hatch = function(data)
	local rarity = Config.RarityById[data.rarity]
	HUD.playHatch(data)
	playSound(&quot;hatch&quot;, 0.7, 0.9)
	task.delay(0.95, function()
		playSound(rarity.index &gt;= 4 and &quot;rare&quot; or &quot;coin&quot;, 0.8, rarity.index &gt;= 4 and 1 or 1.5)
		flashScreen(rarity.color, 0.6, 0.8)
		local char = player.Character
		local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
		if hrp then
			burst(hrp.Position, rarity.color, 40 + rarity.index * 10, 15, 0.7, 2)
			shockwave(hrp.Position - Vector3.new(0, 2, 0), rarity.color, 10 + rarity.index * 4, 0.8)
		end
	end)
end

handlers.Evolve = function(data)
	local evo = Config.Evolutions[data.evo]
	playSound(&quot;evolve&quot;, 0.8, 1.3)
	flashScreen(evo.color or Config.Colors.Gold, 0.5, 1.2)
	local char = player.Character
	local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if hrp then
		burst(hrp.Position, evo.color or Config.Colors.Gold, 80, 20, 0.9, 4)
		shockwave(hrp.Position - Vector3.new(0, 2, 0), evo.color or Config.Colors.Gold, 30, 1)
		floatingText(hrp.Position + Vector3.new(0, 3, 0), evo.icon .. &quot; &quot; .. evo.name .. &quot; !&quot;, evo.color or Config.Colors.Gold, 240)
	end
	HUD.playHatch({ petId = data.petId, rarity = Config.PetById[data.petId].rarity, egg = &quot;Village&quot; })
end

handlers.ZoneUnlock = function(data)
	local zone = Config.ZoneById[data.zoneId]
	playSound(&quot;unlock&quot;, 1, 1)
	flashScreen(Config.Colors.Gold, 0.5, 1)
	HUD.toast(&quot;🗺️ &quot; .. zone.icon .. &quot; &quot; .. zone.name .. &quot; debloque ! Utilise le menu ZONES pour t'y rendre.&quot;, &quot;gold&quot;)
end

handlers.Teleport = function(data)
	playSound(&quot;teleport&quot;, 0.6, 1)
	flashScreen(Config.Colors.Accent, 0.4, 0.8)
	local char = player.Character
	local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if hrp then
		shockwave(hrp.Position - Vector3.new(0, 2, 0), Config.Colors.Accent, 20, 0.8)
	end
end

handlers.Daily = function(data)
	playSound(&quot;win&quot;, 0.8, 1.2)
	flashScreen(Config.Colors.Gold, 0.6, 1)
	HUD.toast(&quot;🎁 Cadeau du jour : +&quot; .. data.coins .. &quot; coins et un oeuf gratuit !&quot;, &quot;gold&quot;)
end

handlers.RaceStart = function()
	playSound(&quot;race&quot;, 1, 0.8)
	flashScreen(Color3.new(1, 1, 1), 0.7, 0.5)
end

handlers.RaceEnd = function(data)
	if data.position then
		burst(data.position, Config.Colors.Gold, 60, 20, 0.8, 2)
		shockwave(data.position, Config.Colors.Gold, 30, 1)
	end
	if data.winnerUserId == player.UserId then
		playSound(&quot;win&quot;, 1, 1)
		flashScreen(Config.Colors.Gold, 0.5, 1.5)
	else
		playSound(&quot;win&quot;, 0.4, 1.3)
	end
end

function Effects.Init(hudModule)
	HUD = hudModule
	Remotes.FX.OnClientEvent:Connect(function(kind, data)
		local handler = handlers[kind]
		if handler then
			local ok, err = pcall(handler, data or {})
			if not ok then
				warn(&quot;[PetRush] Effet &quot; .. kind .. &quot; : &quot; .. tostring(err))
			end
		end
	end)
	-- Compteur de coins anime
	local lastCoins = nil
	State.Changed.Event:Connect(function(what, data)
		if what == &quot;sync&quot; then
			if lastCoins and data.coins &gt; lastCoins then
				playSound(&quot;click&quot;, 0.15, 1.6)
			end
			lastCoins = data.coins
		end
	end)
end

return Effects
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">HUD</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Interface PET RUSH : coins, pets, oeufs, index, zones, courses, cadeau du jour, notifications.

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)
local ProximityPromptService = game:GetService(&quot;ProximityPromptService&quot;)
local CollectionService = game:GetService(&quot;CollectionService&quot;)

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local PetModel = require(ReplicatedStorage.Shared.PetModel)
local State = require(script.Parent.State)

local HUD = {}
local ICON = Config.Icons

local player = Players.LocalPlayer
local playerGui = player:WaitForChild(&quot;PlayerGui&quot;)
local FONT = Enum.Font.FredokaOne
local FONT_BOLD = Enum.Font.GothamBold
local TOUCH = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local ui = {}
local panels = {}

-- Helpers -------------------------------------------------------------------------------

local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end
local function corner(p, r)
	return new(&quot;UICorner&quot;, { CornerRadius = UDim.new(0, r or 12) }, p)
end
local function stroke(p, color, thickness, transparency)
	return new(&quot;UIStroke&quot;, { Color = color, Thickness = thickness or 2, Transparency = transparency or 0 }, p)
end
local function gradient(p, c1, c2, rotation)
	return new(&quot;UIGradient&quot;, { Color = ColorSequence.new(c1, c2), Rotation = rotation or 90 }, p)
end
local function label(props, parent)
	local base = { BackgroundTransparency = 1, Font = FONT, TextColor3 = Color3.new(1, 1, 1), TextScaled = true, TextStrokeTransparency = 0.75, TextStrokeColor3 = Color3.new(0, 0, 0) }
	for k, v in pairs(props) do
		base[k] = v
	end
	return new(&quot;TextLabel&quot;, base, parent)
end
local function glass(props, parent, color)
	local base = { BackgroundColor3 = Config.Colors.Panel, BackgroundTransparency = 0.1, BorderSizePixel = 0 }
	for k, v in pairs(props) do
		base[k] = v
	end
	local f = new(&quot;Frame&quot;, base, parent)
	corner(f, 14)
	gradient(f, Config.Colors.Panel, Config.Colors.Panel2, 90)
	stroke(f, color or Config.Colors.Accent, 2, 0.3)
	return f
end
local function button(props, parent, color)
	color = color or Config.Colors.Accent
	local base = { BackgroundColor3 = color, Font = FONT, TextColor3 = Color3.new(1, 1, 1), TextScaled = true, AutoButtonColor = false, Text = &quot;&quot;, BorderSizePixel = 0 }
	for k, v in pairs(props) do
		base[k] = v
	end
	local b = new(&quot;TextButton&quot;, base, parent)
	corner(b, 12)
	gradient(b, Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170), 90)
	stroke(b, Color3.new(1, 1, 1), 1.5, 0.6)
	new(&quot;UIPadding&quot;, { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5) }, b)
	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = color:Lerp(Color3.new(1, 1, 1), 0.25) }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.15), { BackgroundColor3 = color }):Play()
	end)
	return b
end
local function panel(name, size, title, icon, color, parent)
	local frame = new(&quot;Frame&quot;, { Name = name, Size = size, Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Config.Colors.Panel, BackgroundTransparency = 0.04, Visible = false, BorderSizePixel = 0 }, parent)
	corner(frame, 20)
	gradient(frame, Config.Colors.Panel, Config.Colors.Panel2, 90)
	stroke(frame, color, 3, 0.1)
	local head = new(&quot;Frame&quot;, { Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = color, BackgroundTransparency = 0.7, BorderSizePixel = 0 }, frame)
	corner(head, 20)
	gradient(head, Color3.new(1, 1, 1), Color3.new(0, 0, 0), 0)
	local t = label({ Name = &quot;Title&quot;, Size = UDim2.new(1, -80, 0, 36), Position = UDim2.new(0, 18, 0, 10), Text = icon .. &quot;  &quot; .. title, TextXAlignment = Enum.TextXAlignment.Left }, head)
	local close = button({ Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -10, 0, 8), AnchorPoint = Vector2.new(1, 0), Text = &quot;✕&quot; }, head, Config.Colors.Danger)
	close.Activated:Connect(function()
		HUD.hide(frame)
	end)
	frame:SetAttribute(&quot;FullSize&quot;, size)
	panels[name] = frame
	ui[name .. &quot;Title&quot;] = t
	return frame
end
local function scrollList(parent, top, bottom)
	local scroll = new(&quot;ScrollingFrame&quot;, { Size = UDim2.new(1, -24, 1, -(top + (bottom or 12))), Position = UDim2.new(0, 12, 0, top), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6, ScrollBarImageColor3 = Config.Colors.Accent, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y }, parent)
	new(&quot;UIListLayout&quot;, { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
	return scroll
end
local function grid(parent, top, cell)
	local scroll = new(&quot;ScrollingFrame&quot;, { Size = UDim2.new(1, -24, 1, -(top + 12)), Position = UDim2.new(0, 12, 0, top), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6, ScrollBarImageColor3 = Config.Colors.Accent, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y }, parent)
	new(&quot;UIGridLayout&quot;, { CellSize = cell, CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
	return scroll
end

function HUD.show(frame)
	for _, other in pairs(panels) do
		if other ~= frame and other.Visible then
			other.Visible = false
		end
	end
	frame.Visible = true
	local size = frame:GetAttribute(&quot;FullSize&quot;)
	frame.Size = UDim2.fromOffset(size.X.Offset * 0.8, size.Y.Offset * 0.8)
	TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = size }):Play()
end
function HUD.hide(frame)
	local size = frame:GetAttribute(&quot;FullSize&quot;)
	local t = TweenService:Create(frame, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.fromOffset(size.X.Offset * 0.85, size.Y.Offset * 0.85) })
	t:Play()
	t.Completed:Connect(function()
		frame.Visible = false
		frame.Size = size
	end)
end
function HUD.toggle(name)
	local frame = panels[name]
	if not frame then
		return
	end
	if frame.Visible then
		HUD.hide(frame)
	else
		if ui.rebuild[name] then
			ui.rebuild[name]()
		end
		HUD.show(frame)
	end
end

local function rarityOf(petId)
	return Config.RarityById[Config.PetById[petId].rarity]
end

local function statsText(petId, evo)
	local s = PetModel.Stats(petId, evo)
	return string.format(&quot;%s %d  %s %d  %s %d  %s %d&quot;, ICON.speed, s.speed, ICON.power, s.power, ICON.stamina, s.stamina, ICON.luck, s.luck)
end

-- Construction -------------------------------------------------------------------------------

local function build()
	local gui = new(&quot;ScreenGui&quot;, { Name = &quot;PetHUD&quot;, ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, playerGui)
	ui.gui = gui
	ui.rebuild = {}

	-- Barre du haut (gauche)
	local top = glass({ Size = UDim2.fromOffset(330, 92), Position = UDim2.new(0, 14, 0, 14) }, gui, Config.Colors.Gold)
	ui.coins = label({ Size = UDim2.new(1, -16, 0, 40), Position = UDim2.new(0, 10, 0, 6), Text = ICON.coins .. &quot; 0&quot;, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Config.Colors.Gold }, top)
	ui.power = label({ Size = UDim2.new(1, -16, 0, 22), Position = UDim2.new(0, 10, 0, 46), Text = &quot;&quot;, Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Config.Colors.Accent }, top)
	ui.stats = label({ Size = UDim2.new(1, -16, 0, 18), Position = UDim2.new(0, 10, 0, 68), Text = &quot;&quot;, Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(210, 210, 225) }, top)

	-- Boutons menu (droite)
	local right = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(176, 300), Position = UDim2.new(1, -14, 0, 14), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1 }, gui)
	new(&quot;UIListLayout&quot;, { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right }, right)
	local menuDefs = {
		{ &quot;Pets&quot;, ICON.pets .. &quot;  MES PETS&quot;, Config.Colors.Accent2, &quot;P&quot; },
		{ &quot;Index&quot;, ICON.index .. &quot;  INDEX&quot;, Config.Colors.Accent, &quot;I&quot; },
		{ &quot;Zones&quot;, ICON.zone .. &quot;  ZONES&quot;, Config.Colors.Grass, &quot;Z&quot; },
		{ &quot;Race&quot;, ICON.race .. &quot;  COURSES&quot;, Config.Colors.Gold, &quot;R&quot; },
	}
	ui.menuButtons = {}
	for i, def in ipairs(menuDefs) do
		local b = button({ Size = UDim2.fromOffset(176, 46), Text = def[2] .. (TOUCH and &quot;&quot; or &quot;  &quot; .. def[4]), LayoutOrder = i }, right, def[3])
		b.Activated:Connect(function()
			HUD.toggle(def[1])
		end)
		ui.menuButtons[def[1]] = b
	end
	ui.dailyButton = button({ Size = UDim2.fromOffset(176, 46), Text = ICON.daily .. &quot;  CADEAU&quot;, LayoutOrder = 5, Visible = false }, right, Config.Colors.Gold)
	ui.dailyButton.Activated:Connect(function()
		Remotes.Pets:FireServer(&quot;daily&quot;)
	end)

	-- Pets equipes (bas gauche)
	ui.equippedBar = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(330, 70), Position = UDim2.new(0, 14, 1, -14), AnchorPoint = Vector2.new(0, 1), BackgroundTransparency = 1 }, gui)
	new(&quot;UIListLayout&quot;, { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, ui.equippedBar)

	-- Zone actuelle (bas centre)
	ui.zoneLabel = label({ Size = UDim2.fromOffset(400, 30), Position = UDim2.new(0.5, 0, 1, -16), AnchorPoint = Vector2.new(0.5, 1), Text = &quot;&quot;, Font = FONT_BOLD, TextColor3 = Color3.fromRGB(230, 230, 240) }, gui)

	-- Notifications
	ui.toasts = new(&quot;Frame&quot;, { Size = UDim2.fromOffset(620, 240), Position = UDim2.new(0.5, 0, 0, 16), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1 }, gui)
	new(&quot;UIListLayout&quot;, { HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }, ui.toasts)

	-- Course en direct (haut centre sous les toasts)
	ui.raceLive = glass({ Size = UDim2.fromOffset(300, 150), Position = UDim2.new(1, -14, 0, 300), AnchorPoint = Vector2.new(1, 0), Visible = false }, gui, Config.Colors.Gold)
	ui.raceLiveTitle = label({ Size = UDim2.new(1, -16, 0, 26), Position = UDim2.new(0, 8, 0, 6), Text = &quot;🏁 COURSE&quot;, TextColor3 = Config.Colors.Gold, TextXAlignment = Enum.TextXAlignment.Left }, ui.raceLive)
	ui.raceLiveList = label({ Size = UDim2.new(1, -16, 1, -40), Position = UDim2.new(0, 8, 0, 34), Text = &quot;&quot;, Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextScaled = false, TextSize = 16 }, ui.raceLive)

	-- Panneaux
	local pets = panel(&quot;Pets&quot;, UDim2.fromOffset(760, 540), &quot;MES PETS&quot;, ICON.pets, Config.Colors.Accent2, gui)
	ui.petsInfo = label({ Size = UDim2.new(1, -32, 0, 22), Position = UDim2.new(0, 16, 0, 60), Text = &quot;&quot;, Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(210, 210, 225) }, pets)
	ui.petsGrid = grid(pets, 88, UDim2.fromOffset(232, 150))

	local index = panel(&quot;Index&quot;, UDim2.fromOffset(760, 540), &quot;PET INDEX&quot;, ICON.index, Config.Colors.Accent, gui)
	ui.indexInfo = label({ Size = UDim2.new(1, -32, 0, 22), Position = UDim2.new(0, 16, 0, 60), Text = &quot;&quot;, Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(210, 210, 225) }, index)
	ui.indexGrid = grid(index, 88, UDim2.fromOffset(140, 120))

	local zones = panel(&quot;Zones&quot;, UDim2.fromOffset(520, 400), &quot;ZONES&quot;, ICON.zone, Config.Colors.Grass, gui)
	ui.zonesList = scrollList(zones, 64)

	local egg = panel(&quot;Egg&quot;, UDim2.fromOffset(520, 560), &quot;OEUF&quot;, ICON.egg, Config.Colors.Accent2, gui)
	ui.eggList = scrollList(egg, 64, 70)
	ui.eggButton = button({ Size = UDim2.new(1, -24, 0, 50), Position = UDim2.new(0, 12, 1, -60), Text = &quot;&quot; }, egg, Config.Colors.Gold)
	ui.eggButton.Activated:Connect(function()
		if ui.currentEgg then
			Remotes.Pets:FireServer(&quot;hatch&quot;, ui.currentEgg)
		end
	end)

	local race = panel(&quot;Race&quot;, UDim2.fromOffset(640, 540), &quot;COURSES DE PETS&quot;, ICON.race, Config.Colors.Gold, gui)
	ui.raceInfo = label({ Size = UDim2.new(1, -32, 0, 40), Position = UDim2.new(0, 16, 0, 60), Text = &quot;&quot;, Font = FONT_BOLD, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(220, 220, 235) }, race)
	ui.raceTypes = new(&quot;Frame&quot;, { Size = UDim2.new(1, -24, 0, 70), Position = UDim2.new(0, 12, 0, 104), BackgroundTransparency = 1 }, race)
	new(&quot;UIListLayout&quot;, { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, ui.raceTypes)
	ui.racePets = grid(race, 184, UDim2.fromOffset(190, 100))
	ui.racePets.Size = UDim2.new(1, -24, 1, -250)
	ui.raceJoin = button({ Size = UDim2.new(1, -24, 0, 48), Position = UDim2.new(0, 12, 1, -58), Text = &quot;&quot; }, race, Config.Colors.Gold)
	ui.raceJoin.Activated:Connect(function()
		if ui.raceType and ui.racePet then
			Remotes.Race:FireServer(&quot;join&quot;, ui.raceType, ui.racePet)
		else
			HUD.toast(&quot;Choisis un type de course et un pet.&quot;, &quot;info&quot;)
		end
	end)

	-- Eclosion plein ecran
	ui.hatch = new(&quot;Frame&quot;, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Config.Colors.Panel2, BackgroundTransparency = 0.25, Visible = false, ZIndex = 30, BorderSizePixel = 0 }, gui)
	ui.hatchEgg = label({ Size = UDim2.fromOffset(220, 220), Position = UDim2.new(0.5, 0, 0.45, 0), AnchorPoint = Vector2.new(0.5, 0.5), Text = &quot;🥚&quot;, ZIndex = 31, TextStrokeTransparency = 1 }, ui.hatch)
	ui.hatchName = label({ Size = UDim2.fromOffset(700, 60), Position = UDim2.new(0.5, 0, 0.68, 0), AnchorPoint = Vector2.new(0.5, 0.5), Text = &quot;&quot;, ZIndex = 31 }, ui.hatch)
	ui.hatchRarity = label({ Size = UDim2.fromOffset(500, 34), Position = UDim2.new(0.5, 0, 0.76, 0), AnchorPoint = Vector2.new(0.5, 0.5), Text = &quot;&quot;, Font = FONT_BOLD, ZIndex = 31 }, ui.hatch)
	ui.hatchStats = label({ Size = UDim2.fromOffset(500, 26), Position = UDim2.new(0.5, 0, 0.82, 0), AnchorPoint = Vector2.new(0.5, 0.5), Text = &quot;&quot;, Font = FONT_BOLD, ZIndex = 31, TextColor3 = Color3.fromRGB(220, 220, 235) }, ui.hatch)
end

-- Notifications ------------------------------------------------------------------------------

local toastCount = 0
function HUD.toast(text, kind)
	toastCount += 1
	local colors = { danger = Config.Colors.Danger, gold = Config.Colors.Gold, good = Config.Colors.Accent, info = Color3.fromRGB(210, 210, 225) }
	local color = colors[kind] or colors.info
	local frame = glass({ Size = UDim2.new(1, 0, 0, 40), LayoutOrder = toastCount, BackgroundTransparency = 0.15 }, ui.toasts, color)
	local l = label({ Size = UDim2.new(1, -20, 1, -10), Position = UDim2.new(0, 10, 0, 5), Text = text, TextColor3 = color, Font = FONT_BOLD }, frame)
	frame.Size = UDim2.new(1, 0, 0, 0)
	TweenService:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, 40) }):Play()
	task.delay(4, function()
		TweenService:Create(frame, TweenInfo.new(0.4), { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0) }):Play()
		TweenService:Create(l, TweenInfo.new(0.3), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.wait(0.45)
		frame:Destroy()
	end)
end

-- Carte de pet ---------------------------------------------------------------------------------

local function petCard(parent, pet, order, options)
	local def = Config.PetById[pet.id]
	local rarity = rarityOf(pet.id)
	local evo = Config.Evolutions[pet.evo]
	local card = new(&quot;Frame&quot;, { BackgroundColor3 = Config.Colors.Panel, LayoutOrder = order, BorderSizePixel = 0 }, parent)
	corner(card, 12)
	gradient(card, rarity.color:Lerp(Config.Colors.Panel, 0.7), Config.Colors.Panel2, 90)
	stroke(card, options.selected and Config.Colors.Gold or (evo.color or rarity.color), options.selected and 4 or 2)
	label({ Size = UDim2.fromOffset(54, 54), Position = UDim2.new(0, 6, 0, 6), Text = def.icon, TextStrokeTransparency = 1 }, card)
	label({ Size = UDim2.new(1, -70, 0, 24), Position = UDim2.new(0, 64, 0, 8), Text = (evo.icon ~= &quot;&quot; and evo.icon .. &quot; &quot; or &quot;&quot;) .. pet.id, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = evo.color or Color3.new(1, 1, 1) }, card)
	label({ Size = UDim2.new(1, -70, 0, 18), Position = UDim2.new(0, 64, 0, 34), Text = rarity.icon .. &quot; &quot; .. rarity.name .. (evo.name ~= &quot;&quot; and (&quot;  •  &quot; .. evo.name) or &quot;&quot;), Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = rarity.color }, card)
	label({ Size = UDim2.new(1, -12, 0, 18), Position = UDim2.new(0, 6, 0, 62), Text = statsText(pet.id, pet.evo), Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(215, 215, 230) }, card)
	return card
end

-- Mes pets --------------------------------------------------------------------------------------

local function rebuildPets()
	for _, child in ipairs(ui.petsGrid:GetChildren()) do
		if child:IsA(&quot;Frame&quot;) then
			child:Destroy()
		end
	end
	local data = State.data
	ui.petsInfo.Text = string.format(&quot;%d / %d pets  •  %d / %d equipes  •  %s Puissance totale %d  •  %s %d exemplaires identiques = evolution&quot;, #data.pets, Config.MaxPets, #data.equipped, Config.MaxEquipped, ICON.power, data.power, ICON.evolve, Config.EvolveCost)
	local sorted = table.clone(data.pets)
	table.sort(sorted, function(a, b)
		local ra, rb = rarityOf(a.id).index, rarityOf(b.id).index
		if ra ~= rb then
			return ra &gt; rb
		end
		if a.evo ~= b.evo then
			return a.evo &gt; b.evo
		end
		return a.uid &lt; b.uid
	end)
	local counts = {}
	for _, pet in ipairs(data.pets) do
		local k = pet.id .. &quot;:&quot; .. pet.evo
		counts[k] = (counts[k] or 0) + 1
	end
	for i, pet in ipairs(sorted) do
		local equipped = table.find(data.equipped, pet.uid) ~= nil
		local card = petCard(ui.petsGrid, pet, i, { selected = equipped })
		local eq = button({ Size = UDim2.new(0.5, -8, 0, 30), Position = UDim2.new(0, 6, 1, -36), Text = equipped and &quot;✔ EQUIPE&quot; or ICON.equip .. &quot; EQUIPER&quot; }, card, equipped and Color3.fromRGB(70, 70, 90) or Config.Colors.Accent)
		eq.Activated:Connect(function()
			Remotes.Pets:FireServer(&quot;equip&quot;, pet.uid)
		end)
		local same = counts[pet.id .. &quot;:&quot; .. pet.evo] or 0
		local canEvolve = same &gt;= Config.EvolveCost and pet.evo &lt; #Config.Evolutions
		local ev = button({ Size = UDim2.new(0.5, -8, 0, 30), Position = UDim2.new(0.5, 2, 1, -36), Text = pet.evo &gt;= #Config.Evolutions and &quot;🌌 MAX&quot; or (ICON.evolve .. &quot; &quot; .. same .. &quot;/&quot; .. Config.EvolveCost) }, card, canEvolve and Config.Colors.Accent2 or Color3.fromRGB(70, 70, 90))
		ev.Activated:Connect(function()
			Remotes.Pets:FireServer(&quot;evolve&quot;, pet.uid)
		end)
		local del = button({ Size = UDim2.fromOffset(26, 26), Position = UDim2.new(1, -4, 0, 4), AnchorPoint = Vector2.new(1, 0), Text = ICON.delete }, card, Config.Colors.Danger)
		del.Activated:Connect(function()
			Remotes.Pets:FireServer(&quot;delete&quot;, pet.uid)
		end)
	end
end

local function rebuildEquippedBar()
	for _, child in ipairs(ui.equippedBar:GetChildren()) do
		if child:IsA(&quot;Frame&quot;) then
			child:Destroy()
		end
	end
	for i, uid in ipairs(State.data.equipped) do
		local pet = State.petByUid(uid)
		if pet then
			local rarity = rarityOf(pet.id)
			local evo = Config.Evolutions[pet.evo]
			local slot = glass({ Size = UDim2.fromOffset(70, 70), LayoutOrder = i }, ui.equippedBar, evo.color or rarity.color)
			label({ Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 0, 4), Text = Config.PetById[pet.id].icon, TextStrokeTransparency = 1 }, slot)
			label({ Size = UDim2.new(1, -4, 0, 16), Position = UDim2.new(0, 2, 1, -20), Text = (evo.icon ~= &quot;&quot; and evo.icon or rarity.icon) .. &quot; &quot; .. pet.id, Font = FONT_BOLD }, slot)
		end
	end
	for i = #State.data.equipped + 1, Config.MaxEquipped do
		local slot = glass({ Size = UDim2.fromOffset(70, 70), LayoutOrder = i, BackgroundTransparency = 0.5 }, ui.equippedBar, Color3.fromRGB(90, 90, 110))
		label({ Size = UDim2.fromScale(1, 1), Text = &quot;+&quot;, TextColor3 = Color3.fromRGB(120, 120, 140) }, slot)
	end
end

-- Index ----------------------------------------------------------------------------------------

local function rebuildIndex()
	for _, child in ipairs(ui.indexGrid:GetChildren()) do
		if child:IsA(&quot;Frame&quot;) then
			child:Destroy()
		end
	end
	local found = 0
	for _, pet in ipairs(Config.Pets) do
		if State.data.index[pet.id] then
			found += 1
		end
	end
	ui.indexInfo.Text = string.format(&quot;%d / %d pets decouverts  •  %s %d oeufs ouverts&quot;, found, #Config.Pets, ICON.egg, State.data.hatched)
	for i, pet in ipairs(Config.Pets) do
		local known = State.data.index[pet.id] == true
		local rarity = Config.RarityById[pet.rarity]
		local egg = Config.EggById[pet.egg]
		local card = new(&quot;Frame&quot;, { BackgroundColor3 = Config.Colors.Panel, LayoutOrder = i, BorderSizePixel = 0 }, ui.indexGrid)
		corner(card, 12)
		gradient(card, known and rarity.color:Lerp(Config.Colors.Panel, 0.65) or Config.Colors.Panel, Config.Colors.Panel2, 90)
		stroke(card, known and rarity.color or Color3.fromRGB(70, 70, 90), 2)
		label({ Size = UDim2.new(1, 0, 0, 50), Position = UDim2.new(0, 0, 0, 6), Text = known and pet.icon or &quot;❓&quot;, TextStrokeTransparency = 1, TextTransparency = known and 0 or 0.4 }, card)
		label({ Size = UDim2.new(1, -8, 0, 20), Position = UDim2.new(0, 4, 0, 58), Text = known and pet.id or &quot;???&quot;, Font = FONT_BOLD, TextColor3 = known and Color3.new(1, 1, 1) or Color3.fromRGB(140, 140, 160) }, card)
		label({ Size = UDim2.new(1, -8, 0, 16), Position = UDim2.new(0, 4, 0, 80), Text = rarity.icon .. &quot; &quot; .. rarity.name, Font = FONT_BOLD, TextColor3 = rarity.color }, card)
		label({ Size = UDim2.new(1, -8, 0, 14), Position = UDim2.new(0, 4, 0, 98), Text = egg.icon .. &quot; &quot; .. egg.name, Font = FONT_BOLD, TextColor3 = Color3.fromRGB(190, 190, 210) }, card)
	end
end

-- Zones ----------------------------------------------------------------------------------------

local function rebuildZones()
	for _, child in ipairs(ui.zonesList:GetChildren()) do
		if child:IsA(&quot;Frame&quot;) then
			child:Destroy()
		end
	end
	for i, zone in ipairs(Config.Zones) do
		local unlocked = State.data.zones[zone.id] == true
		local row = glass({ Size = UDim2.new(1, 0, 0, 72), LayoutOrder = i }, ui.zonesList, unlocked and zone.ground or Color3.fromRGB(90, 90, 110))
		label({ Size = UDim2.fromOffset(50, 50), Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Text = zone.icon, TextStrokeTransparency = 1 }, row)
		label({ Size = UDim2.new(0.5, 0, 0, 28), Position = UDim2.new(0, 70, 0, 8), Text = zone.name, TextXAlignment = Enum.TextXAlignment.Left }, row)
		local egg = Config.Eggs[i]
		label({ Size = UDim2.new(0.55, 0, 0, 18), Position = UDim2.new(0, 70, 0, 40), Text = ICON.coins .. &quot; &quot; .. zone.coinValue .. &quot; / coin   &quot; .. egg.icon .. &quot; oeuf &quot; .. egg.price, Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(210, 210, 225) }, row)
		local b = button({ Size = UDim2.fromOffset(150, 40), Position = UDim2.new(1, -10, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Text = unlocked and &quot;➡️ Y ALLER&quot; or (ICON.lock .. &quot; &quot; .. zone.price) }, row, unlocked and Config.Colors.Accent or Config.Colors.Gold)
		b.Activated:Connect(function()
			if unlocked then
				Remotes.Pets:FireServer(&quot;teleport&quot;, zone.id)
				HUD.hide(panels.Zones)
			else
				Remotes.Pets:FireServer(&quot;unlock&quot;, zone.id)
			end
		end)
	end
end

-- Oeuf -----------------------------------------------------------------------------------------

function HUD.openEgg(eggId)
	local egg = Config.EggById[eggId]
	if not egg then
		return
	end
	ui.currentEgg = eggId
	ui.EggTitle.Text = egg.icon .. &quot;  &quot; .. egg.name
	for _, child in ipairs(ui.eggList:GetChildren()) do
		if child:IsA(&quot;Frame&quot;) then
			child:Destroy()
		end
	end
	-- Chances (avec la chance des pets equipes)
	local luck = 0
	for _, uid in ipairs(State.data.equipped) do
		local pet = State.petByUid(uid)
		if pet then
			luck += PetModel.Stats(pet.id, pet.evo).luck
		end
	end
	local luckMult = 1 + math.min(luck, 300) / 150
	local pool, total = {}, 0
	for _, pet in ipairs(Config.Pets) do
		if pet.egg == eggId then
			local rarity = Config.RarityById[pet.rarity]
			local weight = rarity.weight * (rarity.index &gt;= 3 and luckMult or 1)
			table.insert(pool, { pet = pet, weight = weight })
			total += weight
		end
	end
	for i, entry in ipairs(pool) do
		local pet = entry.pet
		local rarity = Config.RarityById[pet.rarity]
		local known = State.data.index[pet.id]
		local row = glass({ Size = UDim2.new(1, 0, 0, 50), LayoutOrder = i }, ui.eggList, rarity.color)
		label({ Size = UDim2.fromOffset(40, 40), Position = UDim2.new(0, 8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Text = known and pet.icon or &quot;❓&quot;, TextStrokeTransparency = 1 }, row)
		label({ Size = UDim2.new(0.45, 0, 0, 24), Position = UDim2.new(0, 56, 0, 5), Text = known and pet.id or &quot;???&quot;, TextXAlignment = Enum.TextXAlignment.Left }, row)
		label({ Size = UDim2.new(0.45, 0, 0, 16), Position = UDim2.new(0, 56, 0, 30), Text = rarity.icon .. &quot; &quot; .. rarity.name, Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = rarity.color }, row)
		local pct = entry.weight / total * 100
		label({ Size = UDim2.new(0.3, -10, 1, -12), Position = UDim2.new(0.7, 0, 0, 6), Text = pct &gt;= 1 and string.format(&quot;%.1f %%&quot;, pct) or string.format(&quot;%.2f %%&quot;, pct), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = rarity.color }, row)
	end
	ui.eggButton.Text = ICON.egg .. &quot;  OUVRIR  •  &quot; .. ICON.coins .. &quot; &quot; .. egg.price .. (luck &gt; 0 and (&quot;   &quot; .. ICON.luck .. &quot; +&quot; .. math.floor((luckMult - 1) * 100) .. &quot; %&quot;) or &quot;&quot;)
	HUD.show(panels.Egg)
end

-- Courses ---------------------------------------------------------------------------------------

local function rebuildRace()
	for _, child in ipairs(ui.raceTypes:GetChildren()) do
		if child:IsA(&quot;TextButton&quot;) then
			child:Destroy()
		end
	end
	for _, child in ipairs(ui.racePets:GetChildren()) do
		if child:IsA(&quot;Frame&quot;) then
			child:Destroy()
		end
	end
	for i, t in ipairs(Config.Race.Types) do
		local selected = ui.raceType == t.id
		local b = button({ Size = UDim2.new(0.5, -5, 1, 0), Text = t.icon .. &quot; &quot; .. t.name .. &quot;\n&quot; .. t.description .. &quot;  •  &quot; .. ICON.coins .. &quot; &quot; .. t.reward, LayoutOrder = i }, ui.raceTypes, selected and Config.Colors.Gold or Color3.fromRGB(70, 70, 90))
		b.Activated:Connect(function()
			ui.raceType = t.id
			rebuildRace()
		end)
	end
	for i, pet in ipairs(State.data.pets) do
		local card = petCard(ui.racePets, pet, i, { selected = ui.racePet == pet.uid })
		local b = new(&quot;TextButton&quot;, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = &quot;&quot;, ZIndex = 5 }, card)
		b.Activated:Connect(function()
			ui.racePet = pet.uid
			rebuildRace()
		end)
	end
	local race = State.race
	if race.phase == &quot;Idle&quot; then
		ui.raceInfo.Text = &quot;Aucune course en cours. Choisis un type et un pet, puis lance la course : les autres joueurs ont &quot; .. Config.Race.LobbyTime .. &quot; s pour te rejoindre. Les places vides sont prises par des bots.&quot;
		ui.raceJoin.Text = ICON.race .. &quot;  LANCER / REJOINDRE&quot;
	elseif race.phase == &quot;Lobby&quot; then
		ui.raceInfo.Text = &quot;🏁 Course &quot; .. tostring(race.type) .. &quot; en preparation : &quot; .. #race.racers .. &quot; / &quot; .. Config.Race.MaxRacers .. &quot; inscrits. Rejoins maintenant !&quot;
		ui.raceJoin.Text = ICON.race .. &quot;  REJOINDRE&quot;
	else
		ui.raceInfo.Text = &quot;Course en cours, regarde la piste !&quot;
		ui.raceJoin.Text = &quot;⏳ EN COURS&quot;
	end
end

local function onRace(race)
	State.race = race
	if panels.Race.Visible then
		rebuildRace()
	end
	if race.phase == &quot;Idle&quot; then
		ui.raceLive.Visible = false
		return
	end
	ui.raceLive.Visible = true
	local lines = {}
	if race.phase == &quot;Lobby&quot; then
		ui.raceLiveTitle.Text = &quot;🏁 LOBBY &quot; .. tostring(race.type)
		for _, r in ipairs(race.racers) do
			table.insert(lines, Config.PetById[r.petId].icon .. &quot; &quot; .. r.name)
		end
	elseif race.phase == &quot;Countdown&quot; then
		ui.raceLiveTitle.Text = &quot;🏁 DEPART IMMINENT&quot;
		for _, r in ipairs(race.racers) do
			table.insert(lines, Config.PetById[r.petId].icon .. &quot; &quot; .. r.name)
		end
	elseif race.phase == &quot;Racing&quot; then
		ui.raceLiveTitle.Text = &quot;🏁 COURSE &quot; .. tostring(race.type)
		local sorted = table.clone(race.racers)
		table.sort(sorted, function(a, b)
			return (a.progress or 0) &gt; (b.progress or 0)
		end)
		for i, r in ipairs(sorted) do
			local pct = race.total and math.floor((r.progress or 0) / race.total * 100) or 0
			table.insert(lines, string.format(&quot;%d. %s %s  %d%%&quot;, i, Config.PetById[r.petId].icon, r.name, pct))
		end
	else
		ui.raceLiveTitle.Text = &quot;🏆 RESULTATS&quot;
		local medals = { &quot;🥇&quot;, &quot;🥈&quot;, &quot;🥉&quot;, &quot;4.&quot; }
		for _, r in ipairs(race.results or race.racers) do
			table.insert(lines, (medals[r.rank] or &quot;&quot;) .. &quot; &quot; .. Config.PetById[r.petId].icon .. &quot; &quot; .. r.name)
		end
	end
	ui.raceLiveList.Text = table.concat(lines, &quot;\n&quot;)
end

-- Eclosion ---------------------------------------------------------------------------------------

function HUD.playHatch(data)
	local def = Config.PetById[data.petId]
	local rarity = Config.RarityById[data.rarity]
	ui.hatch.Visible = true
	ui.hatchEgg.Text = Config.EggById[data.egg or &quot;Village&quot;].icon
	ui.hatchEgg.TextTransparency = 0
	ui.hatchName.Text = &quot;&quot;
	ui.hatchRarity.Text = &quot;&quot;
	ui.hatchStats.Text = &quot;&quot;
	task.spawn(function()
		for i = 1, 10 do
			ui.hatchEgg.Rotation = (i % 2 == 0) and 12 or -12
			ui.hatchEgg.Size = UDim2.fromOffset(220 + i * 6, 220 + i * 6)
			task.wait(0.09)
		end
		ui.hatchEgg.Rotation = 0
		ui.hatchEgg.Text = def.icon
		ui.hatchEgg.Size = UDim2.fromOffset(60, 60)
		TweenService:Create(ui.hatchEgg, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(300, 300) }):Play()
		ui.hatchName.Text = def.id
		ui.hatchName.TextColor3 = rarity.color
		ui.hatchRarity.Text = rarity.icon .. &quot; &quot; .. rarity.name
		ui.hatchRarity.TextColor3 = rarity.color
		ui.hatchStats.Text = statsText(def.id, 1)
		task.wait(2.6)
		TweenService:Create(ui.hatch, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
		task.wait(0.4)
		ui.hatch.Visible = false
		ui.hatch.BackgroundTransparency = 0.25
	end)
end

-- Mises a jour ----------------------------------------------------------------------------------

local function onSync(data)
	State.data = data
	ui.coins.Text = ICON.coins .. &quot; &quot; .. data.coins
	ui.power.Text = ICON.power .. &quot; Puissance &quot; .. data.power .. &quot;   &quot; .. ICON.pets .. &quot; &quot; .. #data.pets .. &quot; pets&quot;
	ui.stats.Text = string.format(&quot;%s %d courses gagnees   %s %d oeufs   %s %d total&quot;, ICON.trophy, data.raceWins, ICON.egg, data.hatched, ICON.coins, data.totalCoins)
	ui.dailyButton.Visible = data.dailyReady
	rebuildEquippedBar()
	if panels.Pets.Visible then
		rebuildPets()
	end
	if panels.Index.Visible then
		rebuildIndex()
	end
	if panels.Zones.Visible then
		rebuildZones()
	end
	if panels.Race.Visible then
		rebuildRace()
	end
	if panels.Egg.Visible and ui.currentEgg then
		HUD.openEgg(ui.currentEgg)
	end
	State.fire(&quot;sync&quot;, data)
end

local function isNear(tag, distance)
	local char = player.Character
	local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if not hrp then
		return false
	end
	for _, s in ipairs(CollectionService:GetTagged(tag)) do
		if (s.Position - hrp.Position).Magnitude &lt;= distance then
			return true
		end
	end
	return false
end

function HUD.Init()
	build()
	ui.rebuild = { Pets = rebuildPets, Index = rebuildIndex, Zones = rebuildZones, Race = rebuildRace }
	Remotes.PetsSync.OnClientEvent:Connect(onSync)
	Remotes.RaceSync.OnClientEvent:Connect(onRace)
	Remotes.Notify.OnClientEvent:Connect(HUD.toast)

	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local s = prompt.Parent
		if not s then
			return
		end
		if CollectionService:HasTag(s, &quot;EggStand&quot;) then
			HUD.openEgg(s:GetAttribute(&quot;EggId&quot;))
		elseif CollectionService:HasTag(s, &quot;RaceStand&quot;) then
			rebuildRace()
			HUD.show(panels.Race)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local map = { [Enum.KeyCode.P] = &quot;Pets&quot;, [Enum.KeyCode.I] = &quot;Index&quot;, [Enum.KeyCode.Z] = &quot;Zones&quot;, [Enum.KeyCode.R] = &quot;Race&quot; }
		local name = map[input.KeyCode]
		if name then
			HUD.toggle(name)
		elseif input.KeyCode == Enum.KeyCode.Escape then
			for _, f in pairs(panels) do
				if f.Visible then
					HUD.hide(f)
				end
			end
		end
	end)

	-- Zone actuelle + pulsation du bouton cadeau
	RunService.Heartbeat:Connect(function()
		local char = player.Character
		local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
		if hrp then
			local current
			for _, zone in ipairs(Config.Zones) do
				if math.abs(hrp.Position.X - zone.center.X) &lt;= zone.size / 2 + 50 and math.abs(hrp.Position.Z - zone.center.Z) &lt;= zone.size / 2 + 50 then
					current = zone
				end
			end
			ui.zoneLabel.Text = current and (current.icon .. &quot; &quot; .. current.name .. &quot;   •   &quot; .. ICON.coins .. &quot; &quot; .. current.coinValue .. &quot; par coin&quot;) or &quot;&quot;
		end
		if ui.dailyButton.Visible then
			ui.dailyButton.Rotation = math.sin(os.clock() * 6) * 4
		end
	end)
	task.delay(1, function()
		Remotes.Pets:FireServer(&quot;sync&quot;)
		Remotes.Race:FireServer(&quot;state&quot;)
	end)
end

return HUD
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">PetFollow</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Affiche les pets equipes qui suivent chaque joueur (rendu local, fluide, sans replication).

local Players = game:GetService(&quot;Players&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local HttpService = game:GetService(&quot;HttpService&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local PetModel = require(ReplicatedStorage.Shared.PetModel)

local PetFollow = {}

local folder = Instance.new(&quot;Folder&quot;)
folder.Name = &quot;ClientPets&quot;
folder.Parent = workspace

local tracked = {} -- [player] = { models = { {model=, id=, evo=, pos=CFrame} }, json = string }

local function rebuild(player)
	local entry = tracked[player]
	if not entry then
		entry = { models = {}, json = &quot;&quot; }
		tracked[player] = entry
	end
	local json = player:GetAttribute(&quot;EquippedPets&quot;) or &quot;[]&quot;
	if json == entry.json then
		return
	end
	entry.json = json
	for _, m in ipairs(entry.models) do
		m.model:Destroy()
	end
	entry.models = {}
	local ok, list = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	if not ok or type(list) ~= &quot;table&quot; then
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	for i, pet in ipairs(list) do
		local cf = hrp and hrp.CFrame or CFrame.new(0, 5, 0)
		local model = PetModel.Build(pet.id, pet.evo, cf)
		model.Parent = folder
		table.insert(entry.models, { model = model, id = pet.id, evo = pet.evo, index = i, current = cf })
	end
end

local function update(dt)
	local now = os.clock()
	for player, entry in pairs(tracked) do
		if player.Parent ~= Players then
			for _, m in ipairs(entry.models) do
				m.model:Destroy()
			end
			tracked[player] = nil
		else
			local char = player.Character
			local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
			local count = #entry.models
			for _, m in ipairs(entry.models) do
				if hrp then
					local angle = math.pi + (m.index - (count + 1) / 2) * 0.9
					local offset = Vector3.new(math.sin(angle) * 5, 0, math.cos(angle) * 5 * -1)
					local target = hrp.CFrame * CFrame.new(offset.X, -1.2, -offset.Z)
					local bob = math.sin(now * 6 + m.index * 1.5) * 0.35 + 0.35
					local goal = CFrame.new(target.Position + Vector3.new(0, bob, 0)) * CFrame.Angles(0, select(2, hrp.CFrame:ToEulerAnglesYXZ()), 0)
					m.current = m.current:Lerp(goal, math.clamp(dt * 6, 0, 1))
					m.model:PivotTo(m.current)
					-- Rainbow : couleur qui cycle
					if m.evo == 3 then
						local hue = (now * 0.4 + m.index * 0.2) % 1
						for _, part in ipairs(m.model:GetChildren()) do
							if part:IsA(&quot;BasePart&quot;) and part.Name ~= &quot;Eye&quot; then
								part.Color = Color3.fromHSV(hue, 0.7, 1)
							end
						end
					end
				end
			end
		end
	end
end

function PetFollow.Init()
	local function hook(player)
		rebuild(player)
		player:GetAttributeChangedSignal(&quot;EquippedPets&quot;):Connect(function()
			rebuild(player)
		end)
		player.CharacterAdded:Connect(function()
			local entry = tracked[player]
			if entry then
				entry.json = &quot;&quot;
			end
			task.wait(0.5)
			rebuild(player)
		end)
	end
	for _, p in ipairs(Players:GetPlayers()) do
		hook(p)
	end
	Players.PlayerAdded:Connect(hook)
	RunService.RenderStepped:Connect(update)
end

return PetFollow
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">State</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Etat partage cote client.

local State = {}

State.data = { coins = 0, totalCoins = 0, pets = {}, equipped = {}, zones = { Village = true }, index = {}, hatched = 0, raceWins = 0, races = 0, dailyReady = false, dailyIn = 0, power = 0 }
State.race = { phase = &quot;Idle&quot;, racers = {} }
State.Changed = Instance.new(&quot;BindableEvent&quot;)

function State.fire(what, data)
	State.Changed:Fire(what, data)
end

function State.petByUid(uid)
	for _, pet in ipairs(State.data.pets) do
		if pet.uid == uid then
			return pet
		end
	end
	return nil
end

return State
</ProtectedString></Properties></Item></Item></Item></Item></Item>
</roblox>
